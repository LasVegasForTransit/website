{
  "version": 1,
  "local": {
    "env": [
      {
        "example": "apps/site/.env.example",
        "file": "apps/site/.env.local"
      }
    ],
    "optional": [
      {
        "name": "LVBT_BEEHIIV_API_KEY",
        "purpose": "Newsletter signup"
      },
      {
        "name": "LVBT_BEEHIIV_PUBLICATION_ID",
        "purpose": "Newsletter signup"
      },
      {
        "name": "LVBT_MEMBERSHIP_INTAKE_SECRET",
        "purpose": "Local form intake"
      },
      {
        "name": "LVBT_NOTION_API_KEY",
        "purpose": "Staff follow-up and press archive"
      },
      {
        "name": "LVBT_NOTION_DATA_SOURCE_ID",
        "purpose": "Staff membership follow-up"
      },
      {
        "name": "LVBT_PRESS_DATA_SOURCE_ID",
        "purpose": "Press archive"
      },
      {
        "name": "LVBT_NOTION_PARENT_PAGE_ID",
        "purpose": "Notion database setup"
      },
      {
        "name": "LVBT_TRANSIT_NEWS_DB_ID",
        "purpose": "Transit news publishing"
      },
      {
        "name": "LVBT_TRANSIT_NEWS_INTAKE_SECRET",
        "purpose": "Local transit news webhook"
      }
    ]
  },
  "audits": {
    "workflow": ".github/workflows/audit-scheduled.yml",
    "artifactName": "lvbt-audit-report",
    "dependencies": {
      "local": {
        "command": ["pnpm", "audit", "--prod", "--audit-level=low", "--json"],
        "format": "pnpm"
      },
      "production": {
        "command": ["pnpm", "audit", "--prod", "--audit-level=low", "--json"],
        "format": "pnpm"
      }
    },
    "links": {
      "local": {
        "cwd": "apps/site",
        "command": [
          "pnpm",
          "exec",
          "tsx",
          "scripts/audit/check-build-links.ts",
          "--report",
          "audit-links.json"
        ],
        "output": "apps/site/audit-links.json",
        "format": "links"
      },
      "production": {
        "cwd": "apps/site",
        "command": [
          "pnpm",
          "exec",
          "tsx",
          "scripts/audit/check-build-links.ts",
          "--report",
          "audit-links.json",
          "--target",
          "production"
        ],
        "output": "apps/site/audit-links.json",
        "format": "links"
      }
    },
    "lighthouse": {
      "local": {
        "cwd": "apps/site",
        "command": ["pnpm", "exec", "lhci", "autorun"],
        "output": "apps/site/.lighthouseci/assertion-results.json",
        "format": "lhci"
      },
      "production": {
        "cwd": "apps/site",
        "command": ["pnpm", "exec", "lhci", "autorun"],
        "output": "apps/site/.lighthouseci/assertion-results.json",
        "format": "lhci",
        "env": {
          "LIGHTHOUSE_PRESET": "prod"
        }
      }
    }
  },
  "release": {
    "repository": "LasVegasForTransit/website",
    "appDirectory": "apps/deploy",
    "productionUrl": "https://lasvegasfortransit.org",
    "previewUrl": "https://preview.lasvegasfortransit.org",
    "productionWorker": "lvbt-website",
    "previewWorker": "lvbt-website-preview",
    "artifactPrefix": "website-release",
    "stagingWorkflow": {
      "name": "Deploy staging",
      "path": ".github/workflows/deploy-production.yml",
      "branch": "main"
    },
    "promotionWorkflow": {
      "file": "deploy-worker-candidate.yml",
      "titlePrefix": "Promote website",
      "branch": "main"
    },
    "artifactAcceptance": {
      "forbiddenPaths": ["patterns", "prototypes"],
      "forbiddenLanguages": ["en-XA"]
    },
    "artifactSource": "typed-worker",
    "typedConfig": "cloudflare.config.ts",
    "assetsDirectory": "../site/dist",
    "workersDevSubdomain": "las-vegas-for-better-transit",
    "previewBindings": {
      "PLATFORM_DB": {
        "type": "d1",
        "name": "lvbt-platform-preview",
        "id": "8bb072e7-9865-487a-8867-d97fdb2ea00b"
      },
      "ASSETS": {
        "type": "assets"
      },
      "LVBT_DEPLOYMENT_ENV": {
        "type": "text",
        "value": "preview"
      },
      "LVBT_RESEND_API_KEY": {
        "type": "secret"
      },
      "LVBT_BEEHIIV_API_KEY": {
        "type": "secret"
      },
      "LVBT_BEEHIIV_PUBLICATION_ID": {
        "type": "secret"
      },
      "LVBT_MEMBERSHIP_INTAKE_SECRET": {
        "type": "secret"
      },
      "LVBT_NOTION_API_KEY": {
        "type": "secret"
      },
      "LVBT_NOTION_DATA_SOURCE_ID": {
        "type": "secret"
      },
      "LVBT_PRESS_DATA_SOURCE_ID": {
        "type": "secret"
      },
      "LVBT_TRANSIT_NEWS_INTAKE_SECRET": {
        "type": "secret"
      },
      "LVBT_SIGN_IN_SECRET": {
        "type": "secret"
      },
      "LVBT_LINK_SIGNING_SECRET": {
        "type": "secret"
      }
    },
    "migrations": [
      {
        "binding": "PLATFORM_DB",
        "directory": "../site/platform/storage/migrations"
      }
    ],
