{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["CI"],
  "tasks": {
    "//#security:secrets": {
      "cache": false
    },
    "//#security:dependencies": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".wrangler/worker/**"]
    },
    "sync": {
      "outputs": [".astro/**"]
    },
    "lint": {
      "dependsOn": ["^lint", "sync"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "validate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "lint:styles": {},
    "lint:brand": {},
    "check:docs": {},
    "check-types:scripts": {},
    "@lasvegasfortransit/site#validate": {
      "dependsOn": ["build", "lint:styles", "lint:brand", "check:docs", "check-types:scripts"],
      "cache": false
    },
    "@lasvegasfortransit/staff#validate": {
      "dependsOn": ["^build", "sync"]
    },
    "@lasvegasfortransit/staff#check-types": {
      "dependsOn": ["^check-types", "sync"]
    },
    "preflight": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
    },
    "release": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_ACCOUNT_ID", "CLOUDFLARE_API_TOKEN"]
    }
  },
  "globalDependencies": [".lvbt/web-platform.json", ".lvbt/tooling.json", ".github/workflows/**"],
  "globalPassThroughEnv": ["AUDIT_PORT", "AUDIT_SKIP_BUILD", "PLAYWRIGHT_BASE_URL"]
}
