#!/bin/bash
#
# pre-push hook -- enforces project-wide gates before code leaves the laptop
#
# Steps:
#   1. Working tree must be clean (checks build from your working tree, not
#      from the commits you're pushing).
#   2. Every commit between BASE..HEAD must follow conventional format.
#   3. pnpm lint (prettier --write .) and bail if it produces a diff. CI
#      runs `prettier --check .` which can hard-fail the deploy, so this
#      gate makes sure formatting drift is fixed locally first.
#   4. pnpm typecheck (astro check + tsc -p scripts/tsconfig.json).
#   5. pnpm build (astro build).
#
# Adapted from lovelace/.githooks/pre-push, trimmed to this repo's stack
# (Astro + pnpm + Cloudflare Pages; no Vercel env reconciliation, no Rust,
# no monorepo affected-graph filtering).

set -e

# ---------------------------------------------------------------------------
# Terminal formatting
# ---------------------------------------------------------------------------
BOLD='\033[1m'
DIM='\033[2m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    BOLD='' DIM='' RED='' GREEN='' YELLOW='' CYAN='' RESET=''
fi

TOTAL_STEPS=5
STEP_START=0

step() {
    STEP_START=$SECONDS
    printf "\n${CYAN}${BOLD}[%s/%s]${RESET} %s\n" "$1" "$TOTAL_STEPS" "$2"
}

step_time() { echo "$(( SECONDS - STEP_START ))s"; }

pass() { printf "  ${GREEN}pass${RESET}  %s\n" "$1"; }
fail() { printf "\n  ${RED}${BOLD}Push blocked${RESET} -- %s\n" "$1"; }
hint() { printf "  ${DIM}%s${RESET}\n" "$1"; }
cmd()  { printf "    ${BOLD}%s${RESET}\n" "$1"; }
filelist() { while IFS= read -r line; do printf "    ${YELLOW}%s${RESET}\n" "$line"; done; }

# ---------------------------------------------------------------------------
# Preamble: figure out push base
# ---------------------------------------------------------------------------
BRANCH=$(git rev-parse --abbrev-ref HEAD)
UPSTREAM=$(git rev-parse --abbrev-ref "@{u}" 2>/dev/null || echo "")

if [ -z "$UPSTREAM" ]; then
    BASE="main"
else
    BASE="@{u}"
fi

printf "\n${BOLD}Pre-push validation${RESET} -- %s checks to run\n" "$TOTAL_STEPS"

COMMITS_AHEAD=$(git rev-list --count "${BASE}..HEAD" 2>/dev/null || echo "0")

if [ "$COMMITS_AHEAD" -eq 0 ]; then
    hint "No commits to push"
    exit 0
fi

printf "  Commits to push: ${BOLD}%s${RESET}" "$COMMITS_AHEAD"
if [ -z "$UPSTREAM" ]; then
    printf " ${DIM}(new branch, comparing against main)${RESET}"
fi
printf "\n"

# ---------------------------------------------------------------------------
# 1. Working tree clean
# ---------------------------------------------------------------------------
step 1 "Checking working directory"
hint "Uncommitted changes make build/typecheck results unreliable."

STAGED_FILES=$(git diff --cached --name-status 2>/dev/null || true)
UNSTAGED_FILES=$(git diff --name-status 2>/dev/null || true)
UNTRACKED_FILES=$(git ls-files --others --exclude-standard 2>/dev/null || true)

if [ -n "$STAGED_FILES" ] || [ -n "$UNSTAGED_FILES" ] || [ -n "$UNTRACKED_FILES" ]; then
    fail "Working directory is not clean"
    echo ""

    if [ -n "$STAGED_FILES" ]; then
        printf "  ${BOLD}Staged${RESET}\n"
        echo "$STAGED_FILES" | filelist
        echo ""
    fi
    if [ -n "$UNSTAGED_FILES" ]; then
        printf "  ${BOLD}Unstaged${RESET}\n"
        echo "$UNSTAGED_FILES" | filelist
        echo ""
    fi
    if [ -n "$UNTRACKED_FILES" ]; then
        printf "  ${BOLD}Untracked${RESET}\n"
        echo "$UNTRACKED_FILES" | filelist
        echo ""
    fi

    STASH_FLAGS=""
    [ -n "$UNTRACKED_FILES" ] && STASH_FLAGS=" --include-untracked"

    printf "  ${BOLD}Stash, push, restore:${RESET}\n"
    cmd "git stash push${STASH_FLAGS} -m \"wip: ${BRANCH}\""
    cmd "git push"
    cmd "git stash pop"
    echo ""
    exit 1
fi

pass "Working directory is clean ($(step_time))"

# ---------------------------------------------------------------------------
# 2. Conventional commit format on every commit between BASE and HEAD
# ---------------------------------------------------------------------------
step 2 "Validating commit messages"
hint "All commits must follow conventional-commits format."

INVALID_COMMITS=0

# Single `git log` call returns `<short-hash>\t<subject>` per commit, parsed
# with `read`. Avoids the previous `for + git log -1 + git rev-parse` pattern
# that spawned 2N git processes for an N-commit push.
while IFS=$'\t' read -r short_hash first_line; do
    if ! printf '%s' "$first_line" | grep -qE '^[a-z]+(\([a-z0-9._-]+\))?!?: .+'; then
        if [ "$INVALID_COMMITS" -eq 0 ]; then
            fail "One or more commit messages don't follow conventional format"
            echo ""
            printf "  ${BOLD}These commits need rewording:${RESET}\n"
        fi
        echo ""
        printf "    ${YELLOW}%s${RESET}  %s\n" "$short_hash" "$first_line"
        INVALID_COMMITS=$((INVALID_COMMITS + 1))
    fi
done < <(git log --reverse --format='%h%x09%s' "${BASE}..HEAD" 2>/dev/null)

if [ "$INVALID_COMMITS" -gt 0 ]; then
    echo ""
    printf "  ${BOLD}Fix:${RESET}\n"
    cmd "git rebase -i ${BASE}"
    printf "  Change ${BOLD}pick${RESET} to ${BOLD}reword${RESET} for each invalid commit.\n"
    echo ""
    hint "Reference: docs/standards/commit-messages.md"
    echo ""
    exit 1
fi

pass "All commit messages follow conventional format ($(step_time))"

# ---------------------------------------------------------------------------
# 3. Prettier formatting -- auto-fixes drift instead of failing. CI runs
# `prettier --check .` and a hard fail there blocks the production deploy,
# so the local pre-push runs `prettier --write .` and stops the push only
# if it produces a non-empty diff (which it shouldn't, because pre-commit
# already formatted everything).
# ---------------------------------------------------------------------------
step 3 "Auto-formatting (prettier --write)"
hint "Running prettier --write across the repo; never fail on fixable drift."

if ! pnpm --silent lint; then
    fail "Prettier crashed"
    echo ""
    cmd "pnpm lint"
    echo ""
    exit 1
fi

PRETTIER_DIFF=$(git diff --name-only 2>/dev/null || true)
if [ -n "$PRETTIER_DIFF" ]; then
    fail "Prettier reformatted files; commit them before pushing"
    echo ""
    printf "  ${BOLD}Reformatted${RESET}\n"
    echo "$PRETTIER_DIFF" | filelist
    echo ""
    printf "  ${BOLD}Fix:${RESET}\n"
    cmd "git add ${PRETTIER_DIFF}"
    cmd "git commit --amend --no-edit  # or a new commit"
    echo ""
    exit 1
fi

pass "Formatting clean ($(step_time))"

# ---------------------------------------------------------------------------
# 4. TypeScript / Astro check
# ---------------------------------------------------------------------------
step 4 "Running pnpm typecheck"
hint "astro check + tsc -p scripts/tsconfig.json"

if ! pnpm typecheck; then
    fail "Type errors detected"
    echo ""
    cmd "pnpm typecheck"
    echo ""
    exit 1
fi

pass "Typecheck clean ($(step_time))"

# ---------------------------------------------------------------------------
# 5. Build (skipped when the push only touches paths that can't change output)
# ---------------------------------------------------------------------------
step 5 "Running pnpm build"
hint "astro build"

# Paths that never affect the built site: repo docs (.md, not .mdx — MDX is
# rendered), hook scripts, the scope policy file, and the standards docs tree.
# Anything outside this set means we must build.
PUSH_FILES=$(git diff --name-only "${BASE}..HEAD" 2>/dev/null || echo "")
BUILD_AFFECTING=$(printf '%s\n' "$PUSH_FILES" \
    | grep -vE '^docs/|^\.githooks/|^allowed-scopes\.txt$|(^|/)[^/]+\.md$' \
    | grep -v '^$' || true)

if [ -z "$BUILD_AFFECTING" ]; then
    pass "Build skipped -- push only touches docs/hooks/policy ($(step_time))"
elif ! pnpm build; then
    fail "Build failed"
    echo ""
    cmd "pnpm build"
    echo ""
    exit 1
else
    pass "Build clean ($(step_time))"
fi

# ---------------------------------------------------------------------------
# Success
# ---------------------------------------------------------------------------
TOTAL_TIME=$SECONDS
printf "\n${GREEN}${BOLD}All checks passed${RESET} ${DIM}(%ss)${RESET} -- pushing to remote\n\n" "$TOTAL_TIME"

exit 0
