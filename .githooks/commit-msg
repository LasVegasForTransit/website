#!/usr/bin/env sh
# The contribution plugin owns the subject policy so its PR helper and this
# local hook cannot silently accept different scopes.
set -eu

MESSAGE_FILE="$1"
SUBJECT=$(head -n 1 "$MESSAGE_FILE")

# Git writes these subjects itself; they do not name an authored change.
case "$SUBJECT" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

ROOT=$(git rev-parse --show-toplevel)
exec node "$ROOT/plugins/lvbt-contributions/scripts/validate-commit-subject.mjs" "$SUBJECT"
