#!/usr/bin/env sh
# Pre-commit checks. Each block runs only when the staged change touches files
# it cares about. Add new checks below; keep them small and conditional.

set -e

cd "$(git rev-parse --show-toplevel)"

STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

if [ -z "$STAGED" ]; then
  exit 0
fi

# ----------------------------------------------------------------------------
# Prettier via lint-staged. Auto-formats every staged file prettier can handle
# (the lint-staged config uses `*` + `--ignore-unknown`, so prettier decides
# what's formattable). Runs unconditionally — the ~250ms cold-start is the
# price of never letting an unformatted file slip through and fail
# `prettier --check` in CI.
# ----------------------------------------------------------------------------
if ! NODE_OPTIONS="--max-old-space-size=4096" pnpm --silent exec lint-staged; then
  printf '\n❌ Commit blocked: lint-staged failed. Fix the issues above and re-stage.\n\n' >&2
  exit 1
fi

# ----------------------------------------------------------------------------
# Shellcheck on staged .sh files. Soft-skip if shellcheck is not installed.
# A here-doc (not a pipe) drives the while loop so `sh_failed=1` propagates
# back to this shell — a pipe would run the loop in a subshell and silently
# lose the failure flag.
# ----------------------------------------------------------------------------
sh_files=$(printf '%s\n' "$STAGED" | grep -E '\.sh$' || true)
if [ -n "$sh_files" ]; then
  if command -v shellcheck >/dev/null 2>&1; then
    sh_failed=0
    while IFS= read -r file; do
      [ -f "$file" ] || continue
      shellcheck --severity=warning "$file" || sh_failed=1
    done <<EOF
$sh_files
EOF
    if [ "$sh_failed" -ne 0 ]; then
      printf '\n❌ Commit blocked: shellcheck warnings in staged scripts.\n\n' >&2
      exit 1
    fi
  else
    printf 'warn: shellcheck not installed; skipping shell-script lint.\n' >&2
  fi
fi

# ----------------------------------------------------------------------------
# Stylesheet lint + brand-token drift. stylelint covers the hand-authored
# stylesheets (rule set in .stylelintrc.json — Astro <style> blocks are out of
# scope). brand-tokens.ts guards the palette hexes copied outside global.css
# and global.css's unlayered-zone allowlist.
# ----------------------------------------------------------------------------
CSS_STAGED=$(printf '%s\n' "$STAGED" | grep -E '^src/.*\.css$' || true)
if [ -n "$CSS_STAGED" ]; then
  # shellcheck disable=SC2086  # intentional word-split into file args
  if ! pnpm --silent exec stylelint $CSS_STAGED; then
    printf '\n❌ Commit blocked: stylelint failed on staged stylesheets.\n\n' >&2
    exit 1
  fi
fi

BRAND_TOKEN_STAGED=$(printf '%s\n' "$STAGED" | grep -E '^src/styles/global\.css$|^src/pages/(brand|qr)\.astro$|^src/lib/qr-svg\.ts$|^scripts/generate-og-image\.ts$|^tests/(a11y-helpers\.ts|body-links\.spec\.ts|color-contracts\.spec\.ts)$' || true)
if [ -n "$BRAND_TOKEN_STAGED" ]; then
  if ! pnpm --silent exec tsx scripts/audit/brand-tokens.ts; then
    printf '\n❌ Commit blocked: brand token drift (see scripts/audit/brand-tokens.ts output).\n\n' >&2
    exit 1
  fi
fi

# ----------------------------------------------------------------------------
# Markdown / MDX link validation. Pass the staged set with `--files` so the
# script restricts outbound-link extraction to changed files (cross-file
# anchor checks still work — target headings are read lazily on demand).
# `.astro` files have no markdown links, so they're filtered out.
# ----------------------------------------------------------------------------
STAGED_DOCS=$(printf '%s\n' "$STAGED" | grep -iE '\.(md|mdx)$' || true)
if [ -n "$STAGED_DOCS" ]; then
  # shellcheck disable=SC2086  # intentional word-split into multiple --files args
  pnpm --silent check:docs --files $STAGED_DOCS
fi

# ----------------------------------------------------------------------------
# TypeScript typecheck. Split into two independent gates so a scripts-only
# commit doesn't pay for `astro check` cold-start, and a src-only commit
# doesn't run `tsc -p scripts/tsconfig.json`.
# ----------------------------------------------------------------------------
ASTRO_STAGED=$(printf '%s\n' "$STAGED" | grep -E '^src/.*\.(ts|tsx|astro)$|^astro\.config\.(mjs|ts)$|^tsconfig\.json$' || true)
SCRIPTS_STAGED=$(printf '%s\n' "$STAGED" | grep -E '^scripts/' || true)

if [ -n "$ASTRO_STAGED" ]; then
  pnpm --silent exec astro check
fi
if [ -n "$SCRIPTS_STAGED" ]; then
  pnpm --silent exec tsc -p scripts/tsconfig.json
fi

# ----------------------------------------------------------------------------
# GitHub Actions workflow lint. actionlint validates schema, expression syntax,
# job/output references, and runs shellcheck on inline `run:` blocks. Soft-skip
# if not installed — `pnpm bootstrap` (or `pnpm preflight`) flags it.
# ----------------------------------------------------------------------------
if printf '%s\n' "$STAGED" | grep -qE '^\.github/(workflows|actions)/'; then
  if command -v actionlint >/dev/null 2>&1; then
    actionlint
  else
    printf 'warn: actionlint not installed; skipping workflow lint. Run `pnpm bootstrap --phase install` to install.\n' >&2
  fi
fi
