# Las Vegans for Better Transit — environment variables
#
# Copy this file to .env.local and fill in real values.
# `pnpm bootstrap --phase env` will walk you through it interactively.
#
# PUBLIC_-prefixed vars are baked into the static HTML at build time.
# Non-PUBLIC vars are server-side only (Cloudflare Pages Functions) — set
# these as Secrets in the Cloudflare Pages dashboard too.

# Newsletter (Beehiiv API — server-side only, never baked into HTML)
LVBT_BEEHIIV_API_KEY=
LVBT_BEEHIIV_PUBLICATION_ID=pub_PLACEHOLDER

# Donations (Givebutter, Donorbox, etc.)
PUBLIC_LVBT_DONATE_URL=https://givebutter.com/lvbt

# Social profile URLs
PUBLIC_LVBT_INSTAGRAM=https://instagram.com/lasvegasfortransit
PUBLIC_LVBT_BLUESKY=https://bsky.app/profile/lasvegasfortransit.org
