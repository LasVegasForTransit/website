{
  "name": "lvbt-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4320",
    "dev:pages": "sh -lc 'trap \"kill 0\" INT TERM EXIT; astro dev --host 127.0.0.1 --port ${PORT:-4320} & wrangler pages dev .wrangler/dev-static --ip 127.0.0.1 --port 4321 & wait'",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "check-types": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "stylelint 'src/styles/*.css' 'src/**/*.module.css'"
  },
  "dependencies": {
    "@astrojs/mdx": "catalog:",
    "@astrojs/sitemap": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "astro": "catalog:",
    "astro-icon": "catalog:",
    "fast-xml-parser": "catalog:",
    "ical.js": "catalog:",
    "sitemap": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@iconify-json/mdi": "catalog:",
    "@lvbt/eslint-config": "link:../../../repository-tooling/packages/eslint-config",
    "@lvbt/playwright-config": "link:../../../repository-tooling/packages/playwright-config",
    "@lvbt/typescript-config": "link:../../../repository-tooling/packages/typescript-config",
    "@lvbt/vitest-config": "link:../../../repository-tooling/packages/vitest-config",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "pagefind": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
