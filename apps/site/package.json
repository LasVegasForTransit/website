{
  "name": "@lasvegasfortransit/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "portless": {
    "name": "lvbt",
    "script": "dev:app",
    "appPort": 4320
  },
  "scripts": {
    "dev": "portless",
    "dev:app": "sh -lc 'trap \"kill 0\" INT TERM EXIT; astro dev --host 127.0.0.1 --port ${PORT:-4320} & wrangler pages dev .wrangler/dev-static --ip 127.0.0.1 --port 4321 & wait'",
    "build": "pnpm build:site && pnpm build:functions",
    "build:site": "astro build && tsx scripts/minify-public-scripts.ts && pagefind --site dist --output-subdir pagefind",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/worker",
    "preview": "wrangler dev --local",
    "sync": "astro sync",
    "lint": "eslint . --max-warnings 0",
    "lint:styles": "stylelint 'src/styles/*.css' 'src/**/*.module.css'",
    "lint:brand": "tsx scripts/audit/brand-tokens.ts",
    "check-types": "astro check --noSync",
    "check-types:scripts": "tsc -p scripts/tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --import tsx node_modules/@playwright/test/cli.js test",
    "test:update": "pnpm test:e2e --update-snapshots",
    "test:install": "playwright install --with-deps chromium",
    "validate": "tsx scripts/audit/worker-parity.ts",
    "astro": "astro",
    "setup:notion": "tsx scripts/notion/provision-intake-db.ts",
    "add:transit-news": "tsx scripts/notion/add-transit-news.ts",
    "event:new": "tsx scripts/event-new.ts",
    "screenshot": "tsx scripts/screenshot.ts",
    "check:docs": "tsx scripts/check-docs-links.ts",
    "check:baseline": "tsx scripts/audit/baseline.ts",
    "check:lighthouse": "lhci autorun",
    "check:html": "html-validate dist/**/*.html",
    "check:structured-data": "tsx scripts/audit/structured-data.ts",
    "check:third-party": "tsx scripts/audit/third-party-scan.ts",
    "check:a11y": "pnpm test:e2e --project=a11y",
    "check:content": "alex src/content && cspell --no-progress --no-summary 'src/**/*.{md,mdx,astro}'",
    "worker:types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types worker-configuration.d.ts --include-runtime=false --check",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/deploy-dry-run",
    "worker:test:live": "tsx scripts/audit/worker-live-parity.ts",
    "worker:test:browser": "pnpm test:e2e",
    "worker:preview": "tsx scripts/deploy/worker-preview.ts",
    "worker:dev": "pnpm build && pnpm preview",
    "worker:release": "tsx scripts/deploy/worker-release.ts",
    "worker:smoke": "tsx scripts/deploy/release-smoke.ts",
    "worker:publication": "tsx scripts/deploy/record-publication.ts",
    "worker:promote": "pnpm --dir ../.. promote",
    "check:links": "tsx scripts/audit/check-build-links.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "astro-icon": "catalog:",
    "fast-xml-parser": "catalog:",
    "ical.js": "catalog:",
    "sharp": "catalog:",
    "sitemap": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@astrojs/mdx": "catalog:",
    "@axe-core/playwright": "catalog:",
    "@clack/prompts": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@iconify-json/mdi": "catalog:",
    "@lasvegasfortransit/analytics": "catalog:",
    "@lasvegasfortransit/eslint-config": "file:../../.lvbt/web-platform/packages/eslint-config",
    "@lasvegasfortransit/playwright-config": "file:../../.lvbt/web-platform/packages/playwright-config",
    "@lasvegasfortransit/typescript-config": "file:../../.lvbt/web-platform/packages/typescript-config",
    "@lasvegasfortransit/web-platform": "file:../../.lvbt/web-platform/packages/web-platform",
    "@lhci/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "alex": "catalog:",
    "astro": "catalog:",
    "cspell": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "html-validate": "catalog:",
    "pagefind": "catalog:",
    "picocolors": "catalog:",
    "portless": "catalog:",
    "stylelint": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
