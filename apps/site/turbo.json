{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "sync"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/packages/platform-core/src/staff-gate*",
        "$TURBO_ROOT$/packages/platform-core/src/StaffGateLayout.astro"
      ],
      "env": ["PUBLIC_LVBT_*", "LVBT_REQUIRE_ANALYTICS", "LVBT_PSEUDO_LOCALE"],
      "outputs": ["dist/**", ".wrangler/worker/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "lint": {
      "dependsOn": ["^lint", "sync", "lint:styles", "lint:brand"]
    },
    "lint:styles": {},
    "lint:brand": {},
    "check-types": {
      "dependsOn": ["^check-types", "check-types:scripts", "sync"]
    },
    "check-types:scripts": {},
    "validate": {
      "dependsOn": [
        "^build",
        "build",
        "check:docs",
        "worker:types",
        "worker:check",
        "//#security:secrets",
        "//#security:dependencies"
      ]
    },
    "check:docs": {
      "inputs": ["$TURBO_DEFAULT$", "../../docs/**"]
    },
    "worker:types": {
      "dependsOn": ["build"]
    },
    "worker:check": {
      "dependsOn": ["build"],
      "outputs": [".wrangler/deploy-dry-run/**"]
    },
    "test:e2e": {
      "passThroughEnv": ["RELEASE_ID", "RELEASE_COMMIT", "BUILT_ASSETS_DIRECTORY"]
    },
    "test:ui-contracts": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "dist/**", ".wrangler/worker/**"],
      "outputs": []
    },
    "roster:export": {
      "cache": false,
      "passThroughEnv": [
        "LVBT_BEEHIIV_API_KEY",
        "LVBT_BEEHIIV_PUBLICATION_ID",
        "LVBT_NOTION_API_KEY",
        "LVBT_NOTION_DATA_SOURCE_ID"
      ]
    },
    "roster:import": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/staff/src/**",
        "$TURBO_ROOT$/packages/platform-core/src/**",
        "$TURBO_ROOT$/packages/platform-storage/src/**",
        "$TURBO_ROOT$/packages/platform-integrations/src/**"
      ]
    }
  }
}
