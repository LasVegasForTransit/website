# Las Vegans for Better Transit — environment variables
#
# Copy this file to .env.local and fill in real values.
# `pnpm bootstrap --phase env` will walk you through it interactively.
#
# Everything in .env.local is for this machine only. PUBLIC_-prefixed vars are
# baked into the static HTML at build time; production builds read them from
# GitHub Actions variables. Non-PUBLIC vars are server-side only; the live
# site gets them from `pnpm bootstrap --phase secrets`, never from this file.

# Newsletter (Beehiiv API — server-side only, never baked into HTML)
LVBT_BEEHIIV_API_KEY=
LVBT_BEEHIIV_PUBLICATION_ID=pub_PLACEHOLDER

# Membership intake (Google Forms → Cloudflare → Beehiiv + Notion)
LVBT_MEMBERSHIP_INTAKE_SECRET=
LVBT_NOTION_API_KEY=
LVBT_NOTION_DATA_SOURCE_ID=
# Used only by `pnpm setup:notion` to create the intake database: the Notion
# page (shared with the integration) to create it under. Not needed at runtime.
LVBT_NOTION_PARENT_PAGE_ID=

# Transit News database — required by `pnpm add:transit-news`. Paste the 32-char
# ID from the database's Notion URL into .env.local; the script resolves its data
# source from it. Left blank here like the other Notion IDs — it's not a secret,
# but internal resource IDs don't belong in the committed example.
LVBT_TRANSIT_NEWS_DB_ID=
# Shared secret for the /api/transit-news-intake Pages Function. The Notion form
# automation sends it as `Authorization: Bearer <value>`. For local testing only;
# `pnpm bootstrap --phase secrets` stores the live value. Local value:
# openssl rand -hex 32
LVBT_TRANSIT_NEWS_INTAKE_SECRET=

# Membership form — public Google Form, the front door for new members.
# Use the forms.gle short link (Google Forms → Send → link → Shorten URL):
# it drives the /join CTA and the QR slide (whose encoder caps at 84 bytes).
PUBLIC_LVBT_MEMBERSHIP_FORM_URL=https://forms.gle/mcLd4EQrGwRPA3bv7

# Donations (Givebutter, Donorbox, etc.)
PUBLIC_LVBT_DONATE_URL=https://givebutter.com/lvbt

# Newsletter (Beehiiv) — public links surfaced on /newsletter. `URL` is the
# Beehiiv home (archive + subscribe); `FEED_URL` is the RSS feed pulled at
# build to list recent issues. Both blank → /newsletter shows its empty state.
PUBLIC_LVBT_NEWSLETTER_URL=https://mail.lasvegasfortransit.org/
PUBLIC_LVBT_NEWSLETTER_FEED_URL=https://rss.beehiiv.com/feeds/XuCVpFPme9.xml

# Social profile URLs
PUBLIC_LVBT_INSTAGRAM=https://instagram.com/lasvegasfortransit
PUBLIC_LVBT_LINKEDIN=https://www.linkedin.com/company/lasvegasfortransit/
PUBLIC_LVBT_BLUESKY=https://bsky.app/profile/lasvegasfortransit.org
PUBLIC_LVBT_DISCORD=https://discord.gg/Pfzk5p8QNV
