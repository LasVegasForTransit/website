---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import VegasUrbanistsPage from '../../components/programs/VegasUrbanistsPage.astro';
import { paths } from '../../lib/paths';

export async function getStaticPaths() {
  const [programs, projects] = await Promise.all([
    getCollection('programs'),
    getCollection('projects'),
  ]);
  const programIds = new Set(programs.map((program) => program.id));
  for (const project of projects) {
    if (project.data.program && !programIds.has(project.data.program)) {
      throw new Error(
        `Project "${project.id}" references missing program "${project.data.program}".`,
      );
    }
  }
  return programs.map((program) => ({
    params: { slug: program.id },
    props: {
      program,
      relatedProjects: projects.filter((project) => project.data.program === program.id),
    },
  }));
}

const { program, relatedProjects } = Astro.props;
const { Content } = await render(program);
---

<BaseLayout title={program.data.title} description={program.data.summary}>
  {
    program.id === 'vegas-urbanists' ? (
      <VegasUrbanistsPage cadence={program.data.cadence} venue={program.data.venue}>
        <Content />
      </VegasUrbanistsPage>
    ) : (
      <>
        <header class="container-page pt-6 pb-8 md:pt-10">
          <Breadcrumbs
            section={{ name: 'Programs', href: paths.programs }}
            current={program.data.title}
          />
          <h1 class="mt-3 text-display-md">{program.data.title}</h1>
          <p class="lede mt-5 max-w-3xl">{program.data.summary}</p>
          <p class="mt-6 text-title-lg font-semibold">{program.data.cadence}</p>
        </header>

        <hr class="rule-thick container-page" />

        <div class="container-page grid gap-12 pt-8 pb-16 md:grid-cols-[2fr_1fr]">
          <article class="prose-doc max-w-none">
            <Content />
          </article>
          <aside class="space-y-8 md:border-l md:border-outline-variant/20 md:pl-10">
            <div>
              <h2 class="text-title-lg font-bold">Join in</h2>
              {program.data.participationUrl ? (
                <>
                  <p class="mt-3 text-on-surface-variant">
                    Find current dates, details, and resources on the participant site.
                  </p>
                  <a
                    href={program.data.participationUrl}
                    class="mt-4 inline-block font-bold underline underline-offset-4"
                  >
                    Visit the participant site →
                  </a>
                </>
              ) : (
                <>
                  <p class="mt-3 text-on-surface-variant">
                    Check the events calendar for confirmed meetup details.
                  </p>
                  <a
                    href={paths.events}
                    class="mt-4 inline-block font-bold underline underline-offset-4"
                  >
                    See upcoming events →
                  </a>
                </>
              )}
            </div>
            {relatedProjects.length > 0 && (
              <div>
                <h2 class="text-title-lg font-bold">Related projects</h2>
                <ul class="mt-3 space-y-3">
                  {relatedProjects.map((project) => (
                    <li>
                      <a href={paths.project(project.id)} class="nav-link">
                        {project.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </aside>
        </div>
      </>
    )
  }
</BaseLayout>
