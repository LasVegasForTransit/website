---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import LetterCard from '../../components/LetterCard.astro';
import { getCollection } from 'astro:content';

const letters = (await getCollection('letters')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Letters from Leadership"
  description="Periodic notes from LVBT's team on where the fight for better transit stands."
>
  <PageHero title="Letters from Leadership" lede="Periodic notes from LVBT's team." />

  <section class="container-page py-12">
    <h2 class="sr-only">Published letters</h2>
    {
      letters.length === 0 ? (
        <p class="lede max-w-2xl">Nothing published yet — check back soon.</p>
      ) : (
        <div class="flex max-w-3xl flex-col gap-4">
          {letters.map((letter) => (
            <LetterCard letter={letter} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
