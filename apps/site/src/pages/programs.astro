---
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProgramFeature from '../components/programs/ProgramFeature.astro';
import { byOrderThenTitle, isActiveProject } from '../lib/projects';
import { paths } from '../lib/paths';
import { selectEventBody } from '../lib/event-bodies';
import '../styles/programs.css';

const [programs, workAreas, projects, events, eventBodies] = await Promise.all([
  getCollection('programs'),
  getCollection('workAreas'),
  getCollection('projects'),
  getCollection('events'),
  getCollection('eventBodies'),
]);

const programIds = new Set(programs.map((program) => program.id));
for (const project of projects) {
  if (project.data.program && !programIds.has(project.data.program)) {
    throw new Error(
      `Project "${project.id}" references missing program "${project.data.program}".`,
    );
  }
}

const namedPrograms = programs.toSorted((a, b) => a.data.order - b.data.order);
const programEvents = events.map((event) => ({
  ...event,
  data: {
    ...event.data,
    discussionTopic: selectEventBody(eventBodies, event)?.data.discussionTopic,
  },
}));

const projectsById = new Map(projects.map((project) => [project.id, project]));
const renderedWorkAreas = await Promise.all(
  workAreas
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (area) => ({
      ...area,
      Content: (await render(area)).Content,
      projectEntries: area.data.projects
        .map((id) => {
          const project = projectsById.get(id);
          if (!project)
            throw new Error(`Work area "${area.id}" references missing project "${id}".`);
          return project;
        })
        .filter(isActiveProject)
        .sort(byOrderThenTitle),
    })),
);
---

<BaseLayout
  title="Programs"
  description="Ongoing programs for transportation and urbanism in Southern Nevada."
  mainClass="programs-directory"
>
  <PageHero
    title="Our programs"
    lede="Ongoing programs for transportation and urbanism in Southern Nevada."
  />

  <section class="container-page program-directory" aria-label="Named programs">
    {
      namedPrograms.map((program, index) => {
        const nextProgram = namedPrograms[index + 1];
        return (
          <ProgramFeature
            program={program}
            events={programEvents.filter(
              ({ data }) => data.calendarUid === program.data.calendarSeriesUid,
            )}
            next={
              nextProgram
                ? { title: nextProgram.data.title, href: `#${nextProgram.id}` }
                : { title: 'Ongoing work', href: '#ongoing-work' }
            }
          />
        );
      })
    }
  </section>

  <div class="container-page pt-16 pb-16 md:pt-20 md:pb-24">
    <section aria-labelledby="ongoing-work">
      <h2 id="ongoing-work" class="text-headline-lg">Ongoing work</h2>
      <div class="mt-10 grid gap-16 md:gap-20 lg:gap-28 xl:gap-36">
        {
          renderedWorkAreas.map((area) => (
            <article
              id={area.id}
              class="grid min-w-0 scroll-mt-24 gap-8 lg:grid-cols-[minmax(14rem,22.5rem)_minmax(0,1fr)] lg:gap-10"
            >
              <div class="min-w-0 lg:sticky lg:top-24 lg:self-start">
                <span
                  class="inline-flex size-16 items-center justify-center bg-slab text-on-slab"
                  aria-hidden="true"
                >
                  <Icon name={area.data.icon} class="size-9" />
                </span>
                <h3 class="mt-6 text-headline-lg">{area.data.title}</h3>
                <p class="mt-4 max-w-xl text-body-lg leading-relaxed text-on-surface-variant text-pretty">
                  {area.data.summary}
                </p>
              </div>

              <div class="min-w-0">
                <h4 class="text-title-lg">Overview</h4>
                <div class="prose-doc mt-4 max-w-[72ch] text-on-surface-variant">
                  <area.Content />
                </div>

                {area.projectEntries.length > 0 && (
                  <div class="mt-8">
                    <h4 class="text-title-lg">Projects</h4>
                    <ul
                      class="mt-4 grid min-w-0 max-w-[49rem] gap-4 md:grid-cols-2"
                      data-print-stack-list
                    >
                      {area.projectEntries.map((project) => (
                        <li>
                          <a
                            href={paths.project(project.id)}
                            data-print-keep-together
                            class="group block h-full min-w-0 bg-surface-container p-4 no-underline transition-colors hover:bg-slab hover:text-on-slab focus-visible:bg-slab focus-visible:text-on-slab"
                          >
                            <span class="font-bold leading-tight">{project.data.title}</span>
                            <span class="mt-2 block text-sm leading-relaxed text-on-surface-variant text-pretty group-hover:text-on-slab/75 group-focus-visible:text-on-slab/75">
                              {project.data.tldr}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="pt-16 md:pt-20 lg:pt-28 xl:pt-36" aria-labelledby="project-roadmap">
      <div
        class="relative grid overflow-hidden bg-surface-container md:grid-cols-[minmax(0,1fr)_18rem]"
      >
        <span class="absolute inset-y-0 left-0 w-2 bg-primary" aria-hidden="true"></span>
        <div class="min-w-0 p-6 pl-10 md:p-8 md:pl-12 lg:p-10 lg:pl-14">
          <h2 id="project-roadmap" class="text-headline-lg">Project roadmap</h2>
          <p
            class="mt-5 max-w-[64ch] text-body-lg leading-relaxed text-on-surface-variant text-pretty"
          >
            See the campaigns, tools, research, outreach work, and events behind these work areas.
          </p>
        </div>
        <a
          href={paths.projects}
          class="group flex min-w-0 flex-col justify-between bg-slab p-6 text-on-slab no-underline transition-colors hover:bg-primary hover:text-on-primary focus-visible:bg-primary focus-visible:text-on-primary md:p-8"
        >
          <span class="flex items-center justify-between gap-4 text-title-lg">
            Browse projects
            <Icon
              name="mdi:arrow-right"
              class="arrow size-6 shrink-0 transition-transform"
              aria-hidden="true"
            />
          </span>
          <span
            class="mt-8 block text-sm leading-relaxed text-on-slab/75 group-hover:text-on-primary/80 group-focus-visible:text-on-primary/80"
          >
            Campaigns, tools, reports, outreach, and events.
          </span>
        </a>
      </div>
    </section>
  </div>
  <nav class="program-index" aria-label="Programs on this page" hidden>
    {
      namedPrograms.map((program) => (
        <a href={`#${program.id}`} aria-label={program.data.title}>
          <span class="program-index-marker" aria-hidden="true" />
        </a>
      ))
    }
  </nav>
</BaseLayout>

<script>
  import '../scripts/program-index';
</script>
