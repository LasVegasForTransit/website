---
import BaseLayout from '../layouts/BaseLayout.astro';
import PullQuote from '../components/PullQuote.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../lib/site';
import { websiteSchema } from '../lib/structured-data';

const membershipUrl = site.membership.formUrl;
const membershipHref = membershipUrl ?? '/join#membership';
const membershipTarget = membershipUrl ? '_blank' : undefined;
const membershipRel = membershipUrl ? 'noopener noreferrer' : undefined;

// The three ways we do the work — plain language, one line each.
const ways: Array<{ title: string; body: string; icon: string; href: string; cta: string }> = [
  {
    title: 'Educate',
    icon: 'mdi:school-outline',
    body: 'We help our neighbors see how the way we get around shapes what daily life costs, in both money and time.',
    href: '/about',
    cta: 'Why we exist',
  },
  {
    title: 'Organize',
    icon: 'mdi:account-group-outline',
    body: 'We bring together the many Las Vegans who want better transit, so the people who write the budget have to listen.',
    href: '/projects',
    cta: 'Our projects',
  },
  {
    title: 'Advocate',
    icon: 'mdi:bullhorn-outline',
    body: 'We show up at public meetings and push for the funding, the street design, and the projects the Valley needs.',
    href: '/about/strategy',
    cta: 'Our strategy',
  },
];

// Real projects already moving — the reason an organized public matters now.
const projects: Array<{ when: string; title: string; body: string }> = [
  {
    when: 'Fall 2026',
    title: 'Maryland Parkway BRT',
    body: '$378 million, 29 stations, and dedicated lanes running from downtown to Henderson.',
  },
  {
    when: 'Underway',
    title: 'Charleston corridor',
    body: 'A 17-mile study of light rail versus bus rapid transit — the Valley’s first real shot at rail.',
  },
  {
    when: 'Expected 2029',
    title: 'Brightline West',
    body: 'High-speed rail to Southern California that only pays off if local transit can meet it here.',
  },
];
---

<BaseLayout
  title="The transit movement Vegas needs"
  description="Las Vegans for Better Transit is the grassroots advocacy group fighting for world-class public transit and supportive land use in the Las Vegas Valley."
>
  <StructuredData slot="head" data={websiteSchema()} />

  {/* LVBT's enduring invitation is the hero. */}
  <section class="container-page pt-8 pb-4 md:pt-12 md:pb-12">
    <div class="reveal max-w-5xl">
      <h1 class="text-display-lg">
        We're building the public transit <span class="text-primary">movement</span> Las&nbsp;Vegas has
        never had.
      </h1>
      <p
        class="mt-5 max-w-3xl text-body-md text-on-surface-variant text-pretty md:mt-6 md:text-body-lg"
      >
        We want safe, reliable, and useful public transportation for everyone and vibrant, walkable
        neighborhoods to support world-class transit.
      </p>
    </div>
  </section>

  {/* The current campaign follows the mission as a distinct way to participate. */}
  <section class="border-t-4 border-primary bg-primary-container text-on-primary-container">
    <div class="container-page pt-5 pb-6 md:py-8">
      <div class="reveal max-w-3xl">
        <p class="text-body-sm font-bold text-primary-ink">October 1–8, 2026</p>
        <h2 class="text-display-sm mt-3">Week Without Driving</h2>
        <p class="mt-4 max-w-2xl text-body-lg leading-relaxed text-pretty">
          One trip counts. Share what it's like to get around without driving.
        </p>
        <a
          href={site.weekWithoutDriving.url}
          aria-label="Take the One Trip Challenge"
          class="press mt-4 inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 font-bold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
        >
          Take the One Trip Challenge
          <Icon name="mdi:arrow-right" class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="arts-district-title"
    class="border-t border-outline-variant/20 bg-surface-container"
  >
    <div
      class="container-page grid gap-6 py-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:py-10"
    >
      <div class="reveal max-w-3xl">
        <h2 id="arts-district-title" class="text-headline-md">
          Arts District Neighborhood Campaign
        </h2>
        <p class="mt-3 max-w-2xl text-body-md leading-relaxed text-on-surface-variant">
          Help identify what’s difficult about living, working, or spending time in the Arts
          District, and help plan better transit, streets, and places to live and gather.
        </p>
      </div>
      <a
        href="/campaigns/arts-district/"
        class="body-link justify-self-start text-title-sm font-bold"
      >
        Explore the campaign
      </a>
    </div>
  </section>

  {/* HOW WE FIGHT — three plain ways we do the work */}
  <section class="container-page border-t border-outline-variant/15 py-16 md:py-24">
    <div class="reveal">
      <h2 class="text-headline-lg max-w-3xl">How we fight for better transit.</h2>
    </div>
    <div class="reveal-stagger mt-12 grid gap-12 md:grid-cols-3">
      {
        ways.map((way) => (
          <div class="reveal">
            <div class="flex items-center gap-3">
              <Icon name={way.icon} class="size-8 text-primary-ink" aria-hidden="true" />
              <h3 class="text-title-lg">{way.title}</h3>
            </div>
            <p class="mt-4 text-body-md leading-relaxed text-pretty">{way.body}</p>
            <a href={way.href} class="body-link mt-4 inline-block font-semibold">
              {way.cta} &#8594;
            </a>
          </div>
        ))
      }
    </div>
  </section>

  {/* PROOF — real projects already in motion */}
  <section class="container-page border-t border-outline-variant/15 py-16 md:py-24">
    <div class="reveal max-w-3xl">
      <h2 class="text-headline-lg">Real projects are already in motion.</h2>
      <p class="lede mt-4">
        The Valley is finally building. These projects only pay off with a public organized to use
        them and defend them.
      </p>
    </div>
    <div class="reveal-stagger mt-12 grid gap-6 md:grid-cols-3">
      {
        projects.map((p) => (
          <div class="reveal relative overflow-hidden border border-outline bg-surface-container p-8">
            <span class="absolute inset-y-0 left-0 w-2 bg-primary" aria-hidden="true" />
            <p class="text-body-sm font-semibold text-on-surface-variant">{p.when}</p>
            <h3 class="text-title-lg mt-2">{p.title}</h3>
            <p class="mt-3 text-body-md leading-relaxed text-on-surface-variant text-pretty">
              {p.body}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  {/* THE CLOSE — the ask again, on the serious band, with the stakes in the founder's words */}
  <section data-print-callout class="bg-slab text-on-slab">
    <div class="container-page grid items-center gap-12 py-16 md:grid-cols-2 md:gap-20 md:py-20">
      <div class="reveal">
        <h2 class="text-display-sm">We win this by being too many to ignore.</h2>
        <p class="mt-6 max-w-md text-body-lg leading-relaxed text-on-slab/85 text-pretty">
          Membership is free and takes about a minute. The more Las&nbsp;Vegans behind this, the
          stronger the case we make to the people who fund transit.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={membershipHref}
            target={membershipTarget}
            rel={membershipRel}
            class="press inline-flex items-center gap-2 bg-primary text-on-primary px-6 py-3 font-bold no-underline hover:bg-surface hover:text-on-surface focus-visible:bg-surface focus-visible:text-on-surface"
          >
            Become a member
            <Icon name="mdi:arrow-right" class="size-4" aria-hidden="true" />
          </a>
          <a href="/newsletter" class="body-link font-semibold text-primary-soft">
            Or get our newsletter &#8594;
          </a>
        </div>
      </div>
      <div class="reveal">
        <PullQuote cite="RTC of Southern Nevada, March 2026" surface="slab">
          "Without a new dedicated funding source, the Regional Transportation Commission of
          Southern Nevada will be forced to eliminate fifteen routes and reduce service across the
          network — affecting hundreds of thousands of riders by 2028."
        </PullQuote>
      </div>
    </div>
  </section>
</BaseLayout>
