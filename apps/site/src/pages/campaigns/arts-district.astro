---
// cspell:ignore underlink Diandra
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import {
  artsDistrictDocuments,
  artsDistrictEvents,
  artsDistrictEventPath,
} from '../../lib/campaigns/arts-district';

import { campaignDateParts, groupCampaignEvents } from '../../lib/campaigns/event-schedule';

const schedule = groupCampaignEvents(artsDistrictEvents);
const sections = [
  { kind: 'upcoming', events: schedule.upcoming },
  { kind: 'proposed', events: schedule.proposed },
  { kind: 'past', events: schedule.past },
];
---

<BaseLayout
  title="Arts District Neighborhood Campaign"
  description="Help shape a neighborhood plan for world-class transit and supportive land use in the Arts District. Join public gatherings and help choose the neighborhood’s priorities."
>
  <div id="lvbt-arts-authentic">
    <section class="hero" aria-labelledby="lvbt-auth-title">
      <div class="hero-copy">
        <h1 id="lvbt-auth-title">Arts District<br />Neighborhood<br />Campaign</h1>
        <p>
          Help make the Arts District a better place to live, work, and spend time. Tell us what’s
          difficult, and help plan better transit, streets, and places to live and gather.
        </p>
        <div class="hero-actions">
          <a class="button" href="#lvbt-auth-events">Upcoming events</a>
          <a class="underlink" href="#lvbt-auth-campaign">About the campaign</a>
        </div>
      </div>
      <figure class="hero-photo">
        <picture>
          <source srcset="/images/campaigns/arts-district-sign-2015.webp" type="image/webp" />
          <img
            src="/images/campaigns/arts-district-sign-2015.jpg"
            width="960"
            height="720"
            alt="The 18b Arts District sign on Casino Center Boulevard"
          />
        </picture>
        <figcaption class="photo-label">
          <span>Casino Center Boulevard · 18b</span>
          <span class="photo-credit">
            Photo: <a
              data-external-icon="false"
              href="https://commons.wikimedia.org/wiki/File:18b_Arts_District_sign_(2015).jpg"
              >Diandra Rodriguez</a
            >
            &nbsp;·&nbsp;<a
              data-external-icon="false"
              href="https://creativecommons.org/licenses/by/2.0/">CC BY 2.0</a
            >
          </span>
        </figcaption>
      </figure>
    </section>
    <section class="campaign" id="lvbt-auth-campaign" aria-labelledby="lvbt-auth-purpose-title">
      <div class="wrap">
        <h2 class="motivation-head" id="lvbt-auth-purpose-title">About the campaign</h2>
        <div class="campaign-summary">
          <p class="campaign-intro">
            Las Vegans for Better Transit is organizing public gatherings to identify problems with
            daily life in the Arts District. Tell us about bus trips that take too long, crossings
            you avoid, or places you can’t easily reach. We’ll use those experiences to identify
            which problems the campaign should address first.
          </p>
          <div class="campaign-mission">
            <Icon name="mdi:city-variant-outline" class="campaign-icon" aria-hidden="true" />
            <div>
              <h3>A public neighborhood plan</h3>
              <p>
                We’ll publish gathering summaries, the priorities participants identify, and a draft
                neighborhood plan with recommendations for transit, streets, housing, and public
                spaces. You’ll be able to review the draft and suggest changes before we take the
                recommendations to people responsible for transportation and development decisions.
              </p>
            </div>
          </div>
        </div>
        <div class="motivation-grid">
          <div class="motivation-card">
            <Icon name="mdi:bus-stop" class="campaign-icon" aria-hidden="true" />
            <div>
              <h3>More ways to get here</h3><p>
                Whether you’re heading to work, a gallery, or First Friday, getting here shouldn’t
                require a car. Parking costs and limited transit options can make everyday trips
                difficult. Better connections can make it easier to reach the neighborhood and get
                around.
              </p>
            </div>
          </div>
          <div class="motivation-card">
            <Icon name="mdi:account-group-outline" class="campaign-icon" aria-hidden="true" />
            <div>
              <h3>Help choose the priorities</h3><p>
                At the gatherings, compare possible improvements. When we share a draft, tell us
                what works, what’s missing, and what should change.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section
      class="events wrap"
      id="lvbt-auth-events"
      data-campaign-events
      aria-labelledby="lvbt-auth-events-title"
    >
      <div class="section-head">
        <div>
          <h2 id="lvbt-auth-events-title">Upcoming events</h2>
          <p class="series-intro">
            We’ll meet about once a month to talk through the problems you face, explore
            improvements, and review a neighborhood plan together.
          </p>
        </div>
      </div>
      <p data-campaign-empty hidden={schedule.upcoming.length > 0}>
        The next gathering’s date and location will be announced here.
      </p>
      {
        sections.map(({ kind, events }) => (
          <div data-campaign-group={kind} hidden={kind !== 'upcoming' && events.length === 0}>
            {kind !== 'upcoming' && (
              <h3 class="series-heading">
                {kind === 'proposed' ? 'More gatherings' : 'Past gatherings'}
              </h3>
            )}
            <div class={kind === 'proposed' ? 'series' : 'event-grid'} data-campaign-list={kind}>
              {events.map((event, index) =>
                kind === 'proposed' ? (
                  <article>
                    <span class="month">{event.month}</span>
                    <span class="series-year">{event.year}</span>
                    <h3>
                      <a class="event-title-link" href={artsDistrictEventPath(event)}>
                        {event.title}
                      </a>
                    </h3>
                    <p>{event.summary}</p>
                    <span class="date-note">Date and location to be announced</span>
                    {event.lvbtEventUrl && (
                      <a class="underlink event-rsvp" href={event.lvbtEventUrl}>
                        Event details and RSVP
                      </a>
                    )}
                  </article>
                ) : (
                  <article
                    class:list={[
                      'event',
                      {
                        'event--featured': kind === 'upcoming' && index === 0,
                        'event--past': kind === 'past',
                      },
                    ]}
                    data-campaign-event={event.slug}
                    data-start={event.start}
                    data-end={event.end}
                  >
                    <div class="date" aria-hidden="true">
                      <strong>{campaignDateParts(event.start ?? '').day}</strong>
                      <span>{campaignDateParts(event.start ?? '').month}</span>
                      <span>{campaignDateParts(event.start ?? '').year}</span>
                    </div>
                    <div class="event-copy">
                      <span class="eyebrow" data-campaign-event-label style="margin-bottom:12px">
                        {kind === 'past'
                          ? 'Past gathering'
                          : index === 0
                            ? 'Next gathering'
                            : 'Upcoming gathering'}
                      </span>
                      <h3>
                        <a class="event-title-link" href={artsDistrictEventPath(event)}>
                          {event.title}
                        </a>
                      </h3>
                      <p>{event.summary}</p>
                      <div class="event-facts">
                        <span>
                          <strong>
                            <time datetime={event.start}>{event.dateLabel}</time>
                          </strong>
                        </span>
                        <span>{event.venue ?? 'Location to be announced'}</span>
                      </div>
                      {event.venueUrl && (
                        <a
                          class="underlink"
                          data-active-action
                          hidden={kind === 'past'}
                          data-external-icon="false"
                          href={event.venueUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Get directions
                        </a>
                      )}
                      {event.lvbtEventUrl && (
                        <a
                          class="underlink event-rsvp"
                          data-campaign-rsvp
                          href={event.lvbtEventUrl}
                        >
                          {kind === 'past' ? 'Event details' : 'Event details and RSVP'}
                        </a>
                      )}
                    </div>
                  </article>
                ),
              )}
            </div>
          </div>
        ))
      }
    </section>
    <section
      class="campaign-record wrap"
      id="lvbt-auth-record"
      aria-labelledby="lvbt-auth-record-title"
    >
      <h2 id="lvbt-auth-record-title">Community priorities and proposals</h2>
      <p class="record-intro">
        Read gathering summaries and proposals here as we publish them. Tell us what’s missing or
        what you’d change.
      </p>
      {
        artsDistrictDocuments.length > 0 && (
          <ul class="campaign-documents">
            {artsDistrictDocuments.map((document) => (
              <li>
                <h3>
                  <a class="underlink" data-external-icon="false" href={document.url}>
                    {document.title}
                  </a>
                </h3>
                <p>{document.summary}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>
    <section class="join" id="lvbt-auth-join" aria-labelledby="lvbt-auth-organize-title">
      <div>
        <h2 id="lvbt-auth-organize-title">Help organize the campaign</h2>
        <p>
          You can help bring more people into these conversations. Partner with us through your
          community organization or business, volunteer with the campaign, or help make the
          gatherings happen.
        </p>
        <ul class="organizing-needs">
          <li>Connect us with community organizations and local businesses.</li>
          <li>Invite neighbors, coworkers, and artists to join the conversation.</li>
          <li>Help organize gatherings and keep outreach going between events.</li>
          <li>Provide food, help with publicity, or share other resources for events.</li>
        </ul>
      </div>
      <div class="join-actions">
        <a
          class="button"
          href="mailto:hello@lasvegasfortransit.org?subject=Help%20organize%20the%20Arts%20District%20Neighborhood%20Campaign"
          >Help organize this campaign</a
        >
        <a class="underlink" href="/join/#membership">Become an LVBT member</a>
      </div>
    </section>
  </div>
</BaseLayout>
<style>
  #lvbt-arts-authentic [hidden] {
    display: none !important;
  }
  #lvbt-arts-authentic [data-campaign-list='past'] {
    margin-top: 24px;
  }
  #lvbt-arts-authentic .event:not(.event--featured) .date {
    background: var(--color-surface-container);
    color: var(--color-on-surface-variant);
    border-inline-end: 1px solid var(--color-outline-variant);
  }
  #lvbt-arts-authentic .event.event--past {
    min-height: 0;
  }
  #lvbt-arts-authentic .event--past .event-copy > p {
    display: none;
  }
  #lvbt-arts-authentic .event--past .event-facts {
    padding-bottom: 0;
  }

  #lvbt-arts-authentic {
    color: var(--color-on-surface);
    background: var(--color-surface);
    width: 100%;
    /* Measure full-bleed gutters from the page width, excluding the scrollbar. */
    container-type: inline-size;
    overflow: hidden;
  }
  #lvbt-arts-authentic * {
    box-sizing: border-box;
  }
  #lvbt-arts-authentic section[id] {
    scroll-margin-top: calc(var(--lvbt-header-h, 4.5rem) + 1rem);
  }
  #lvbt-arts-authentic a {
    color: inherit;
    text-decoration: none;
  }
  #lvbt-arts-authentic h1,
  #lvbt-arts-authentic h2,
  #lvbt-arts-authentic h3,
  #lvbt-arts-authentic p {
    margin: 0;
  }
  #lvbt-arts-authentic .bar {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 32px;
    gap: 20px;
  }
  #lvbt-arts-authentic .brand {
  }
  #lvbt-arts-authentic .brand em {
    color: var(--color-primary-ink);
    font-style: normal;
  }
  #lvbt-arts-authentic .nav {
    display: flex;
    gap: 26px;
  }
  #lvbt-arts-authentic .nav a:last-child {
    color: var(--color-primary-ink);
  }
  #lvbt-arts-authentic .hero {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    min-height: 580px;
  }
  #lvbt-arts-authentic .hero-copy {
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 58px min(7vw, 80px) 65px
      max(var(--page-pad), calc((100cqw - 80rem) / 2 + var(--page-pad)));
  }
  #lvbt-arts-authentic .eyebrow {
    display: block;
    color: var(--color-primary-ink);
  }
  #lvbt-arts-authentic h1 {
    margin: 19px 0 25px;
  }
  #lvbt-arts-authentic .hero-copy p {
    max-width: 465px;
  }
  #lvbt-arts-authentic .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 32px;
  }
  #lvbt-arts-authentic .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-width: 180px;
    padding: 15px 17px;
    background: var(--color-primary-ink);
    color: var(--color-surface);
  }
  #lvbt-arts-authentic .underlink {
    display: inline-flex;
    align-items: center;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  #lvbt-arts-authentic .hero-photo {
    position: relative;
    min-height: 580px;
    overflow: hidden;
    background: var(--color-surface-container);
  }
  #lvbt-arts-authentic .hero-photo picture {
    display: contents;
  }
  #lvbt-arts-authentic .hero-photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 49% center;
  }
  #lvbt-arts-authentic .photo-label {
    position: absolute;
    right: 0;
    bottom: 0;
    background: var(--color-slab);
    color: var(--color-on-slab);
    padding: 12px 16px;
    max-width: 100%;
  }
  #lvbt-arts-authentic .photo-credit {
    display: block;
    margin-top: 4px;
  }
  #lvbt-arts-authentic .photo-label a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  #lvbt-arts-authentic .statement {
    background: var(--color-slab);
    color: var(--color-on-slab);
    display: flex;
    align-items: center;
    gap: 37px;
    padding: 33px max(var(--page-pad), calc((100cqw - 80rem) / 2 + var(--page-pad)));
  }
  #lvbt-arts-authentic .statement b {
    flex: none;
    color: var(--color-primary-soft);
  }
  #lvbt-arts-authentic .statement p {
    max-width: 745px;
  }
  #lvbt-arts-authentic .wrap {
    max-width: 80rem;
    margin: auto;
    padding-inline: var(--page-pad);
  }
  #lvbt-arts-authentic .events {
    padding-top: 72px;
    padding-bottom: 78px;
  }
  #lvbt-arts-authentic .section-head {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    align-items: end;
    margin-bottom: 32px;
  }
  #lvbt-arts-authentic .section-head .eyebrow {
    margin-bottom: 12px;
  }
  #lvbt-arts-authentic h2 {
  }
  #lvbt-arts-authentic .event-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 19px;
  }
  #lvbt-arts-authentic .event {
    min-height: 314px;
    display: grid;
    grid-template-columns: 124px 1fr;
    background: var(--color-surface-container);
  }
  #lvbt-arts-authentic .event:nth-child(2) {
    background: var(--color-surface-container);
  }
  #lvbt-arts-authentic .date {
    background: var(--color-primary-ink);
    color: var(--color-surface);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 26px;
  }
  #lvbt-arts-authentic .date strong {
  }
  #lvbt-arts-authentic .date span {
    margin-top: 11px;
  }
  #lvbt-arts-authentic .date i {
    display: block;
    width: 1px;
    height: 95px;
    background: currentColor;
    opacity: 0.5;
    margin-top: 30px;
  }
  #lvbt-arts-authentic .event-copy {
    padding: 27px 23px 23px;
    display: flex;
    flex-direction: column;
  }
  #lvbt-arts-authentic .event-copy h3 {
    margin-bottom: 11px;
  }
  #lvbt-arts-authentic .event-copy p {
    color: var(--color-on-surface-variant);
  }
  #lvbt-arts-authentic .event-facts {
    margin-top: auto;
    display: grid;
    gap: 5px;
    padding: 22px 0 18px;
  }
  #lvbt-arts-authentic .event-copy .eyebrow,
  #lvbt-arts-authentic .event-copy > a {
    color: var(--color-on-surface);
    align-self: flex-start;
  }
  #lvbt-arts-authentic .event-title-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  #lvbt-arts-authentic .event-rsvp {
    margin-top: 16px;
  }
  #lvbt-arts-authentic .campaign {
    background: var(--color-surface-container);
    color: var(--color-on-surface);
    padding: 48px 0;
  }
  #lvbt-arts-authentic .campaign .heading-row {
    display: grid;
    grid-template-columns: 0.88fr 1.12fr;
    gap: 55px;
    align-items: end;
    margin-bottom: 34px;
  }
  #lvbt-arts-authentic .campaign h2 {
    max-width: 495px;
  }
  #lvbt-arts-authentic .campaign .heading-row p {
    max-width: 430px;
  }
  #lvbt-arts-authentic .stage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  #lvbt-arts-authentic .stage {
    min-height: 195px;
    padding: 23px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--color-surface);
  }
  #lvbt-arts-authentic .stage:nth-child(2) {
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
  }
  #lvbt-arts-authentic .stage:nth-child(3) {
    background: var(--color-slab);
    color: var(--color-on-slab);
  }
  #lvbt-arts-authentic .stage span {
    opacity: 0.42;
  }
  #lvbt-arts-authentic .stage h3 {
    max-width: 210px;
  }
  #lvbt-arts-authentic .join {
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
    padding: 50px max(var(--page-pad), calc((100cqw - 80rem) / 2 + var(--page-pad)));
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 26px;
    align-items: end;
  }
  #lvbt-arts-authentic .join .eyebrow {
    color: inherit;
  }
  #lvbt-arts-authentic .join h2 {
    max-width: 600px;
    margin: 10px 0 14px;
  }
  #lvbt-arts-authentic .join p {
    max-width: 490px;
  }
  #lvbt-arts-authentic .join-actions {
    display: grid;
    justify-items: start;
    gap: 24px;
  }
  #lvbt-arts-authentic .campaign-record {
    padding-bottom: 72px;
  }
  #lvbt-arts-authentic .record-intro {
    max-width: 800px;
    margin-top: 24px;
  }
  #lvbt-arts-authentic .campaign-documents {
    display: grid;
    gap: 28px;
    max-width: 800px;
    margin-top: 32px;
  }
  #lvbt-arts-authentic .campaign-documents p {
    margin-top: 12px;
  }
  #lvbt-arts-authentic .series-heading {
    margin-top: 40px;
  }
  #lvbt-arts-authentic .organizing-needs {
    display: grid;
    gap: 12px;
    max-width: 600px;
    margin-top: 24px;
    padding-left: 1.25rem;
    list-style: disc;
  }
  #lvbt-arts-authentic .join .button {
    background: var(--color-primary-ink);
    color: var(--color-surface);
    white-space: nowrap;
  }
  #lvbt-arts-authentic .footer {
    padding-top: 25px;
    padding-bottom: 27px;
    display: flex;
    justify-content: space-between;
    gap: 22px;
    align-items: center;
  }
  #lvbt-arts-authentic .footer a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 800px) {
    #lvbt-arts-authentic .hero {
      grid-template-columns: 1fr;
    }
    #lvbt-arts-authentic .hero-copy {
      padding: 55px var(--page-pad) 48px;
    }
    #lvbt-arts-authentic .hero-photo {
      min-height: 370px;
      max-height: 430px;
    }
    #lvbt-arts-authentic .statement {
      padding: 29px 30px;
    }
    #lvbt-arts-authentic .event-grid {
      grid-template-columns: 1fr;
    }
    #lvbt-arts-authentic .event {
      min-height: 260px;
    }
    #lvbt-arts-authentic .campaign .heading-row {
      grid-template-columns: 1fr;
      gap: 19px;
    }
    #lvbt-arts-authentic .join {
      padding: 45px var(--page-pad);
    }
  }
  @media (max-width: 540px) {
    #lvbt-arts-authentic .bar {
      padding: 0 18px;
    }
    #lvbt-arts-authentic .nav a:not(:last-child) {
      display: none;
    }
    #lvbt-arts-authentic .hero-copy {
      padding: 45px var(--page-pad) 42px;
    }
    #lvbt-arts-authentic .hero-copy p {
    }
    #lvbt-arts-authentic .hero-photo {
      min-height: 285px;
      max-height: 340px;
    }
    #lvbt-arts-authentic .statement {
      padding: 26px 20px;
      align-items: flex-start;
      gap: 19px;
    }
    #lvbt-arts-authentic .statement b {
    }
    #lvbt-arts-authentic .wrap {
      padding-inline: var(--page-pad);
    }
    #lvbt-arts-authentic .events {
      padding-top: 55px;
      padding-bottom: 55px;
    }
    #lvbt-arts-authentic .section-head {
      display: block;
    }
    #lvbt-arts-authentic .section-head a {
      display: inline-block;
      margin-top: 18px;
    }
    #lvbt-arts-authentic .event {
      grid-template-columns: 90px 1fr;
      min-height: 270px;
    }
    #lvbt-arts-authentic .date strong {
    }
    #lvbt-arts-authentic .event-copy {
      padding: 23px 18px 20px;
    }
    #lvbt-arts-authentic .event-copy h3 {
    }
    #lvbt-arts-authentic .campaign {
      padding: 55px 0;
    }
    #lvbt-arts-authentic .stage-grid {
      grid-template-columns: 1fr;
    }
    #lvbt-arts-authentic .stage {
      min-height: 125px;
      flex-direction: row;
      align-items: end;
    }
    #lvbt-arts-authentic .stage span {
    }
    #lvbt-arts-authentic .join {
      grid-template-columns: 1fr;
      padding: 42px var(--page-pad);
    }
    #lvbt-arts-authentic .join .button {
      justify-self: start;
    }
    #lvbt-arts-authentic .footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
  #lvbt-arts-authentic .hero-copy {
    padding-top: 42px;
  }
  #lvbt-arts-authentic .hero-copy h1 {
    margin-top: 0;
  }
  #lvbt-arts-authentic .motivation-head {
    max-width: 800px;
    margin-bottom: 24px;
  }
  #lvbt-arts-authentic .campaign-intro {
    max-width: 560px;
  }
  #lvbt-arts-authentic .campaign-summary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
    margin-bottom: 28px;
  }
  #lvbt-arts-authentic .campaign-mission {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: 16px;
    background: var(--color-primary-container);
    color: var(--color-on-primary-container);
    padding: 24px;
