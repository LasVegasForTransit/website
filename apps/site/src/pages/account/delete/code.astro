---
// Delete your account: the code step. Served through
// functions/account/delete/code/index.ts.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/app/Button.astro';
import ErrorSummary from '../../../components/app/ErrorSummary.astro';
import Notice from '../../../components/app/Notice.astro';
import TextField from '../../../components/app/TextField.astro';
import { buttonClass, linkClass } from '../../../components/app/styles';
import { t } from '../../../../platform/messages';
---

<BaseLayout title={t('account.deleteTitle')} noindex>
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="max-w-2xl">
      <p><a href="/account/" class={linkClass}>{t('account.back')}</a></p>
      <h1 class="text-headline-lg mt-6">{t('account.deleteTitle')}</h1>
      <p class="lede mt-4 [overflow-wrap:anywhere]" data-slot="sent-to" hidden></p>
      <div class="mt-8"><Notice kind="error" hidden dataSlot="notice" /></div>
      <ErrorSummary
        heading={t('account.errorSummaryHeading')}
        errors={[{ field: 'code', message: t('signIn.codeError') }]}
      />
      <form method="post" action="/account/delete/code/" novalidate class="mt-8 space-y-8">
        <TextField
          name="code"
          label={t('signIn.codeLabel')}
          type="code"
          width="code"
          required
          error={t('signIn.codeError')}
        />
        <div class="flex flex-wrap items-center gap-6">
          <Button variant="destructive" busyLabel={t('account.saving')}>
            {t('account.deleteSubmit')}
          </Button>
          <a href="/account/" class={linkClass}>{t('account.keep')}</a>
        </div>
      </form>
      <form method="post" action="/account/delete/" class="mt-10">
        <button type="submit" class={buttonClass.secondary}>{t('signIn.resend')}</button>
      </form>
    </div>
  </section>
</BaseLayout>
