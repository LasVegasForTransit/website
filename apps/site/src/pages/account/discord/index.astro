---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/app/Button.astro';
import { linkClass } from '../../../components/app/styles';
---

<BaseLayout title="Join LVBT on Discord" noindex>
  <section class="container-page py-12">
    <div class="mx-auto max-w-xl">
      <a href="/account/#discord" class={linkClass}>← Your account</a>
      <h1 class="text-headline-md mt-6">Join LVBT on Discord</h1>
      <p class="mt-4">
        Meet other LVBT members, hear what’s happening, and plan committee work together on Discord.
      </p>
      <p class="mt-3">Discord is optional. LVBT news and event invitations also come by email.</p>
      <p class="mt-4" role="alert" data-slot="discord-unavailable" hidden></p>
      <p class="mt-3" data-slot="discord-status" hidden></p>
      <div
        class="mt-4 rounded-lg border border-outline-variant bg-surface-container p-4"
        data-slot="discord-screening"
        hidden
      >
        <p role="status">
          You’re almost in. Open Discord and accept LVBT’s server rules to get started.
        </p>
        <a href="https://discord.com/app" class={`${linkClass} mt-3 inline-block`}>Open Discord</a>
      </div>
      <p class="mt-4" role="status" data-slot="discord-retry" hidden>
        We couldn’t finish joining LVBT’s Discord. Please try again.
      </p>
      <p class="mt-4" data-slot="discord-review" hidden>
        Ask the membership team to check your connected Discord accounts.
      </p>
      <p class="mt-4" role="alert" data-slot="discord-error" hidden>
        We couldn’t connect that account. Try again with your own Discord account. If it still
        fails, ask the membership team for help.
      </p>
      <form method="post" action="/account/discord/" class="mt-6" data-slot="discord-connect">
        <input type="hidden" name="token" value="" />
        <Button><span data-slot="discord-connect-label">Continue to Discord</span></Button>
      </form>
    </div>
  </section>
</BaseLayout>
