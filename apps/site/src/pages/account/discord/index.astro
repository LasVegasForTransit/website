---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/app/Button.astro';
import { t } from '@lasvegasfortransit/platform-core/messages';
import { linkClass } from '../../../components/app/styles';
---

<BaseLayout title={t('discord.join')} noindex navigation="instant">
  <section class="container-page py-12">
    <div class="mx-auto max-w-xl">
      <a href="/account/#discord" class={linkClass}>{t('account.back')}</a>
      <h1 class="text-headline-md mt-6">{t('discord.join')}</h1>
      <p class="mt-4">
        {t('discord.description')}
      </p>
      <p class="mt-3">{t('discord.optional')}</p>
      <p class="mt-4" role="alert" data-slot="discord-unavailable" hidden></p>
      <p class="mt-3" data-slot="discord-status" hidden></p>
      <div
        class="mt-4 rounded-lg border border-outline-variant bg-surface-container p-4"
        data-slot="discord-screening"
        hidden
      >
        <p role="status">
          {t('discord.rules')}
        </p>
        <a href="https://discord.com/app" class={`${linkClass} mt-3 inline-block`}
          >{t('discord.open')}</a
        >
      </div>
      <p class="mt-4" role="status" data-slot="discord-retry" hidden>
        {t('discord.retry')}
      </p>
      <p class="mt-4" data-slot="discord-review" hidden>
        {t('discord.review')}
      </p>
      <p class="mt-4" role="alert" data-slot="discord-error" hidden>
        {t('discord.error')}
      </p>
      <p class="mt-4" role="alert" data-slot="discord-conflict" hidden>
        {t('discord.alreadyConnected')}{' '}
        <a href="mailto:hello@lasvegasfortransit.org" class={linkClass}
          >{t('discord.contactIfWrong', { email: 'hello@lasvegasfortransit.org' })}</a
        >
      </p>
      <a
        href="/account/discord/disconnect/"
        class={`${linkClass} mt-4 inline-block`}
        data-slot="discord-disconnect"
        hidden>{t('discord.disconnect')}</a
      >
      <form method="post" action="/account/discord/" class="mt-6" data-slot="discord-connect">
        <input type="hidden" name="token" value="" />
        <Button><span data-slot="discord-connect-label">{t('discord.continue')}</span></Button>
      </form>
    </div>
  </section>
</BaseLayout>
