---
// The confirmation after a member connects Discord. Served through
// functions/account/discord/connected.ts, which fills in the verified account
// and the channels LVBT keeps in sync. Discord's own server onboarding covers
// rules and channel picks, so this page only links to the server.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '@lasvegasfortransit/platform-core/messages';
import { buttonClass, linkClass } from '../../../components/app/styles';
import { site } from '../../../lib/site';
---

<BaseLayout title={t('discord.connectedTitle')} noindex navigation="instant">
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="max-w-2xl">
      <h1 class="text-headline-lg">{t('discord.connectedHeading')}</h1>
      <p class="lede mt-4">{t('discord.connectedIntro')}</p>

      <div class="mt-8 flex items-center gap-4 border-2 border-on-surface p-5">
        <span
          class="flex size-12 shrink-0 items-center justify-center bg-on-surface text-title-lg font-bold text-surface"
          aria-hidden="true"
          data-slot="discord-initial">D</span
        >
        <div class="min-w-0 [overflow-wrap:anywhere]">
          <p class="text-title-md font-bold" data-slot="discord-display-name"></p>
          <p class="text-on-surface-variant" data-slot="discord-username"></p>
        </div>
      </div>

      <h2 class="text-title-lg mt-10">{t('discord.accessHeading')}</h2>
      <ul class="mt-2" data-slot="discord-access">
        <li class="py-2" data-slot="discord-access-member" hidden>{t('discord.accessMember')}</li>
        <li data-slot="discord-access-committees" hidden></li>
      </ul>
      <p class="mt-4" data-slot="discord-access-none" hidden>
        <a href="/join/#team" class={linkClass}>{t('discord.accessNoCommittees')}</a>
      </p>

      <p class="mt-10">{t('discord.startIntro')}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a
          href={site.social.discord ?? 'https://discord.com/app'}
          class={buttonClass.primary}
          data-slot="discord-open">{t('discord.startOpen')}</a
        >
        <a href="/account/" class={linkClass} data-slot="discord-return-link"
          >{t('discord.startAccount')}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
