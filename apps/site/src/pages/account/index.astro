---
// The member's account page. Built once as a template, then served through
// functions/account/index.ts, which fills in this member's details and shows
// the sections that apply to them. Never cached: it is one person's data.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/app/Button.astro';
import KeyValueSummary from '../../components/app/KeyValueSummary.astro';
import Notice from '../../components/app/Notice.astro';
import { hintClass, linkClass } from '../../components/app/styles';
import { t } from '../../../platform/messages';

const change = (href: string) => ({ href, label: t('account.change') });
---

<BaseLayout title={t('account.title')} noindex>
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="max-w-6xl">
      <header>
        <h1 class="text-headline-lg">{t('account.heading')}</h1>
        <p class="lede mt-4" data-slot="greeting">{t('account.greeting')}</p>
      </header>
      <div class="mt-8 max-w-3xl">
        <Notice kind="success" hidden dataSlot="notice" />
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:items-start">
        <section class="border-l-4 border-primary bg-primary-container p-7 md:p-9">
          <div class="flex items-start justify-between gap-6">
            <div>
              <p class="text-sm font-bold text-primary-ink">Your place in LVBT</p>
              <h2 class="text-title-lg mt-2">{t('account.membershipHeading')}</h2>
            </div>
            <span data-slot="member-check" hidden aria-hidden="true">
              <span
                class="flex size-12 shrink-0 items-center justify-center rounded-full bg-primary text-on-primary"
              >
                <svg viewBox="0 0 24 24" fill="none" class="size-6"
                  ><path
                    d="m5 12 4.5 4.5L19 7"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </span>
            </span>
          </div>
          <p class="mt-4 text-lg" data-slot="member-since" hidden></p>
          <div data-slot="rejoin" hidden>
            <p class="mt-4">{t('account.notOnList')}</p>
            <form method="post" action="/account/mailing-list/" class="mt-4 space-y-4">
              <input type="hidden" name="action" value="rejoin" />
              <p class={hintClass}>{t('account.rejoinConsent')}</p>
              <Button busyLabel={t('account.saving')}>{t('account.rejoin')}</Button>
            </form>
          </div>
        </section>

        <aside class="bg-on-surface p-7 text-surface md:p-8 lg:col-start-2 lg:row-span-4">
          <p class="text-sm font-bold text-primary-soft">Do something together</p>
          <h2 class="text-title-lg mt-3">Put your membership to work</h2>
          <p class="mt-3 leading-relaxed text-surface/80">
            Find an event, join a team, or help with a campaign near you.
          </p>
          <a
            href="/go/"
            class="press mt-6 inline-flex bg-primary px-5 py-3 font-bold text-on-primary no-underline hover:bg-primary-soft hover:text-on-surface"
            >Explore ways to get involved</a
          >
        </aside>

        <section class="lg:col-start-1">
          <h2 class="text-title-lg">{t('account.detailsHeading')}</h2>
          <div class="mt-5">
            <KeyValueSummary
              rows={[
                {
                  key: t('account.name'),
                  value: t('account.notGiven'),
                  dataSlot: 'name',
                  change: change('/account/name/'),
                },
                {
                  key: t('account.email'),
                  value: t('account.notGiven'),
                  dataSlot: 'email',
                  change: change('/account/email/'),
                },
                {
                  key: t('account.phone'),
                  value: t('account.notGiven'),
                  dataSlot: 'phone',
                  change: change('/account/phone/'),
                },
                {
                  key: t('account.area'),
                  value: t('account.notGiven'),
                  dataSlot: 'area',
                  change: change('/account/area/'),
                },
                { key: t('account.language'), value: t('account.languageValue') },
              ]}
            />
          </div>
          <p class={`${hintClass} mt-4`}>{t('account.languageNote')}</p>
        </section>

        <section data-slot="mailing-list" hidden class="bg-surface-container p-7 lg:col-start-1">
          <h2 class="text-title-lg">{t('account.listHeading')}</h2>
          <p class="mt-3">{t('account.onList')}</p>
          <a href="/account/mailing-list/" class={`${linkClass} mt-5 inline-block`}
            >{t('account.leave')}</a
          >
        </section>

        <section class="bg-surface-container p-7 lg:col-start-1">
          <h2 class="text-title-lg">{t('account.dataHeading')}</h2>
          <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
            <li><a href="/account/data/" class={linkClass}>{t('account.download')}</a></li>
            <li><a href="/account/delete/" class={linkClass}>{t('account.delete')}</a></li>
          </ul>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
