---
// Render the account template; the request handler fills only the signed-in person's values.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Notice from '../../components/app/Notice.astro';
import AccountSections from '../../components/account/AccountSections.astro';
import { t } from '@lasvegasfortransit/platform-core/messages';
---

<BaseLayout title={t('account.title')} noindex navigation="instant">
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="mx-auto max-w-4xl">
      <AccountSections part="summary" />
      <div class="mt-8 max-w-3xl">
        <Notice kind="success" hidden dataSlot="notice" />
      </div>
      <AccountSections part="navigation" />
      <AccountSections part="content" />
    </div>
  </section>
</BaseLayout>
