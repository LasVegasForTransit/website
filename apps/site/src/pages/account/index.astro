---
// The member's account page. Built once as a template, then served through
// functions/account/index.ts, which fills in this member's details and shows
// the sections that apply to them. Never cached: it is one person's data.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/app/Button.astro';
import KeyValueSummary from '../../components/app/KeyValueSummary.astro';
import Notice from '../../components/app/Notice.astro';
import { hintClass, linkClass } from '../../components/app/styles';
import { t } from '../../../platform/messages';
import { Icon } from 'astro-icon/components';

const change = (href: string) => ({ href, label: t('account.change') });
---

<BaseLayout title={t('account.title')} noindex>
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="mx-auto max-w-4xl">
      <header>
        <h1 class="text-headline-lg">{t('account.heading')}</h1>
        <p class="lede mt-4" data-slot="greeting">{t('account.greeting')}</p>
        <div class="mt-5 flex items-center gap-2 text-sm font-semibold text-on-surface-variant">
          <span data-slot="member-check" hidden aria-hidden="true"
            ><Icon name="mdi:check-circle" class="size-5 text-primary" /></span
          >
          <span data-slot="member-since" hidden></span>
          <span data-slot="membership-inactive" hidden>{t('account.notOnList')}</span>
        </div>
      </header>
      <div class="mt-8 max-w-3xl">
        <Notice kind="success" hidden dataSlot="notice" />
      </div>

      <nav
        aria-label="Account sections"
        class="mt-8 flex max-w-full flex-nowrap gap-2 overflow-x-auto whitespace-nowrap pb-2"
      >
        <a
          href="#details"
          class="press shrink-0 bg-surface-container px-4 py-2 font-bold no-underline hover:bg-primary-container"
          >Details</a
        >
        <a
          href="#mailing-list"
          class="press shrink-0 bg-surface-container px-4 py-2 font-bold no-underline hover:bg-primary-container"
          >Email</a
        >
        <a
          href="#data"
          class="press shrink-0 bg-surface-container px-4 py-2 font-bold no-underline hover:bg-primary-container"
          >Data</a
        >
      </nav>

      <div class="mt-8 max-w-4xl space-y-8">
        <section id="details" class="scroll-mt-24">
          <h2 class="flex items-center gap-3 text-title-lg">
            <Icon
              name="mdi:card-account-details-outline"
              class="size-6 text-primary"
              aria-hidden="true"
            />{t('account.detailsHeading')}
          </h2>
          <div class="mt-5">
            <KeyValueSummary
              rows={[
                {
                  key: t('account.name'),
                  icon: 'mdi:account-outline',
                  value: t('account.notGiven'),
                  dataSlot: 'name',
                  change: change('/account/name/'),
                },
                {
                  key: t('account.email'),
                  icon: 'mdi:email-outline',
                  value: t('account.notGiven'),
                  dataSlot: 'email',
                  change: change('/account/email/'),
                },
                {
                  key: t('account.phone'),
                  icon: 'mdi:phone-outline',
                  value: t('account.notGiven'),
                  dataSlot: 'phone',
                  change: change('/account/phone/'),
                },
                {
                  key: t('account.area'),
                  icon: 'mdi:map-marker-outline',
                  value: t('account.notGiven'),
                  dataSlot: 'area',
                  change: change('/account/area/'),
                },
              ]}
            />
          </div>
        </section>

        <section id="mailing-list" class="scroll-mt-24 bg-surface-container p-7">
          <h2 class="flex items-center gap-3 text-title-lg">
            <Icon name="mdi:email-newsletter" class="size-6 text-primary" aria-hidden="true" />{
              t('account.listHeading')
            }
          </h2>
          <div data-slot="mailing-list" hidden>
            <p class="mt-3">{t('account.onList')}</p>
            <a href="/account/mailing-list/" class={`${linkClass} mt-5 inline-block`}
              >{t('account.leave')}</a
            >
          </div>
          <div data-slot="rejoin" hidden>
            <p class="mt-3">{t('account.notOnList')}</p>
            <form method="post" action="/account/mailing-list/" class="mt-4 space-y-4">
              <input type="hidden" name="action" value="rejoin" />
              <p class={hintClass}>{t('account.rejoinConsent')}</p>
              <Button busyLabel={t('account.saving')}>{t('account.rejoin')}</Button>
            </form>
          </div>
        </section>

        <section id="data" class="scroll-mt-24 bg-surface-container p-7">
          <h2 class="flex items-center gap-3 text-title-lg">
            <Icon name="mdi:database-outline" class="size-6 text-primary" aria-hidden="true" />{
              t('account.dataHeading')
            }
          </h2>
          <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-3">
            <li><a href="/account/data/" class={linkClass}>{t('account.download')}</a></li>
            <li><a href="/account/delete/" class={linkClass}>{t('account.delete')}</a></li>
          </ul>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
