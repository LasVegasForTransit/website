---
// The region step, shown right after joining only when LVBT couldn't tell
// the new member's part of the valley from their address or ZIP code. Served
// through functions/join/member/region/index.ts.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Button from '../../../components/app/Button.astro';
import ChoiceGroup from '../../../components/app/ChoiceGroup.astro';
import { REGIONS } from '../../../../platform/core/regions';
import { t } from '../../../../platform/messages';
---

<BaseLayout title={t('region.title')} noindex>
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="max-w-2xl">
      <form method="post" action="/join/member/region/" class="space-y-8">
        <ChoiceGroup
          name="region"
          legend={t('region.question')}
          hint={t('region.hint')}
          legendAsHeading
          options={[
            ...REGIONS.map((region) => ({ value: region.id, label: region.name })),
            { value: 'none', label: t('region.ratherNotSay') },
          ]}
        />
        <Button>{t('region.submit')}</Button>
      </form>
    </div>
  </section>
</BaseLayout>
