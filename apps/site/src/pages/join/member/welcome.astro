---
// The confirmation page after joining. Served through
// functions/join/member/welcome/index.ts, which fills in the name and email
// this browser just submitted. Reaching it discards the join form's saved
// draft.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Confirmation from '../../../components/app/Confirmation.astro';
import { t } from '../../../../platform/messages';
import { site } from '../../../lib/site';

const nextSteps = [
  { href: '/events', label: t('welcome.nextEvents') },
  ...(site.social.discord ? [{ href: site.social.discord, label: t('welcome.nextDiscord') }] : []),
];
---

<BaseLayout title={t('welcome.title')} noindex>
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="max-w-2xl">
      <Confirmation
        heading={t('welcome.heading')}
        nextStepsHeading={t('welcome.nextStepsHeading')}
        nextSteps={nextSteps}
        clearDrafts="/join/member/"
      >
        <p class="lede mt-4 [overflow-wrap:anywhere]" data-slot="sent-to" hidden></p>
        <p class="mt-6 border-2 border-primary-ink p-4" data-slot="address-notice" hidden></p>
      </Confirmation>
    </div>
  </section>
  <script is:inline src="/scripts/app-enhance.js" defer></script>
</BaseLayout>
