// Type roles grouped into MD3 families. Each family opens its own subsection
// with a short guideline, then shows the sizes within it — so Typography reads
// as guidance, not a flat specimen list. `includes` pulls the matching entries
// out of `typeSamples` so specimen copy stays in one place.
const typeFamilies = [
  {
    name: 'Display',
    includes: ['Display large', 'Display medium', 'Display small'],
    guidance:
      'The loudest type. Reserve it for the largest home-page and campaign moments and for page titles. Keep it short and concrete — if it needs punctuation to explain itself, it is probably a headline.',
  },
  {
    name: 'Headline',
    includes: ['Headline large', 'Headline medium', 'Headline small'],
    guidance:
      'Section-level emphasis. Headlines should tell the reader what a section does, so prefer a concrete claim over a generic label.',
  },
  {
    name: 'Title',
    includes: ['Title'],
    guidance:
      'The scanning size. Titles name cards, rows, buttons, and assets; pair them with body copy that explains the decision or action.',
  },
  {
    name: 'Body',
    includes: ['Body large', 'Body medium', 'Body small'],
    guidance:
      'The reading sizes. Body large introduces, medium explains, and small supports — reach for the smallest that still gives the content its proper rank.',
  },
];

