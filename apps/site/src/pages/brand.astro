      },
    ],
  },
  {
    title: 'Cut filler',
    paragraphs: [
      'Delete throat-clearing, generic urgency, and sentences that sound important without helping anyone.',
      'If a line does not help someone understand, decide, or act, cut it.',
    ],
    examples: [
      {
        context: 'Opening line',
        note: 'A sentence that sounds urgent but says nothing specific. Replace it with the event and action.',
        vague: 'In these unprecedented times, it is more important than ever to come together.',
        specific: 'Join us Thursday to plan testimony for the RTC board meeting.',
      },
    ],
  },
];

const brandContents = [
  {
    id: 'foundations',
    label: 'Overview',
    children: [{ id: 'principles', label: 'Personality' }],
  },
  {
    id: 'visual-style',
    label: 'Visual style',
    children: [{ id: 'visual-style-inspiration', label: 'Inspiration' }],
  },
  {
    id: 'color',
    label: 'Color roles',
    children: [
      { id: 'color-semantic-reference', label: 'Semantic reference' },
      { id: 'color-functional-reference', label: 'Functional reference' },
      { id: 'color-in-practice', label: 'Color in practice' },
    ],
  },
  {
    id: 'typography',
    label: 'Typography',
    children: typeFamilies.map((family) => ({
      id: `typography-${slugify(family.name)}`,
      label: family.name,
    })),
  },
  {
    id: 'layout',
    label: 'Layout & spacing',
    children: [
      { id: 'layout-alignment', label: 'Alignment' },
      { id: 'layout-communications', label: 'Communication layouts' },
      { id: 'layout-spacing', label: 'Spacing and rhythm' },
      { id: 'layout-actions', label: 'Actions' },
    ],
  },
  {
    id: 'logos',
    label: 'Logos',
    children: [
      { id: 'logos-versions', label: 'Logo versions' },
      { id: 'logos-space', label: 'Space around logos' },
      { id: 'logos-size', label: 'Minimum sizes' },
      { id: 'logos-backgrounds', label: 'Backgrounds' },
      { id: 'logos-placement', label: 'Logo placement' },
      { id: 'logos-artwork', label: 'Logo artwork' },
      { id: 'logos-assets', label: 'Logo assets' },
    ],
  },
  {
    id: 'voice',
    label: 'Voice',
    children: voiceGuidelines.map((item) => ({
      id: `voice-${slugify(item.title)}`,
      label: item.title,
    })),
  },
];
---

<BaseLayout
  title="Brand Guidelines"
  description="Brand guidelines, logo assets, color tokens, typography, layout rules, and voice guidance for Las Vegans for Better Transit."
>
  <header data-brand-page data-brand-intro class="container-page pt-10 pb-8 md:pt-14 md:pb-10">
    <div class="max-w-4xl">
      <HeadingLink id="brand-guidelines" as="h1" label="Brand Guidelines" class="text-display-md" />
      <p class="lede mt-5 max-w-3xl">
        Guidelines for a grassroots transit advocacy brand that is bold, trustworthy, approachable,
        and fun.
      </p>
    </div>
  </header>
  <div class="container-page">
    <hr class="rule-thick max-w-[68rem]" />
  </div>

  <div data-brand-body class="container-page relative grid items-start gap-y-8 py-8 md:py-10">
    <BrandContents items={brandContents} />

    <div data-brand-shell class="grid min-w-0 gap-14 lg:max-w-[68rem]">
      <BrandSection
        id="foundations"
        title="Overview"
        lede="We're building a modern, playful brand for transit advocacy and better urbanism in Las Vegas."
      >
        <div class="grid min-w-0 gap-8">
          <p data-readable class="text-body-md max-w-2xl text-on-surface-variant">
            LVBT is part traditional nonprofit, part bold advocacy campaign. A legislator or a
            coalition partner should take it seriously. It should also feel energetic and youthful
            enough to carry a genuinely moonshot case for world-class transit in a car-built desert
            city.
          </p>
          <p data-readable class="text-body-md max-w-2xl text-on-surface-variant">
            It also has to stay accessible enough that a rider, a neighbor, or a first-time
            volunteer can pick it up and use it well, and flexible enough to support both education
            and action: explainers, flyers, public testimony, volunteer asks, social posts, and
            coalition materials.
          </p>
          <div>
            <HeadingLink
              id="principles"
              as="h3"
              label="Personality"
              class="text-headline-sm scroll-mt-24"
            />
            <p data-readable class="mt-3 max-w-2xl text-body-md text-on-surface-variant">
              LVBT should feel like people who care about the Valley and know what they are talking
              about: optimistic without being naive, direct without being mean, and playful only
              when play helps people feel invited into the work.
            </p>
            <div data-brand-principles class="mt-6 grid min-w-0 max-w-2xl gap-5">
              {
                principles.map((principle) => (
                  <article data-brand-principle>
                    <HeadingLink
                      id={`principles-${slugify(principle.title)}`}
                      as="h4"
                      label={principle.title}
                      class="text-title-md scroll-mt-24"
                    />
                    <p data-readable class="text-body-md mt-3 text-on-surface-variant">
                      {principle.body}
                    </p>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </BrandSection>

      <BrandSection
        id="visual-style"
        title="Visual style"
        lede="LVBT is expressive. This is not your typical urbanist organization, and the design should make that clear at a glance."
      >
        <div class="grid min-w-0 gap-8">
          <p data-readable class="text-body-md max-w-2xl text-on-surface-variant">
            The look pulls from two instincts at once. One is the clean, structured clarity of a
            modern news explainer. The other is the bold, vibrant energy of a labor and justice
            campaign. Most of a page stays calm and readable so the loud moments land: a big
            headline, a block of Ember, or one strong photo.
          </p>
          <div>
            <HeadingLink
              id="visual-style-inspiration"
              as="h3"
              label="Inspiration"
              class="text-headline-sm scroll-mt-24"
            />
            <p data-readable class="text-body-md mt-2 max-w-2xl text-on-surface-variant">
              Draw from public-interest design that is legible, energetic, and built for people who
              are new to the issue.
            </p>
            <div class="mt-5 grid gap-6 md:grid-cols-2">
              {
                inspirations.map((ref, index) => (
                  <article data-brand-inspiration-card class="grid gap-4">
                    <div
                      data-brand-inspiration-specimen
                      class:list={[
                        'grid aspect-[4/3] overflow-hidden border border-outline bg-surface-container',
                        index === 0 ? 'p-5' : 'bg-slab p-4 text-on-slab',
                      ]}
                      aria-hidden="true"
                    >
                      {index === 0 ? (
                        <div class="grid content-between gap-5">
                          <div class="flex items-start justify-between gap-4">
                            <div class="grid gap-2">
                              <span class="h-2 w-24 bg-on-surface" />
                              <span class="h-2 w-16 bg-on-surface/45" />
                            </div>
                            <span class="text-label-md border border-outline px-2 py-1 text-on-surface-variant">
                              Brief
                            </span>
                          </div>
                          <div class="grid gap-2">
                            <span class="h-5 w-11/12 bg-on-surface" />
                            <span class="h-5 w-4/5 bg-on-surface" />
                            <span class="h-2 w-full bg-on-surface/25" />
                            <span class="h-2 w-5/6 bg-on-surface/25" />
                            <span class="h-2 w-3/5 bg-on-surface/25" />
                          </div>
                          <div class="border-t border-outline pt-3">
                            <span class="block h-2 w-28 bg-primary" />
                          </div>
                        </div>
                      ) : (
                        <div class="grid content-between gap-4">
                          <div class="grid grid-cols-[1fr_3rem] gap-3">
                            <span class="h-20 bg-primary" />
                            <span class="bg-surface" />
                          </div>
                          <div class="grid gap-2">
                            <span class="h-8 w-full bg-surface" />
                            <span class="h-8 w-2/3 bg-primary" />
                          </div>
                          <div class="grid grid-cols-3 gap-2">
                            <span class="h-9 bg-primary" />
                            <span class="h-9 border border-surface/60" />
                            <span class="h-9 bg-surface/20" />
                          </div>
                        </div>
                      )}
                    </div>
                    <div>
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        <h4
                          id={`visual-style-${slugify(ref.handle)}`}
                          class="text-title-md scroll-mt-24"
                        >
                          {ref.handle}
                        </h4>
                        <p class="text-label-md text-on-surface-variant">{ref.role}</p>
                      </div>
                      <p data-readable class="text-body-md mt-2 text-on-surface-variant">
                        {ref.body}
                      </p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
        <div class="mt-10">
          <BrandGuidance>
            <BrandGuidanceCard
              variant="recommended"
              title="Let one loud moment lead"
              text="Keep most of a layout calm and readable so a single big headline, block of Ember, or strong photo can land."
            />
            <BrandGuidanceCard
              variant="avoid"
              title="Don't make everything shout"
              text="Competing loud elements cancel out. When everything is bold, nothing reads as emphasis."
            />
          </BrandGuidance>
        </div>
      </BrandSection>

      <BrandSection
        id="color"
        title="Color roles"
        lede="Color creates hierarchy, marks action, and keeps LVBT materials legible across education, outreach, and campaign work."
      >
        <div data-readable class="mb-8 max-w-3xl">
          <p class="text-body-md text-on-surface-variant">
            Start with neutral surfaces. Paper and Ink should carry most of the composition; Ember
            enters when the reader needs to notice an action, selected state, deadline, or key
            point.
          </p>
          <p class="text-body-md mt-4 text-on-surface-variant">
            Treat every color as a role with an intended foreground. Do not choose text color by
            eye. Use the foreground listed with the role, and use Primary ink when orange appears as
            text on a light surface.
          </p>
        </div>

        <div data-brand-color-list class="grid max-w-5xl gap-3 lg:grid-cols-2">
          {colors.map((color) => <BrandColorCard color={color} />)}
        </div>
        <p
          data-brand-color-status
          class="text-body-sm mt-4 min-h-[1.5rem] text-on-surface-variant"
          aria-live="polite"
        >
        </p>

        <div data-brand-color-pairings class="mt-8">
          <HeadingLink
            id="color-semantic-reference"
            as="h3"
            label="Semantic reference"
            class="text-headline-sm scroll-mt-24"
            includeInContents
          />
          <p data-readable class="mt-3 max-w-3xl text-body-md text-on-surface-variant">
            Semantic tokens describe what a color is in the system. Use the paired token listed here
            when text or icons sit on a colored surface.
          </p>

          <div class="mt-5 overflow-x-auto border border-outline-variant/25">
            <table class="min-w-[58rem] w-full border-collapse text-left">
              <thead class="bg-surface-container">
                <tr class="border-b border-outline-variant/25">
                  <th class="p-3 text-title-sm">Token</th>
                  <th class="p-3 text-title-sm">Light</th>
                  <th class="p-3 text-title-sm">Dark</th>
                  <th class="p-3 text-title-sm">Pair</th>
                  <th class="p-3 text-title-sm">Role</th>
                  <th class="p-3 text-title-sm">Guidance</th>
                </tr>
              </thead>
              <tbody>
                {
                  semanticColorRoles.map((role) => (
                    <tr class="border-b border-outline-variant/20 last:border-b-0">
                      <td class="p-3 align-top">
                        <button
                          type="button"
                          data-copy-color
                          data-color={role.token}
                          data-color-text={role.light}
                          class="inline-flex items-center gap-2 bg-transparent p-0 text-left font-bold text-primary-ink hover:text-on-surface focus-visible:text-on-surface"
                        >
                          <Icon name="mdi:content-copy" class="size-4" aria-hidden="true" />
                          {role.token}
                        </button>
                      </td>
                      <td class="p-3 align-top">
                        <span class="inline-flex items-center gap-2">
                          <span
                            class="size-7 border border-outline-variant/25"
                            style={`background: ${role.light}`}
                            aria-hidden="true"
                          />
                          <span class="text-body-sm">{role.light}</span>
                        </span>
                      </td>
                      <td class="p-3 align-top">
                        <span class="inline-flex items-center gap-2">
                          <span
                            class="size-7 border border-outline-variant/25"
                            style={`background: ${role.dark}`}
                            aria-hidden="true"
                          />
                          <span class="text-body-sm">{role.dark}</span>
                        </span>
                      </td>
                      <td class="p-3 align-top text-body-sm font-semibold">{role.pair}</td>
                      <td class="p-3 align-top text-body-sm font-semibold">{role.role}</td>
                      <td data-readable class="p-3 align-top text-body-sm text-on-surface-variant">
                        {role.guidance}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-10">
          <HeadingLink
            id="color-functional-reference"
            as="h3"
            label="Functional reference"
            class="text-headline-sm scroll-mt-24"
            includeInContents
          />
          <p data-readable class="mt-3 max-w-3xl text-body-md text-on-surface-variant">
            Functional roles describe what to reach for when designing a page, graphic, event card,
            or document.
          </p>

          <div class="mt-5 overflow-x-auto border border-outline-variant/25">
            <table class="min-w-[48rem] w-full border-collapse text-left">
              <thead class="bg-surface-container">
                <tr class="border-b border-outline-variant/25">
                  <th class="p-3 text-title-sm">Use</th>
                  <th class="p-3 text-title-sm">Tokens</th>
                  <th class="p-3 text-title-sm">Guidance</th>
                </tr>
              </thead>
              <tbody>
                {
                  functionalColorRoles.map((role) => (
                    <tr class="border-b border-outline-variant/20 last:border-b-0">
                      <td class="p-3 align-top text-title-sm">{role.use}</td>
                      <td class="p-3 align-top text-body-sm font-semibold text-primary-ink">
                        {role.tokens}
                      </td>
                      <td data-readable class="p-3 align-top text-body-sm text-on-surface-variant">
                        {role.guidance}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-10">
          <HeadingLink
            id="color-in-practice"
            as="h3"
            label="Color in practice"
            class="text-headline-sm scroll-mt-24"
            includeInContents
          />
          <div data-brand-color-specimen class="mt-5 grid gap-4 md:grid-cols-3">
            <div class="bg-primary p-5 text-on-primary">
              <p class="text-title-md">Action surface</p>
              <p data-readable class="text-body-sm mt-2">
                Use for the primary call to action, urgent facts, and active controls.
              </p>
            </div>
            <div class="bg-primary-container p-5 text-on-primary-container">
              <p class="text-title-md">Support surface</p>
              <p data-readable class="text-body-sm mt-2">
                Use for softer emphasis when the page still needs to feel connected to the brand.
              </p>
            </div>
            <div class="bg-surface-container p-5">
              <p class="text-title-md">Text accent</p>
              <p data-readable class="text-body-sm mt-2 text-on-surface-variant">
                Use <span class="text-primary-ink">Primary ink</span> for orange text on quiet surfaces.
              </p>
            </div>
          </div>
        </div>
        <div class="mt-10">
          <BrandGuidance>
            <BrandGuidanceCard
              variant="recommended"
              title="Pair each color with its role"
              text="Lead with Paper and Ink, bring in Ember to mark action, and use the foreground listed with each role."
            />
            <BrandGuidanceCard
              variant="avoid"
              title="Don't pick text color by eye"
              text="Don't flood a layout with Ember or set orange text on Ember. Neutrals carry the page, and color earns its place."
            />
          </BrandGuidance>
        </div>
      </BrandSection>

      <BrandSection
        id="typography"
        title="Typography"
        lede="Use Public Sans everywhere, and save display type for moments that need real emphasis."
      >
        <div data-readable class="mb-10 grid max-w-2xl gap-4 text-body-md text-on-surface-variant">
          <p>
            The scale keeps a few roles so pages stay consistent and easy to scan. Reach for the
            smallest role that still gives the content its proper rank.
          </p>
          <p>
            Labels, buttons, metadata, and section markers should use sentence case or title case.
            Acronyms can stay uppercase when they are the actual term, but do not force text into
            uppercase as a style.
          </p>
        </div>
        <div class="grid min-w-0 gap-12">
          {
            typeFamilies.map((family) => (
              <div class="grid min-w-0 gap-5">
                <div data-readable class="max-w-2xl">
                  <HeadingLink
                    id={`typography-${slugify(family.name)}`}
                    as="h3"
                    label={family.name}
                    class="text-headline-sm scroll-mt-24"
                  />
                  <p class="text-body-md mt-2 text-on-surface-variant">{family.guidance}</p>
                </div>
                <div class="grid min-w-0 gap-4">
                  {typeSamples
                    .filter((sample) => family.includes.includes(sample.name))
                    .map((sample) => (
                      <article class="bg-surface-container p-5 md:p-6">
                        <div class="grid gap-5">
                          <p class={`${sample.className} text-balance`}>{sample.sample}</p>
                          <div data-readable class="min-w-0">
                            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                              <p class="text-title-sm">{sample.name}</p>
                              <p class="text-label-md text-on-surface-variant">{sample.spec}</p>
                            </div>
                            <p class="text-body-sm mt-2 text-on-surface-variant">{sample.use}</p>
                          </div>
                        </div>
                      </article>
                    ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="mt-12">
          <BrandGuidance>
            <BrandGuidanceCard
              variant="recommended"
              title="Use the smallest role that fits"
              text="Match the role to the job, and step down to the smallest size that still gives the content its proper rank."
            />
            <BrandGuidanceCard
              variant="avoid"
              title="Don't force uppercase labels"
              text="Use weight, size, spacing, or color for hierarchy. Do not turn labels, buttons, or metadata into all-caps styling."
            />
          </BrandGuidance>
        </div>
      </BrandSection>

      <BrandSection
        id="layout"
        title="Layout & spacing"
        lede="Layout should make the hierarchy visible before anyone reads the copy. Keep the structure direct, roomy, and easy to scan across pages, flyers, decks, and social graphics."
      >
        <div class="grid min-w-0 gap-14">
          {/* Alignment */}
          <BrandExampleRow>
            <div slot="copy">
              <HeadingLink
                id="layout-alignment"
                as="h3"
                label="Alignment"
                class="text-headline-sm scroll-mt-24"
                includeInContents
              />
              <div data-readable class="mt-4 grid gap-4 text-body-md text-on-surface-variant">
                <p>
                  Default to left-aligning copy, headings, buttons, captions, and stacked elements.
                  A strong left edge makes flyers, carousels, one-page briefs, and meeting slides
                  faster to scan.
                </p>
                <p>
                  Center only for a short, intentional moment: a poster-like campaign line, a single
                  stat, a lone call to action. Never center long paragraphs or mix alignments in one
                  small block.
                </p>
              </div>
            </div>
            <BrandExample
              slot="example"
              caption="Left edge by default. Center only a short, intentional line, never long copy."
            >
              <div class="grid gap-5">
                <div class="border-l-[6px] border-primary pl-4">
                  <p class="text-title-sm">Left by default</p>
                  <p class="text-body-sm mt-1 text-on-surface-variant">
                    Left edge for reading, comparison, and action.
                  </p>
                </div>
                <div class="border-t border-outline-variant/40 pt-5 text-center">
                  <p class="text-title-sm">Center for emphasis</p>
                  <p class="text-body-sm mt-1 text-on-surface-variant">
                    Center one short idea when it should feel like a moment.
                  </p>
                </div>
              </div>
            </BrandExample>
          </BrandExampleRow>

          {/* Communication layouts */}
          <BrandExampleRow>
            <div slot="copy">
              <HeadingLink
                id="layout-communications"
                as="h3"
                label="Communication layouts"
                class="text-headline-sm scroll-mt-24"
                includeInContents
              />
              <div data-readable class="mt-4 grid gap-4 text-body-md text-on-surface-variant">
                <p>
                  <span class="font-semibold text-on-surface">Start with the message.</span> Put the headline,
                  fact, date, or ask where the eye lands first; decorative structure never outranks the
                  reason the piece exists.
                </p>
                <p>
                  <span class="font-semibold text-on-surface">Build one clear path.</span> Most pieces
                  read top-left to bottom-right. Use columns only for comparison, lists, or paired choices.
                </p>
                <p>
                  <span class="font-semibold text-on-surface">Keep groups obvious.</span> Related items
                  sit close together; separate sections with space first, then a rule if the break needs
                  to stay visible.
                </p>
              </div>
            </div>
            <BrandExample
              slot="example"
              caption="One reading path: message, then context, then proof, then the action."
            >
              <ol class="grid gap-4">
                <li class="flex items-baseline gap-4">
                  <span class="text-label-md text-on-surface-variant">01</span>
                  <span class="text-title-md">Message</span>
                </li>
                <li class="flex items-baseline gap-4">
                  <span class="text-label-md text-on-surface-variant">02</span>
                  <span class="text-body-md text-on-surface-variant">Context</span>
                </li>
                <li class="flex items-baseline gap-4">
                  <span class="text-label-md text-on-surface-variant">03</span>
                  <span class="text-body-md text-on-surface-variant">Proof</span>
                </li>
                <li class="flex items-center gap-4">
                  <span class="text-label-md text-on-surface-variant">04</span>
                  <span
                    class="text-title-sm inline-flex items-center gap-2 bg-on-surface px-3 py-2 text-surface"
                  >
                    Action
                  </span>
                </li>
              </ol>
            </BrandExample>
          </BrandExampleRow>

          {/* Spacing and rhythm */}
          <BrandExampleRow>
            <div slot="copy">
              <HeadingLink
                id="layout-spacing"
                as="h3"
                label="Spacing and rhythm"
                class="text-headline-sm scroll-mt-24"
                includeInContents
              />
              <div data-readable class="mt-4 grid gap-4 text-body-md text-on-surface-variant">
                <p>
                  Use larger gaps between major ideas and tighter gaps inside a related group. The
                  page should feel organized before it feels decorated.
                </p>
                <p>
                  Avoid stacking redundant separators. If a sticky header already has a rule, the
                  first block below it usually does not need another.
                </p>
              </div>
            </div>
            <BrandExample
              slot="example"
              caption="Big gaps between ideas, tight gaps within a group. Add a rule only when space isn't enough."
            >
              <div class="grid gap-8">
                <div class="grid gap-1.5">
                  <p class="text-title-sm">Major section</p>
                  <p class="text-body-sm text-on-surface-variant">
                    Strong break, clear title, then content.
                  </p>
                </div>
                <div class="grid gap-1.5">
                  <p class="text-title-sm">Supporting block</p>
                  <p class="text-body-sm text-on-surface-variant">
                    Thin rules divide related tools or repeated rows.
                  </p>
                </div>
              </div>
            </BrandExample>
          </BrandExampleRow>

          {/* Actions */}
          <BrandExampleRow>
            <div slot="copy">
              <HeadingLink
                id="layout-actions"
                as="h3"
                label="Actions"
