---
import StaffGateLayout from '@lasvegasfortransit/platform-core/staff-gate-layout';
import StructuredData from '../../components/seo/StructuredData.astro';
import { organizationSchema } from '../../lib/structured-data';
---

<StaffGateLayout title="Connect to the Staff Portal">
  <StructuredData slot="head" data={organizationSchema()} />
  <p data-slot="connection-intro">
    Use this member account to finish setting up your Staff Portal access.
  </p>
  <div class="staff-gate-form" data-slot="connection-form">
    <p class="staff-gate-account">
      LVBT member account
      <strong data-slot="member-email"></strong>
      <a
        class="staff-gate-link"
        data-slot="different-member"
        href="https://staff.lasvegasfortransit.org/sign-in/link-account/?step=existing"
        >Use a different member account</a
      >
    </p>
    <form method="post" action="/sign-in/staff-link/">
      <input type="hidden" name="request" data-slot="request" />
      <button class="staff-action-link" type="submit">Continue</button>
    </form>
  </div>
  <div data-slot="connection-recovery" hidden>
    <a
      data-slot="portal-link"
      href="https://staff.lasvegasfortransit.org/"
      class="staff-action-link">Open Staff Portal</a
    >
  </div>
  <p slot="help">Need a hand? Ask the LVBT volunteer who invited you.</p>
</StaffGateLayout>
