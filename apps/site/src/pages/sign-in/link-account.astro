---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/app/Button.astro';
import Notice from '../../components/app/Notice.astro';
import ErrorSummary from '../../components/app/ErrorSummary.astro';
import TextField from '../../components/app/TextField.astro';
import { linkClass } from '../../components/app/styles';
import { t } from '@lasvegasfortransit/platform-core/messages';
---

<BaseLayout title={t('workspace.heading')} noindex>
  <PageHero title={t('workspace.heading')} lede={t('workspace.intro')} />
  <section class="container-page py-12 md:py-16">
    <div class="max-w-[30rem] space-y-6">
      <p data-slot="workspace-account" class="[overflow-wrap:anywhere]"></p>
      <Notice kind="error" hidden dataSlot="notice" />
      <ErrorSummary
        heading={t('signIn.errorSummaryHeading')}
        errors={[
          { field: 'email', message: t('signIn.emailError') },
          { field: 'code', message: t('signIn.codeError') },
        ]}
      />
      <div data-slot="email-step">
        <form method="post" action="/sign-in/link-account/" class="space-y-6" novalidate>
          <input type="hidden" name="action" value="request" />
          <TextField
            name="email"
            label={t('workspace.emailLabel')}
            type="email"
            autocomplete="email"
            required
            error={t('signIn.emailError')}
          />
          <Button busyLabel={t('workspace.sending')} block>{t('workspace.send')}</Button>
        </form>
      </div>
      <div data-slot="code-step" hidden>
        <h2 class="text-headline-sm">{t('workspace.codeHeading')}</h2>
        <p data-slot="sent-to" class="mt-3 [overflow-wrap:anywhere]"></p>
        <form method="post" action="/sign-in/link-account/" class="mt-6 space-y-6" novalidate>
          <input type="hidden" name="action" value="confirm" />
          <TextField
            name="code"
            label={t('signIn.codeLabel')}
            hint={t('signIn.codeHint')}
            type="code"
            width="code"
            required
            error={t('signIn.codeError')}
          />
          <Button busyLabel={t('workspace.confirming')} block>{t('workspace.confirm')}</Button>
        </form>
        <a
          href="/sign-in/link-account/?change_email=1"
          class:list={[linkClass, 'mt-6 inline-block']}>{t('signIn.differentEmail')}</a
        >
      </div>
      <a href="/sign-in/google/" class={linkClass}>{t('workspace.signIn')}</a>
    </div>
  </section>
</BaseLayout>
