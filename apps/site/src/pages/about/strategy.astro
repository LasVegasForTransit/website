---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import {
  strategicPriorities,
  strategyIntro,
  strategyMeta,
  strategyNorthStar,
} from '../../lib/strategy-content';
---

<BaseLayout title="Our strategy" description={strategyMeta.description}>
  <PageHero title={strategyMeta.title} lede={strategyMeta.lede}>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/go"
        class="press inline-flex bg-primary px-5 py-3 font-bold text-on-primary no-underline"
      >
        Get involved
      </a>
      <a
        href="/programs"
        class="press inline-flex border-2 border-outline px-5 py-3 font-bold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
      >
        See programs
      </a>
    </div>
  </PageHero>

  <div class="strategy-page container-page">
    <section class="strategy-intro" aria-label="Strategy introduction">
      <div class="strategy-intro__copy">
        {strategyIntro.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <aside class="strategy-north-star" aria-labelledby="strategy-north-star">
        <h2 id="strategy-north-star">{strategyNorthStar.title}</h2>
        <p>{strategyNorthStar.body}</p>
        <p>{strategyNorthStar.note}</p>
      </aside>
    </section>

    <section class="strategy-layout" aria-labelledby="strategy-priorities">
      <aside class="strategy-sidebar" aria-label="Strategic priority links">
        <nav class="strategy-priority-nav" aria-label="Strategic priorities">
          {
            strategicPriorities.map((item) => (
              <a href={`#${item.id}`}>
                <span aria-hidden="true">{item.number}</span>
                {item.shortTitle}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="strategy-content">
        <div class="strategy-section-heading">
          <h2 id="strategy-priorities">Strategic priorities</h2>
          <p>Five areas guide LVBT's first years of organizing, education, and public action.</p>
        </div>

        <ol class="strategy-priorities">
          {
            strategicPriorities.map((item) => (
              <li id={item.id} class="strategy-priority">
                <article>
                  <div class="strategy-priority__number" aria-hidden="true">
                    {item.number}
                  </div>

                  <div class="strategy-priority__copy">
                    <h3>{item.title}</h3>
                    <p class="strategy-priority__thesis">{item.thesis}</p>
                    <p>{item.body}</p>

                    <div
                      class="strategy-priority__links"
                      aria-label={`Related links for ${item.title}`}
                    >
                      {item.links.map((link) => (
                        <a href={link.href}>{link.label}</a>
                      ))}
                    </div>
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .strategy-page {
    padding-block: clamp(3.5rem, 7vw, 5rem) clamp(5rem, 9vw, 8rem);
  }

  .strategy-intro {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .strategy-intro__copy {
    display: grid;
    gap: 1.1rem;
    max-width: 52rem;
    color: var(--color-on-surface-variant);
    font-size: var(--text-body-lg);
    font-weight: var(--text-body-lg--font-weight);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .strategy-layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .strategy-sidebar {
    align-self: start;
  }

  .strategy-content {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    min-width: 0;
  }

  .strategy-priority-nav {
    display: grid;
    gap: 0.35rem;
    border-left: 2px solid
      color-mix(in srgb, var(--color-outline-variant) 28%, var(--color-surface));
    padding-left: 0.9rem;
  }

  .strategy-priority-nav a {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 0.35rem;
    color: var(--color-on-surface-variant);
    font-size: var(--text-body-md);
    font-weight: 650;
    line-height: 1.25;
    text-decoration: none;
  }

  .strategy-priority-nav a:hover,
  .strategy-priority-nav a:focus-visible {
    color: var(--color-primary-ink);
  }

  .strategy-priority-nav span {
    color: var(--color-primary-ink);
    font-variant-numeric: tabular-nums;
  }

  .strategy-north-star {
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 45%, var(--color-surface));
    background: var(--color-surface-container);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .strategy-north-star h2,
  .strategy-section-heading h2,
  .strategy-priority h3 {
    font-size: var(--text-headline-lg);
    font-weight: var(--text-headline-lg--font-weight);
    letter-spacing: var(--text-headline-lg--letter-spacing);
    line-height: var(--text-headline-lg--line-height);
    text-wrap: balance;
  }

  .strategy-north-star p,
  .strategy-section-heading p {
    margin-top: 1rem;
    max-width: 62ch;
    color: var(--color-on-surface-variant);
    font-size: var(--text-body-lg);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .strategy-north-star p:first-of-type,
  .strategy-priority__thesis {
    color: var(--color-on-surface);
    font-size: var(--text-title-lg);
    font-weight: var(--text-title-lg--font-weight);
    letter-spacing: var(--text-title-lg--letter-spacing);
    /* 1.35, not the token's 1.2: these run two or three lines at this
       measure, where the tighter token leading reads cramped. */
    line-height: 1.35;
  }

  .strategy-section-heading {
    max-width: 60rem;
  }

  .strategy-priorities {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    list-style: none;
  }

  .strategy-priority {
    scroll-margin-top: 7rem;
  }

  .strategy-priority article {
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 52%, var(--color-surface));
    background: var(--color-surface-container);
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }

  .strategy-priority__number {
    color: var(--color-primary-ink);
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .strategy-priority__copy {
    min-width: 0;
  }

  .strategy-priority h3 {
    max-width: 22ch;
  }

  .strategy-priority__thesis {
    margin-top: 1.25rem;
    max-width: 64ch;
    text-wrap: pretty;
  }

  .strategy-priority__thesis + p {
    margin-top: 1rem;
    max-width: 68ch;
    color: var(--color-on-surface-variant);
    font-size: var(--text-body-lg);
    font-weight: var(--text-body-lg--font-weight);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .strategy-priority__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  .strategy-priority__links a {
    border: 1px solid color-mix(in srgb, var(--color-outline-variant) 60%, var(--color-surface));
    color: var(--color-on-surface);
    font-weight: 800;
    padding: 0.65rem 0.9rem;
    text-decoration: none;
  }

  .strategy-priority__links a:hover,
  .strategy-priority__links a:focus-visible {
    background: var(--color-slab);
    color: var(--color-on-slab);
  }

  @media (min-width: 64rem) {
    .strategy-intro {
      grid-template-columns: minmax(0, 1fr) minmax(22rem, 30rem);
    }

    .strategy-layout {
      grid-template-columns: minmax(12rem, 16rem) minmax(0, 1fr);
      align-items: start;
    }

    .strategy-sidebar {
      position: sticky;
      top: 7rem;
    }

    .strategy-priority article {
      grid-template-columns: minmax(4rem, 7rem) minmax(0, 1fr);
    }
  }
</style>
