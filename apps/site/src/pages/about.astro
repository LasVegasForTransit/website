---
import BaseLayout from '../layouts/BaseLayout.astro';
import PullQuote from '../components/PullQuote.astro';
import { Icon } from 'astro-icon/components';
import { getEntry, render } from 'astro:content';
import { site } from '../lib/site';
import { requireEntry } from '../lib/content-guard';

const aboutPage = await getEntry('pages', 'about');
requireEntry(aboutPage, 'pages', 'about');

const { Content: OriginContent } = await render(aboutPage);

const pillars: Array<{ id: string; label: string; body: string; icon: string }> = [
  {
    id: 'educate',
    label: 'Educate',
    icon: 'mdi:school-outline',
    body: 'We help Las Vegans see how the way we get around, what our neighborhoods look like, and what daily life costs in time, money, and lives are all connected.',
  },
  {
    id: 'organize',
    label: 'Organize',
    icon: 'mdi:account-group-outline',
    body: 'We build the constituency for transit that Las Vegas has never had, from riders and neighbors to business owners, students, faith communities, and labor, and we bring it to the people who write the budget.',
  },
  {
    id: 'advocate',
    label: 'Advocate',
    icon: 'mdi:bullhorn-outline',
    body: 'We show up at the Legislature, the RTC board, planning commissions, and in the press, and we push for dedicated funding, transit-oriented zoning, and the projects the Valley needs.',
  },
];

const imprint: Array<{ label: string; value: string }> = [
  { label: 'Legal name', value: site.org.legalName },
  { label: 'Tax status', value: '501(c)(3)' },
  { label: 'EIN', value: site.org.ein },
  { label: 'Founded', value: site.org.founded },
];

const candidUrl = site.transparency.candidUrl;

// Our approach — plain-language theory of change for the About page.
const approachItems: Array<{ title: string; body: string }> = [
  {
    title: 'Public Education and Engagement',
    body: 'Many Las Vegans have never ridden a train before or experienced daily life without being car-dependent. We educate and inspire residents so they can see the value of a transit-oriented city and imagine one here.',
  },
  {
    title: 'Youth Engagement',
    body: 'Young people are the future of our country and have the most to gain from well-designed neighborhoods. We give them opportunities to grow, learn, organize, and use their voices.',
  },
  {
    title: 'Direct Advocacy',
    body: 'Public investment is the only sustainable way to build better transit. We push government to align funding, land use, street design, and transit service with the needs of residents.',
  },
  {
    title: 'Civic Belonging',
    body: 'Better transit depends on the people and places it connects. We are building a community of riders, neighbors, students, workers, and local leaders who can make the case for a safer, more affordable, and more connected Las Vegas Valley.',
  },
  {
    title: 'Coalition Building',
    body: 'Citywide change requires alignment across the public sector, business, labor, education, neighborhoods, and civic life. We bring partners together around practical improvements and a shared long-term vision for the Valley.',
  },
];

const contacts: Array<{ label: string; email: string; context: string; icon: string }> = [
  {
    label: 'General',
    icon: 'mdi:email-outline',
    email: site.email.general,
    context: 'Residents, riders, anyone with a story or a question.',
  },
  {
    label: 'Press',
    icon: 'mdi:newspaper-variant-outline',
    email: site.email.press,
    context: 'Reporters, editors, podcasters working on a transit story.',
  },
  {
    label: 'Partnerships',
    icon: 'mdi:handshake-outline',
    email: site.email.partners,
    context: 'Organizations that want to work with us on transit and land use.',
  },
];

const membershipUrl = site.membership.formUrl;
const membershipHref = membershipUrl ?? '/go';

// Underlined mission "thrusts" that highlight their matching pillar on hover.
const thrustClass =
  'text-inherit underline decoration-2 underline-offset-4 decoration-on-surface/30 transition-colors motion-reduce:transition-none hover:text-primary-ink hover:decoration-primary focus-visible:text-primary-ink focus-visible:decoration-primary';
---

<BaseLayout title="About" description={aboutPage.data.summary}>
  {/* Hero --------------------------------------------------------------- */}
  <header class="container-page pt-16 pb-10 md:pt-24 md:pb-12">
    <h1 class="text-display-sm max-w-4xl text-balance">About Las Vegans for Better Transit</h1>
    <p class="lede mt-6 max-w-3xl">
      Las Vegans for Better Transit is a nonprofit advocacy organization in the Las&nbsp;Vegas
      Valley. We educate residents about the value of public transit, organize them into a
      constituency that wants it, and push government to implement it.
    </p>
    <dl class="mt-10 grid max-w-4xl grid-cols-2 gap-x-8 gap-y-4 text-body-sm sm:grid-cols-4">
      {
        imprint.map((item) => (
          <div>
            <dt class="text-on-surface-variant">{item.label}</dt>
            <dd
              data-about-imprint-value={item.label}
              class="mt-1 font-semibold text-on-surface tnum [overflow-wrap:anywhere]"
            >
              <span>{item.value}</span>
              {item.label === 'Tax status' && candidUrl && (
                <>
                  <span class="text-on-surface-variant" aria-hidden="true">
                    {' '}
                    ·{' '}
                  </span>
                  <a
                    href={candidUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-primary-ink underline decoration-2 decoration-primary/40 underline-offset-4 hover:decoration-primary"
                  >
                    Candid
                  </a>
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </header>

  {/* Mission — the statement and the three ways we pursue it ----------- */}
  <section class="container-page pb-20 pt-8 md:pb-28 md:pt-12">
    <h2 class="text-headline-lg max-w-5xl text-balance">
      Our mission is to advocate for <span class="text-primary-ink"
        >world-class public transportation</span
      > and <span class="text-primary-ink">supportive land use policies</span> in the Las&nbsp;Vegas metropolitan
      area through <a href="#educate" data-thrust class={thrustClass}>public education</a>, <a
        href="#organize"
        data-thrust
        class={thrustClass}>community outreach</a
      >, and <a href="#advocate" data-thrust class={thrustClass}>coalition building</a>.
    </h2>

    <div class="mt-16 grid gap-10 border-t border-outline-variant/15 pt-12 md:grid-cols-3 md:gap-8">
      {
        pillars.map((p) => (
          <div id={p.id} class="group scroll-mt-28">
            <div class="flex items-center gap-3">
              <Icon name={p.icon} class="size-8 text-primary-ink" aria-hidden="true" />
              <h3 class="text-headline-sm transition-colors group-[.is-linked]:text-primary-ink">
                {p.label}
              </h3>
            </div>
            <p class="mt-3 leading-relaxed text-pretty">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* Origin — founder voice on the dark band; quote left, prose right -- */}
  <section class="bg-slab text-on-slab">
    <div
      class="container-page py-10 md:py-12 grid gap-12 md:grid-cols-[1fr_1.5fr] md:gap-16 items-start"
    >
      <div>
        <h2 class="text-headline-lg">Our story</h2>
        <div class="mt-10">
          <PullQuote cite="Willie Chalmers III, founder" surface="slab">
            "Las Vegas never had an organized public voice for transit. I started LVBT to be it."
          </PullQuote>
        </div>
      </div>

      <div>
        <div class="prose-doc text-on-slab text-body-lg">
          <OriginContent />
        </div>
      </div>
    </div>
  </section>

  {/* Our approach — theory of change, then the org on paper ------------ */}
  <section class="container-page py-20 md:py-28">
    <h2 class="text-headline-lg">Our approach</h2>
    <p class="mt-4 max-w-2xl text-body-lg leading-relaxed text-pretty">
      Our theory of change for fulfilling our mission.
    </p>

    <ul
      data-about-approach-list
      class="mt-10 grid list-none gap-x-10 gap-y-8 border-t border-outline-variant/15 pt-8 md:grid-cols-2 xl:grid-cols-3"
    >
      {
        approachItems.map((item) => (
          <li>
            <article>
              <h3 class="text-title-lg">{item.title}</h3>
              <p class="mt-2 text-body-md leading-relaxed text-on-surface-variant text-pretty">
                {item.body}
              </p>
            </article>
          </li>
        ))
      }
    </ul>

    <a href="/projects" data-screen-action class="body-link mt-8 inline-block font-semibold"
      >See our projects &#8594;</a
    >
  </section>

  {/* Join — the membership conversion band ----------------------------- */}
  <section data-print-callout class="bg-primary text-on-primary">
    <div class="container-page py-24 md:py-32">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-headline-lg">Membership</h2>
          <p class="mt-4 max-w-xl text-body-lg leading-relaxed text-on-primary text-pretty">
            Membership is free and takes a minute. LVBT is a volunteer-powered organization, and the
            number of Las&nbsp;Vegans behind this campaign is part of the case we make to the people
            who write the budget.
          </p>
        </div>
        <div class="md:justify-self-end">
          <a
            href={membershipHref}
            target={membershipUrl ? '_blank' : undefined}
            rel={membershipUrl ? 'noopener noreferrer' : undefined}
            class="press inline-flex items-center gap-2 bg-on-surface text-surface px-7 py-4 font-bold no-underline"
          >
            Become a member
            <Icon name="mdi:arrow-right" class="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Contact — hover-inverting icon cards ------------------------------ */}
  <section class="container-page py-20 md:py-28">
    <h2 class="text-headline-lg">Contact</h2>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        contacts.map((c) => (
          <a
            href={`mailto:${c.email}`}
            class="group flex flex-col border border-outline bg-surface-container p-6 no-underline transition-colors hover:bg-slab hover:text-on-slab focus-visible:bg-slab focus-visible:text-on-slab"
          >
            <Icon
              name={c.icon}
              class="size-10 text-primary-ink group-hover:text-primary-soft group-focus-visible:text-primary-soft"
              aria-hidden="true"
            />
            <p class="text-title-lg mt-3">{c.label}</p>
            <p class="mt-1 text-sm font-bold [overflow-wrap:anywhere] group-hover:text-primary-soft group-focus-visible:text-primary-soft">
              {c.email}
            </p>
            <p class="mt-2 text-sm text-on-surface-variant leading-relaxed text-pretty group-hover:text-on-slab/80 group-focus-visible:text-on-slab/80">
              {c.context}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const thrusts = document.querySelectorAll<HTMLAnchorElement>('a[data-thrust]');
  thrusts.forEach((link) => {
    const id = link.getAttribute('href')?.slice(1);
    const pillar = id ? document.getElementById(id) : null;
    if (!pillar) return;
    const set = (on: boolean) => pillar.classList.toggle('is-linked', on);
    link.addEventListener('mouseenter', () => set(true));
    link.addEventListener('mouseleave', () => set(false));
    link.addEventListener('focus', () => set(true));
    link.addEventListener('blur', () => set(false));
  });
</script>
