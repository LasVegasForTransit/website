---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="LVBT in the press"
  description="News coverage and interviews featuring Las Vegans for Better Transit."
>
  <PageHero
    title="LVBT in the press"
    lede="Reporting and interviews featuring Las Vegans for Better Transit and our work for a more connected Las Vegas Valley."
  >
    <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-body-sm">
      <span class="text-on-surface-variant">For interviews and media inquiries</span>
      <a
        href={`mailto:${site.email.press}`}
        class="font-semibold text-on-surface no-underline hover:text-primary-ink focus-visible:text-primary-ink"
      >
        {site.email.press}
      </a>
    </p>
  </PageHero>

  <section class="container-page py-12 md:py-16" aria-label="Press coverage">
    <ul
      class="m-0 grid list-none gap-x-16 gap-y-12 p-0 md:gap-y-16 lg:grid-cols-2"
      data-slot="press-coverage"
    >
      <li class="col-span-full">
        <p class="text-body-lg">
          Press coverage could not be loaded right now. Please check back soon.
        </p>
      </li>
    </ul>
  </section>
</BaseLayout>
