---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="LVBT in the press"
  description="News coverage and interviews featuring Las Vegans for Better Transit."
>
  <header
    class="container-page grid gap-8 pb-10 pt-[clamp(3rem,10dvh,7rem)] md:grid-cols-[minmax(0,1fr)_minmax(16rem,20rem)] md:items-end md:gap-12 md:pb-12"
  >
    <div class="max-w-4xl">
      <h1 class="text-display-md text-balance">LVBT in the press</h1>
      <p class="lede mt-6 max-w-2xl">
        Reporting and interviews featuring LVBT's work for better transit in the Las Vegas Valley.
      </p>
    </div>
    <a
      href={`mailto:${site.email.press}`}
      aria-label="Email LVBT about a media inquiry"
      class="press bg-slab p-6 text-on-slab no-underline transition-colors hover:bg-on-surface focus-visible:bg-on-surface"
    >
      <span class="block text-body-sm font-bold text-primary-soft">Media inquiries</span>
      <span class="mt-3 block break-all text-title-md font-semibold">{site.email.press}</span>
      <span class="mt-3 block text-sm text-on-slab/75">Contact LVBT about a story.</span>
    </a>
  </header>

  <hr class="rule-thick container-page" />

  <section class="container-page pb-16 pt-10 md:pb-24 md:pt-12" aria-label="Press coverage">
    <ul
      class="m-0 list-none space-y-10 p-0 md:space-y-12"
      aria-label="Press coverage"
      data-slot="press-coverage"
    >
      <li class="py-4 md:py-5">
        <p class="text-body-lg">
          Press coverage could not be loaded right now. Please check back soon.
        </p>
      </li>
    </ul>
  </section>
</BaseLayout>
