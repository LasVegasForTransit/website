---
// Format-badge pill shared by EventCard, the event detail page, and the /go
// carousel. Background + foreground are baked in so the badge clears WCAG AA
// regardless of surrounding canvas — `text-primary-soft` text alone on the
// paper canvas was the bug we're correcting here.
//
// `canvas` flips the pill into a dark-surface variant for use on the ink-
// background featured card or any future dark surface. `size` lets the
// detail page use a slightly larger pill where it has more vertical room.
import { Icon } from 'astro-icon/components';
import {
  FORMAT_LABEL,
  FORMAT_ICON_NAME,
  PENDING_FORMAT_LABEL,
  PENDING_FORMAT_ICON_NAME,
  type EventFormat,
} from '../lib/event-format';

interface Props {
  // Optional: an event whose attendance details aren't set yet has no format,
  // and the pill falls back to the "details to come" presentation.
  format?: EventFormat;
  canvas?: 'paper' | 'ink';
  size?: 'sm' | 'md';
}

const { format, canvas = 'paper', size = 'sm' } = Astro.props;

const iconName = format ? FORMAT_ICON_NAME[format] : PENDING_FORMAT_ICON_NAME;
const label = format ? FORMAT_LABEL[format] : PENDING_FORMAT_LABEL;

const surfaceClass =
  canvas === 'ink'
    ? 'bg-on-slab/10 text-on-slab'
    : 'bg-primary-container text-on-primary-container';
const iconColorClass = canvas === 'ink' ? 'text-primary-soft' : 'text-primary-ink';
const padClass = size === 'md' ? 'px-3 py-1.5 text-sm' : 'px-2.5 py-1 text-xs';
const iconSizeClass = size === 'md' ? 'size-4' : 'size-3.5';
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 self-start rounded-full font-bold',
    surfaceClass,
    padClass,
  ]}
>
  <Icon name={iconName} class:list={[iconSizeClass, iconColorClass]} aria-hidden="true" />
  <span>{label}</span>
</span>
