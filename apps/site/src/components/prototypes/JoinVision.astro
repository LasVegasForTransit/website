---
import PrototypeLayout from '../app/PrototypeLayout.astro';
import JoinVisionBreadcrumbs from './JoinVisionBreadcrumbs.astro';
import { Icon } from 'astro-icon/components';
import { getCollection, getEntry, render } from 'astro:content';

interface Props {
  requestId?: string;
}

const contributorRequests = (await getCollection('contributorRequests')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const selectedRequest =
  contributorRequests.find((entry) => entry.id === Astro.props.requestId) ?? contributorRequests[0];
if (!selectedRequest) throw new Error('The contributor request prototype needs a content entry.');
const briefRequest = selectedRequest.data;
const project = await getEntry('projects', briefRequest.project);
if (!project) throw new Error(`Contributor request project not found: ${briefRequest.project}`);
const technicalLead = await getEntry('roles', 'technical-lead');
if (!technicalLead) throw new Error('The Technical Lead posting is missing.');
const { Content: TechnicalLeadContent } = await render(technicalLead);
const requestHref = (id: string) => {
  const url = new URL(`/prototypes/join/vision/${id}/`, Astro.url);
  url.hash = 'request';
  return `${url.pathname}${url.search}${url.hash}`;
};
---

<PrototypeLayout title="Join and member participation" canvas="paper" showBanner={false}>
  <div class="vision" data-join-vision>
    <div class="prototype-index container-page">
      <nav class="screen-nav" aria-label="Prototype screens">
        <button type="button" data-show-screen="join">Public join</button>
        <button type="button" data-show-screen="member">Member home</button>
        <button type="button" data-show-screen="finder">Member questions</button>
        <button type="button" data-show-screen="request">Contributor request</button>
        <button type="button" data-open-request-interest>Contributor interest</button>
        <button type="button" data-show-screen="role">Leadership role</button>
        <button type="button" data-show-screen="membership">Membership Committee</button>
        <button type="button" data-show-screen="group">Public Engagement Team</button>
      </nav>
    </div>

    <section class="screen" data-screen="join" aria-labelledby="join-heading">
      <div class="container-page page-opening">
        <h1 id="join-heading">Join Las Vegans for Better Transit.</h1>
        <p>
          Membership is free. Get updates on the 2028 service cuts, the 2027 legislative session,
          and the moments when LVBT needs members to show up.
        </p>
        <a class="primary-link" href="/join/member">Become a member</a>
      </div>
      <div class="container-page section-list">
        <section class="plain-section">
          <h2>Requests for contributors</h2>
          <p>Help move a specific project forward.</p>
          <div class="lined-list">
            {
              contributorRequests.map((entry) => (
                <div>
                  <div>
                    <h3>{entry.data.title}</h3>
                    <p>{entry.data.listing}</p>
                  </div>
                  <a href={requestHref(entry.id)} data-request-link>
                    See the request
                  </a>
                </div>
              ))
            }
          </div>
        </section>
        <section class="plain-section">
          <h2>Volunteer leadership positions</h2>
          <p>Ongoing roles with responsibility for a part of LVBT's work.</p>
          <div class="lined-list compact">
            <div>
              <div>
                <h3>Technical Lead</h3><p>Volunteer leadership · about 5–10 hours a week</p>
              </div><button type="button" data-show-screen="role">View role</button>
            </div>
          </div>
        </section>
        <section class="plain-section">
          <h2>Committees and teams</h2>
          <p>Work with other members on an ongoing part of the organization.</p>
          <div class="committee-grid">
            <article class="committee-card">
              <p class="committee-type">Committee</p>
              <h3>Membership Committee</h3>
              <p>Improve sign-up, member information, and the first invitation to help.</p>
              <button type="button" data-show-screen="membership">About this committee</button>
            </article>
            <article class="committee-card">
              <p class="committee-type">Working team</p>
              <h3>Public Engagement Team</h3>
              <p>Plan town halls, prepare speakers, and share public comment opportunities.</p>
              <button type="button" data-show-screen="group">About this team</button>
            </article>
          </div>
        </section>
        <p class="join-events">
          Want to meet us first? <a href="/events">See upcoming events</a>
        </p>
      </div>
    </section>

    <section class="screen" data-screen="member" aria-labelledby="member-heading" hidden>
      <div class="container-page page-opening member-opening">
        <h1 id="member-heading">Welcome to LVBT.</h1>
        <p>
          Browse current projects and teams, or tell us what interests you and we’ll suggest a place
          to start.
        </p>
        <button class="primary-link" type="button" data-show-screen="finder"
          >Get a suggestion</button
        >
      </div>
      <div class="container-page section-list member-layout">
        <div class="member-opportunities">
          <section class="plain-section">
            <h2>Project requests</h2>
            <div class="lined-list">
              {
                contributorRequests.map((entry) => (
                  <div>
                    <div>
                      <h3>{entry.data.title}</h3>
                      <p>{entry.data.listing}</p>
                    </div>
                    <a href={requestHref(entry.id)} data-request-link>
                      See request
                    </a>
                  </div>
                ))
              }
            </div>
          </section>
          <section class="plain-section" id="member-committees">
            <h2>Committees and teams</h2>
            <div class="committee-grid">
              <article class="committee-card">
                <p class="committee-type">Committee</p>
                <h3>Membership Committee</h3>
                <p>Improve sign-up, member information, and follow-up.</p>
                <button type="button" data-show-screen="membership">About this committee</button>
              </article>
              <article class="committee-card">
                <p class="committee-type">Working team</p>
                <h3>Public Engagement Team</h3>
                <p>Plan town halls and prepare residents to give comment.</p>
                <button type="button" data-show-screen="group">About this team</button>
              </article>
            </div>
          </section>
          <section class="plain-section">
            <h2>Leadership positions</h2>
            <div class="lined-list compact">
              <div>
                <div>
                  <h3>Technical Lead</h3><p>About 5–10 hours a week</p>
                </div><button type="button" data-show-screen="role">View role</button>
              </div>
            </div>
          </section>
        </div>
        <aside class="member-account">
          <h2>Your account</h2>
          <p>Keep your contact details and email preferences up to date.</p>
          <a href="/account/">Account details</a>
          <a href="/account/mailing-list/">Email preferences</a>
          <button type="button" data-show-screen="finder">Change interests</button>
        </aside>
      </div>
    </section>

    <section class="screen" data-screen="finder" aria-labelledby="finder-heading" hidden>
      <div class="container-page form-shell">
        <JoinVisionBreadcrumbs current="Get a suggestion" parent="member" />
        <p class="step-progress" data-progress-label>1 of 3 · Interests</p>
        <div class="step" data-step="1">
          <h1 id="finder-heading">What would you like to do?</h1>
          <p class="form-intro">
            Pick the thing that interests you most right now. You can change it later.
          </p>
          <div class="choices" role="group" aria-label="Your interests">
            <button type="button" data-interest="meet"
              ><strong>Meet other people</strong><span>Try a meetup or social event.</span></button
            >
            <button type="button" data-interest="learn"
              ><strong>Learn about transit and urbanism</strong><span
                >Join a discussion or book club.</span
              ></button
            >
            <button type="button" data-interest="speak"
              ><strong>Speak at a public meeting</strong><span
                >Follow a local decision and give comment.</span
              ></button
            >
            <button type="button" data-interest="build"
              ><strong>Contribute skills to a project</strong><span
                >Help with research, design, technology, or events.</span
              ></button
            >
            <button type="button" data-interest="membership"
              ><strong>Help members get involved</strong><span
                >Work on the membership experience and follow-up.</span
              ></button
            >
          </div>
        </div>
        <div class="step" data-step="2" hidden>
          <h1>How much time works for you?</h1>
          <p class="form-intro">
            This helps us show a sensible first step. It is not a commitment.
          </p>
          <div class="choices" role="group" aria-label="Available time">
            <button type="button" data-pace="once"
              ><strong>One event or small task</strong><span>Try something once.</span></button
            >
            <button type="button" data-pace="sometimes"
              ><strong>Occasionally</strong><span>Join when your schedule allows.</span></button
            >
            <button type="button" data-pace="regular"
              ><strong>Regularly</strong><span>Talk about a team or ongoing role.</span></button
            >
          </div>
        </div>
        <div class="step" data-step="3" hidden>
          <h1>One place to start</h1>
          <p class="form-intro">Here is a place you could help.</p>
          <article class="result">
            <p data-result-kind>Contributor request</p>
            <h2 data-result-title>Research and edit a Transit Accountability Brief</h2>
            <p data-result-description>Find sources, build a timeline, or check the draft.</p>
            <dl>
              <div>
                <dt data-result-source-label>Project</dt><dd data-result-source>
                  Transit Accountability Briefs
                </dd>
              </div><div>
                <dt>Your availability</dt><dd data-result-commitment>One assignment</dd>
              </div>
            </dl>
            <button type="button" data-result-action data-show-screen="request"
              >Read the details</button
            >
          </article>
        </div>
        <div class="form-actions">
          <button type="button" class="back-link" data-step-back hidden>Back</button><button
            type="button"
            class="primary-link"
            data-step-next
            disabled>Continue</button
          >
        </div>
      </div>
    </section>

    <section
      class="screen"
      data-screen="request"
      data-request-listing={briefRequest.listing}
      data-request-project={project.data.title}
      aria-labelledby="request-heading"
      hidden
    >
      <div class="container-page request-shell">
        <JoinVisionBreadcrumbs current={briefRequest.title} />
        <header class="request-opening">
          <h1 id="request-heading">{briefRequest.title}</h1>
          <p class="request-lede">{briefRequest.summary}</p>
          <div class="request-actions">
            <button type="button" class="primary-link" data-open-request-interest
              >I can help with this</button
            >
            <a href={`/projects/${briefRequest.project}/`}>About the project</a>
          </div>
        </header>
        <div class="request-content">
          <section aria-labelledby="request-work">
            <h2 id="request-work">What you’ll do</h2>
            <p class="assignment-intro">
              Work with LVBT’s project lead on one defined part of the first brief.
            </p>
            <div class="assignment-list">
              {
                briefRequest.waysToHelp.map((item) => (
                  <div>
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                ))
              }
            </div>
          </section>
          <section aria-labelledby="request-next">
            <h2 id="request-next">What happens next</h2>
            <p>
              Tell us you’re interested. LVBT staff will reach out to confirm the assignment, the
              first deliverable, and a schedule that works for you.
            </p>
            <button type="button" class="text-action" data-open-request-interest
              >Let us know you’re interested</button
            >
          </section>
        </div>
      </div>
    </section>

    <dialog
      class="interest-dialog"
      data-request-interest-dialog
      aria-labelledby="interest-heading"
      aria-describedby="interest-intro"
    >
      <div class="interest-shell">
        <button
          type="button"
          class="interest-close"
          data-close-request-interest
          aria-label="Close contributor form">×</button
        >
        <div data-request-interest-entry>
          <header class="interest-opening">
            <h2 id="interest-heading" tabindex="-1">{briefRequest.title}</h2>
            <p id="interest-intro">
              Tell us where you’d like to help. LVBT staff will follow up personally.
            </p>
          </header>
          <form data-request-interest-form novalidate>
            <div class="interest-section-heading">
              <h3>Your contact details</h3>
            </div>
            <p class="public-interest-note" data-public-interest-note>
              You can offer to help without becoming a member.
            </p>
            <div class="interest-contact" data-public-contact>
              <div class="interest-fields">
                <label>
                  <span>Name</span>
                  <input
                    type="text"
                    name="name"
                    autocomplete="name"
                    placeholder="Your name"
                    aria-describedby="interest-name-hint interest-name-error"
                    required
                  />
                  <small class="field-hint" id="interest-name-hint"
                    >Use the name you’d like LVBT staff to call you.</small
                  >
                  <small class="field-error" id="interest-name-error" hidden></small>
                </label>
                <label>
                  <span>Email</span>
                  <input
                    type="email"
                    name="email"
                    autocomplete="email"
                    placeholder="you@example.com"
                    aria-describedby="interest-email-hint interest-email-error"
                    required
                  />
                  <small class="field-hint" id="interest-email-hint"
                    >We’ll use this address to follow up about the project.</small
                  >
                  <small class="field-error" id="interest-email-error" hidden></small>
                </label>
                <label class="interest-phone">
                  <span>Phone <small class="optional-label">(optional)</small></span>
                  <input
                    type="tel"
                    name="phone"
                    autocomplete="tel"
                    placeholder="(702) 555-0123"
                    aria-describedby="interest-phone-hint interest-phone-error"
                  />
                  <small class="field-hint" id="interest-phone-hint"
                    >Add a number if you’d prefer a call.</small
                  >
                  <small class="field-error" id="interest-phone-error" hidden></small>
                </label>
              </div>
            </div>
            <div class="interest-contact" data-member-contact hidden>
              <p class="member-contact-note">
                These details come from your <a href="/account/">LVBT account</a>, where you can
                change them.
              </p>
              <div class="interest-fields">
                <label>
                  <span>Name</span>
                  <input type="text" value="Jordan Rivera" readonly />
                </label>
                <label>
                  <span>Email</span>
                  <input type="email" value="jordan@example.com" readonly />
                </label>
                <label class="interest-phone">
                  <span>Phone</span>
                  <input type="tel" value="(702) 555-0145" readonly />
                </label>
              </div>
            </div>

            <div class="interest-resume">
              <label class="resume-card" for="interest-resume">
                <Icon name="mdi:file-document-outline" class="resume-icon" aria-hidden="true" />
                <span class="resume-copy">
                  <strong>Résumé <small class="optional-label">(optional)</small></strong>
                  <span>Share one if it helps show your experience. PDF or Word · 10 MB max.</span>
                </span>
                <span class="resume-pick" aria-hidden="true">Choose file</span>
                <input
                  id="interest-resume"
                  name="resume"
                  type="file"
                  accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                  aria-describedby="interest-resume-error"
                />
              </label>
              <p class="resume-selected" data-resume-filename aria-live="polite" hidden></p>
              <p id="interest-resume-error" data-resume-error hidden></p>
            </div>

            <fieldset class="interest-choices" aria-describedby="interest-work-error">
              <legend>{briefRequest.interestPrompt}</legend>
              <p class="field-hint">Choose one area. We’ll talk through the details with you.</p>
              <div class="interest-options">
                {
                  briefRequest.waysToHelp.map((item, index) => (
                    <label class="interest-option">
                      <input type="radio" name="work" value={item.title} required={index === 0} />
                      <span class="interest-radio" aria-hidden="true" />
                      <span class="interest-option-copy">
                        <strong>{item.title}</strong>
                        <small>{item.description}</small>
                      </span>
                    </label>
                  ))
                }
                <label class="interest-option">
                  <input type="radio" name="work" value="unsure" />
                  <span class="interest-radio" aria-hidden="true"></span>
                  <span class="interest-option-copy">
                    <strong>Not sure yet</strong>
                    <small>We can talk through the options.</small>
                  </span>
                </label>
              </div>
              <p class="field-error" id="interest-work-error" data-work-error hidden>
                Choose one option, or select “Not sure yet.”
              </p>
            </fieldset>

            <label class="interest-note">
              <span>Additional context <small class="optional-label">(optional)</small></span>
              <small class="field-hint" id="interest-note-hint"
                >Relevant skills or why this project interests you can help us find a good fit. 300
                characters max.</small
              >
              <textarea
                name="note"
                rows="2"
                maxlength="300"
                placeholder="For example, I’ve edited reports or worked with public records."
                aria-describedby="interest-note-hint"></textarea>
            </label>
            <button type="submit" class="primary-link">Send interest</button>
          </form>
        </div>
        <div class="interest-confirmation" data-request-interest-confirmation hidden>
          <h2 tabindex="-1" data-interest-confirm-heading>Thanks for offering to help.</h2>
          <p>
            LVBT staff will reach out at <strong data-interest-confirm-email></strong> to talk about the
            brief and where you could contribute.
          </p>
          <p data-public-join-invitation>
            Want updates about other LVBT work? Membership is free.
            <a href="/join/member">Become a member</a>
          </p>
          <button type="button" class="text-action" data-close-request-interest>Done</button>
        </div>
      </div>
    </dialog>

    <dialog
      class="interest-dialog role-dialog"
      data-role-dialog
      aria-labelledby="role-apply-heading"
    >
      <div class="interest-shell">
        <button type="button" class="interest-close" data-close-role aria-label="Close application"
          >×</button
        >
        <div data-role-entry>
          <header class="interest-opening">
            <h2 id="role-apply-heading" tabindex="-1">Apply for Technical Lead</h2>
            <p>Send your details and LVBT will get in touch about the role.</p>
          </header>
          <form data-role-form novalidate>
            <div class="interest-section-heading">
              <h3>Your contact details</h3>
            </div>
            <div class="interest-contact" data-role-public-contact>
              <div class="interest-fields">
                <label
                  ><span>Name</span><input
                    type="text"
                    name="name"
                    autocomplete="name"
                    placeholder="Your name"
                    aria-describedby="role-name-hint role-name-error"
                    required
                  /><small class="field-hint" id="role-name-hint"
                    >Use the name you’d like LVBT staff to call you.</small
                  ><small class="field-error" id="role-name-error" hidden></small></label
                >
                <label
                  ><span>Email</span><input
                    type="email"
                    name="email"
                    autocomplete="email"
                    placeholder="you@example.com"
                    aria-describedby="role-email-hint role-email-error"
                    required
                  /><small class="field-hint" id="role-email-hint"
                    >We’ll use this address to follow up about the role.</small
                  ><small class="field-error" id="role-email-error" hidden></small></label
                >
                <label
                  ><span>Phone <small class="optional-label">(optional)</small></span><input
                    type="tel"
                    name="phone"
                    autocomplete="tel"
                    placeholder="(702) 555-0123"
                    aria-describedby="role-phone-hint role-phone-error"
                  /><small class="field-hint" id="role-phone-hint"
                    >Add a number if you’d prefer a call.</small
                  ><small class="field-error" id="role-phone-error" hidden></small></label
                >
              </div>
            </div>
            <div class="interest-contact" data-role-member-contact hidden>
              <p class="member-contact-note">
                These details come from your <a href="/account/">LVBT account</a>, where you can
                change them.
              </p>
              <div class="interest-fields">
                <label><span>Name</span><input type="text" value="Jordan Rivera" readonly /></label>
                <label
                  ><span>Email</span><input
                    type="email"
                    value="jordan@example.com"
                    readonly
                  /></label
                >
                <label><span>Phone</span><input type="tel" value="(702) 555-0145" readonly /></label
                >
              </div>
            </div>
            <div class="interest-resume">
              <label class="resume-card" for="role-resume">
                <Icon name="mdi:file-document-outline" class="resume-icon" aria-hidden="true" />
                <span class="resume-copy">
                  <strong>Résumé <small class="optional-label">(optional)</small></strong>
                  <span>Share one if it helps show your experience. PDF or Word · 10 MB max.</span>
                </span>
                <span class="resume-pick" aria-hidden="true">Choose file</span>
                <input
                  id="role-resume"
                  name="resume"
                  type="file"
                  accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                  aria-describedby="role-resume-error"
                />
              </label>
              <p class="resume-selected" data-resume-filename aria-live="polite" hidden></p>
              <p id="role-resume-error" data-role-resume-error hidden></p>
            </div>
            <button type="submit" class="primary-link">Send application</button>
          </form>
        </div>
        <div class="interest-confirmation" data-role-confirmation hidden>
          <h2 tabindex="-1" data-role-confirm-heading>Application received.</h2>
          <p>LVBT will follow up at <strong data-role-confirm-email></strong> about the role.</p>
          <button type="button" class="text-action" data-close-role>Done</button>
        </div>
      </div>
    </dialog>

    <section class="screen" data-screen="role" aria-labelledby="role-heading" hidden>
      <div class="container-page detail-shell role-shell">
        <JoinVisionBreadcrumbs current={technicalLead.data.title} />
        <header class="role-opening">
          <h1 id="role-heading">{technicalLead.data.title}</h1>
          <p class="role-terms">Volunteer role · Remote first</p>
          <p class="detail-intro">{technicalLead.data.summary}</p>
          <dl class="role-facts">
            <div><dt>Commitment</dt><dd>{technicalLead.data.commitment}</dd></div>
            <div><dt>Team</dt><dd>{technicalLead.data.team}</dd></div>
          </dl>
          <button type="button" class="primary-link" data-open-role>Apply for this role</button>
        </header>
        <div class="role-copy prose-doc prose-posting max-w-2xl">
          <TechnicalLeadContent />
        </div>
        <div class="role-bottom-action">
          <button type="button" class="primary-link" data-open-role>Apply for this role</button>
        </div>
      </div>
    </section>

    <section class="screen" data-screen="membership" aria-labelledby="membership-heading" hidden>
      <div class="container-page detail-shell">
        <JoinVisionBreadcrumbs current="Membership Committee" />
        <h1 id="membership-heading">Membership Committee</h1>
        <p class="detail-intro">
          This committee works on what happens after someone decides to join LVBT: a clear sign-up,
          useful member information, and ways to help that match the person’s interests and time.
        </p>
        <h2>Current work</h2>
        <ul>
          <li>Improve the membership experience on the website.</li>
          <li>Shape the member portal so people can find specific ways to contribute.</li>
          <li>Make sure new members hear about relevant projects and events.</li>
        </ul>
        <h2>Ask about joining</h2>
        <p>Tell the committee which part of membership work you’d like to help with.</p>
        <button type="button" class="primary-link" data-open-sample>Ask about the committee</button>
      </div>
    </section>

    <section class="screen" data-screen="group" aria-labelledby="group-heading" hidden>
      <div class="container-page detail-shell">
        <JoinVisionBreadcrumbs current="Public Engagement Team" />
        <h1 id="group-heading">Public Engagement Team</h1>
        <p class="detail-intro">
          This team plans LVBT’s public meetings and helps residents speak up about transit
          decisions.
        </p>
        <h2>What the team does</h2>
        <ul>
          <li>Choose issues for town halls and other public meetings.</li>
          <li>Prepare information people need to ask questions or give comment.</li>
          <li>Host events and bring what residents say back to LVBT.</li>
        </ul>
        <h2>Ask about joining</h2>
        <p>
          Tell the team what kind of public meeting work interests you. A team lead can explain the
          current work and time involved.
        </p>
