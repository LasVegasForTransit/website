---
import Breadcrumbs from '../Breadcrumbs.astro';
import { paths } from '../../lib/paths';
import { site } from '../../lib/site';

interface Props {
  cadence: string;
  venue?: {
    name: string;
    address: string;
    mapUrl: string;
    status: 'proposed' | 'confirmed';
  };
}

const { cadence, venue } = Astro.props;
---

<div class="container-page pt-6 pb-16 md:pt-10 md:pb-24">
  <Breadcrumbs section={{ name: 'Programs', href: paths.programs }} current="Vegas Urbanists" />

  <header class="max-w-4xl">
    <h1 class="text-display-md">Vegas Urbanists</h1>
    <p class="mt-6 max-w-3xl text-title-lg font-normal leading-snug text-on-surface-variant">
      Meet neighbors who care about the streets, transit, and places we use every day.
    </p>
  </header>

  <div
    class="mt-12 grid max-w-6xl gap-12 md:mt-16 lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)] lg:gap-20"
  >
    <aside class="bg-slab p-7 text-on-slab md:p-9 lg:order-last" aria-label="Meetup details">
      <p class="text-title-lg font-semibold leading-snug">{cadence}</p>
      {
        venue && (
          <p class="mt-5 leading-relaxed text-on-slab-variant">
            <a href={venue.mapUrl} class="text-on-slab underline underline-offset-4">
              {venue.name}
            </a>
            <br />
            {venue.address}
            {venue.status === 'proposed' && ' (tentative)'}
          </p>
        )
      }
      <a
        href={paths.events}
        class="mt-8 inline-flex items-center gap-3 font-semibold text-on-slab underline underline-offset-4 hover:text-primary focus-visible:text-primary"
      >
        See upcoming meetups <span aria-hidden="true">→</span>
      </a>
    </aside>

    <div class="max-w-2xl">
      <div class="prose-doc text-body-lg text-on-surface-variant"><slot /></div>
      <p class="mt-7 text-on-surface-variant">
        Hosted by {site.name}. No membership required.
      </p>
    </div>
  </div>
</div>
