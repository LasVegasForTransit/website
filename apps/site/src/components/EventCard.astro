---
import type { CollectionEntry } from 'astro:content';
import EventFormatPill from './EventFormatPill.astro';
import EventBadgePill from './EventBadgePill.astro';
import { whereLabel } from '../lib/event-format';
import { relativeLabel, formatEventTime, TIMEZONE } from '../lib/event-time';

interface Props {
  event: CollectionEntry<'events'>;
  featured?: boolean;
}

const { event, featured = false } = Astro.props;
const { title, date, endDate, summary, location } = event.data;
const format = location?.format;
const href = `/events/${event.id}`;

// Mixed case, not all-caps. The date is the primary scannable anchor of an
// event card ("when is this?"), so it gets a real label treatment rather
// than a decorative label. Year stays for cross-year clarity.
const dateLabel = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: TIMEZONE,
}).format(date);

const timeLabel = formatEventTime(date);

// Relative-time label (Live now / Today / Tomorrow / In N days / Next week).
// `live` and `today` render as a small badge near the top of the card;
// softer values render inline next to the absolute date.
const relative = relativeLabel(event.data);
const isUrgent = relative?.kind === 'live' || relative?.kind === 'today';
const inlineRelative = relative && !isUrgent ? relative.text : null;
---

<a
  href={href}
  data-event-when
  data-format={format}
  data-start={date.toISOString()}
  data-end={endDate ? endDate.toISOString() : undefined}
  class:list={[
    // `flex flex-col h-full` lets the "where" line anchor to the card's
    // footer via `mt-auto` so neighbouring cards align horizontally even
    // when their summaries are different lengths.
    'lift group flex h-full flex-col border border-outline-variant/25 no-underline transition-colors',
    featured
      ? 'bg-slab p-6 text-on-slab md:p-8 lg:p-10'
      : 'bg-surface-container p-5 text-on-surface hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface md:p-6',
  ]}
>
  {
    /* Featured card carries no format pill. Stacking the "Next event"
      label on top of a pill on top of the date created
      three decorative labels in a row — too much chrome before the
      editorial content (date / title / summary / where) starts. On the
      featured card the where-line below carries the format affordance:
      "Online" for virtual, the venue for in-person. The pill earns its
      keep on the non-featured grid cards where it's the only quick
      visual differentiator between rows. */
  }
  {
    /* Live now / Today badge supersedes the static label on featured
      cards and stacks above the format pill on grid cards. Both the badge
      and the fallback are rendered; `hidden` picks one. The server sets it
      from the build-time relative kind; event-relative.ts re-derives it at
      view time so a card built days ago doesn't keep saying "Today". */
  }
  <span data-event-badge hidden={!isUrgent} class="self-start">
    <EventBadgePill relative={relative} />
  </span>
  {
    featured ? (
      <p data-event-fallback hidden={isUrgent} class="text-title-sm text-primary-soft">
        Next event
      </p>
    ) : (
      <span data-event-fallback hidden={isUrgent}>
        <EventFormatPill format={format} canvas="paper" />
      </span>
    )
  }

  {
    /* Date — KEY label. Mixed case, semibold, near-body size. The
    inline relative label appears next to it in the soft cases (Tomorrow
    / In N days / Next week); urgent cases own the badge above. */
  }
  <p class:list={[featured ? 'mt-4 text-title-md md:mt-5' : 'mt-4 text-title-sm']}>
    <time datetime={date.toISOString()}>{dateLabel} · {timeLabel}</time>
    <span
      data-event-inline
      hidden={!inlineRelative}
      class:list={['ml-2 font-normal', featured ? 'text-on-slab/70' : 'text-on-surface-variant']}
      >· <span data-event-inline-text>{inlineRelative ?? ''}</span></span
    >
  </p>

  {
    /* Title — primary anchor. `break-words` keeps long titles from kissing
    the right edge on narrow viewports where display-md clamps down.
    Featured-card title carries the warm primary: same family as the
    brand orange, softer against ink than the saturated CTA primary.
    Non-featured grid cards stay ink-on-paper. */
  }
  <h3
    class:list={[
      featured
        ? 'mt-3 break-words text-headline-lg text-primary-soft md:mt-4 md:text-display-sm'
        : 'mt-2 text-title-lg',
    ]}
  >
    {title}
  </h3>

  {
    /* Summary — flex-grows so the bottom row anchors via `mt-auto`. The
    featured card spans the full container width, so the summary needs
    an explicit reading-width cap (max-w-prose ≈ 65ch) — otherwise it
    stretches edge-to-edge and reads as a wall of text. Stays
    left-aligned. */
  }
  <p
    class:list={[
      featured
        ? 'mt-5 max-w-prose flex-1 text-body-lg leading-relaxed text-on-slab/85 md:mt-6'
        : 'mt-4 flex-1 text-body-md leading-relaxed text-on-surface-variant group-hover:text-surface/75 group-focus-visible:text-surface/75',
    ]}
  >
    {summary}
  </p>

  {
    /* Where — tertiary, mute-colored. On the featured card it always
      renders since there's no pill above to carry the format
      affordance. On non-featured cards it's suppressed for virtual
      events where the pill already says "Virtual" and a "Online"
      footer here adds nothing. */
  }
  {
    (featured || (format != null && format !== 'virtual')) && (
      <p
        class:list={[
          'mt-6 text-body-sm',
          featured
            ? 'text-on-slab/70'
            : 'text-on-surface-variant group-hover:text-surface/70 group-focus-visible:text-surface/70',
        ]}
      >
        {whereLabel(location)}
      </p>
    )
  }
</a>

<script>
  import '../scripts/event-relative';
</script>
