---
import { navMain } from '../../lib/site';
import { t } from '../../../platform/messages';
import ProfileIcon from './ProfileIcon.astro';

const normalizePath = (value: string) => {
  const normalized = value.replace(/\/$/, '');
  return normalized || '/';
};

const path = normalizePath(Astro.url.pathname);
const tabletNavHrefs = new Set(['/programs', '/events']);
---

{
  /* Sentinel drives data-stuck via IntersectionObserver below; cheaper
    and more reliable than listening to scroll events. */
}
<div data-header-sentinel aria-hidden="true" class="h-px"></div>
<header
  data-site-header
  class="sticky top-0 h-(--lvbt-header-h) z-(--z-header) bg-surface/80 border-b border-transparent data-[stuck]:backdrop-blur-md data-[stuck]:backdrop-saturate-150 data-[stuck]:border-outline-variant/15 transition-[border-color] duration-200 ease-out [view-transition-name:site-header]"
>
  <div class="container-page h-full flex items-center justify-between gap-3 lg:gap-6">
    {
      /* Wordmark sits at text-xl across breakpoints: at 18px (text-lg)
        the primary "for Better Transit" reads 3.64:1 on cream, which
        passes WCAG large-text (3:1) but fails normal-text (4.5:1).
        font-extrabold qualifies as large only at ≥18.66px, so dropping
        to text-lg on mobile flipped the threshold and tanked mobile
        a11y on every paper-canvas page. text-xl (20px) clears it on
        every viewport. */
    }
    <a
      href="/"
      class="shrink-0 whitespace-nowrap font-extrabold tracking-tight text-xl no-underline"
    >
      <span class="block leading-none">Las Vegans</span>
      <span class="block leading-none text-primary">for Better Transit</span>
    </a>
    <nav aria-label="Primary" class="hidden md:block shrink-0">
      <ul class="flex items-center gap-5 lg:gap-7 whitespace-nowrap text-sm font-semibold">
        {
          navMain.map((item) => {
            const active = path === normalizePath(item.href);
            return (
              <li class={tabletNavHrefs.has(item.href) ? undefined : 'hidden lg:block'}>
                {item.href === '/join' ? (
                  <>
                    <a
                      href="/join"
                      data-auth="signed-out"
                      aria-current={active ? 'page' : undefined}
                      class="nav-link no-underline hover:text-primary-ink"
                    >
                      Join
                    </a>
                    <a
                      href="/go/"
                      data-auth="signed-in"
                      hidden
                      aria-current={path === '/go' ? 'page' : undefined}
                      class="nav-link no-underline hover:text-primary-ink"
                    >
                      Get involved
                    </a>
                  </>
                ) : (
                  <a
                    href={item.href}
                    aria-current={active ? 'page' : undefined}
                    class="nav-link no-underline hover:text-primary-ink"
                  >
                    {item.label}
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>
    {
      /* Sign-in state. Public pages are prebuilt, so they ship both states:
        signed-in-state.js shows the right one from the non-secret
        lvbt_signed_in cookie, and pages rendered on request set it on the
        server. Without JavaScript a public page shows "Sign in", which
        sends a signed-in member straight to their account. */
    }
    <div class="hidden lg:flex shrink-0 items-center gap-6 whitespace-nowrap">
      <div class="flex items-center gap-5 text-sm font-semibold">
        <a
          href="/sign-in/"
          data-auth="signed-out"
          class="nav-link no-underline hover:text-primary-ink"
        >
          {t('header.signIn')}
        </a>
        <details data-auth="signed-in" hidden class="relative group">
          <summary
            class="flex cursor-pointer list-none items-center gap-2 font-semibold hover:text-primary-ink"
          >
            <span
              class="flex size-9 items-center justify-center rounded-full bg-primary-container text-primary-ink"
              ><ProfileIcon /></span
            >
            <span>Profile</span>
          </summary>
          <div class="absolute right-0 top-full z-50 mt-3 w-48 bg-surface-container p-3 shadow-lg">
            <a
              href="/account/"
              class="block px-3 py-2 no-underline font-semibold hover:bg-surface hover:text-primary-ink"
              >{t('header.account')}</a
            >
            <form method="post" action="/sign-out/">
              <button
                type="submit"
                class="block w-full px-3 py-2 text-left font-semibold hover:bg-surface hover:text-primary-ink"
                >{t('header.signOut')}</button
              >
            </form>
          </div>
        </details>
      </div>
      <div data-auth="signed-out">
        <a
          href="/go"
          data-header-cta
          class="press inline-flex items-center gap-1.5 bg-on-surface text-surface px-4 py-2 text-sm font-bold no-underline hover:bg-primary hover:text-on-primary focus-visible:bg-primary focus-visible:text-on-primary"
        >
          Get involved <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    {/* Mobile controls: Join CTA (hidden when nav open) + hamburger toggle */}
    <div class="lg:hidden flex shrink-0 items-center gap-3 whitespace-nowrap">
      <div data-auth="signed-out" class="hidden min-[375px]:block">
        <a
          href="/join"
          data-mobile-join
          class="press inline-flex items-center gap-1.5 bg-on-surface text-surface px-4 py-2 text-sm font-bold no-underline hover:bg-primary hover:text-on-primary focus-visible:bg-primary focus-visible:text-on-primary"
        >
          Join <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div data-auth="signed-in" hidden>
        <a
          href="/account/"
          aria-label="Your account"
          class="flex size-10 items-center justify-center rounded-full bg-primary-container text-primary-ink"
          ><ProfileIcon /></a
        >
      </div>
      <button
        type="button"
        data-nav-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-overlay"
        class="flex flex-col items-center justify-center gap-1 p-2 -mr-2 w-10 h-10"
      >
        <span class="block w-5 h-0.5 bg-current" aria-hidden="true"></span>
        <span class="block w-5 h-0.5 bg-current" aria-hidden="true"></span>
        <span class="block w-5 h-0.5 bg-current" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

{/* Full-screen mobile nav overlay — sits beneath the sticky header */}
<nav
  id="mobile-nav-overlay"
  data-nav-overlay
  aria-label="Mobile navigation"
  inert
  class="lg:hidden fixed left-0 right-0 bottom-0 bg-surface z-(--z-mobile-nav) flex flex-col overflow-y-auto"
  style="top: var(--lvbt-header-h)"
>
  <ul class="flex-1 list-none m-0 px-6 py-2">
    {
      navMain
        .filter((item) => item.href !== '/join')
        .map((item) => {
          const active = path === normalizePath(item.href);
          return (
            <li class="border-b border-outline-variant/15">
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class="flex items-center py-5 text-2xl font-extrabold tracking-tight no-underline hover:text-primary-ink aria-[current=page]:text-primary-ink"
              >
                {item.label}
              </a>
            </li>
          );
        })
    }
  </ul>
  <div class="px-6 pt-4 flex flex-wrap items-center gap-6 text-lg font-bold">
    <a href="/sign-in/" data-auth="signed-out" class="no-underline hover:text-primary-ink">
      {t('header.signIn')}
    </a>
    <details data-auth="signed-in" hidden class="w-full bg-surface-container p-4">
      <summary class="flex cursor-pointer list-none items-center gap-3"
        ><span
          class="flex size-10 items-center justify-center rounded-full bg-primary-container text-primary-ink"
          ><ProfileIcon /></span
        ><span>Profile</span></summary
      >
      <div class="mt-4 space-y-3 pl-13 text-base">
        <a href="/account/" class="block no-underline hover:text-primary-ink"
          >{t('header.account')}</a
        >
        <form method="post" action="/sign-out/">
          <button type="submit" class="font-bold hover:text-primary-ink"
            >{t('header.signOut')}</button
          >
        </form>
      </div>
    </details>
  </div>
  <div class="px-6 pb-8 pt-4">
    <a
      href="/go"
      class="press flex items-center justify-center gap-1.5 bg-on-surface text-surface py-4 text-sm font-bold no-underline hover:bg-primary hover:text-on-primary focus-visible:bg-primary focus-visible:text-on-primary"
    >
      Get involved <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</nav>

{
  /* Sourced from public/scripts/ rather than written inline because the
     site's CSP is `script-src 'self'` (see public/_headers) — an inline
     observer here would silently fail in production, leaving the header
     without its bottom border on scroll and breaking the vision page's
     transparent→cream color flip. Astro inlines short hoisted <script>
     tags too, so going through public/ is the only reliable way to keep
     the script same-origin and CSP-allowed. */
}
<script is:inline src="/scripts/header-stuck.js" defer></script>
<script is:inline src="/scripts/mobile-nav.js" defer></script>
<script is:inline src="/scripts/signed-in-state.js" defer></script>
