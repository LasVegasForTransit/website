---
interface Props {
  step: 1 | 2;
}

const { step } = Astro.props;
const steps = ['Basic info', 'Optional details'];
---

<ol
  class="mt-6 grid grid-cols-2 gap-2"
  aria-label="Join LVBT progress"
  data-join-progress
  style="display:none"
>
  {
    steps.map((label, index) => {
      const position = index + 1;
      const current = position === step;
      const complete = position < step;
      return (
        <li
          aria-current={current ? 'step' : undefined}
          class:list={[
            'flex items-center gap-2 border-b-2 pb-2 text-sm leading-tight',
            current ? 'border-primary text-on-surface font-bold' : 'border-outline/25',
            complete && 'border-on-surface text-on-surface',
            !current && !complete && 'text-on-surface-variant',
          ]}
        >
          <span class="text-xs font-bold" aria-hidden="true">
            {position}
          </span>
          <span>{label}</span>
        </li>
      );
    })
  }
</ol>
