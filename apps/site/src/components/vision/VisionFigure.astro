---
interface Props {
  /** Figure number, e.g. "1", "10". Rendered as "FIG. 1". */
  num: string;
  /** Human label after the dash, e.g. "What's within a 5-minute walk". */
  title: string;
}

const { num, title } = Astro.props;
---

<figure class="vision-figure reveal">
  <p class="figure-label">Fig. {num}: {title}</p>
  <slot />
  <figcaption class="figure-caption"><slot name="caption" /></figcaption>
</figure>

<style>
  .vision-figure {
    margin-block: 4rem;
    padding-block: 2.5rem;
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  .figure-label {
    font-size: 0.9rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--vp-text-muted, var(--color-on-surface-variant));
    margin-bottom: 1.5rem;
  }
  .figure-caption {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--vp-text-muted, var(--color-on-surface-variant));
    max-width: 42rem;
    text-wrap: pretty;
  }
  .figure-caption :global(em) {
    font-style: italic;
    color: var(--vp-text, var(--color-on-surface));
    font-weight: 600;
  }
</style>
