---
import KeyValueSummary from '../app/KeyValueSummary.astro';
import { t } from '@lasvegasfortransit/platform-core/messages';
import { Icon } from 'astro-icon/components';

const change = (href: string) => ({ href, label: t('account.change') });
---

<h2 class="flex items-center gap-3 text-title-lg">
  <Icon name="mdi:card-account-details-outline" class="size-6 text-primary" aria-hidden="true" />{
    t('account.detailsHeading')
  }
</h2>
<div class="mt-5">
  <KeyValueSummary
    rows={[
      {
        key: t('account.name'),
        icon: 'mdi:account-outline',
        value: t('account.notGiven'),
        dataSlot: 'name',
        change: change('/account/name/'),
      },
      {
        key: t('account.email'),
        icon: 'mdi:email-outline',
        value: t('account.notGiven'),
        dataSlot: 'email',
        change: change('/account/email/'),
      },
      {
        key: t('account.phone'),
        icon: 'mdi:phone-outline',
        value: t('account.notGiven'),
        dataSlot: 'phone',
        change: change('/account/phone/'),
      },
      {
        key: t('account.area'),
        icon: 'mdi:map-marker-outline',
        value: t('account.notGiven'),
        dataSlot: 'area',
        change: change('/account/area/'),
      },
    ]}
  />
</div>
