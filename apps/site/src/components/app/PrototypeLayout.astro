---
// Every prototype page is hidden from search engines. Presentation mockups
// may hide the banner while retaining the noindex directive.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROTOTYPE_BANNER } from '../../lib/prototypes';

interface Props {
  title: string;
  canvas?: 'paper' | 'dark';
  showBanner?: boolean;
}

const { title, canvas = 'paper', showBanner = true } = Astro.props;
---

<BaseLayout title={`${title} · Prototype`} noindex canvas={canvas}>
  {
    showBanner && (
      <p class="bg-primary-ink text-surface px-4 py-3 text-center font-bold" data-prototype-banner>
        {PROTOTYPE_BANNER}
      </p>
    )
  }
  <slot />
  <script is:inline src="/scripts/app-enhance.js" defer></script>
</BaseLayout>
