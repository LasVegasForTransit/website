---
// A person's details as a description list, each with a "Change" link whose
// text says what it changes (docs/explanation/app-copy.md#links): the visible
// "Change" is followed by the row's name for screen readers, so it is read as
// "Change Phone". `dataSlot` marks a value a server fills in on request.
import { linkClass } from './styles';
import { Icon } from 'astro-icon/components';

interface Row {
  key: string;
  value: string;
  dataSlot?: string;
  icon?: string;
  change?: { href: string; label: string };
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<dl class="grid gap-3 sm:grid-cols-2">
  {
    rows.map((row) => (
      <div class="flex min-h-36 flex-col bg-surface-container p-5">
        <dt class="flex items-center gap-2 text-sm font-bold text-on-surface-variant">
          {row.icon && <Icon name={row.icon} class="size-5 text-primary" aria-hidden="true" />}
          {row.key}
        </dt>
        <dd data-slot={row.dataSlot} class="mt-2 [overflow-wrap:anywhere] font-semibold">
          {row.value}
        </dd>
        {row.change && (
          <dd class="mt-auto pt-4">
            <a href={row.change.href} class={linkClass}>
              {row.change.label}
              <span class="sr-only"> {row.key}</span>
            </a>
          </dd>
        )}
      </div>
    ))
  }
</dl>
