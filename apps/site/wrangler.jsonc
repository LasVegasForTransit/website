{
  "name": "lvbt-website",
  "main": ".wrangler/worker/index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/platform/discord/interactions",
      "/press",
      "/press/*",
      "/join/member",
      "/join/member/*",
      "/join/remove",
      "/join/remove/*",
      "/sign-in",
      "/sign-in/*",
      "/sign-out",
      "/sign-out/*",
      "/account",
      "/account/*",
      "/prototypes/join",
      "/prototypes/join/*",
      "/lvbt-release.json",
    ],
    "binding": "ASSETS",
    "directory": "dist",
  },
  "routes": [
    {
      "pattern": "lasvegasfortransit.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.lasvegasfortransit.org",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": [],
  },
  "durable_objects": {
    "bindings": [],
  },
  "vars": {
    "LVBT_DEPLOYMENT_ENV": "production",
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "lvbt-platform",
      "database_id": "dcde8dbd-d827-4405-85b4-97bc2accc906",
      "migrations_dir": "../../packages/platform-storage/migrations",
    },
  ],
  "r2_buckets": [],
  "analytics_engine_datasets": [],
  "ratelimits": [],
  "unsafe": {
    "metadata": {
      "keep_bindings": ["secret_text", "secret_key"],
    },
  },
  "env": {
    "preview": {
      "name": "lvbt-website-preview",
      "assets": {
        "not_found_handling": "404-page",
        "run_worker_first": true,
        "binding": "ASSETS",
        "directory": "dist",
      },
      "observability": {
        "enabled": true,
      },
      "unsafe": {
        "metadata": {
          "keep_bindings": ["secret_text", "secret_key"],
        },
      },
      "workers_dev": false,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "preview.lasvegasfortransit.org",
          "custom_domain": true,
        },
      ],
      "triggers": {
        "crons": [],
      },
      "durable_objects": {
        "bindings": [],
      },
      "vars": {
        "LVBT_DEPLOYMENT_ENV": "preview",
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "lvbt-platform-preview",
          "database_id": "8bb072e7-9865-487a-8867-d97fdb2ea00b",
          "migrations_dir": "../../packages/platform-storage/migrations",
        },
      ],
      "r2_buckets": [],
      "analytics_engine_datasets": [],
      "ratelimits": [],
    },
  },
}
