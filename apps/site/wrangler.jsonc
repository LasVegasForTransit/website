{
  "name": "lvbt-website",
  "main": ".wrangler/worker/index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/platform/discord/interactions",
      "/press",
      "/press/*",
      "/join/member",
      "/join/member/*",
      "/join/remove",
      "/join/remove/*",
      "/sign-in",
      "/sign-in/*",
      "/sign-out",
      "/sign-out/*",
      "/account",
      "/account/*",
      "/prototypes/join",
      "/prototypes/join/*",
      "/lvbt-release.json",
    ],
    "binding": "ASSETS",
    "directory": "dist",
  },
  "routes": [
    {
      "pattern": "lasvegasfortransit.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.lasvegasfortransit.org",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": [],
  },
  "services": [
    {
      "binding": "LVBT_DISCORD_JOBS",
      "service": "lvbt-jobs",
    },
    {
      "binding": "DISCORD_WORK",
      "service": "lvbt-jobs",
      "entrypoint": "WorkPreview",
    },
  ],
  "durable_objects": {
    "bindings": [],
  },
  "vars": {
    "LVBT_DEPLOYMENT_ENV": "production",
    "LVBT_TASK_CHECKINS_ENABLED": "false",
    "LVBT_TASK_UPDATES_ENABLED": "true",
    "LVBT_DISCORD_WORK_ENABLED": "false",
    "LVBT_NOTION_TASK_SOURCE_ID": "1601d4dd-a09c-4562-8029-5a63446bd5ff",
    "LVBT_NOTION_TASK_PRODUCTION_SOURCE_ID": "1601d4dd-a09c-4562-8029-5a63446bd5ff",
    "LVBT_DISCORD_APPLICATION_ID": "1552481672945999872",
    "LVBT_DISCORD_GUILD_ID": "1509298455896522823",
    "LVBT_DISCORD_PRODUCTION_GUILD_ID": "1509298455896522823",
    "LVBT_DISCORD_PUBLIC_KEY": "21422dba5d410653b6e1b21fedffbf8cdbccaa94fc221d81d767712d2f6faef9",
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "lvbt-platform",
      "database_id": "dcde8dbd-d827-4405-85b4-97bc2accc906",
      "migrations_dir": "../../packages/platform-storage/migrations",
    },
  ],
  "r2_buckets": [],
  "analytics_engine_datasets": [],
  "ratelimits": [],
  "unsafe": {
    "metadata": {
      "keep_bindings": ["secret_text", "secret_key"],
    },
  },
  "env": {
    "preview": {
      "name": "lvbt-website-preview",
      "assets": {
        "not_found_handling": "404-page",
        "run_worker_first": true,
        "binding": "ASSETS",
        "directory": "dist",
      },
      "observability": {
        "enabled": true,
      },
      "unsafe": {
        "metadata": {
          "keep_bindings": ["secret_text", "secret_key"],
        },
      },
      "workers_dev": false,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "preview.lasvegasfortransit.org",
          "custom_domain": true,
        },
      ],
      "triggers": {
        "crons": [],
      },
      "services": [
        {
          "binding": "LVBT_DISCORD_JOBS",
          "service": "lvbt-jobs-preview",
        },
        {
          "binding": "DISCORD_WORK",
          "service": "lvbt-jobs-preview",
          "entrypoint": "WorkPreview",
        },
      ],
      "durable_objects": {
        "bindings": [],
      },
      "vars": {
        "LVBT_DEPLOYMENT_ENV": "preview",
        "LVBT_TASK_CHECKINS_ENABLED": "false",
        "LVBT_NOTION_TASK_SOURCE_ID": "",
        "LVBT_NOTION_TASK_PRODUCTION_SOURCE_ID": "",
        "LVBT_DISCORD_APPLICATION_ID": "1552481672945999872",
        "LVBT_DISCORD_PUBLIC_KEY": "21422dba5d410653b6e1b21fedffbf8cdbccaa94fc221d81d767712d2f6faef9",
        "LVBT_DISCORD_GUILD_ID": "1560146082640568350",
        "LVBT_DISCORD_PRODUCTION_GUILD_ID": "1509298455896522823",
        "LVBT_DISCORD_WORK_ENABLED": "false",
        "LVBT_TASK_UPDATES_ENABLED": "false",
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "lvbt-platform-preview",
          "database_id": "8bb072e7-9865-487a-8867-d97fdb2ea00b",
          "migrations_dir": "../../packages/platform-storage/migrations",
        },
      ],
      "r2_buckets": [],
      "analytics_engine_datasets": [],
      "ratelimits": [],
    },
  },
}
