{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lvbt-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "LVBT_DEPLOYMENT_ENV": "production",
    "LVBT_TASK_CHECKINS_ENABLED": "false",
    "LVBT_TASK_UPDATES_ENABLED": "true",
    "LVBT_DISCORD_WORK_ENABLED": "false",
    "LVBT_NOTION_TASK_SOURCE_ID": "1601d4dd-a09c-4562-8029-5a63446bd5ff",
    "LVBT_NOTION_TASK_PRODUCTION_SOURCE_ID": "1601d4dd-a09c-4562-8029-5a63446bd5ff",
    "LVBT_BEEHIIV_SYNC_ENABLED": "true",
    "LVBT_BEEHIIV_CONFLICT_POLICY": "staff_review",
    "LVBT_BEEHIIV_PUBLICATION_ID": "pub_d3178023-f8d5-4e9d-a768-0c4eaa6b7280",
    "LVBT_BEEHIIV_PRODUCTION_PUBLICATION_ID": "pub_d3178023-f8d5-4e9d-a768-0c4eaa6b7280",
    "LVBT_DISCORD_SYNC_ENABLED": "true",
    "LVBT_DISCORD_APPLICATION_ID": "1552481672945999872",
    "LVBT_DISCORD_GUILD_ID": "1509298455896522823",
    "LVBT_DISCORD_PRODUCTION_GUILD_ID": "1509298455896522823",
    "LVBT_DISCORD_MEMBER_ROLE_ID": "1509695122541903902",
  },
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "lvbt-platform",
      "database_id": "dcde8dbd-d827-4405-85b4-97bc2accc906",
      "migrations_dir": "../../packages/platform-storage/migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "lvbt-jobs-preview",
      "triggers": { "crons": [] },
      "vars": {
        "LVBT_DEPLOYMENT_ENV": "preview",
        "LVBT_TASK_CHECKINS_ENABLED": "false",
        "LVBT_TASK_UPDATES_ENABLED": "false",
        "LVBT_DISCORD_WORK_ENABLED": "false",
        "LVBT_NOTION_TASK_SOURCE_ID": "",
        "LVBT_NOTION_TASK_PRODUCTION_SOURCE_ID": "",
        "LVBT_BEEHIIV_SYNC_ENABLED": "false",
        "LVBT_BEEHIIV_CONFLICT_POLICY": "staff_review",
        "LVBT_BEEHIIV_PUBLICATION_ID": "",
        "LVBT_BEEHIIV_PRODUCTION_PUBLICATION_ID": "pub_d3178023-f8d5-4e9d-a768-0c4eaa6b7280",
        "LVBT_DISCORD_SYNC_ENABLED": "true",
        "LVBT_DISCORD_APPLICATION_ID": "1552481672945999872",
        "LVBT_DISCORD_GUILD_ID": "1560146082640568350",
        "LVBT_DISCORD_PRODUCTION_GUILD_ID": "1509298455896522823",
        "LVBT_DISCORD_MEMBER_ROLE_ID": "1560151428180353104",
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "lvbt-platform-preview",
          "database_id": "8bb072e7-9865-487a-8867-d97fdb2ea00b",
          "migrations_dir": "../../packages/platform-storage/migrations",
        },
      ],
    },
  },
}
