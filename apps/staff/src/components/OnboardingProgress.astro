---
interface Props {
  step: 'account' | 'discord' | 'ready';
}
const { step } = Astro.props;
const labels = { account: 'Account', discord: 'Discord', ready: 'Ready' } as const;
const current = { account: 1, discord: 2, ready: 3 }[step];
---

<div class="onboarding-progress">
  <p>Step {current} of 3: {labels[step]}</p>
  <progress value={current} max="3" aria-label="Setup progress"></progress>
</div>
<style>
  .onboarding-progress {
    display: grid;
    gap: 0.5rem;
    margin-block: 0.5rem 1.5rem;
  }
  p {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-on-surface-variant);
  }
  progress {
    display: block;
    width: 100%;
    height: 0.4rem;
    border: 0;
    border-radius: 999px;
    accent-color: var(--color-primary);
    background: var(--color-surface-container);
  }
  progress::-webkit-progress-bar {
    border-radius: 999px;
    background: var(--color-surface-container);
  }
  progress::-webkit-progress-value {
    border-radius: 999px;
    background: var(--color-primary);
  }
  progress::-moz-progress-bar {
    border-radius: 999px;
    background: var(--color-primary);
  }
</style>
