---
import type { StaffPerson } from '@lasvegasfortransit/platform-storage/staff-people';
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import { MEMBERSHIP_LABELS } from '../lib/people';
interface Props {
  profile: StaffPerson;
  discordConnected: boolean;
  discordStatus: string;
}
const { profile, discordConnected, discordStatus } = Astro.props;
const newsletter = profile.consents.filter((consent) => consent.scope === 'newsletter');
const active = newsletter.filter((consent) => consent.withdrawn_at === null);
const since = active
  .map((consent) => consent.given_at)
  .filter((date) => Number.isFinite(Date.parse(date)))
  .sort((a, b) => Date.parse(a) - Date.parse(b))[0];
const left = newsletter
  .flatMap((consent) => (consent.withdrawn_at ? [consent.withdrawn_at] : []))
  .filter((date) => Number.isFinite(Date.parse(date)))
  .sort((a, b) => Date.parse(b) - Date.parse(a))[0];
const date = profile.person.membership_status === 'member' ? since : left;
const lastActivity = profile.counts.last_engaged_at;
const membershipLabel = MEMBERSHIP_LABELS[profile.person.membership_status];
const membershipClass =
  profile.person.membership_status === 'member'
    ? 'staff-access-status staff-access-status-confirmed'
    : 'staff-access-status';
const membershipDate = date
  ? profile.person.membership_status === 'member'
    ? t('staff.profile.memberSince', { date: formatFullDate(new Date(date)) })
    : t('staff.profile.leftOn', { date: formatFullDate(new Date(date)) })
  : t('staff.profile.dateNotRecorded');
const mailingStatus = active.length
  ? t('staff.profile.mailingSignedUp')
  : newsletter.length
    ? t('staff.profile.mailingLeft')
    : t('staff.profile.mailingUnknown');
---

<section aria-label={t('staff.profile.summary')} class="staff-profile-summary">
  <dl class="staff-profile-facts">
    <div>
      <dt>{t('staff.profile.membership')}</dt>
      <dd><strong class={membershipClass}>{membershipLabel}</strong></dd>
      {
        profile.person.membership_status !== 'not_member' && (
          <dd class="staff-profile-fact-note">
            {date ? <time datetime={date}>{membershipDate}</time> : membershipDate}
          </dd>
        )
      }
    </div>
    <div>
      <dt>{t('staff.labels.newsletter')}</dt>
      <dd>
        <strong>{mailingStatus}</strong>
      </dd>
    </div>
    <div>
      <dt>{t('staff.profile.lastActivity')}</dt>
      <dd>
        {
          lastActivity ? (
            <time datetime={lastActivity}>{formatFullDate(new Date(lastActivity))}</time>
          ) : (
            t('staff.record.noActivity')
          )
        }
      </dd>
      {
        profile.counts.attended_total > 0 && (
          <dd class="staff-profile-fact-note">
            {t('staff.profile.attended', { count: profile.counts.attended_total })}
          </dd>
        )
      }
    </div>
    <div>
      <dt>{t('staff.common.discord')}</dt>
      <dd><strong>{discordConnected ? discordStatus : t('staff.profile.notConnected')}</strong></dd>
      {
        discordConnected && (
          <dd class="staff-profile-fact-note">
            <a href={`/access/?person=${profile.person.id}`}>{t('staff.profile.checkAccess')}</a>
          </dd>
        )
      }
    </div>
  </dl>
</section>
