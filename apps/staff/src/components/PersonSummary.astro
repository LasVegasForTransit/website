---
import type { StaffPerson } from '@lasvegasfortransit/platform-storage/staff-people';
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import { MEMBERSHIP_LABELS } from '../lib/people';
interface Props {
  profile: StaffPerson;
}
const { profile } = Astro.props;
const newsletter = profile.consents.filter((consent) => consent.scope === 'newsletter');
const active = newsletter.filter((consent) => consent.withdrawn_at === null);
const since = active
  .map((consent) => consent.given_at)
  .filter((date) => Number.isFinite(Date.parse(date)))
  .sort((a, b) => Date.parse(a) - Date.parse(b))[0];
const left = newsletter
  .filter((consent) => consent.withdrawn_at && Number.isFinite(Date.parse(consent.withdrawn_at)))
  .sort((a, b) => Date.parse(b.withdrawn_at!) - Date.parse(a.withdrawn_at!))[0];
const membershipLabel = MEMBERSHIP_LABELS[profile.person.membership_status];
const date = profile.person.membership_status === 'member' ? since : left?.withdrawn_at;
const explanation =
  profile.person.membership_status === 'member'
    ? since
      ? t('staff.profile.memberSince', { date: formatFullDate(new Date(since)) })
      : t('staff.profile.memberUpdates')
    : profile.person.membership_status === 'former_member'
      ? left?.withdrawn_at
        ? left.withdrawn_time_basis === 'observed'
          ? t('staff.profile.unsubscribeRecorded', {
              date: formatFullDate(new Date(left.withdrawn_at)),
            })
          : t('staff.profile.unsubscribedOn', {
              date: formatFullDate(new Date(left.withdrawn_at)),
            })
        : t('staff.profile.formerUpdates')
      : t('staff.profile.noSignup');
---

<section aria-label={t('staff.profile.summary')} class="staff-member-membership">
  <h2>{t('staff.profile.membership')}</h2>
  <p class="staff-membership-state"><strong>{membershipLabel}</strong></p>
  <p class="staff-membership-explanation">
    {date ? <time datetime={date}>{explanation}</time> : explanation}
  </p>
</section>
