---
import { t } from '@lasvegasfortransit/platform-core/messages';
import type { HeldTask } from '@lasvegasfortransit/platform-storage/notion-task-admin';
interface Props {
  sourceId: string;
  review: { items: HeldTask[]; nextCursor: string | null };
}
const { sourceId, review } = Astro.props;
const reasons: Record<string, string> = {
  missing_name: t('taskCheckins.staff.missingName'),
  invalid_link: t('taskCheckins.staff.invalidLink'),
  incomplete_assignment: t('taskCheckins.staff.incompleteAssignment'),
  unassigned: t('taskCheckins.staff.unassigned'),
  incomplete_project: t('taskCheckins.staff.incompleteProject'),
  invalid_deadline: t('taskCheckins.staff.invalidDeadline'),
  unconfirmed_date_range: 'This task has a date range. Choose which date to use for reminders.',
  unsupported_status: t('taskCheckins.staff.unsupportedStatus'),
};
---

<section class="staff-checkin-section" aria-labelledby="held-tasks-title">
  <h3 id="held-tasks-title">Task details to fix</h3>
  <p class="staff-help">These tasks need a change before reminders can be sent.</p>
  {review.items.length === 0 && <p>No task details need a change.</p>}
  <ul class="staff-checkin-list staff-task-review-list">
    {
      review.items.map((task) => (
        <li>
          <div>
            <h4>
              <a
                href={`https://www.notion.so/${task.task_id.replaceAll('-', '')}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {task.task_title || 'Untitled task'}
              </a>
            </h4>
            <p>{reasons[task.reason] ?? 'Review the task details in Notion.'}</p>
            <div class="staff-task-row-links">
              <a
                href={`https://www.notion.so/${task.task_id.replaceAll('-', '')}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                Open task in Notion ↗
              </a>
              {task.reason === 'unconfirmed_date_range' && (
                <a
                  href={`/task-checkins/settings/?source=${encodeURIComponent(sourceId)}#rangeBoundary`}
                >
                  Choose reminder date
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
  {
    review.nextCursor && (
      <a
        class="staff-next"
        href={`/task-checkins/?view=review&source=${encodeURIComponent(sourceId)}&heldCursor=${encodeURIComponent(review.nextCursor)}`}
      >
        {t('taskCheckins.staff.next')}
      </a>
    )
  }
</section>
