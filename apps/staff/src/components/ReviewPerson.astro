---
import type { StaffPerson } from '@lasvegasfortransit/platform-storage/staff-people';
import { formatDate, t } from '@lasvegasfortransit/platform-core/messages';
import { formatPhone } from '@lasvegasfortransit/platform-core/join-form';
import { displayLabel } from '../lib/presentation';
import { personName, MEMBERSHIP_LABELS } from '../lib/people';
interface Props {
  profile: StaffPerson;
  label: string;
}
const { profile, label } = Astro.props;
const { person } = profile;
---

<section class="staff-review-person">
  <p class="staff-section-label">{label}</p>
  <h2 class="mt-2 font-bold text-title-lg">
    <a href={`/people/${person.id}/`}>{personName(person)}</a>
  </h2>
  <p class="mt-1 text-body-sm text-on-surface-variant">
    {MEMBERSHIP_LABELS[person.membership_status]} · {
      t('staff.review.addedAt', {
        date: formatDate(new Date(person.created_at)),
      })
    }
  </p>
  <dl class="staff-contact-details">
    <div>
      <dt>{t('staff.common.email')}</dt><dd>{person.email ?? t('staff.review.notProvided')}</dd>
    </div>
    <div>
      <dt>{t('staff.common.phone')}</dt><dd>
        {person.phone ? formatPhone(person.phone) : t('staff.review.notProvided')}
      </dd>
    </div>
    <div>
      <dt>{t('staff.common.zip')}</dt><dd>{person.zip ?? t('staff.review.notProvided')}</dd>
    </div>
  </dl>
  <details class="staff-review-history">
    <summary>{t('staff.review.permissionsAndAccounts')}</summary>
    <h3 class="mt-4 font-bold">{t('staff.record.permission')}</h3>
    {
      profile.consents.length ? (
        <ul class="mt-2 space-y-3">
          {profile.consents.map((consent) => (
            <li>
              <strong>{displayLabel(consent.scope)}</strong> ·{' '}
              {consent.withdrawn_at
                ? t('staff.record.permissionWithdrawn')
                : t('staff.record.permissionGiven')}
              <p class="text-on-surface-variant">
                {consent.withdrawn_at
                  ? t('staff.review.permissionWithdrawnAt', {
                      givenDate: formatDate(new Date(consent.given_at)),
                      withdrawnDate: formatDate(new Date(consent.withdrawn_at)),
                    })
                  : t('staff.review.permissionGivenAt', {
                      date: formatDate(new Date(consent.given_at)),
                    })}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-2">{t('staff.record.noPermission')}</p>
      )
    }
    <h3 class="mt-4 font-bold">{t('staff.record.accounts')}</h3>
    {
      profile.identities.length ? (
        <ul class="mt-2 space-y-3">
          {profile.identities.map((identity) => (
            <li>
              <strong>{displayLabel(identity.platform)}</strong>
              <p class="[overflow-wrap:anywhere]">
                {identity.external_email ?? t('staff.review.accountConnected')}
              </p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-2">{t('staff.record.noAccounts')}</p>
      )
    }
    <h3 class="mt-4 font-bold">{t('staff.common.committees')}</h3>
    {
      profile.assignments.length ? (
        <ul class="mt-2 space-y-3">
          {profile.assignments.map((assignment) => (
            <li>
              <strong>{assignment.committee_name}</strong> · {displayLabel(assignment.role)}
              {assignment.ended_at && ` · ${t('staff.assignments.ended')}`}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-2">{t('staff.review.noCommittees')}</p>
      )
    }
  </details>
</section>
