---
import type { AccessRow } from '@lasvegasfortransit/platform-storage/access-view';
import { issueFormToken } from '@lasvegasfortransit/platform-storage/form-tokens';
import { ulid } from '@lasvegasfortransit/platform-core/ids';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { t, formatFullDate, formatTime } from '@lasvegasfortransit/platform-core/messages';
import Button from '../../../site/src/components/app/Button.astro';
import { accessLabel, updateFailure } from '../lib/account-access';
import { MEMBERSHIP_LABELS } from '../lib/people';
import { needsAccessRecovery } from '@lasvegasfortransit/platform-core/access';
interface Props {
  row: AccessRow;
  personView?: boolean;
}
const { row, personView = false } = Astro.props;
const memberChannels = row.targetId === 'person';
const staff = Astro.locals.staff!;
const admin = can(staff.actor, 'access.recover');
const removeToken =
  admin && row.assignmentId
    ? await issueFormToken(staff.db, staff.actor, `access:remove:${row.assignmentId}`)
    : null;
const providers =
  row.targetId === 'person'
    ? [
        {
          name: t(personView ? 'staff.access.memberChannels' : 'staff.common.discord'),
          access: row.discord,
        },
      ]
    : [
        { name: t('staff.access.googleGroup'), access: row.googleWorkspace },
        { name: t('staff.common.discord'), access: row.discord },
      ];
const needsRecovery = needsAccessRecovery(row);
const retryToken =
  admin && needsRecovery && row.operationId
    ? await issueFormToken(staff.db, staff.actor, `access:retry:${row.operationId}`)
    : null;
---

<li class="staff-account-row">
  <header class="staff-account-heading">
    <h2>
      {
        personView ? (
          memberChannels ? (
            t('staff.common.discord')
          ) : (
            row.committeeName
          )
        ) : (
          <a class="staff-person-link" href={`/people/${row.personId}/`}>
            {row.name}
          </a>
        )
      }
    </h2>
    {
      !personView && (
        <p class="staff-account-scope">
          {memberChannels ? t('staff.access.memberChannels') : row.committeeName}
        </p>
      )
    }
    {
      !(personView && memberChannels) && (
        <p class="staff-help">
          {memberChannels
            ? personView
              ? t('staff.access.memberChannelsHint')
              : MEMBERSHIP_LABELS[row.membershipStatus]
            : row.assignmentId
              ? row.role === 'lead'
                ? t('staff.access.committeeLead')
                : t('staff.access.committeeMember')
              : t('staff.access.noLongerAssigned')}
        </p>
      )
    }
  </header>
  <dl class="staff-account-status">
    {
      providers.map(({ name, access }) => (
        <div>
          <dt>{name}</dt>
          <dd>
            <span
              class:list={[
                'staff-access-status',
                {
                  'staff-access-status-confirmed':
                    access.state !== 'unknown' &&
                    access.state === (row.expectedAccess ? 'granted' : 'absent'),
                  'staff-access-status-attention':
                    access.state !== 'unknown' &&
                    access.state !== (row.expectedAccess ? 'granted' : 'absent'),
                },
              ]}
            >
              {accessLabel(access, row.expectedAccess, memberChannels)}
            </span>
          </dd>
          {access.observedAt && (
            <dd class="staff-access-checked">
              <time datetime={access.observedAt}>
                {t('staff.access.checked', {
                  date: formatFullDate(new Date(access.observedAt)),
                  time: formatTime(new Date(access.observedAt)),
                })}
              </time>
            </dd>
          )}
        </div>
      ))
    }
  </dl>
  {
    needsRecovery && (
      <div class="staff-access-recovery">
        <p role="status">{updateFailure(row.lastFailure)}</p>
        {retryToken && (
          <form method="post" action={Astro.url.pathname + Astro.url.search}>
            <input type="hidden" name="token" value={retryToken} />
            <input type="hidden" name="action" value="retry" />
            <input type="hidden" name="target" value={row.operationId} />
            <Button>{t('staff.access.retry')}</Button>
          </form>
        )}
      </div>
    )
  }
  {
    removeToken && (
      <details class="staff-account-removal">
        <summary>{t('staff.access.remove')}</summary>
        <p class="staff-help">
          {t('staff.access.removeHint', {
            name: row.name,
            committee: row.committeeName ?? t('staff.common.committee'),
          })}
        </p>
        <form
          method="post"
          action={Astro.url.pathname + Astro.url.search}
          class="staff-form staff-inline-form"
        >
          <input type="hidden" name="token" value={removeToken} />
          <input type="hidden" name="action" value="remove" />
          <input type="hidden" name="target" value={row.assignmentId} />
          <input type="hidden" name="operation_id" value={ulid()} />
          <>
            <div>
              <>
                <label for={`reason-${row.assignmentId}`}>{t('staff.access.reason')}</label>
                <select name="reason" id={`reason-${row.assignmentId}`} required>
                  <option value="">{t('staff.access.chooseReason')}</option>
                  <>
                    <option value="stepped_back">{t('staff.access.steppedBack')}</option>
                    <option value="moved">{t('staff.access.moved')}</option>
                    <option value="left_lvbt">{t('staff.access.left')}</option>
                    <option value="removed">{t('staff.access.removed')}</option>
                  </>
                </select>
              </>
            </div>
            <Button>{t('staff.access.remove')}</Button>
          </>
        </form>
      </details>
    )
  }
</li>
