---
import type { AccessHistoryRow } from '@lasvegasfortransit/platform-storage/access-view';
import type { Page } from '@lasvegasfortransit/platform-core/staff-types';
import { t, formatFullDate, formatTime } from '@lasvegasfortransit/platform-core/messages';
import { displayLabel } from '../lib/presentation';
interface Props {
  page: Page<AccessHistoryRow>;
  title?: string;
  personId?: string | undefined;
}
const { page, title = t('staff.history.recent'), personId } = Astro.props;
const next = new URL(Astro.url);
if (page.nextCursor) next.searchParams.set('history_cursor', page.nextCursor);
const labels: Record<string, string> = {
  'committee.assign': t('staff.history.added'),
  'committee.change': t('staff.history.roleChanged'),
  'committee.end': t('staff.history.removed'),
  'committee.settings': t('staff.history.settingsUpdated'),
  'access.retry': t('staff.history.retried'),
  'access.group_update': t('staff.history.googleAccessRequested'),
  'staff_admin.manage': t('staff.history.staffAccessChanged'),
  'access.granted': t('staff.history.granted'),
  'access.revoked': t('staff.history.revoked'),
  'access.suspended': t('staff.accessOverview.suspended'),
  'access.unsuspended': t('staff.accessOverview.unsuspended'),
  'access.transferred': t('staff.accessOverview.transferred'),
  'access.deleted': t('staff.accessOverview.deleted'),
};
const sources: Record<string, string> = {
  access_page: t('staff.accessOverview.removedReason'),
  discord_drift: t('staff.history.periodicCheck'),
  google_group_review: t('staff.history.groupReview'),
  'access.group_update': t('staff.history.groupReview'),
  membership_change: t('staff.history.membershipChanged'),
  person_deleted: t('staff.history.accountDeleted'),
  discord_link: t('staff.history.discordConnected'),
  'committee.assign': t('staff.history.added'),
  'committee.change': t('staff.history.roleChanged'),
  'committee.end': t('staff.history.removed'),
  'committee.settings': t('staff.history.settingsChanged'),
  settings_changed: t('staff.history.settingsChanged'),
  'person.merge': t('staff.history.combined'),
  'person.unmerge': t('staff.history.separated'),
  account_update: t('staff.history.accountUpdate'),
};
function actionLabel(item: AccessHistoryRow): string {
  if (item.provider && ['access.granted', 'access.revoked'].includes(item.action)) {
    const values = { service: displayLabel(item.provider) };
    return item.action === 'access.granted'
      ? t('staff.history.serviceGranted', values)
      : t('staff.history.serviceRemoved', values);
  }
  const label = labels[item.action] ?? t('staff.history.accessChanged');
  return item.provider &&
    ['access.suspended', 'access.unsuspended', 'access.transferred', 'access.deleted'].includes(
      item.action,
    )
    ? `${displayLabel(item.provider)} · ${label}`
    : label;
}
function actorLabel(item: AccessHistoryRow): string {
  return item.actorKind === 'person'
    ? (item.actorName ?? t('staff.labels.staff'))
    : t('staff.history.automaticActor');
}
function reasonLabel(item: AccessHistoryRow): string {
  return [
    item.source && item.source !== 'account_update' && sources[item.source],
    item.role && item.action !== 'committee.end' && displayLabel(item.role),
    item.reason &&
      item.reason !== item.source &&
      (sources[item.reason] ?? displayLabel(item.reason)),
  ]
    .filter(Boolean)
    .join(' · ');
}
---

<details class="staff-account-history" open={Boolean(Astro.url.searchParams.get('history_cursor'))}>
  <summary>{title}</summary>
  {
    page.items.length ? (
      <ol class="staff-account-history-list">
        {page.items.map((item) => (
          <li>
            <p class="staff-history-date">
              <time datetime={item.occurredAt}>
                <span>{formatFullDate(new Date(item.occurredAt))}</span>
                <span>{formatTime(new Date(item.occurredAt))}</span>
              </time>
            </p>
            <div>
              <p class="staff-history-action">
                <strong>{actionLabel(item)}</strong>
              </p>
              {((!personId && (item.personName || !item.committeeName)) || item.personDeleted) && (
                <p class="staff-history-person">
                  {item.personDeleted
                    ? t('staff.history.deletedRecord')
                    : (item.personName ?? t('staff.common.member'))}
                </p>
              )}
              {item.committeeName && (
                <p class="staff-history-person">
                  {item.committeeName}
                  {item.mappingState === 'retained' && ` · ${t('staff.googleGroups.retired')}`}
                </p>
              )}
              <p class="staff-help">
                {t('staff.history.by', { name: actorLabel(item) })}
                {item.requestedByName &&
                  ` · ${t('staff.history.requestedBy', { name: item.requestedByName })}`}
              </p>
              {reasonLabel(item) && <p class="staff-history-reason">{reasonLabel(item)}</p>}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="staff-help">{t('staff.history.none')}</p>
    )
  }
  {
    page.nextCursor && (
      <a class="staff-next" href={next.pathname + next.search}>
        {t('staff.history.earlier')}
      </a>
    )
  }
</details>
