---
import Button from '../../../site/src/components/app/Button.astro';
import { ulid } from '@lasvegasfortransit/platform-core/ids';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import { issueFormToken } from '@lasvegasfortransit/platform-storage/form-tokens';
import type { StaffPerson } from '@lasvegasfortransit/platform-storage/staff-people';
import { visibleCommittees } from '../lib/people';
import { displayLabel } from '../lib/presentation';
import type { CommitteeFeedback } from '../lib/committees';
import { rosterReturn } from '../lib/roster-return';
interface Props {
  profile: StaffPerson;
  feedback?: CommitteeFeedback;
}
const { profile, feedback } = Astro.props;
const staff = Astro.locals.staff!;
const current = profile.assignments.filter((item) => !item.ended_at);
const past = profile.assignments.filter((item) => item.ended_at);
const available = (await visibleCommittees(staff.db, staff.actor)).filter(
  (item) =>
    item.acceptingMembers && !current.some((assignment) => assignment.committee_id === item.id),
);
const token = await issueFormToken(staff.db, staff.actor, `person:committee:${profile.person.id}`);
const returnTo = rosterReturn(Astro.url.searchParams.get('return_to'));
const returnQuery = returnTo ? `?return_to=${encodeURIComponent(returnTo)}` : '';
const afterAssign = returnTo && Astro.url.searchParams.get('return_after_assign') === '1';
const action = `/people/${profile.person.id}/${returnQuery}${afterAssign ? '&return_after_assign=1' : ''}#committees-heading`;
const endReasons = {
  stepped_back: t('staff.assignments.steppedBack'),
  moved: t('staff.assignments.moved'),
  left_lvbt: t('staff.assignments.left'),
  removed: t('staff.assignments.removed'),
};
---

<section aria-labelledby="committees-heading" class="staff-profile-committees">
  <h2 id="committees-heading">{t('staff.common.committees')}</h2>
  {
    feedback && (
      <p role="alert" class="staff-error mt-3">
        {feedback.message}
      </p>
    )
  }
  <ul class="staff-current-assignments">
    {
      current.map((item) => (
        <li>
          <p>
            {can(staff.actor, 'committee.view', { committeeId: item.committee_id }) ? (
              <a href={`/committees/${item.committee_id}/`} class="staff-person-link">
                {item.committee_name}
              </a>
            ) : (
              <strong>{item.committee_name}</strong>
            )}{' '}
            · {displayLabel(item.role)}
          </p>
          <p class="staff-help">
            <time datetime={item.started_at}>
              {t('staff.assignments.since', { date: formatFullDate(new Date(item.started_at)) })}
            </time>
          </p>
          {item.account_update_state === 'retry' && (
            <p class="staff-help">
              <a href="#accounts">{t('staff.assignments.attention')}</a>
            </p>
          )}
          {can(staff.actor, 'committee.assign', { committeeId: item.committee_id }) && (
            <details class="staff-assignment-actions">
              <summary>{t('staff.assignments.change')}</summary>
              <form method="post" action={action} class="staff-form staff-inline-form">
                <input type="hidden" name="token" value={token} />
                <input type="hidden" name="operation_id" value={ulid()} />
                <input type="hidden" name="action" value="change" />
                <input type="hidden" name="assignment_id" value={item.id} />
                <div>
                  <label for={`role-${item.id}`}>
                    {t('staff.assignments.roleIn', { committee: item.committee_name })}
                  </label>
                  <select id={`role-${item.id}`} name="role">
                    <option value="member" selected={item.role === 'member'}>
                      {t('staff.common.member')}
                    </option>
                    <option value="lead" selected={item.role === 'lead'}>
                      {t('staff.common.lead')}
                    </option>
                  </select>
                </div>
                <Button>{t('staff.assignments.saveRole')}</Button>
              </form>
              <form method="post" action={action} class="staff-form staff-inline-form">
                <input type="hidden" name="token" value={token} />
                <input type="hidden" name="operation_id" value={ulid()} />
                <input type="hidden" name="action" value="end" />
                <input type="hidden" name="assignment_id" value={item.id} />
                <div>
                  <label for={`reason-${item.id}`}>
                    {t('staff.assignments.reasonForLeaving', { committee: item.committee_name })}
                  </label>
                  <select id={`reason-${item.id}`} name="reason" required>
                    <option value="">{t('staff.assignments.chooseReason')}</option>
                    {Object.entries(endReasons).map(([value, label]) => (
                      <option value={value}>{label}</option>
                    ))}
                  </select>
                </div>
                <Button>{t('staff.assignments.remove')}</Button>
              </form>
            </details>
          )}
        </li>
      ))
    }
  </ul>
  {!current.length && <p class="mt-3">{t('staff.assignments.none')}</p>}
  {
    available.length > 0 && profile.person.membership_status !== 'member' && (
      <p class="staff-help">{t('staff.assignments.onlyCurrent')}</p>
    )
  }
  {
    available.length > 0 && profile.person.membership_status === 'member' && (
      <>
        {current.length > 0 && <p class="staff-help">{t('staff.assignments.multiple')}</p>}
        <form method="post" action={action} class="staff-form staff-assignment-form">
          <input type="hidden" name="token" value={token} />
          <input type="hidden" name="operation_id" value={ulid()} />
          <input type="hidden" name="action" value="assign" />
          <div>
            <label for="committee_id">{t('staff.common.committee')}</label>
            <select id="committee_id" name="committee_id" required>
              <option value="">{t('staff.assignments.choose')}</option>
              {available.map((item) => (
                <option value={item.id} selected={feedback?.committeeId === item.id}>
                  {item.name}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label for="assignment_role">{t('staff.assignments.role')}</label>
            <select id="assignment_role" name="role">
              <option value="member" selected={feedback?.role !== 'lead'}>
                {t('staff.common.member')}
              </option>
              <option value="lead" selected={feedback?.role === 'lead'}>
                {t('staff.common.lead')}
              </option>
            </select>
          </div>
          <Button>
            {current.length ? t('staff.people.addAnother') : t('staff.assignments.add')}
          </Button>
        </form>
      </>
    )
  }
  {
    past.length > 0 && (
      <details class="staff-assignment-history">
        <summary>{t('staff.assignments.past')}</summary>
        <ul class="staff-past-assignments mt-3 space-y-3">
          {past.map((item) => (
            <li>
              <strong>{item.committee_name}</strong> · {displayLabel(item.role)}
              <p class="staff-help">
                {formatFullDate(new Date(item.started_at))}–
                {formatFullDate(new Date(item.ended_at!))} ·{' '}
                {item.end_reason ? displayLabel(item.end_reason) : t('staff.assignments.ended')}
              </p>
            </li>
          ))}
        </ul>
      </details>
    )
  }
</section>
