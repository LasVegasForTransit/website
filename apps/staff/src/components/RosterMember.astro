---
import type { Person } from '@lasvegasfortransit/platform-storage/person-service';
import type { RosterDetails } from '@lasvegasfortransit/platform-storage/roster-details';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { MEMBERSHIP_LABELS, personName } from '../lib/people';
import { rosterReturn } from '../lib/roster-return';
interface Props {
  person: Person;
  details?: RosterDetails;
  showMembership: boolean;
  showDiscord: boolean;
  canAddToAnotherCommittee: boolean;
}
const { person, details, showMembership, showDiscord, canAddToAnotherCommittee } = Astro.props;
const name = personName(person);
const discordPresence =
  details?.discordInServer === true
    ? 'In LVBT Discord'
    : details?.discordInServer === false
      ? 'Not in LVBT Discord'
      : 'Discord not checked yet';
const rosterStatus = [
  showMembership ? MEMBERSHIP_LABELS[person.membership_status] : null,
  showDiscord
    ? details?.discordConnected
      ? discordPresence
      : 'Discord account not connected'
    : null,
]
  .filter(Boolean)
  .join(' · ');
const returnTo = rosterReturn(Astro.url.pathname + Astro.url.search) ?? '/people/';
const profile = `/people/${person.id}/?return_to=${encodeURIComponent(returnTo)}`;
const assignLink = `${profile}&return_after_assign=1#committees-heading`;
const staff = Astro.locals.staff!;
---

<tr>
  <th scope="row" class="staff-roster-person">
    <a href={profile}>{name}</a>
    {person.email && person.email !== name && <p>{person.email}</p>}
  </th>
  {(showMembership || showDiscord) && <td class="staff-roster-status">{rosterStatus}</td>}
  <td class="staff-roster-committee">
    <div class="staff-roster-committee-content">
      {
        details?.committees.length ? (
          <ul class="staff-committee-chips" aria-label={`${name}'s committees`}>
            {details.committees.map((committee) => (
              <li>
                {can(staff.actor, 'committee.view', {
                  committeeId: committee.id,
                }) ? (
                  <a href={`/committees/${committee.id}/`}>{committee.name}</a>
                ) : (
                  <span>{committee.name}</span>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p>{person.membership_status === 'member' ? 'No committee yet' : '—'}</p>
        )
      }
      {
        person.membership_status === 'member' && canAddToAnotherCommittee && (
          <a
            href={assignLink}
            class="staff-roster-add-committee"
            aria-label={
              details?.committees.length
                ? `Add another committee for ${name}`
                : `Add ${name} to a committee`
            }
          >
            {details?.committees.length ? 'Add another committee' : 'Add to a committee'}
          </a>
        )
      }
    </div>
  </td>
</tr>
