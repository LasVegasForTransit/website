---
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import type { Person } from '@lasvegasfortransit/platform-storage/person-service';
import type { RosterDetails } from '@lasvegasfortransit/platform-storage/roster-details';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { MEMBERSHIP_LABELS, personName } from '../lib/people';
import { rosterReturn } from '../lib/roster-return';
import RosterCommittees from './RosterCommittees.astro';
interface Props {
  person: Person;
  details?: RosterDetails;
  showMembership: boolean;
  showDiscord: boolean;
  canAddToAnotherCommittee: boolean;
}
const { person, details, showMembership, showDiscord, canAddToAnotherCommittee } = Astro.props;
const name = personName(person);
const discordPresence =
  details?.discordInServer === true
    ? t('staff.people.discordPresent')
    : details?.discordInServer === false
      ? t('staff.people.discordAbsent')
      : t('staff.people.discordNotChecked');
type Tone = 'ok' | 'attention' | 'neutral';
// Each status renders as a labeled indicator. Ember marks only the state that
// asks staff to act (a connected account that left the server), so the roster
// doesn't flood with color for the common "not connected yet" case.
const rosterStatus: { label: string; tone: Tone }[] = [
  ...(showMembership
    ? [
        {
          label: MEMBERSHIP_LABELS[person.membership_status],
          tone: (person.membership_status === 'member' ? 'ok' : 'neutral') as Tone,
        },
      ]
    : []),
  ...(showDiscord
    ? [
        details?.discordConnected
          ? {
              label: discordPresence,
              tone: (details.discordInServer === true
                ? 'ok'
                : details.discordInServer === false
                  ? 'attention'
                  : 'neutral') as Tone,
            }
          : { label: t('staff.people.discordNotConnected'), tone: 'neutral' as Tone },
      ]
    : []),
];
const returnTo = rosterReturn(Astro.url.pathname + Astro.url.search) ?? '/people/';
const profile = `/people/${person.id}/?return_to=${encodeURIComponent(returnTo)}`;
const assignLink = `${profile}&return_after_assign=1#committees-heading`;
const staff = Astro.locals.staff!;
---

<tr>
  <th scope="row" class="staff-roster-person">
    <a href={profile}>{name}</a>
    {person.email && person.email !== name && <p>{person.email}</p>}
    {
      /* Phones show one line per member; the toggle reveals the other cells.
        A checkbox keeps it working without scripts and without copying the
        cells' content. */
    }
    <input
      type="checkbox"
      id={`row-details-${person.id}`}
      class="staff-row-toggle-input"
      aria-label={t('staff.people.rowDetails', { name })}
    />
    <label for={`row-details-${person.id}`} class="staff-row-toggle" aria-hidden="true">
      {t('staff.people.rowDetailsShort')}
    </label>
  </th>
  {
    (showMembership || showDiscord) && (
      <td
        class="staff-roster-status"
        data-label={
          showMembership && showDiscord
            ? t('staff.people.membershipDiscord')
            : showDiscord
              ? t('staff.common.discord')
              : t('staff.common.membership')
        }
      >
        <ul class="staff-status-list">
          {rosterStatus.map((status) => (
            <li class:list={['staff-status', `staff-status-${status.tone}`]}>{status.label}</li>
          ))}
        </ul>
      </td>
    )
  }
  <td class="staff-roster-committee" data-label={t('staff.common.committees')}>
    <RosterCommittees
      person={person}
      name={name}
      details={details}
      canAddToAnotherCommittee={canAddToAnotherCommittee}
      assignLink={assignLink}
    />
  </td>
  <td class="staff-roster-activity-cell" data-label={t('staff.people.lastActivityHeading')}>
    {
      details?.lastEngagedAt ? (
        <p class="staff-roster-activity">
          <time datetime={details.lastEngagedAt}>
            <span class="sr-only">{t('staff.people.lastActivityHeading')} </span>
            {formatFullDate(new Date(details.lastEngagedAt))}
          </time>
        </p>
      ) : (
        <span class="staff-roster-none">—</span>
      )
    }
  </td>
</tr>
