---
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import type { StaffPerson } from '@lasvegasfortransit/platform-storage/staff-people';
import { displayLabel } from '../lib/presentation';
import { eventFacts } from '../lib/engagement';
import { pageLink } from '../lib/people';
interface Props {
  profile: StaffPerson;
}
const { profile } = Astro.props;
const { consents, identities, events, fieldSources } = profile;
---

<details class="staff-records" open={Astro.url.searchParams.has('cursor')}>
  <summary>{t('staff.record.history')}</summary>
  <div class="staff-record-grid">
    <section aria-labelledby="consent-heading">
      <h2 id="consent-heading">{t('staff.record.permission')}</h2>
      {
        consents.length ? (
          <ul class="mt-3 space-y-3">
            {consents.map((consent) => (
              <li>
                <strong>{displayLabel(consent.scope)}</strong> ·{' '}
                {consent.withdrawn_at
                  ? t('staff.record.permissionWithdrawn')
                  : t('staff.record.permissionGiven')}
                <p class="text-body-sm">
                  {t('staff.record.given', {
                    date: formatFullDate(new Date(consent.given_at)),
                    source: displayLabel(consent.source),
                    method: displayLabel(consent.method),
                  })}
                </p>
                {consent.wording_version && (
                  <details class="mt-2 text-body-sm">
                    <summary>{t('staff.record.signupDetails')}</summary>
                    <p class="mt-2">
                      {t('staff.record.formVersion', { version: consent.wording_version })}
                    </p>
                  </details>
                )}
                {consent.withdrawn_at && (
                  <p class="text-body-sm">
                    {t('staff.record.withdrawn', {
                      date: formatFullDate(new Date(consent.withdrawn_at)),
                      source: displayLabel(consent.withdrawn_source ?? 'unknown'),
                    })}
                  </p>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3">{t('staff.record.noPermission')}</p>
        )
      }
    </section>
    <section aria-labelledby="accounts-heading">
      <h2 id="accounts-heading">{t('staff.record.accounts')}</h2>
      {
        identities.length ? (
          <ul class="mt-3 space-y-3">
            {identities.map((identity) => (
              <li class="[overflow-wrap:anywhere]">
                <strong>{displayLabel(identity.platform)}</strong>
                {identity.external_email && <p>{identity.external_email}</p>}
                <details class="mt-2 text-body-sm">
                  <summary>{t('staff.record.reference')}</summary>
                  <p class="mt-2">{identity.external_id}</p>
                </details>
                <p class="text-body-sm">
                  {t('staff.record.linked', {
                    date: formatFullDate(new Date(identity.linked_at)),
                    method: displayLabel(identity.link_method),
                  })}
                </p>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3">{t('staff.record.noAccounts')}</p>
        )
      }
    </section>
    <section aria-labelledby="history-heading">
      <h2 id="history-heading">{t('staff.record.activity')}</h2>
      {
        events.items.length ? (
          <ol class="mt-3 space-y-3">
            {events.items.map((event) => (
              <li>
                <strong>{displayLabel(event.type)}</strong> ·{' '}
                <time datetime={event.occurred_at}>
                  {formatFullDate(new Date(event.occurred_at))}
                </time>
                <p class="text-body-sm">
                  {displayLabel(event.source)}
                  {event.recorded_by &&
                    ` · ${t('staff.record.recordedBy', { name: event.recorded_by })}`}
                </p>
                {eventFacts(event).length > 0 && (
                  <details class="mt-2">
                    <summary>{t('staff.record.details')}</summary>
                    <dl class="mt-3 space-y-3">
                      {eventFacts(event).map((fact) => (
                        <div>
                          <dt class="font-bold">{fact.label}</dt>
                          <dd class="mt-1 whitespace-pre-wrap [overflow-wrap:anywhere]">
                            {fact.value}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </details>
                )}
              </li>
            ))}
          </ol>
        ) : (
          <p class="mt-3">{t('staff.record.noActivity')}</p>
        )
      }
      {
        events.nextCursor && (
          <a href={pageLink(Astro.url, events.nextCursor)} class="mt-6 inline-block font-bold">
            {t('staff.record.older')}
          </a>
        )
      }
    </section>
    <section aria-labelledby="sources-heading">
      <details>
        <summary id="sources-heading">{t('staff.record.sources')}</summary>
        <ul class="mt-3 space-y-3">
          {
            fieldSources.map((source) => (
              <li>
                {displayLabel(source.field)} · {displayLabel(source.source)} ·{' '}
                {formatFullDate(new Date(source.confirmed_at))}
              </li>
            ))
          }
        </ul>
      </details>
    </section>
  </div>
</details>
