---
import { t, LOCALE } from '@lasvegasfortransit/platform-core/messages';
import '../styles/staff.css';
import { issueFormToken } from '@lasvegasfortransit/platform-storage/form-tokens';
import { welcomeVisible } from '../lib/welcome';
import { can } from '@lasvegasfortransit/platform-core/permissions';
interface Props {
  title: string;
  signIn?: boolean;
  printPage?: boolean;
  description?: string;
}
const { title, signIn = false, printPage = false, description } = Astro.props;
const staff = Astro.locals.staff;
const consoleVisible = staff && can(staff.actor, 'console.enter');
const home = staff && !consoleVisible ? '/paper/' : '/';
const signOutToken = staff ? await issueFormToken(staff.db, staff.actor, 'sign-out') : null;
const memberRecord = /^\/people\/[^/]+(?:\/(?:edit|delete))?\/?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{t('staff.navigation.pageTitle', { title })}</title>
  </head>
  <body class={printPage ? 'staff-print-sheet' : undefined}>
    <a href="#main" class="skip-link">{t('staff.navigation.skip')}</a>
    <div class="staff-shell">
      <header class="staff-header">
        <div class="container-page staff-header-inner">
          <a href={home} class="staff-identity" aria-label={t('staff.navigation.home')}>
            <picture class="staff-identity-mark">
              <source
                srcset="/brand/lvbt-logo-dark.svg"
                media="(prefers-color-scheme: dark)"
                type="image/svg+xml"
              />
              <img src="/brand/lvbt-logo.svg" width="32" height="32" alt="" />
            </picture>
            <span>{t('staff.navigation.staff')}</span>
          </a>
          {
            !signIn && consoleVisible && (
              <nav aria-label={t('staff.navigation.label')} class="staff-nav">
                <a
                  href="/people/"
                  aria-current={
                    [
                      '/people',
                      '/access',
                      '/administrators',
                      '/review',
                      '/export',
                      '/newsletter',
                      '/offboarding',
                    ].some((path) => Astro.url.pathname.startsWith(path))
                      ? 'page'
                      : undefined
                  }
                >
                  {t('staff.navigation.members')}
                </a>
                {staff && welcomeVisible(staff) && (
                  <a
                    href="/welcome/"
                    aria-current={Astro.url.pathname.startsWith('/welcome') ? 'page' : undefined}
                  >
                    {t('staff.navigation.welcome')}
                  </a>
                )}
                <a
                  href="/committees/"
                  aria-current={Astro.url.pathname.startsWith('/committees') ? 'page' : undefined}
                >
                  {t('staff.navigation.committees')}
                </a>
              </nav>
            )
          }
          {
            signOutToken && (
              <form method="post" action="/sign-out/" class="staff-sign-out">
                <input type="hidden" name="token" value={signOutToken} />
                <button type="submit" class="staff-secondary-button press">
                  {t('staff.navigation.signOut')}
                </button>
              </form>
            )
          }
        </div>
      </header>
      <main
        id="main"
        class:list={['container-page staff-main', memberRecord && 'staff-main-record']}
        tabindex="-1"
      >
        <slot name="breadcrumb" />
        <div class="staff-page-heading">
          <div class="staff-heading-copy">
            <h1>{title}</h1>
            {description && <p>{description}</p>}
          </div>
          <slot name="heading-meta" />
        </div>
        <slot />
      </main>
    </div>
    {
      signIn && (
        <footer class="container-page py-8 text-body-sm">
          {t('staff.navigation.organization')}
        </footer>
      )
    }
  </body>
</html>
