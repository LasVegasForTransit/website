---
import { env } from 'cloudflare:workers';
import { workspaceEnrollment } from '@lasvegasfortransit/platform-storage/workspace-enrollment';
import { safeNext } from '@lasvegasfortransit/platform-core/web-auth';
import StaffGateLayout from '@lasvegasfortransit/platform-core/staff-gate-layout';
import StaffAccount from '../../components/StaffAccount.astro';
import { readStaffSession } from '../../lib/staff-session';
import { staffReturnPath } from '../../lib/sign-in-return';
import type { StaffEnv } from '../../lib/context';
const session = await readStaffSession(
  env as unknown as StaffEnv,
  Astro.request,
  Astro.locals.access,
);
if (!session) return Astro.redirect('/sign-in/', 303);
const next = safeNext(Astro.url.searchParams.get('next'));
if (
  (env as unknown as StaffEnv).LVBT_STAFF_DISCORD_REQUIRED === 'true' ||
  (await workspaceEnrollment((env as unknown as StaffEnv).PLATFORM_DB, session.personId))
)
  return Astro.redirect(`/onboarding/?next=${encodeURIComponent(next)}`, 303);
const title = session.person.givenName
  ? `Welcome, ${session.person.givenName}`
  : 'Your account is ready';
---

<StaffGateLayout title={title}>
  <p>Your account is ready. Continue to the tools for your LVBT work.</p>
  <StaffAccount email={session.email} />
  <a class="staff-action-link" href={staffReturnPath(next)}>Continue</a>
</StaffGateLayout>
