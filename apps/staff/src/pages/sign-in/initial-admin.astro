---
import { env } from 'cloudflare:workers';
import StaffGateLayout from '../../layouts/StaffGateLayout.astro';
import type { StaffEnv } from '../../lib/context';
import { bootstrapInitialStaffAdmin, getInitialStaffAdminState } from '../../lib/initial-admin';

const staffEnv = env as unknown as StaffEnv;
const access = Astro.locals.access;

let state =
  Astro.request.method === 'POST'
    ? await bootstrapInitialStaffAdmin(staffEnv, Astro.request, access)
    : await getInitialStaffAdminState(staffEnv, Astro.request, access);

if (state.kind === 'ok' || state.kind === 'already_initialized') return Astro.redirect('/', 303);
if (state.kind === 'needs_sign_in')
  return Astro.redirect(`/sign-in/?next=${encodeURIComponent('/sign-in/initial-admin/')}`);

Astro.response.status =
  state.kind === 'ready'
    ? 200
    : state.kind === 'not_authorized'
      ? 403
      : state.kind === 'invalid_request'
        ? 400
        : 503;
---

<StaffGateLayout title="Set up staff access">
  {
    state.kind === 'ready' ? (
      <>
        <p>
          This gives your LVBT account administrator access to Staff. You’ll be able to manage
          member records and other administrators.
        </p>
        <form method="post" action="/sign-in/initial-admin/">
          <button class="staff-action-link" type="submit">
            Set up staff access
          </button>
        </form>
      </>
    ) : state.kind === 'not_authorized' ? (
      <p class="staff-gate-notice" role="alert">
        You don't have access to this.
      </p>
    ) : state.kind === 'invalid_request' ? (
      <p class="staff-gate-notice" role="alert">
        Reload this page and try again.
      </p>
    ) : state.kind === 'unconfigured' ? (
      <p class="staff-gate-notice" role="alert">
        Staff setup is not ready yet. Ask the LVBT president for help.
      </p>
    ) : (
      <p class="staff-gate-notice" role="alert">
        Staff setup is unavailable right now. Please try again later.
      </p>
    )
  }
  {
    state.kind !== 'ready' && (
      <a class="staff-secondary-button" href="/sign-in/">
        Back to sign in
      </a>
    )
  }
</StaffGateLayout>
