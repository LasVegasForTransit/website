---
import StaffLayout from '../../layouts/StaffLayout.astro';
import Button from '../../../../site/src/components/app/Button.astro';
import AccountAccessRow from '../../components/AccountAccessRow.astro';
import MemberAccess from '../../components/MemberAccess.astro';
import AccessHistory from '../../components/AccessHistory.astro';
import CommitteeAccessOverview from '../../components/CommitteeAccessOverview.astro';
import DiscordAccessChanges from '../../components/DiscordAccessChanges.astro';
import { listCommitteeAccessOverview } from '@lasvegasfortransit/platform-storage/committee-access';
import { listAccessChanges } from '@lasvegasfortransit/platform-storage/access-audit';
import GoogleGroupOverview from '../../components/GoogleGroupOverview.astro';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { listGoogleGroupOverview } from '@lasvegasfortransit/platform-storage/google-group-overview';
import { listAccess, accessHistory } from '@lasvegasfortransit/platform-storage/access-view';
import {
  listDiscordRoleReviews,
  InvalidDiscordRosterCursor,
} from '@lasvegasfortransit/platform-storage/discord-roster';
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import { InvalidCursor } from '@lasvegasfortransit/platform-storage/staff-history';
import { PermissionDenied } from '@lasvegasfortransit/platform-core/permissions';
import { submitAccessAction, type AccessFeedback } from '../../lib/account-access';
import { visibleCommittees, MEMBERSHIP_LABELS } from '../../lib/people';
import { messageResponse } from '../../lib/responses';
const staff = Astro.locals.staff;
if (!staff) return messageResponse(t('staff.common.accessDenied'), 403);
const personId = Astro.url.searchParams.get('person') ?? undefined;
if (personId && Astro.request.method === 'GET') {
  const query = new URLSearchParams();
  const historyCursor = Astro.url.searchParams.get('history_cursor');
  const accessCursor = Astro.url.searchParams.get('cursor');
  if (historyCursor) query.set('history_cursor', historyCursor);
  if (accessCursor) query.set('access_cursor', accessCursor);
  return Astro.redirect(
    `/people/${encodeURIComponent(personId)}/${query.size ? `?${query}` : ''}#accounts`,
    303,
  );
}
if (!can(staff.actor, 'staff_admin.manage'))
  return messageResponse(t('staff.common.accessDenied'), 403);
let feedback: AccessFeedback | undefined;
if (Astro.request.method === 'POST') {
  const result = await submitAccessAction(Astro.request, staff);
  if (result instanceof Response) return result;
  feedback = result;
  Astro.response.status = result.status;
}
const committeeId = Astro.url.searchParams.get('committee') ?? undefined;
const text = Astro.url.searchParams.get('q') ?? '';
const needsAttention =
  !personId && !committeeId && !text && Astro.url.searchParams.get('view') !== 'all';
let page, history, discordReviews, memberAccess, googleOverview, committeeOverview, corrections;
try {
  if (!personId && !committeeId && !text && can(staff.actor, 'staff_admin.manage')) {
    const configuration = staff.googleGroups ?? {
      provider: { configured: false, contextId: '' },
      consoleGroupEmail: null,
    };
    const now = new Date();
    committeeOverview = await listCommitteeAccessOverview(staff.db, staff.actor, {
      configuration: staff.accessConfiguration ?? {},
      consoleGroupEmail: configuration.consoleGroupEmail,
      now,
      cursor: Astro.url.searchParams.get('committee_cursor') ?? undefined,
      includeUnmapped: Astro.url.searchParams.get('committees') === 'all',
    });
    corrections = await listAccessChanges(staff.db, staff.actor, {
      system: 'discord',
      since: new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000),
      now,
      cursor: Astro.url.searchParams.get('correction_cursor') ?? undefined,
    });
    googleOverview = await listGoogleGroupOverview(staff.db, staff.actor, {
      configuration: configuration.provider,
      consoleGroupEmail: configuration.consoleGroupEmail,
      now: new Date(),
      problemsOnly: Astro.url.searchParams.get('groups') !== 'all',
      cursor: Astro.url.searchParams.get('group_cursor') ?? undefined,
    });
  }
  page = await listAccess(staff.db, staff.actor, {
    personId,
    target: personId ? 'committee' : undefined,
    committeeId,
    text,
    needsAttention,
    cursor: Astro.url.searchParams.get('cursor') ?? undefined,
    configuration: staff.accessConfiguration ?? {},
  });
  if (personId)
    memberAccess = (
      await listAccess(staff.db, staff.actor, {
        personId,
        target: 'member',
        limit: 1,
        configuration: staff.accessConfiguration ?? {},
      })
    ).items[0];
  history = await accessHistory(staff.db, staff.actor, {
    personId,
    committeeId,
    cursor: Astro.url.searchParams.get('history_cursor') ?? undefined,
  });
  const discord = staff.accessConfiguration?.discord;
  if (needsAttention && discord?.configured && discord.contextId && discord.memberRoleId)
    discordReviews = await listDiscordRoleReviews(staff.db, staff.actor, {
      guildId: discord.contextId,
      memberRoleId: discord.memberRoleId,
      cursor: Astro.url.searchParams.get('review_cursor') ?? undefined,
    });
} catch (error) {
  if (error instanceof InvalidDiscordRosterCursor)
    return messageResponse(t('staff.access.invalidReviewLink'), 400);
  if (error instanceof InvalidCursor) return messageResponse(t('staff.access.invalidLink'), 400);
  if (error instanceof PermissionDenied) return messageResponse(error.message, 403);
  throw error;
}
const selectedPerson = memberAccess;
if (personId && !selectedPerson) return messageResponse(t('staff.common.accessDenied'), 404);
const committees = personId ? [] : await visibleCommittees(staff.db, staff.actor);
const next = new URL(Astro.url);
if (page.nextCursor) next.searchParams.set('cursor', page.nextCursor);
const reviewNext = new URL(Astro.url);
if (discordReviews?.nextCursor)
  reviewNext.searchParams.set('review_cursor', discordReviews.nextCursor);
---

<StaffLayout
  title={selectedPerson?.name ?? t('staff.access.title')}
  description={selectedPerson ? t('staff.access.accountTitle') : t('staff.access.description')}
>
  <a slot="breadcrumb" href={personId ? `/people/${personId}/` : '/people/'} class="staff-back"
    >{personId ? t('staff.navigation.backProfile') : t('staff.navigation.backMembers')}</a
  >
  {
    selectedPerson && (
      <span slot="heading-meta" class="staff-membership-badge">
        {MEMBERSHIP_LABELS[selectedPerson.membershipStatus]}
      </span>
    )
  }
  {
    feedback && (
      <p role="alert" class="staff-error">
        {feedback.message}
      </p>
    )
  }
  {committeeOverview && <CommitteeAccessOverview page={committeeOverview} />}
  {googleOverview && <GoogleGroupOverview page={googleOverview} showGroups={false} />}
  {
    discordReviews && (
      <section class="staff-discord-review" aria-labelledby="discord-review-heading">
        <h2 id="discord-review-heading">{t('staff.access.reviewHeading')}</h2>
        <p>{t('staff.access.reviewHint')}</p>
        {discordReviews.items.length ? (
          <ul class="staff-discord-review-list">
            {discordReviews.items.map((review, index) => {
              const accountName =
                review.nickname ||
                review.displayName ||
                review.username ||
                t('staff.access.reviewNameUnavailable');
              const profileLabel = review.username
                ? t('staff.access.openDiscordLabel', { name: `@${review.username}` })
                : t('staff.access.openDiscordUnknownLabel', { number: String(index + 1) });
              return (
                <li>
                  <div>
                    <strong>{accountName}</strong>
                    {review.username && <p class="staff-help">@{review.username}</p>}
                    <p>{review.roles.map((role) => role.label).join(', ')}</p>
                    <p class="staff-help staff-discord-review-meta">
                      <span>
                        {t('staff.access.reviewAdded', {
                          date: formatFullDate(new Date(review.firstSeenAt)),
                        })}
                      </span>
                    </p>
                  </div>
                  <a
                    class="staff-action-link"
                    aria-label={profileLabel}
                    href={`https://discord.com/users/${review.discordUserId}`}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {t('staff.access.openDiscord')}
                  </a>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="staff-help">{t('staff.access.reviewNone')}</p>
        )}
        {discordReviews.nextCursor && (
          <a href={reviewNext.pathname + reviewNext.search} class="staff-next">
            {t('staff.access.reviewMore')}
          </a>
        )}
      </section>
    )
  }
  {
    !personId && (
      <form
        method="get"
        action="/access/"
        class="staff-search"
        role="search"
        aria-label={t('staff.access.findMember')}
      >
        <div class="staff-search-row">
          <>
            <div class="staff-search-query">
              <>
                <label for="q">{t('staff.access.nameOrEmail')}</label>
                <input id="q" name="q" type="search" value={text} maxlength="254" />
              </>
            </div>
            <Button>{t('staff.access.search')}</Button>
          </>
        </div>
        <details class="staff-search-filters" open={Boolean(committeeId)}>
          <>
            <summary>{t('staff.access.committeeFilter')}</summary>
            <div class="staff-filter-row">
              <div>
                <>
                  <label for="committee">{t('staff.common.committee')}</label>
                  <select id="committee" name="committee">
                    <option value="">{t('staff.access.allCommittees')}</option>
                    {committees.map((item) => (
                      <option value={item.id} selected={committeeId === item.id}>
                        {item.name}
                      </option>
                    ))}
                  </select>
                </>
              </div>
            </div>
          </>
        </details>
        <input type="hidden" name="view" value="all" />
      </form>
    )
  }
  {
    !personId && !committeeId && !text && (
      <nav class="staff-access-views" aria-label={t('staff.access.views')}>
        <a href="/access/" aria-current={needsAttention ? 'page' : undefined}>
          {t('staff.access.retries')}
        </a>
        <a href="/access/?view=all" aria-current={!needsAttention ? 'page' : undefined}>
          {t('staff.access.all')}
        </a>
      </nav>
    )
  }
  {
    memberAccess ? (
      <MemberAccess member={memberAccess} committees={page.items} />
    ) : page.items.length ? (
      <ul class="staff-account-list" aria-label={t('staff.access.title')}>
        {page.items.map((row) => (
          <AccountAccessRow row={row} />
        ))}
      </ul>
    ) : (
      <p>{needsAttention ? t('staff.access.noneToRetry') : t('staff.access.noResults')}</p>
    )
  }
  {
    page.nextCursor && (
      <a href={next.pathname + next.search} class="staff-next">
        {t('staff.access.next')}
      </a>
    )
  }
  {corrections && <DiscordAccessChanges page={corrections} />}
  <AccessHistory
    page={history}
    personId={personId}
    title={personId ? t('staff.access.history') : t('staff.history.recent')}
  />
</StaffLayout>
