---
import { t } from '@lasvegasfortransit/platform-core/messages';
import StaffLayout from '../../layouts/StaffLayout.astro';
import Button from '../../../../site/src/components/app/Button.astro';
import RosterMember from '../../components/RosterMember.astro';
import { searchStaffPeople } from '@lasvegasfortransit/platform-storage/staff-people';
import { InvalidCursor } from '@lasvegasfortransit/platform-storage/staff-history';
import { PermissionDenied } from '@lasvegasfortransit/platform-core/permissions';
import type { Page } from '@lasvegasfortransit/platform-core/staff-types';
import type { Person } from '@lasvegasfortransit/platform-storage/person-service';
import {
  PeopleQueryError,
  allMembershipsLink,
  MEMBERSHIP_LABELS,
  pageLink,
  peopleQuery,
  peopleStatus,
  visibleCommittees,
} from '../../lib/people';
import { messageResponse } from '../../lib/responses';
import { rosterDetails } from '@lasvegasfortransit/platform-storage/roster-details';
import { can } from '@lasvegasfortransit/platform-core/permissions';
const staff = Astro.locals.staff;
if (!staff) return messageResponse(t('staff.common.accessDenied'), 403);
const committees = await visibleCommittees(staff.db, staff.actor);
let page: Page<Person> = { items: [], nextCursor: null };
let error: string | null = null;
try {
  page = await searchStaffPeople(staff.db, staff.actor, peopleQuery(Astro.url));
} catch (cause) {
  if (cause instanceof PermissionDenied) return messageResponse(cause.message, 403);
  if (cause instanceof InvalidCursor || cause instanceof PeopleQueryError) {
    error = cause instanceof InvalidCursor ? t('staff.people.invalidLink') : cause.message;
    Astro.response.status = 400;
  } else throw cause;
}
const status = peopleStatus(Astro.url);
const showMembership = status !== 'member';
const searchStatus = status;
const unassigned = Astro.url.searchParams.get('committee') === 'unassigned';
const details = await rosterDetails(
  staff.db,
  staff.actor,
  page.items.map((person) => person.id),
  { configuration: staff.accessConfiguration ?? {}, includeActivity: true },
);
const showDiscord = staff.accessConfiguration?.discord?.configured ?? false;
const acceptingCommitteeIds = committees
  .filter((item) => item.acceptingMembers)
  .map((item) => item.id);
const hasMemberTasks =
  can(staff.actor, 'attendance.record') ||
  can(staff.actor, 'review_queue.resolve') ||
  can(staff.actor, 'staff_admin.manage') ||
  can(staff.actor, 'export.full');
---

<StaffLayout
  title={unassigned ? t('staff.people.unassignedTitle') : t('staff.people.title')}
  description={unassigned
    ? t('staff.people.unassignedIntro')
    : staff.actor.staffAdmin
      ? t('staff.people.adminIntro')
      : t('staff.people.leadIntro')}
>
  {
    error && (
      <p role="alert" class="staff-error">
        {error} <a href="/people/">{t('staff.people.clearFilters')}</a>
      </p>
    )
  }
  <form
    method="get"
    action="/people/"
    class="staff-search"
    role="search"
    aria-label={t('staff.people.find')}
  >
    <div class="staff-search-row">
      <div class="staff-search-query">
        <label for="q">{t('staff.people.nameOrEmail')}</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder={t('staff.people.placeholder')}
          value={Astro.url.searchParams.get('q') ?? Astro.url.searchParams.get('email') ?? ''}
          maxlength="254"
        />
      </div>
      <Button name="intent" value="search">{t('staff.people.search')}</Button>
    </div>
    <details
      class="staff-search-filters"
      open={Boolean(
        Astro.url.searchParams.has('zip') ||
        Astro.url.searchParams.has('email') ||
        Astro.url.searchParams.has('committee') ||
        (Astro.url.searchParams.has('status') && Astro.url.searchParams.get('intent') !== 'search'),
      )}
    >
      <summary>{t('staff.people.filters')}</summary>
      <div class="staff-filter-row">
        <div>
          <label for="status">{t('staff.common.membership')}</label>
          <select id="status" name="status">
            {
              Object.entries(MEMBERSHIP_LABELS).map(([value, label]) => (
                <option value={value} selected={searchStatus === value}>
                  {label}
                </option>
              ))
            }
            <option value="all" selected={searchStatus === 'all'}
              >{t('staff.people.everyone')}</option
            >
          </select>
        </div>
        <div>
          <label for="committee">{t('staff.common.committee')}</label>
          <select id="committee" name="committee">
            <option value="">{t('staff.people.all')}</option>
            {
              staff.actor.staffAdmin && (
                <option
                  value="unassigned"
                  selected={Astro.url.searchParams.get('committee') === 'unassigned'}
                >
                  {t('staff.people.unassigned')}
                </option>
              )
            }
            {
              committees.map((committee) => (
                <option
                  value={committee.id}
                  selected={Astro.url.searchParams.get('committee') === committee.id}
                >
                  {committee.name}
                </option>
              ))
            }
          </select>
        </div>
        <div class="staff-zip">
          <label for="zip">{t('staff.common.zip')}</label>
          <input
            id="zip"
            name="zip"
            inputmode="numeric"
            maxlength="5"
            value={Astro.url.searchParams.get('zip') ?? ''}
            aria-invalid={error === t('staff.people.invalidZip') ? 'true' : undefined}
          />
        </div>
      </div>
      <Button name="intent" value="filters">{t('staff.people.applyFilters')}</Button>
    </details>
    {
      Astro.url.search && (
        <div class="staff-search-options">
          <a href="/people/" class="staff-muted-link">
            {t('staff.people.clearFilters')}
          </a>
        </div>
      )
    }
  </form>
  {
    hasMemberTasks && (
      <details class="staff-member-tasks">
        <summary>{t('staff.people.records')}</summary>
        <nav aria-label={t('staff.people.recordTasks')}>
          <ul>
            {can(staff.actor, 'attendance.record') && (
              <li>
                <a href="/paper/">{t('staff.people.paperSignups')}</a>
              </li>
            )}
            {can(staff.actor, 'review_queue.resolve') && (
              <li>
                <a href="/review/">{t('staff.people.duplicates')}</a>
              </li>
            )}
            {staff.actor.staffAdmin && (
              <li>
                <a href="/newsletter/">Newsletter follow-up</a>
              </li>
            )}
            {staff.actor.staffAdmin && (
              <li>
                <a href="/offboarding/">Google accounts to review</a>
              </li>
            )}
            {can(staff.actor, 'staff_admin.manage') && (
              <li>
                <a href="/access/">{t('staff.people.checkAccess')}</a>
              </li>
            )}
            {can(staff.actor, 'export.full') && (
              <li>
                <a href="/export/">{t('staff.people.downloadRecords')}</a>
              </li>
            )}
          </ul>
        </nav>
      </details>
    )
  }
  {
    !error &&
      (page.items.length ? (
        <section aria-label={t('staff.people.results')} class="staff-roster-results">
          <div class="staff-results-meta">
            <p>
              {status === 'member'
                ? page.nextCursor
                  ? t('staff.people.showingMembersOnPage', { count: page.items.length })
                  : t('staff.people.showingMembers', { count: page.items.length })
                : page.nextCursor
                  ? t('staff.people.showingPeopleOnPage', { count: page.items.length })
                  : t('staff.people.showingPeople', { count: page.items.length })}
            </p>
          </div>
          <table class="staff-roster">
            <caption class="sr-only">
              {status === 'member' ? t('staff.people.title') : t('staff.people.people')}
            </caption>
            <thead>
              <tr>
                <th scope="col">{t('staff.common.member')}</th>
                {(showMembership || showDiscord) && (
                  <th scope="col">
                    {showMembership && showDiscord
                      ? t('staff.people.membershipDiscord')
                      : showDiscord
                        ? t('staff.common.discord')
                        : t('staff.common.membership')}
                  </th>
                )}
                <th scope="col">{t('staff.common.committees')}</th>
              </tr>
            </thead>
            <tbody>
              {page.items.map((person) => (
                <RosterMember
                  person={person}
                  details={details.get(person.id)}
                  showMembership={showMembership}
                  showDiscord={showDiscord}
                  canAddToAnotherCommittee={
                    person.membership_status === 'member' &&
                    acceptingCommitteeIds.some(
                      (committeeId) =>
                        !details.get(person.id)?.committees.some((item) => item.id === committeeId),
                    )
                  }
                />
              ))}
            </tbody>
          </table>
          {page.nextCursor && (
            <a href={pageLink(Astro.url, page.nextCursor)} class="staff-next">
              {status === 'member' ? t('staff.people.moreMembers') : t('staff.people.morePeople')}{' '}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </section>
      ) : (
        <div class="staff-empty">
          <>
            <h2>{t('staff.people.noMatches')}</h2>
            <p>{t('staff.people.noMatchesHelp')}</p>
            {status !== 'all' && (
              <a href={allMembershipsLink(Astro.url)}>{t('staff.people.includeFormer')}</a>
            )}
          </>
        </div>
      ))
  }
</StaffLayout>
