---
import StaffLayout from '../../../layouts/StaffLayout.astro';
import { getStaffPerson } from '@lasvegasfortransit/platform-storage/staff-people';
import { InvalidCursor } from '@lasvegasfortransit/platform-storage/staff-history';
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import { personName } from '../../../lib/people';
import { formatPhone } from '@lasvegasfortransit/platform-core/join-form';
import { regionName } from '@lasvegasfortransit/platform-core/regions';
import { languageLabel } from '../../../lib/presentation';
import { personMerges } from '@lasvegasfortransit/platform-storage/merge-views';
import { listAccess, accessHistory } from '@lasvegasfortransit/platform-storage/access-view';
import AccessHistory from '../../../components/AccessHistory.astro';
import PersonCommittees from '../../../components/PersonCommittees.astro';
import PersonRecord from '../../../components/PersonRecord.astro';
import PersonSummary from '../../../components/PersonSummary.astro';
import MemberAccess from '../../../components/MemberAccess.astro';
import { submitAccessAction, type AccessFeedback } from '../../../lib/account-access';
import { submitCommittee, type CommitteeFeedback } from '../../../lib/committees';
import { messageResponse } from '../../../lib/responses';
import { can, PermissionDenied } from '@lasvegasfortransit/platform-core/permissions';
import { rosterReturn } from '../../../lib/roster-return';
const staff = Astro.locals.staff;
if (!staff) return messageResponse(t('staff.common.accessDenied'), 403);
const returnTo = rosterReturn(Astro.url.searchParams.get('return_to'));
const returnQuery = returnTo ? `?return_to=${encodeURIComponent(returnTo)}` : '';
let profile;
try {
  profile = await getStaffPerson(staff.db, staff.actor, Astro.params.id ?? '', {
    cursor: Astro.url.searchParams.get('cursor') ?? undefined,
    mergedFrom: Astro.url.searchParams.get('combined_from') ?? undefined,
  });
} catch (error) {
  if (error instanceof InvalidCursor) return messageResponse(t('staff.people.invalidLink'), 400);
  throw error;
}
if (!profile) return messageResponse(t('staff.common.accessDenied'), 404);
if (profile.person.id !== Astro.params.id) {
  const context = new URLSearchParams({ combined_from: Astro.params.id ?? '' });
  if (returnTo) context.set('return_to', returnTo);
  return Astro.redirect(`/people/${profile.person.id}/?${context}`, 303);
}
let feedback: CommitteeFeedback | undefined;
let accessFeedback: AccessFeedback | undefined;
if (Astro.request.method === 'POST') {
  const action = (await Astro.request.clone().formData()).get('action');
  if (action === 'retry' || action === 'remove') {
    const result = await submitAccessAction(Astro.request, staff);
    if (result instanceof Response) return result;
    accessFeedback = result;
    Astro.response.status = result.status;
  } else {
    const result = await submitCommittee(Astro.request, staff, profile);
    if (result instanceof Response) return result;
    feedback = result;
    Astro.response.status = result.status;
  }
}
const { person } = profile;
const discordConnected = profile.identities.some((identity) => identity.platform === 'discord');
let accountAccess, server;
try {
  accountAccess = await listAccess(staff.db, staff.actor, {
    personId: person.id,
    target: 'committee',
    cursor: Astro.url.searchParams.get('access_cursor') ?? undefined,
    configuration: staff.accessConfiguration ?? {},
  });
  server = (
    await listAccess(staff.db, staff.actor, {
      personId: person.id,
      target: 'member',
      limit: 1,
      configuration: staff.accessConfiguration ?? {},
    })
  ).items[0];
} catch (error) {
  if (error instanceof InvalidCursor) return messageResponse(t('staff.people.invalidLink'), 400);
  if (error instanceof PermissionDenied)
    return messageResponse(t('staff.common.accessDenied'), 403);
  throw error;
}
const nextAccess = new URL(Astro.url);
if (accountAccess.nextCursor)
  nextAccess.searchParams.set('access_cursor', accountAccess.nextCursor);
const combinations = await personMerges(staff.db, staff.actor, person.id);
let providerHistory;
if (can(staff.actor, 'access.recover')) {
  try {
    providerHistory = await accessHistory(staff.db, staff.actor, {
      personId: person.id,
      administratorsOnly: true,
      cursor: Astro.url.searchParams.get('history_cursor') ?? undefined,
    });
  } catch (error) {
    if (error instanceof InvalidCursor) return messageResponse(t('staff.people.invalidLink'), 400);
    if (error instanceof PermissionDenied)
      return messageResponse(t('staff.common.accessDenied'), 403);
    throw error;
  }
}
---

<StaffLayout title={personName(person)}>
  <a slot="breadcrumb" href={returnTo ?? '/people/'} class="staff-back"
    >{t('staff.navigation.backMembers')}</a
  >
  <div slot="heading-meta" class="staff-profile-actions">
    {
      can(staff.actor, 'person.update') && (
        <a href={`/people/${person.id}/edit/${returnQuery}`} class="staff-edit-link">
          {t('staff.profile.edit')}
        </a>
      )
    }
    {
      can(staff.actor, 'export.full') && (
        <a href={`/people/${person.id}/data/`} class="staff-edit-link">
          {t('staff.profile.downloadRecord')}
        </a>
      )
    }
  </div>
  {
    profile.mergeNotice && (
      <p role="status" class="staff-record-notice">
        {t('staff.profile.combinedNotice', {
          date: formatFullDate(new Date(profile.mergeNotice.mergedAt)),
        })}
      </p>
    )
  }
  <div class="staff-member-profile">
    <PersonSummary profile={profile} />
    <div class="staff-profile">
      <section aria-labelledby="contact-heading">
        <h2 id="contact-heading">{t('staff.profile.contact')}</h2>
        <dl class="staff-contact-details">
          <div>
            <dt>{t('staff.common.email')}</dt><dd>
              {
                person.email ? (
                  <>
                    <a href={`mailto:${person.email}`}>{person.email}</a>
                    {profile.emailVerified && (
                      <span class="staff-email-confirmed">{t('staff.profile.emailConfirmed')}</span>
                    )}
                  </>
                ) : (
                  t('staff.profile.noEmail')
                )
              }
            </dd>
          </div>
          {
            person.phone && (
              <div>
                <>
                  <dt>{t('staff.common.phone')}</dt>
                  <dd>
                    <a href={`tel:${person.phone}`}>{formatPhone(person.phone)}</a>
                  </dd>
                </>
              </div>
            )
          }
          {
            person.zip && (
              <div>
                <>
                  <dt>{t('staff.profile.location')}</dt>
                  <dd>
                    {person.zip}
                    {(regionName(person.region_id) ?? person.place_name) &&
                      ` · ${regionName(person.region_id) ?? person.place_name}`}
                  </dd>
                </>
              </div>
            )
          }
          {
            person.preferred_language !== 'en' && (
              <div>
                <>
                  <dt>{t('staff.profile.language')}</dt>
                  <dd>{languageLabel(person.preferred_language)}</dd>
                </>
              </div>
            )
          }
        </dl>
      </section>
      <div class="staff-profile-involvement">
        <PersonCommittees profile={profile} feedback={feedback} />
        {
          server && (
            <MemberAccess
              member={server}
              committees={accountAccess.items}
              discordConnected={discordConnected}
              feedback={accessFeedback}
              nextHref={
                accountAccess.nextCursor
                  ? nextAccess.pathname + nextAccess.search + '#accounts'
                  : undefined
              }
            />
          )
        }
      </div>
    </div>
    <div class="staff-profile-history">
      {
        providerHistory &&
          (providerHistory.items.length > 0 || Astro.url.searchParams.has('history_cursor')) && (
            <AccessHistory
              page={providerHistory}
              personId={person.id}
              title={t('staff.profile.accessHistory')}
            />
          )
      }
      <PersonRecord profile={profile} />
    </div>
    {
      combinations.length > 0 && (
        <details class="mb-6 text-body-sm">
          <summary>{t('staff.profile.combinedEntries', { count: combinations.length })}</summary>
          <ul class="mt-3 space-y-3">
            {combinations.map((item) => (
              <li>
                <a href={`/review/combined/${item.id}/`}>{item.mergedName}</a> ·{' '}
                {formatFullDate(new Date(item.mergedAt))}
                {item.erasedAt
                  ? ` · ${t('staff.profile.detailsErased')}`
                  : item.undoneAt
                    ? ` · ${t('staff.profile.undone')}`
                    : ''}
              </li>
            ))}
          </ul>
        </details>
      )
    }
  </div>
</StaffLayout>
