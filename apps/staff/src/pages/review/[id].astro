---
import StaffLayout from '../../layouts/StaffLayout.astro';
import ReviewPerson from '../../components/ReviewPerson.astro';
import Button from '../../../../site/src/components/app/Button.astro';
import { reviewItem } from '@lasvegasfortransit/platform-storage/reviews';
import { issueFormToken } from '@lasvegasfortransit/platform-storage/form-tokens';
import { ulid } from '@lasvegasfortransit/platform-core/ids';
import { formatDate, t } from '@lasvegasfortransit/platform-core/messages';
import { reviewReason, separateAction, submittedEmail } from '../../lib/reviews';
import { combineAction, type MergeFailure } from '../../lib/merges';
import { messageResponse } from '../../lib/responses';
const staff = Astro.locals.staff;
if (!staff) return messageResponse(t('staff.common.accessDenied'), 403);
const id = Astro.params.id ?? '';
const item = await reviewItem(staff.db, staff.actor, id);
if (!item) return messageResponse(t('staff.common.accessDenied'), 404);
let failure: MergeFailure | undefined;
if (Astro.request.method === 'POST') {
  if (Astro.url.searchParams.get('decision') !== 'combine')
    return separateAction(Astro.request, staff, id);
  const result = await combineAction(Astro.request, staff, item);
  if (result instanceof Response) return result;
  failure = result;
  Astro.response.status = 409;
}
const token = !item.resolvedAt
  ? await issueFormToken(staff.db, staff.actor, `review:separate:${id}`)
  : null;
const combineToken = !item.resolvedAt
  ? await issueFormToken(staff.db, staff.actor, `review:combine:${id}`)
  : null;
const email = submittedEmail(item.details);
---

<StaffLayout title={t('staff.review.detailTitle')} description={reviewReason(item.reason)}>
  <a slot="breadcrumb" href="/review/" class="staff-back">{t('staff.review.back')}</a>
  {
    email && (
      <p class="mb-5 text-body-sm [overflow-wrap:anywhere]">
        {t('staff.review.submittedEmail', { email })}
      </p>
    )
  }
  <div class="staff-review-comparison">
    <ReviewPerson profile={item.candidate} label={t('staff.review.newEntry')} />
    <ReviewPerson profile={item.existing} label={t('staff.review.existingEntry')} />
  </div>
  {
    failure && (
      <p role="alert" class="staff-error mt-4">
        {failure.error}
      </p>
    )
  }
  {
    item.resolvedAt ? (
      <div class="staff-review-decision">
        <>
          <h2 class="font-bold">
            {item.resolution === 'kept_separate'
              ? t('staff.review.keptSeparate')
              : t('staff.review.completed')}
          </h2>
          <p class="staff-help">
            {t('staff.review.reviewedAt', { date: formatDate(new Date(item.resolvedAt)) })}
          </p>
          <a class="staff-next" href="/review/">
            {t('staff.review.backToList')}
          </a>
        </>
      </div>
    ) : (
      <>
        <section class="staff-review-decision" aria-labelledby="separate-heading">
          <h2 id="separate-heading" class="font-bold">
            {t('staff.review.separateHeading')}
          </h2>
          <p class="staff-help">{t('staff.review.separateHint')}</p>
          <form method="post" action={`/review/${id}/`} class="staff-form max-w-2xl">
            <input type="hidden" name="token" value={token} />
            <input type="hidden" name="operation_id" value={ulid()} />
            <div>
              <>
                <label for="note">
                  {t('staff.record.note')}{' '}
                  <span class="staff-optional">{t('staff.review.optional')}</span>
                </label>
                <textarea id="note" name="note" maxlength="2000" rows="2" />
              </>
            </div>
            <Button variant="secondary">{t('staff.review.separate')}</Button>
          </form>
        </section>
        <details class="staff-review-decision staff-combine-options" open={Boolean(failure)}>
          <summary>{t('staff.review.combineHeading')}</summary>
          <p class="staff-help">{t('staff.merge.keepsOlder')}</p>
          <form
            method="post"
            action={`/review/${id}/?decision=combine`}
            class="staff-form max-w-2xl"
          >
            <>
              <input type="hidden" name="token" value={combineToken} />
              <input type="hidden" name="operation_id" value={ulid()} />
            </>
            <div>
              <>
                <label for="combine-reason">{t('staff.review.combineReason')}</label>
                <textarea id="combine-reason" name="reason" maxlength="2000" rows="2" required>
                  {failure?.reason ?? ''}
                </textarea>
              </>
            </div>
            <Button>{t('staff.review.combine')}</Button>
          </form>
        </details>
      </>
    )
  }
</StaffLayout>
