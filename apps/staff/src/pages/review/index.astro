---
import { t } from '@lasvegasfortransit/platform-core/messages';
import StaffLayout from '../../layouts/StaffLayout.astro';
import { listReviews, type ReviewRow } from '@lasvegasfortransit/platform-storage/reviews';
import type { Page } from '@lasvegasfortransit/platform-core/staff-types';
import { InvalidCursor } from '@lasvegasfortransit/platform-storage/staff-history';
import { PermissionDenied } from '@lasvegasfortransit/platform-core/permissions';
import { reviewReason } from '../../lib/reviews';
import { messageResponse } from '../../lib/responses';
const staff = Astro.locals.staff;
if (!staff) return messageResponse(t('staff.common.accessDenied'), 403);
let page: Page<ReviewRow> = { items: [], nextCursor: null };
let error: string | undefined;
try {
  page = await listReviews(staff.db, staff.actor, {
    cursor: Astro.url.searchParams.get('cursor') ?? undefined,
  });
} catch (cause) {
  if (cause instanceof PermissionDenied)
    return messageResponse(t('staff.common.accessDenied'), 403);
  if (!(cause instanceof InvalidCursor)) throw cause;
  error = t('staff.review.invalidLink');
  Astro.response.status = 400;
}
---

<StaffLayout title={t('staff.review.title')} description={t('staff.review.description')}>
  {
    error && (
      <p role="alert">
        {error} <a href="/review/">{t('staff.review.startAgain')}</a>
      </p>
    )
  }
  {
    !error &&
      (page.items.length ? (
        <ul class="staff-review-list" aria-label={t('staff.review.list')}>
          {page.items.map((item) => (
            <li>
              <a href={`/review/${item.id}/`} class="staff-person-link">
                {item.candidateName} <span aria-hidden="true">↔</span> {item.existingName}
              </a>
              <p>{reviewReason(item.reason)}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="staff-empty">
          <>
            <h2>{t('staff.review.empty')}</h2>
            <p>{t('staff.review.emptyHint')}</p>
          </>
        </div>
      ))
  }
  {
    page.nextCursor && (
      <a class="staff-next" href={`/review/?cursor=${encodeURIComponent(page.nextCursor)}`}>
        {t('staff.review.next')}
      </a>
    )
  }
</StaffLayout>
