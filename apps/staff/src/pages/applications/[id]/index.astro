---
import StaffLayout from '../../../layouts/StaffLayout.astro';
import Button from '../../../../../site/src/components/app/Button.astro';
import { t } from '@lasvegasfortransit/platform-core/messages';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { ulid } from '@lasvegasfortransit/platform-core/ids';
import { issueFormToken } from '@lasvegasfortransit/platform-storage/form-tokens';
import { listCommittees } from '@lasvegasfortransit/platform-storage/committee-views';
import {
  CommitteeApplicationService,
  NOTE_LIMIT,
} from '@lasvegasfortransit/platform-storage/committee-applications';
import {
  applicantName,
  applicationTarget,
  applicationWaiting,
  applicationsVisible,
} from '../../../lib/applications';
import { messageResponse } from '../../../lib/responses';
const staff = Astro.locals.staff;
if (!staff || !applicationsVisible(staff))
  return messageResponse("You don't have access to this", 403);
const id = Astro.params.id ?? '';
const application = await new CommitteeApplicationService(staff.db).entry(staff.actor, id);
if (!application) return messageResponse("You don't have access to this", 404);
const waiting = application.state === 'submitted';
// Administrators can place an application on any team; a lead accepts onto the team applied to.
const committees = waiting
  ? (await listCommittees(staff.db, staff.actor)).filter((committee) =>
      can(staff.actor, 'committee.assign', { committeeId: committee.id }),
    )
  : [];
const acceptToken = waiting
  ? await issueFormToken(staff.db, staff.actor, `application:accept:${id}`)
  : null;
const declineToken = waiting
  ? await issueFormToken(staff.db, staff.actor, `application:decline:${id}`)
  : null;
const day = (iso: string | null) =>
  iso
    ? new Date(iso).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        timeZone: 'America/Los_Angeles',
      })
    : '';
---

<StaffLayout title={applicantName(application)}>
  <a slot="breadcrumb" href="/applications/" class="staff-back">{t('staff.applications.back')}</a>
  <div slot="heading-meta" class="staff-member-meta">
    <span>{applicationTarget(application)}</span>
    <span>{day(application.submittedAt)}</span>
    {
      waiting && (
        <span class={application.overdue ? 'text-primary-ink' : undefined}>
          {applicationWaiting(application)}
        </span>
      )
    }
  </div>
  <div class="space-y-8">
    <section class="staff-welcome-start" aria-labelledby="why-heading">
      <h2 id="why-heading">{t('staff.applications.why')}</h2>
      <p>{application.note || t('staff.applications.noNote')}</p>
      {
        application.availability && (
          <>
            <h2 class="mt-6">{t('staff.applications.availability')}</h2>
            <p>{application.availability}</p>
          </>
        )
      }
    </section>
    {
      !waiting && (
        <section class="staff-empty">
          <h2>
            {application.state === 'accepted'
              ? t('staff.applications.accepted', { name: application.decidedByName ?? '' })
              : application.state === 'declined'
                ? t('staff.applications.declined', { name: application.decidedByName ?? '' })
                : t('staff.applications.changed')}
          </h2>
          {application.decisionNote && <p>“{application.decisionNote}”</p>}
        </section>
      )
    }
    {
      waiting && (
        <div class="staff-welcome-workspace">
          <section class="staff-welcome-record" aria-labelledby="accept-heading">
            <h2 id="accept-heading">{t('staff.applications.acceptHeading')}</h2>
            <p>{t('staff.applications.acceptBody')}</p>
            <form method="post" action={`/applications/${id}/accept/`} class="staff-form">
              <input type="hidden" name="token" value={acceptToken} />
              <input type="hidden" name="operation_id" value={ulid()} />
              <div>
                <label for="committee_id">{t('staff.applications.committeeLabel')}</label>
                <select id="committee_id" name="committee_id" required>
                  {committees.map((committee) => (
                    <option
                      value={committee.id}
                      selected={committee.id === application.committeeId}
                    >
                      {committee.name}
                    </option>
                  ))}
                </select>
              </div>
              <div>
                <label for="welcome">{t('staff.applications.welcomeLabel')}</label>
                <textarea id="welcome" name="note" rows="3" maxlength={NOTE_LIMIT} />
              </div>
              <Button>{t('staff.applications.accept')}</Button>
            </form>
          </section>
          <section class="staff-welcome-record" aria-labelledby="decline-heading">
            <h2 id="decline-heading">{t('staff.applications.declineHeading')}</h2>
            <p>{t('staff.applications.declineBody')}</p>
            <form method="post" action={`/applications/${id}/decline/`} class="staff-form">
              <input type="hidden" name="token" value={declineToken} />
              <input type="hidden" name="operation_id" value={ulid()} />
              <div>
                <label for="decline-note">{t('staff.applications.declineLabel')}</label>
                <textarea id="decline-note" name="note" rows="3" maxlength={NOTE_LIMIT} />
              </div>
              <Button variant="secondary">{t('staff.applications.decline')}</Button>
            </form>
          </section>
        </div>
      )
    }
  </div>
</StaffLayout>
