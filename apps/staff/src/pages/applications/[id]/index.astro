---
// One application. The page shows what they sent, then Accept and Decline.
// Each decision is its own step (?step=accept or ?step=decline) with only the
// fields that decision needs, so the two are never on screen together.
import StaffLayout from '../../../layouts/StaffLayout.astro';
import Button from '../../../../../site/src/components/app/Button.astro';
import { t } from '@lasvegasfortransit/platform-core/messages';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { ulid } from '@lasvegasfortransit/platform-core/ids';
import { issueFormToken } from '@lasvegasfortransit/platform-storage/form-tokens';
import { listCommittees } from '@lasvegasfortransit/platform-storage/committee-views';
import {
  CommitteeApplicationService,
  NOTE_LIMIT,
} from '@lasvegasfortransit/platform-storage/committee-applications';
import {
  applicantName,
  applicationDay,
  applicationDecision,
  applicationTarget,
  applicationHours,
  applicationWaiting,
  applicationsVisible,
} from '../../../lib/applications';
import { messageResponse } from '../../../lib/responses';
const staff = Astro.locals.staff;
if (!staff || !applicationsVisible(staff))
  return messageResponse("You don't have access to this", 403);
const id = Astro.params.id ?? '';
const application = await new CommitteeApplicationService(staff.db).entry(staff.actor, id);
if (!application) return messageResponse("You don't have access to this", 404);
const waiting = application.state === 'submitted';
const requested = Astro.url.searchParams.get('step');
const step = waiting && (requested === 'accept' || requested === 'decline') ? requested : null;
const name = applicantName(application);
const hours = applicationHours(application);
const here = `/applications/${id}/`;
// A lead accepts onto the team applied to. An administrator can choose any
// team, and must choose one when the role has none yet.
const teams =
  step === 'accept'
    ? (await listCommittees(staff.db, staff.actor)).filter((committee) =>
        can(staff.actor, 'committee.assign', { committeeId: committee.id }),
      )
    : [];
const appliedTeam = teams.find((committee) => committee.id === application.committeeId);
const chooseTeam = step === 'accept' && (staff.actor.staffAdmin || !appliedTeam);
const token = step
  ? await issueFormToken(staff.db, staff.actor, `application:${step}:${id}`)
  : null;
---

<StaffLayout title={name}>
  <a slot="breadcrumb" href={step ? here : '/applications/'} class="staff-back">
    {step ? t('staff.applications.backToApplication') : t('staff.applications.back')}
  </a>
  <div slot="heading-meta" class="staff-member-meta">
    <span>{applicationTarget(application)}</span>
    {
      !waiting && (
        <span>
          {t('staff.applications.sent', { date: applicationDay(application.submittedAt) })}
        </span>
      )
    }
    {
      waiting && (
        <span class={application.overdue ? 'text-primary-ink' : undefined}>
          {applicationWaiting(application)}
          {application.overdue && ` · ${t('staff.applications.overdue')}`}
        </span>
      )
    }
  </div>
  <div class="space-y-8">
    <section class="staff-application-answers" aria-labelledby="why-heading">
      <h2 id="why-heading" class="font-bold">{t('staff.applications.why')}</h2>
      <p>{application.note || t('staff.applications.noNote')}</p>
      <h2 class="font-bold">{t('staff.applications.availability')}</h2>
      {
        hours.length > 0 && (
          <dl class="staff-application-hours">
            {hours.map((line) => (
              <div>
                <dt>{line.day}</dt>
                <dd>{line.hours}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {application.availability && <p>{application.availability}</p>}
      {!hours.length && !application.availability && <p>{t('staff.applications.noTimes')}</p>}
      {
        waiting && !step && (
          <div class="staff-application-actions">
            <a href={`${here}?step=accept`} class="staff-action-link">
              {t('staff.applications.accept')}
            </a>
            <a href={`${here}?step=decline`} class="staff-secondary-button">
              {t('staff.applications.decline')}
            </a>
          </div>
        )
      }
    </section>
    {
      !waiting && (
        <section class="staff-empty">
          <h2>{applicationDecision(application)}</h2>
          {application.decisionNote && <p>“{application.decisionNote}”</p>}
        </section>
      )
    }
    {
      step === 'accept' && (
        <section class="staff-application-step" aria-labelledby="step-heading">
          <h2 id="step-heading">{t('staff.applications.acceptHeading', { name })}</h2>
          <p>
            {chooseTeam
              ? t('staff.applications.acceptChooseTeam')
              : t('staff.applications.acceptOnto', { committee: appliedTeam?.name ?? '' })}
          </p>
          <form method="post" action={`${here}accept/`} class="staff-form">
            <input type="hidden" name="token" value={token} />
            <input type="hidden" name="operation_id" value={ulid()} />
            {chooseTeam ? (
              <div>
                <label for="committee_id">{t('staff.applications.committeeLabel')}</label>
                <select id="committee_id" name="committee_id" required>
                  {!appliedTeam && <option value="">{t('staff.applications.chooseTeam')}</option>}
                  {teams.map((committee) => (
                    <option value={committee.id} selected={committee.id === appliedTeam?.id}>
                      {committee.name}
                    </option>
                  ))}
                </select>
              </div>
            ) : (
              <input type="hidden" name="committee_id" value={appliedTeam?.id} />
            )}
            <div>
              <label for="welcome">{t('staff.applications.welcomeLabel')}</label>
              <textarea
                id="welcome"
                name="note"
                rows="5"
                maxlength={NOTE_LIMIT}
                aria-describedby="welcome-hint"
              />
              <p id="welcome-hint" class="staff-help">
                {t('staff.applications.welcomeHint')}
              </p>
            </div>
            <div class="staff-application-actions">
              <Button>{t('staff.applications.confirmAccept')}</Button>
              <a href={here} class="staff-secondary-button">
                {t('staff.applications.cancel')}
              </a>
            </div>
          </form>
        </section>
      )
    }
    {
      step === 'decline' && (
        <section class="staff-application-step" aria-labelledby="step-heading">
          <h2 id="step-heading">{t('staff.applications.declineHeading', { name })}</h2>
          <p>{t('staff.applications.declineBody')}</p>
          <form method="post" action={`${here}decline/`} class="staff-form">
            <input type="hidden" name="token" value={token} />
            <input type="hidden" name="operation_id" value={ulid()} />
            <div>
              <label for="decline-note">{t('staff.applications.declineLabel')}</label>
              <textarea
                id="decline-note"
                name="note"
                rows="5"
                maxlength={NOTE_LIMIT}
                aria-describedby="decline-hint"
              />
              <p id="decline-hint" class="staff-help">
                {t('staff.applications.declineHint')}
              </p>
            </div>
            <div class="staff-application-actions">
              <Button variant="destructive">{t('staff.applications.confirmDecline')}</Button>
              <a href={here} class="staff-secondary-button">
                {t('staff.applications.cancel')}
              </a>
            </div>
          </form>
        </section>
      )
    }
  </div>
</StaffLayout>
