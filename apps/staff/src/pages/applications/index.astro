---
// Applications for the teams this person decides on. Rows use the same list
// pattern as the Welcome queue: who, what for, status, and one action.
import StaffLayout from '../../layouts/StaffLayout.astro';
import { t } from '@lasvegasfortransit/platform-core/messages';
import { CommitteeApplicationService } from '@lasvegasfortransit/platform-storage/committee-applications';
import {
  applicantName,
  applicationDay,
  applicationTarget,
  applicationWaiting,
  applicationsVisible,
} from '../../lib/applications';
import { messageResponse } from '../../lib/responses';
const staff = Astro.locals.staff;
if (!staff || !applicationsVisible(staff))
  return messageResponse("You don't have access to this", 403);
const service = new CommitteeApplicationService(staff.db);
const showDecided = Astro.url.searchParams.get('view') === 'decided';
const waiting = await service.queue(staff.actor);
const items = showDecided ? await service.decided(staff.actor) : waiting;
---

<StaffLayout
  title={t('staff.applications.title')}
  description={t('staff.applications.description')}
>
  <nav class="staff-access-views" aria-label={t('staff.applications.views')}>
    <a href="/applications/" aria-current={showDecided ? undefined : 'page'}>
      {t('staff.applications.waitingTab', { count: waiting.length })}
    </a>
    <a href="/applications/?view=decided" aria-current={showDecided ? 'page' : undefined}>
      {t('staff.applications.decidedTab')}
    </a>
  </nav>
  {
    items.length ? (
      <ul
        class="staff-welcome-list"
        aria-label={
          showDecided ? t('staff.applications.decidedTab') : t('staff.applications.title')
        }
      >
        {items.map((application) => (
          <li class="staff-welcome-row">
            <div>
              <a href={`/applications/${application.id}/`} class="staff-person-link">
                {applicantName(application)}
              </a>
              <p class="staff-welcome-meta">
                {applicationTarget(application)}
                {showDecided &&
                  ` · ${t('staff.applications.decidedDate', { date: applicationDay(application.decidedAt) })}`}
              </p>
            </div>
            {showDecided ? (
              <p
                class:list={[
                  'staff-status',
                  application.state !== 'accepted' && 'staff-status-neutral',
                ]}
              >
                {application.state === 'accepted'
                  ? t('staff.applications.accepted', { name: application.decidedByName ?? '' })
                  : application.state === 'declined'
                    ? t('staff.applications.declined', { name: application.decidedByName ?? '' })
                    : t('staff.applications.withdrawn')}
              </p>
            ) : (
              <p class:list={['staff-status', application.overdue && 'staff-status-attention']}>
                {applicationWaiting(application)}
                {application.overdue && ` · ${t('staff.applications.overdue')}`}
              </p>
            )}
            <div class="staff-welcome-action">
              <a
                href={`/applications/${application.id}/`}
                class="staff-secondary-button"
                aria-label={
                  showDecided
                    ? t('staff.applications.viewLabel', { name: applicantName(application) })
                    : t('staff.applications.reviewLabel', { name: applicantName(application) })
                }
              >
                {showDecided ? t('staff.applications.view') : t('staff.applications.review')}
              </a>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <div class="staff-empty">
        <h2>
          {showDecided ? t('staff.applications.emptyDecided') : t('staff.applications.empty')}
        </h2>
        <p>
          {showDecided
            ? t('staff.applications.emptyDecidedBody')
            : t('staff.applications.emptyBody')}
        </p>
      </div>
    )
  }
</StaffLayout>
