---
import { getCollection } from 'astro:content';
import StaffLayout from '../../layouts/StaffLayout.astro';
import Button from '../../../../site/src/components/app/Button.astro';
import PaperRow from '../../components/PaperRow.astro';
import {
  MAX_PAPER_ROWS,
  PAPER_WORDING_VERSION,
  LEGACY_PAPER_WORDING_VERSION,
  PAPER_CONSENT_TEXT,
  emptyPaperRow,
} from '@lasvegasfortransit/platform-core/paper';
import { t, formatFullDate } from '@lasvegasfortransit/platform-core/messages';
import { ulid } from '@lasvegasfortransit/platform-core/ids';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { issueFormToken } from '@lasvegasfortransit/platform-storage/form-tokens';
import { paperBatchSummary } from '@lasvegasfortransit/platform-storage/paper-intake';
import { initialPaper, submitPaper, type PaperFeedback } from '../../lib/paper';
import { messageResponse } from '../../lib/responses';
const staff = Astro.locals.staff;
if (!staff || !can(staff.actor, 'attendance.record'))
  return messageResponse(t('staff.common.accessDenied'), 403);
const events = (await getCollection('paperEvents'))
  .map((event) => ({
    id: event.data.calendarOccurrenceId,
    title: event.data.title,
    date: event.data.date,
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());
let feedback: PaperFeedback | undefined;
if (Astro.request.method === 'POST') {
  const result = await submitPaper(Astro.request, staff, events);
  if (result instanceof Response) return result;
  feedback = result;
  Astro.response.status = result.status;
}
const input = feedback?.input ?? initialPaper(ulid()),
  errors = feedback?.errors ?? {};
const saved = Astro.url.searchParams.get('saved');
const summary = saved ? await paperBatchSummary(staff.db, staff.actor, saved.slice(0, 100)) : null;
const token = await issueFormToken(staff.db, staff.actor, 'paper:submit');
---

<StaffLayout title={t('staff.paper.title')} description={t('staff.paper.help')}>
  {
    can(staff.actor, 'console.enter') && (
      <a slot="breadcrumb" href="/people/" class="staff-back">
        {t('staff.paper.back')}
      </a>
    )
  }
  <a slot="heading-meta" href="/paper/sheet/" class="staff-edit-link"
    >{t('staff.paper.printLink')}</a
  >
  {
    summary && (
      <p role="status" class="staff-paper-saved">
        {t('staff.paper.saved', { count: summary.rows })}
        {summary.created !== null && summary.existing !== null && (
          <>
            {' '}
            {t('staff.paper.newCount', { count: summary.created })} ·{' '}
            {t('staff.paper.existingCount', { count: summary.existing })}.
          </>
        )}
        {summary.heldSignups > 0 && <> {t('staff.paper.held', { count: summary.heldSignups })}</>}
        {summary.reviews > 0 && (
          <>
            {' '}
            {t('staff.paper.reviewCount', { count: summary.reviews })}.{' '}
            {can(staff.actor, 'review_queue.resolve') ? (
              <a href="/review/">{t('staff.paper.reviewLink')}</a>
            ) : (
              t('staff.paper.reviewAdmin')
            )}
          </>
        )}
      </p>
    )
  }
  {
    feedback?.message && (
      <p role="alert" class="staff-error">
        {feedback.message}
      </p>
    )
  }
  <form
    method="post"
    action="/paper/"
    class="staff-form staff-paper-form"
    novalidate
    data-paper-form
    data-max-rows={MAX_PAPER_ROWS}
    data-row-label={t('staff.paper.row', { number: '{number}' })}
  >
    <input type="hidden" name="token" value={token} /><input
      type="hidden"
      name="batch_id"
      value={input.batchId}
    /><input type="hidden" name="row_count" value={input.rows.length} />
    <div class="staff-paper-event">
      <div>
        <label for="event_name">{t('staff.paper.eventName')}</label><input
          id="event_name"
          name="event_name"
          value={input.eventName}
          maxlength="160"
          aria-invalid={errors.eventName ? 'true' : undefined}
          aria-describedby={errors.eventName ? 'event_name_error' : undefined}
        />{
          errors.eventName && (
            <p id="event_name_error" class="staff-error">
              {errors.eventName}
            </p>
          )
        }
      </div>
      <div>
        <label for="event_date">{t('staff.paper.eventDate')}</label><input
          id="event_date"
          name="event_date"
          type="date"
          value={input.eventDate}
          aria-invalid={errors.eventDate ? 'true' : undefined}
          aria-describedby={errors.eventDate ? 'event_date_error' : undefined}
        />{
          errors.eventDate && (
            <p id="event_date_error" class="staff-error">
              {errors.eventDate}
            </p>
          )
        }
      </div>
      <div>
        <label for="wording_version">{t('staff.paper.wording')}</label><select
          id="wording_version"
          name="wording_version"
          aria-invalid={errors.wordingVersion ? 'true' : undefined}
          aria-describedby={errors.wordingVersion ? 'wording_error' : 'consent_wording'}
        >
          <option value="" selected={!input.wordingVersion}>{t('staff.paper.chooseWording')}</option
          ><option
            value={PAPER_WORDING_VERSION}
            selected={input.wordingVersion === PAPER_WORDING_VERSION}
            >{t('staff.paper.currentWording')}</option
          ><option
            value={LEGACY_PAPER_WORDING_VERSION}
            selected={input.wordingVersion === LEGACY_PAPER_WORDING_VERSION}
            >{t('staff.paper.legacyWording')}</option
          >
        </select>{
          errors.wordingVersion && (
            <p id="wording_error" class="staff-error">
              {errors.wordingVersion}
            </p>
          )
        }
      </div>
      <div class="staff-paper-calendar">
        <label for="public_event">{t('staff.paper.publicEvent')}</label><select
          id="public_event"
          name="public_event"
          aria-invalid={errors.eventId ? 'true' : undefined}
          aria-describedby={errors.eventId ? 'public_event_error' : 'public_event_help'}
        >
          <option value="">{t('staff.paper.noPublicEvent')}</option>{
            events.map((event) => (
              <option value={event.id} selected={input.eventId === event.id}>
                {event.title} · {formatFullDate(event.date)}
              </option>
            ))
          }
        </select><p id="public_event_help" class="staff-help">
          {t('staff.paper.publicEventHelp')}
        </p>{
          errors.eventId && (
            <p id="public_event_error" class="staff-error">
              {errors.eventId}
            </p>
          )
        }
      </div>
    </div>
    <details class="staff-paper-wording">
      <summary>{t('staff.paper.wordingCheck')}</summary><p id="consent_wording">
        {PAPER_CONSENT_TEXT}
      </p><p class="staff-help">{t('staff.paper.wordingHelp')}</p>
    </details>
    {
      errors.rows && (
        <p role="alert" class="staff-error">
          {errors.rows}
        </p>
      )
    }
    <div data-paper-rows>
      {input.rows.map((row, index) => <PaperRow row={row} index={index} errors={errors} />)}
    </div>
    <template id="paper-row-template"
      ><PaperRow row={emptyPaperRow()} index={MAX_PAPER_ROWS} errors={{}} /></template
    >
    <div class="staff-paper-actions">
      <Button name="intent" value="save">{t('staff.paper.save')}</Button>{
        input.rows.length < MAX_PAPER_ROWS && (
          <button
            type="submit"
            name="intent"
            value="add"
            class="staff-secondary-button press"
            formnovalidate
            data-add-paper-row
          >
            {t('staff.paper.add')}
          </button>
        )
      }
    </div>
    <p class="staff-help">{t('staff.paper.blankHelp')}</p>
  </form>
</StaffLayout>

<script>
  import '../../scripts/paper-entry';
</script>
