---
import { t } from '@lasvegasfortransit/platform-core/messages';
import StaffLayout from '../../layouts/StaffLayout.astro';
import { PAPER_WORDING_VERSION, PAPER_CONSENT_TEXT } from '@lasvegasfortransit/platform-core/paper';
import { can } from '@lasvegasfortransit/platform-core/permissions';
import { messageResponse } from '../../lib/responses';
const staff = Astro.locals.staff;
if (!staff || !can(staff.actor, 'attendance.record'))
  return messageResponse(t('staff.common.accessDenied'), 403);
---

<StaffLayout title={t('staff.paper.sheetTitle')} printPage>
  <a slot="breadcrumb" href="/paper/" class="staff-back">{t('staff.paper.sheetBack')}</a>
  <p class="staff-print-instructions">
    {t('staff.paper.printHelp')}
  </p>
  <section class="staff-signup-sheet" aria-label={t('staff.paper.sheetLabel')}>
    <h2>{t('staff.navigation.organization')}</h2>
    <p class="staff-signup-event">
      {t('staff.paper.eventCaption')}
      <span></span>
      {t('staff.paper.dateCaption')}
      <span></span>
    </p>
    <p class="staff-signup-wording">
      <strong>{t('staff.paper.signupCaption')}</strong>
      {PAPER_CONSENT_TEXT}
    </p>
    <table>
      <caption class="sr-only">{t('staff.paper.tableCaption')}</caption><thead
        ><tr
          ><th scope="col" class="staff-signup-number">{t('staff.paper.number')}</th><th scope="col"
            >{t('staff.paper.name')}</th
          ><th scope="col">{t('staff.paper.email')}</th><th scope="col"
            >{t('staff.paper.phone')} <small>{t('staff.paper.optional')}</small></th
          ><th scope="col" class="staff-signup-yes"
            >{t('staff.paper.signup')}<br />{t('staff.paper.yes')}</th
          ></tr
        ></thead
      ><tbody
        >{
          Array.from({ length: 12 }, (_, i) => (
            <tr>
              <>
                <td>{i + 1}</td>
                <td />
                <td />
                <td />
                <td>
                  <span class="staff-signup-checkbox" aria-label={t('staff.paper.checkYes')} />
                </td>
              </>
            </tr>
          ))
        }</tbody
      >
    </table>
    <p class="staff-signup-footer">
      {t('staff.paper.footer', { version: PAPER_WORDING_VERSION })}
    </p>
  </section>
</StaffLayout>
