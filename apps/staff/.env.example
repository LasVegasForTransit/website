# Illustrative binding names only; use fictional local fixtures, never live sessions.
# Current production/preview select cloudflare-access in wrangler.jsonc.
LVBT_STAFF_AUTH_MODE=cloudflare-access
LVBT_STAFF_ORIGIN=https://staff.lasvegasfortransit.org
LVBT_STAFF_PREVIEW_ORIGINS=[]
# Both modes need independently generated session signing and membership email credentials.
LVBT_SIGN_IN_SECRET=
LVBT_RESEND_API_KEY=
# cloudflare-access mode: hostname without scheme/path; audience unique per environment.
LVBT_ACCESS_TEAM_DOMAIN=
LVBT_ACCESS_AUD=
# google mode: direct OAuth, with this deployment's exact callback registered in Google.
LVBT_GOOGLE_OAUTH_CLIENT_ID=
LVBT_GOOGLE_OAUTH_CLIENT_SECRET=
# Temporary first-administrator setup only; remove after successful initialization.
LVBT_INITIAL_STAFF_ADMIN_WORKSPACE_EMAIL=
# Optional exact HTTPS origin for the member website used during account linking.
# Defaults to the LVBT public site, or public preview for staff preview hosts.
# LVBT_MEMBER_ORIGIN=https://lasvegasfortransit.org
