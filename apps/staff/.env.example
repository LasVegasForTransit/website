# Staff portal Access bindings
#
# This file documents the binding names; it contains no working credentials.
# Deployment reads the selected environment in wrangler.jsonc. Keep the
# production and preview audience values separate. The team domain is a hostname
# such as your-team.cloudflareaccess.com, without a scheme or path.
#
# Use the synthetic Access identities in the staff browser fixtures for local
# testing. Do not copy production sessions or sign-in secrets into local files.
LVBT_ACCESS_AUD=
LVBT_ACCESS_TEAM_DOMAIN=
