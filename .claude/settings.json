{
  "extraKnownMarketplaces": {
    "lvbt": {
      "source": {
        "source": "github",
        "repo": "LasVegasForTransit/repository-tooling",
        "ref": "v0.8.0"
      }
    }
  },
  "enabledPlugins": {
    "lvbt-contributions@lvbt": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/git-hooks.mjs\" --session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
