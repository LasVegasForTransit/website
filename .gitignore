# build output
dist/
# generated types
.astro/
# turborepo cache
.turbo/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.local
.env.production

# bootstrap CLI state
.lvbt/*
!.lvbt/repository-tooling.json

# superpowers brainstorming mockups
.superpowers/

# claude code: ignore only the per-machine local settings; shared
# .claude config (settings.json, commands, agents) can be committed
.claude/settings.local.json

# antigravity (gemini ide) project link — symlinks to ~/.gemini, per-machine
.antigravitycli/

# wrangler cache
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# playwright (keep tests/snapshots/ — those are the committed baselines)
test-results/
playwright-report/
playwright/.cache/
# playwright-mcp scratch output (ad-hoc screenshots / driven sessions)
.playwright-mcp/
# ad-hoc screenshots dropped in the repo root during local verification
/*.png

# audit tooling output — Lighthouse raw runs are bulky JSON; the readable
# report lives in audits/ and IS committed so improvements show up in git.
.lighthouseci/
.lighthouseci-mobile/
.lighthouseci-prod/
