{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k -n astro,wrangler -c blue,yellow 'kill -9 $(lsof -ti:4320 -sTCP:LISTEN) 2>/dev/null; astro dev --port 4320' 'kill -9 $(lsof -ti:4321 -sTCP:LISTEN) 2>/dev/null; portless run --force --app-port 4321 wrangler pages dev --proxy 4320 --port 4321'",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "bootstrap": "tsx scripts/bootstrap/cold-start.ts",
    "preflight": "tsx scripts/bootstrap/cold-start.ts --doctor",
    "event:new": "tsx scripts/event-new.ts",
    "check:docs": "tsx scripts/check-docs-links.ts",
    "check:baseline": "tsx scripts/audit/baseline.ts",
    "check:lighthouse": "lhci autorun",
    "check:html": "html-validate dist/**/*.html",
    "check:structured-data": "tsx scripts/audit/structured-data.ts",
    "check:third-party": "tsx scripts/audit/third-party-scan.ts",
    "check:a11y": "playwright test --project=a11y",
    "screenshot": "tsx scripts/screenshot.ts",
    "check:content": "alex src/content && cspell --no-progress --no-summary 'src/**/*.{md,mdx,astro}'",
    "typecheck": "astro check && tsc -p scripts/tsconfig.json",
    "lint": "prettier --write .",
    "lint:check": "prettier --check .",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:install": "playwright install --with-deps chromium",
    "prepare": "git config --local core.hooksPath .githooks 2>/dev/null || true"
  },
  "lint-staged": {
    "*.{js,ts,tsx,astro,md,mdx,css,json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource-variable/public-sans": "^5.2.7",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.5",
    "astro-icon": "^1.1.5",
    "ical.js": "^2.2.1",
    "sitemap": "^9.0.1",
    "tailwindcss": "^4.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.3",
    "@clack/prompts": "^1.4.0",
    "@cloudflare/workers-types": "^4.20260519.1",
    "@iconify-json/mdi": "^1.2.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.0",
    "alex": "^11.0.1",
    "concurrently": "^9.2.1",
    "cspell": "^10.0.0",
    "html-validate": "^11.2.0",
    "lint-staged": "^17.0.5",
    "picocolors": "^1.1.1",
    "portless": "^0.13.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tslib": "^2.8.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "wrangler": "4.93.0"
  }
}
