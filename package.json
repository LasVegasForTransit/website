{
  "name": "lvbt-website",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.20.0"
  },
  "portless": {
    "name": "lvbt",
    "script": "dev:pages",
    "appPort": 4320
  },
  "scripts": {
    "bootstrap": "lvbt bootstrap",
    "preflight": "lvbt preflight",
    "provision": "tsx scripts/bootstrap/cold-start.ts",
    "doctor": "tsx scripts/bootstrap/cold-start.ts --doctor",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:pages": "pnpm --filter lvbt-site dev:pages",
    "dev:portless": "portless",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --concurrency=1",
    "test:update": "pnpm --filter lvbt-site exec playwright test --update-snapshots",
    "test:install": "playwright install --with-deps chromium",
    "validate": "pnpm check:root && pnpm check:brand",
    "check:root": "eslint scripts --max-warnings 0 && tsc -p scripts/tsconfig.json --noEmit",
    "check:brand": "tsx scripts/audit/brand-tokens.ts",
    "check:content": "alex apps/site/src/content && cspell --no-progress --no-summary 'apps/site/src/**/*.{md,mdx,astro}'",
    "check:baseline": "tsx scripts/audit/baseline.ts",
    "check:lighthouse": "lhci autorun",
    "check:html": "html-validate 'apps/site/dist/**/*.html'",
    "check:structured-data": "tsx scripts/audit/structured-data.ts",
    "check:third-party": "tsx scripts/audit/third-party-scan.ts",
    "check:a11y": "pnpm --filter lvbt-site exec playwright test --project=a11y",
    "screenshot": "tsx scripts/screenshot.ts",
    "setup:notion": "tsx scripts/notion/provision-intake-db.ts",
    "add:transit-news": "tsx scripts/notion/add-transit-news.ts",
    "event:new": "tsx scripts/event-new.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && markdownlint-cli2 && lvbt check && turbo run lint check-types test validate",
    "check:fix": "pnpm format && markdownlint-cli2 --fix && turbo run lint -- --fix",
    "prepare": "git config --local core.hooksPath .githooks"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@clack/prompts": "catalog:",
    "@lhci/cli": "catalog:",
    "@lvbt/cli": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/cli",
    "@lvbt/eslint-config": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/eslint-config",
    "@lvbt/prettier-config": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/prettier-config",
    "@lvbt/typescript-config": "github:LasVegasForTransit/repository-tooling#v0.2.1&path:/packages/typescript-config",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "alex": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "html-validate": "catalog:",
    "lint-staged": "catalog:",
    "markdownlint-cli2": "catalog:",
    "markdownlint-rule-relative-links": "catalog:",
    "picocolors": "catalog:",
    "portless": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-astro": "catalog:",
    "tslib": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
