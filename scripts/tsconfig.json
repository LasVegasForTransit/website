{
  "extends": "@lvbt/typescript-config/node.json",
  "compilerOptions": {
    "esModuleInterop": true,
    // screenshot.ts and the audits evaluate code inside the browser through Playwright.
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // Adoption debt against the organization base: on in @lvbt/typescript-config,
    // off here until these scripts are made to pass it. Turn it on, fix what it
    // reports, and delete the line.
    "exactOptionalPropertyTypes": false
  },
  "include": ["**/*.ts"]
}
