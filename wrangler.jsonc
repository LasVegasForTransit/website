{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lvbt-website",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".wrangler/worker/index.js",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/join/member",
      "/join/member/*",
      "/join/remove",
      "/join/remove/*",
      "/prototypes/join",
      "/prototypes/join/*",
    ],
  },
  "observability": {
    "enabled": true,
  },
  // The Organizing Platform database. Production uses lvbt-platform; pull request previews
  // upload to the separate lvbt-website-preview Worker, which uses lvbt-platform-preview so test
  // data never mixes with real people. See docs/explanation/decisions/organizing-platform.md.
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "lvbt-platform",
      "database_id": "dcde8dbd-d827-4405-85b4-97bc2accc906",
      "migrations_dir": "platform/storage/migrations",
    },
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "lvbt-platform-preview",
          "database_id": "8bb072e7-9865-487a-8867-d97fdb2ea00b",
          "migrations_dir": "platform/storage/migrations",
        },
      ],
    },
  },
}
