---
interface Props {
  class?: string;
  heading?: string;
  placeholder?: string;
}

const {
  class: className = '',
  heading = 'Search the site',
  placeholder = 'Try "membership", "bus stops", or "events"',
} = Astro.props;
---

<section class:list={['site-search', className]} data-site-search>
  <form class="site-search__form" role="search" data-site-search-form>
    <label class="sr-only" for="site-search-input">{heading}</label>
    <input
      id="site-search-input"
      type="search"
      name="q"
      autocomplete="off"
      spellcheck="false"
      placeholder={placeholder}
      data-site-search-input
    />
    <button type="submit" class="press" data-site-search-submit>Search</button>
  </form>
  <p class="text-body-sm site-search__status" aria-live="polite" data-site-search-status></p>
  <ol class="site-search__results" data-site-search-results></ol>
  <noscript>
    <p class="text-body-sm site-search__status">
      Search needs JavaScript. Use the links below or the sitemap instead.
    </p>
  </noscript>
</section>

<script is:inline src="/scripts/pagefind-search.js" defer></script>

<style>
  .site-search {
    max-width: 100%;
  }

  .site-search__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem;
    align-items: stretch;
  }

  .site-search__form input {
    min-height: 3rem;
    width: 100%;
    border: 2px solid var(--color-ink);
    background: var(--color-paper);
    padding: 0.75rem 0.9rem;
    color: var(--color-ink);
  }

  .site-search__form input:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .site-search__form button {
    min-height: 3rem;
    border: 2px solid var(--color-ink);
    background: var(--color-ink);
    padding: 0.65rem 1rem;
    color: var(--color-paper);
    cursor: pointer;
  }

  .site-search__form button:hover,
  .site-search__form button:focus-visible {
    background: var(--color-accent);
    color: var(--color-ink);
  }

  .site-search__status {
    margin-top: 0.5rem;
    color: var(--color-mute);
  }

  .site-search__results {
    margin-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .site-search__result {
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    padding-top: 0.75rem;
  }

  .site-search__result a {
    color: var(--color-ink);
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 0.16em;
    text-underline-offset: 0.2em;
  }

  .site-search__result a:hover,
  .site-search__result a:focus-visible {
    color: var(--color-accent-ink);
  }

  .site-search__result p {
    margin-top: 0.25rem;
    color: var(--color-mute);
  }

  .site-search__result mark {
    background: var(--color-accent-soft);
    color: inherit;
  }

  @media (min-width: 40rem) {
    .site-search__form {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 28rem) {
    .site-search__form {
      grid-template-columns: 1fr;
    }
  }
</style>
