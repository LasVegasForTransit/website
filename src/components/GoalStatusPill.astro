---
type GoalStatus = 'planned' | 'in-progress' | 'done';

interface Props {
  status: GoalStatus;
}

const { status } = Astro.props;

const styles: Record<GoalStatus, string> = {
  planned: 'bg-transparent text-on-surface-variant border-on-surface-variant/60',
  'in-progress': 'bg-primary text-on-primary border-primary',
  done: 'bg-slab text-on-slab border-slab',
};

const label: Record<GoalStatus, string> = {
  planned: 'Planned',
  'in-progress': 'In progress',
  done: 'Done',
};
---

<span
  class:list={[
    'inline-flex items-center px-2 py-0.5 text-[0.65rem] font-bold border',
    styles[status],
  ]}
>
  {label[status]}
</span>
