---
type GoalStatus = 'planned' | 'in-progress' | 'done';

interface Props {
  status: GoalStatus;
}

const { status } = Astro.props;

const styles: Record<GoalStatus, string> = {
  planned: 'bg-transparent text-mute border-mute/60',
  'in-progress': 'bg-accent text-paper border-accent',
  done: 'bg-ink text-paper border-ink',
};

const label: Record<GoalStatus, string> = {
  planned: 'Planned',
  'in-progress': 'In progress',
  done: 'Done',
};
---

<span
  class:list={[
    'inline-flex items-center px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wider border',
    styles[status],
  ]}
>
  {label[status]}
</span>
