---
interface Props {
  title: string;
  eyebrow?: string;
}
const { title, eyebrow } = Astro.props;
---

<section class="py-12">
  <div class="container-page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="text-headline-lg mt-2 mb-8">{title}</h2>
  </div>
  <div class="carousel-scroll overflow-x-auto pb-4">
    <div class="carousel-track flex gap-5 snap-x snap-mandatory">
      <slot />
      {
        /* Sentinel flex item providing reliable end-side spacing. See
        .carousel-track-end in global.css. Using a real element rather than
        a :last-child selector because the slotted children carry their own
        data-astro-cid that scoped styles can't address. */
      }
      <div class="carousel-track-end" aria-hidden="true"></div>
    </div>
  </div>
</section>
