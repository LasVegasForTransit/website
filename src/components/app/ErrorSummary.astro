---
// The error summary at the top of a form: one link per error, each pointing
// at its field. Every possible error is in the page, hidden; `show` lists the
// fields to reveal. A server can reveal them instead by removing `hidden`
// from the summary and from each `[data-summary-for]` item. The enhancement
// script moves focus here when it is shown. Pattern after the UK government
// design system's error summary.
import { linkClass } from './styles';

interface Props {
  heading: string;
  errors: { field: string; message: string }[];
  show?: string[];
}

const { heading, errors, show = [] } = Astro.props;
const visible = show.length > 0;
---

<div
  data-slot="error-summary"
  data-error-summary
  hidden={!visible}
  class="mt-8 border-2 border-primary-ink p-4"
  role="alert"
  tabindex="-1"
  aria-labelledby="error-summary-heading"
>
  <h2 id="error-summary-heading" class="text-title-lg">{heading}</h2>
  <ul class="mt-3 list-disc pl-5">
    {
      errors.map(({ field, message }) => (
        <li data-summary-for={field} hidden={!show.includes(field)}>
          <a
            href={`#${field}`}
            class={linkClass.replace('decoration-primary', 'decoration-primary-ink')}
          >
            {message}
          </a>
        </li>
      ))
    }
  </ul>
</div>
