---
// The header of one step in a multi-step flow: "Step 2 of 3" and the names of
// all steps, with the current one marked for screen readers.
interface Props {
  current: number;
  steps: string[];
  label: string;
}

const { current, steps, label } = Astro.props;
---

<nav aria-label={label} class="text-sm">
  <p class="font-bold">{`Step ${current} of ${steps.length}`}</p>
  <ol class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
    {
      steps.map((name, index) => (
        <li
          aria-current={index + 1 === current ? 'step' : undefined}
          class:list={[index + 1 === current ? 'font-bold' : 'text-on-surface-variant']}
        >
          {name}
        </li>
      ))
    }
  </ol>
</nav>
