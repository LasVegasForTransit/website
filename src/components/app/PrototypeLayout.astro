---
// Every prototype page: hidden from search engines and marked with the
// prototype banner, so it can never be mistaken for the real site.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROTOTYPE_BANNER } from '../../lib/prototypes';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={`${title} · Prototype`} noindex>
  <p class="bg-primary-ink text-on-primary px-4 py-3 text-center font-bold" data-prototype-banner>
    {PROTOTYPE_BANNER}
  </p>
  <slot />
  <script is:inline src="/scripts/app-enhance.js" defer></script>
</BaseLayout>
