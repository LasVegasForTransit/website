---
// Single button that prefers the native Web Share API and falls back to
// clipboard copy with a transient "Copied" affordance. Used in the event
// detail action row; reusable on any future surface that wants a share
// affordance.
//
// The behaviour script lives at /scripts/share-button.js (public/) so it
// satisfies the site's CSP `script-src 'self'` — Astro inlines short
// hoisted <script> tags, which CSP blocks in production. Same pattern
// as Header.astro / public/scripts/header-stuck.js.
interface Props {
  url: string;
  title: string;
  text?: string;
  // Optional class override so callers can match an action row's button
  // shape (outlined vs ghost) without duplicating the script behaviour.
  class?: string;
}

const { url, title, text, class: className } = Astro.props;
---

<button
  type="button"
  data-share-button
  data-share-url={url}
  data-share-title={title}
  data-share-text={text ?? title}
  class:list={[
    // No bespoke transition here — the consumer passes `.press` for the
    // sitewide 200ms ease-out color/transform timing. Standalone usage
    // (without `.press`) flips colors immediately; pair it with the
    // utility for the consistent gesture.
    'inline-flex items-center px-5 py-3 text-sm font-bold no-underline border-2 border-ink hover:bg-ink hover:text-paper',
    className,
  ]}
>
  <span data-share-label>Share →</span>
</button>

{
  /* `is:inline` keeps the <script> tag exactly as written (no Astro
    processing/inlining) so it references the static asset under
    public/scripts/. `defer` runs after DOM parse but before
    DOMContentLoaded — querySelectorAll finds the button. Astro
    deduplicates identical is:inline scripts per page, so multiple
    ShareButton instances share one network request. */
}
<script is:inline src="/scripts/share-button.js" defer></script>
