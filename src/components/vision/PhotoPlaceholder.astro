---
interface Props {
  description: string;
  badge?: string;
  /** When the placeholder sits in an ink band, switch the gradient + border to paper-tinted. */
  variant?: 'cream' | 'ink';
  /** Fill the parent container (position absolute, inset 0) instead of using a fixed aspect ratio. */
  fill?: boolean;
}

const {
  description,
  badge = 'Photo placeholder · v0',
  variant = 'cream',
  fill = false,
} = Astro.props;
---

<div
  class:list={['photo-placeholder', `is-${variant}`, { 'is-fill': fill }]}
  role="img"
  aria-label={description}
>
  <span class="badge">{badge}</span>
  <p class="desc">{description}</p>
</div>

<style>
  .photo-placeholder {
    width: 100%;
    aspect-ratio: 21 / 9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
  }
  .photo-placeholder.is-cream {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-ink) 6%, var(--color-paper)) 0%,
      color-mix(in srgb, var(--color-ink) 12%, var(--color-paper)) 100%
    );
    border: 1px dashed color-mix(in srgb, var(--color-ink) 28%, transparent);
  }
  .photo-placeholder.is-ink {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-paper) 6%, var(--color-ink)) 0%,
      color-mix(in srgb, var(--color-paper) 12%, var(--color-ink)) 100%
    );
    border: 1px dashed color-mix(in srgb, var(--color-paper) 30%, transparent);
  }
  .badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-weight: 700;
    color: var(--color-mute);
    padding: 0.4rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-ink) 30%, transparent);
  }
  .is-ink .badge {
    color: color-mix(in srgb, var(--color-paper) 55%, var(--color-ink));
    border-color: color-mix(in srgb, var(--color-paper) 30%, transparent);
  }
  .desc {
    font-size: 0.95rem;
    font-style: italic;
    color: color-mix(in srgb, var(--color-ink) 65%, var(--color-paper));
    max-width: 38rem;
    line-height: 1.45;
  }
  .is-ink .desc {
    color: color-mix(in srgb, var(--color-paper) 65%, var(--color-ink));
  }
  .photo-placeholder.is-fill {
    aspect-ratio: unset;
    height: 100%;
    position: absolute;
    inset: 0;
  }
  .photo-placeholder.is-fill .badge,
  .photo-placeholder.is-fill .desc {
    display: none;
  }
</style>
