---
// Behaviour script lives at /scripts/newsletter-subscribe.js (public/) so
// it satisfies the site's CSP `script-src 'self'` — Astro inlines short
// hoisted <script> tags, which CSP blocks in production. Without that
// script running, submit falls through to native form posting and the
// page "refreshes". Same pattern as Header.astro / ShareButton.astro.
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
---

<div
  class:list={[
    'border p-6 md:p-8',
    variant === 'dark' ? 'bg-ink text-paper border-ink' : 'bg-paper text-ink border-ink',
  ]}
>
  <p class="eyebrow">Newsletter</p>
  <h3 class="text-title-lg mt-3">Updates from the front lines.</h3>
  <p class="mt-4 max-w-md">
    The 2027 session is the moment. Subscribe for legislative updates, project briefs, and ways to
    show up.
  </p>
  <form class="mt-6 flex flex-col sm:flex-row gap-3" data-newsletter-form novalidate>
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      aria-describedby="newsletter-status"
      class="flex-1 px-4 py-3 border-2 border-current bg-transparent placeholder:opacity-80 focus:outline-none"
    />
    <button
      type="submit"
      data-submit-btn
      class="px-6 py-3 font-bold uppercase tracking-wider bg-accent text-ink border-2 border-accent hover:bg-transparent hover:text-current transition-colors"
    >
      Subscribe
    </button>
  </form>
  <p id="newsletter-status" role="status" aria-live="polite" data-form-status class="mt-3 text-sm">
  </p>
</div>

<script is:inline src="/scripts/newsletter-subscribe.js" defer></script>
