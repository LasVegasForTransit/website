---
// Behaviour script lives at /scripts/newsletter-subscribe.js (public/) so
// it satisfies the site's CSP `script-src 'self'` — Astro inlines short
// hoisted <script> tags, which CSP blocks in production. Without that
// script running, submit falls through to native form posting and the
// page "refreshes". Same pattern as Header.astro / ShareButton.astro.
interface Props {
  variant?: 'light' | 'dark';
  // `compact` drops the box framing and the internal heading/pitch,
  // rendering just the form. Use it where the surrounding section already
  // supplies the heading and the pitch (e.g. the /join membership section)
  // so the form doesn't read as a second, competing call to action.
  compact?: boolean;
  // `stack` keeps the form vertical (input above button) even on wide
  // viewports. Use it inside narrow containers (e.g. the /go Newsletter card)
  // where the side-by-side row crowds the field or overflows.
  stack?: boolean;
}
const { variant = 'light', compact = false, stack = false } = Astro.props;
---

<div
  class:list={[
    !compact && 'border p-6 md:p-8',
    variant === 'dark' ? 'bg-slab text-on-slab border-slab' : 'text-on-surface',
    !compact && (variant === 'dark' ? 'border-slab' : 'bg-surface-container border-outline'),
  ]}
>
  {
    !compact && (
      <>
        <h3 class="text-title-lg">Get the newsletter.</h3>
        <p class="mt-4 max-w-md">We keep it short and infrequent, usually every couple of weeks.</p>
      </>
    )
  }
  <form
    class:list={[
      stack ? 'flex flex-col gap-3' : 'flex flex-col sm:flex-row gap-3',
      !compact && 'mt-6',
    ]}
    data-newsletter-form
    novalidate
  >
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      aria-label="Email address"
      placeholder="you@example.com"
      aria-describedby="newsletter-status"
      class="flex-1 min-w-0 px-4 py-3 border-2 border-current bg-transparent placeholder:opacity-80 focus:outline-none"
    />
    <button
      type="submit"
      data-submit-btn
      class:list={[
        'font-bold bg-primary text-on-primary border-2 border-primary hover:bg-transparent hover:text-current transition-colors',
        // In stacked layout the button sizes to its label (smaller padding,
        // left-aligned) instead of stretching full width and reading oversized.
        stack ? 'self-start px-4 py-2 text-sm' : 'px-6 py-3',
      ]}
    >
      Subscribe
    </button>
  </form>
  <p id="newsletter-status" role="status" aria-live="polite" data-form-status class="mt-3 text-sm">
  </p>
</div>

<script is:inline src="/scripts/newsletter-subscribe.js" defer></script>
