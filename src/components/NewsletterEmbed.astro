---
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
---

<div
  class:list={[
    'border p-6 md:p-8',
    variant === 'dark' ? 'bg-ink text-paper border-ink' : 'bg-paper text-ink border-ink',
  ]}
>
  <p class="eyebrow">Newsletter</p>
  <h3 class="text-title-lg mt-3">Updates from the front lines.</h3>
  <p class="mt-4 max-w-md">
    The 2027 session is the moment. Subscribe for legislative updates, project briefs, and ways to
    show up.
  </p>
  <form
    class="mt-6 flex flex-col sm:flex-row gap-3"
    data-newsletter-form
    novalidate
  >
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@example.com"
      aria-describedby="newsletter-status"
      class="flex-1 px-4 py-3 border-2 border-current bg-transparent placeholder:opacity-60 focus:outline-none"
    />
    <button
      type="submit"
      data-submit-btn
      class="px-6 py-3 font-bold uppercase tracking-wider bg-accent text-paper border-2 border-accent hover:bg-transparent hover:text-current transition-colors"
    >
      Subscribe
    </button>
  </form>
  <p
    id="newsletter-status"
    role="status"
    aria-live="polite"
    data-form-status
    class="mt-3 text-sm"
  ></p>
</div>

<script>
  interface SubscribeResponse {
    success?: boolean;
    error?: string;
  }

  const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
  if (form) {
    const btn = form.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const status = document.getElementById('newsletter-status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();

      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Subscribing…';
      }
      if (status) status.textContent = '';

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await res.json() as SubscribeResponse;

        if (data.success) {
          form.reset();
          if (btn) btn.textContent = 'Done ✓';
          if (status) status.textContent = "You’re subscribed. Check your inbox for a confirmation.";
        } else if (data.error === 'invalid_email') {
          if (status) status.textContent = "That doesn’t look like a valid email address.";
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Subscribe';
          }
        } else {
          if (status) status.textContent = 'Something went wrong. Please try again.';
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Subscribe';
          }
        }
      } catch {
        if (status) status.textContent = 'Something went wrong. Please try again.';
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Subscribe';
        }
      }
    });
  }
</script>
