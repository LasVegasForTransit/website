---
import { Icon } from 'astro-icon/components';
import { navMain, site } from '../../lib/site';
import { displayUrl } from '../../lib/paths';

const domain = displayUrl(site.url);
const internalPrintUrl = (path: string) => ({ domain, path });

type PrintLinkSheetLink = {
  label: string;
  href: string;
  printUrl: string | { domain: string; path: string } | string[];
};

const printLinkSheetSections: Array<{ links: PrintLinkSheetLink[] }> = [
  {
    links: [
      { label: 'Home', href: '/', printUrl: { domain, path: '/' } },
      ...navMain.map((item) => ({
        label: item.label,
        href: item.href,
        printUrl: internalPrintUrl(item.href),
      })),
    ],
  },
  {
    links: [
      { label: 'Join', href: '/join', printUrl: internalPrintUrl('/join') },
      { label: 'Newsletter', href: '/newsletter', printUrl: internalPrintUrl('/newsletter') },
      ...(site.donate.url
        ? [
            {
              label: site.donate.label,
              href: site.donate.url,
              printUrl: displayUrl(site.donate.url),
            },
          ]
        : []),
      { label: 'Email', href: `mailto:${site.email.general}`, printUrl: site.email.general },
    ],
  },
  {
    links: [
      { label: 'Brand', href: '/brand', printUrl: internalPrintUrl('/brand') },
      { label: 'Colophon', href: '/colophon', printUrl: internalPrintUrl('/colophon') },
      { label: 'Sitemap', href: '/sitemap', printUrl: internalPrintUrl('/sitemap') },
      {
        label: 'Source',
        href: 'https://github.com/LasVegasForTransit/website',
        printUrl: ['github.com', 'LasVegasForTransit', 'website'],
      },
    ],
  },
];
---

{
  /* ============================================================
    FOOTER CONTRACT — read before changing layout.
    History: this footer has been redesigned several times in
    ways that broke either the desktop dvh budget or the mobile
    empty-middle. The rules below are load-bearing.

    HEIGHT
      ALWAYS EXACTLY 1dvh, every viewport, no exceptions. The
      footer is the immersive close — taking the full viewport
      is the entire point. `h-dvh` on <footer> + the flex-1
      centering region + a meta row pinned to the bottom is
      what holds the budget.
        • Do NOT switch to md:h-dvh / min-h-dvh / h-screen.
        • Do NOT add py-* that pushes total content past 1dvh.
        • Do NOT "fix" empty mobile middle by removing h-dvh.
          If the middle reads as empty on a narrow viewport,
          fill it with content (show the mission band there,
          enlarge the wordmark, etc.) — never by shrinking the
          footer.

    STRUCTURE (three siblings inside <footer>, in order)
      1. orange stripe (.reveal-stripe)
      2. flex-1 wrapper with `justify-center` — holds the nav
         grid and the mission band, centered vertically in the
         remaining space.
      3. meta row (border-t) — compact utility nav.

      The meta row is OUTSIDE the flex-1 wrapper on purpose. Do
      not merge them.

    META ROW ITEMS
      A single utility nav keeps colophon/brand on the left and
      sitemap/source/QR grouped on the right. Keep the row slim;
      it should read as a utility strip, not another content band.

    LINK STYLING
      One style everywhere: `nav-link no-underline hover:text-primary`.
      `.nav-link` provides the scaleX underline reveal. Do not
      introduce a second link style; the consistency is the point.

    WORDMARK SIZING
      The wordmark is the brand's loudest gesture, but it may shrink
      on short or narrow viewports so the footer remains usable. Its
      max width is capped against the brand display ramp (a multiple of
      --text-display-lg / --text-display-md), not a magic width, so it
      scales with the type system. Tune the local .footer-wordmark clamp
      below; do not add breakpoint-only text utilities that fight the
      footer's measured height budget.

    MISSION BAND
      Visible on every viewport, including mobile. It can and
      should scale down on narrow or short screens; do not hide
      it to solve overflow.

      No small pre-heading label. The mission band is the footer's closing
      pitch, not a labelled section — the border-top + whitespace
      above already frame it. DO NOT reintroduce a "§ The work" /
      "Mission" / pilcrow-prefixed label; those read as AI template.

      Copy is evergreen. No session dates, no year references, no
      "before the 2027 Nevada session …". The why-now timeline
      lives on /why-now; the chrome ships on every page and must
      not date itself.

    COLOPHON
      Creator attribution and build details live on /colophon. Keep
      the footer meta row as a compact utility nav; long sentences
      wrap poorly at small widths and make the footer feel careless.

    MOTION
      translateY + opacity only. No `scale()` transforms in the
      footer — they read as low-effort AI motion. The site's
      vocabulary is depth + opacity, not scale.
    ============================================================ */
}
<footer class="relative z-[60] bg-slab text-on-slab h-dvh flex flex-col">
  {
    /* Named for the View Transitions API. Latent until @view-transition
      enables cross-document transitions in global.css — harmless as a
      bare property until then. */
  }
  <div class="reveal-stripe h-2 bg-primary [view-transition-name:footer-stripe]"></div>

  {
    /* Footer is locked to exactly one dynamic viewport height (h-dvh on
      <footer>) — not a pixel taller. Stripe at top, meta row at bottom,
      and this flex-1 region centers the wordmark/link grid/mission band
      between them. overflow-hidden clips any overflow on small viewports
      rather than stretching the footer past 1dvh. */
  }
  <div data-footer-middle class="flex-1 flex flex-col justify-center w-full overflow-hidden">
    <div class="footer-primary reveal-stagger container-page w-full">
      {
        /* The wordmark can shrink on constrained viewports. See FOOTER
          CONTRACT → WORDMARK SIZING and the local CSS below. */
      }
      <div class="footer-brand reveal">
        <a
          data-footer-wordmark
          href="/"
          class="footer-wordmark no-underline block"
          aria-label={site.name}
        >
          <img
            src="/brand/lvbt-wordmark-dark.svg"
            alt=""
            width="720"
            height="190"
            class="block h-auto w-full"
          />
        </a>
      </div>
      <div class="footer-nav reveal" data-footer-nav="organization">
        <p class="text-title-md font-bold text-primary-soft">Organization</p>
        <ul class="footer-nav-list text-base font-semibold">
          <li><a href="/about" class="nav-link no-underline hover:text-primary">About</a></li>
          <li><a href="/programs" class="nav-link no-underline hover:text-primary">Programs</a></li>
          <li><a href="/projects" class="nav-link no-underline hover:text-primary">Projects</a></li>
          <li><a href="/events" class="nav-link no-underline hover:text-primary">Events</a></li>
          <li><a href="/contact" class="nav-link no-underline hover:text-primary">Contact</a></li>
          <li>
            <a
              href={site.transparency.candidUrl}
              rel="noopener"
              class="nav-link no-underline hover:text-primary">Candid</a
            >
          </li>
        </ul>
      </div>
      <div class="footer-nav reveal" data-footer-nav="get-involved">
        <p class="text-title-md font-bold text-primary-soft">Get involved</p>
        <ul class="footer-nav-list text-base font-semibold">
          <li><a href="/join" class="nav-link no-underline hover:text-primary">Join us</a></li>
          <li>
            <a href="/newsletter" class="nav-link no-underline hover:text-primary">Newsletter</a>
          </li>
          {
            site.donate.url && (
              <li>
                <a
                  href={site.donate.url}
                  rel="noopener"
                  class="nav-link no-underline hover:text-primary"
                >
                  Donate
                </a>
              </li>
            )
          }
          {
            site.social.discord && (
              <li>
                <a
                  href={site.social.discord}
                  rel="noopener"
                  class="nav-link no-underline hover:text-primary"
                >
                  Discord
                </a>
              </li>
            )
          }
          {
            site.social.instagram && (
              <li>
                <a
                  href={site.social.instagram}
                  rel="noopener"
                  class="nav-link no-underline hover:text-primary"
                >
                  Instagram
                </a>
              </li>
            )
          }
          {
            site.social.linkedin && (
              <li>
                <a
                  href={site.social.linkedin}
                  rel="noopener"
                  class="nav-link no-underline hover:text-primary"
                >
                  LinkedIn
                </a>
              </li>
            )
          }
          <li>
            <a
              href={`mailto:${site.email.general}`}
              class="nav-link no-underline hover:text-primary">Email</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-mission container-page w-full border-t border-on-slab/15">
      {
        /* No pre-heading label. No "§ The work" / "Mission" / pilcrow label.
          The mission band is the footer's closing pitch, not a
          labelled section. Copy is evergreen — no session dates,
          no year references. See FOOTER CONTRACT → MISSION BAND
          at the top of this file. */
      }
      {
        /* reveal-stat gives the headline a heavier 24px-rise entrance —
          punches in with more force than the link columns above. */
      }
      <p class="reveal-stat text-headline-lg max-w-[55ch] text-balance">
        14th-busiest bus system in the country. <span class="text-primary">Zero miles of rail.</span
        >
        Las&nbsp;Vegans deserve better. We're organizing to build it.
      </p>
    </div>
  </div>

  {
    /* META row — structurally separate from the flex-centering region
      above. The colophon carries creator/build attribution; this row
      stays a compact utility surface so narrow viewports do not get
      an ugly wrapped sentence beside the QR icon. */
  }
  <div class="footer-meta border-t border-on-slab/15">
    <p data-print-footer-summary class="hidden">
      {site.name} · {domain} · {site.email.general}
    </p>
    <section data-print-link-sheet class="hidden" aria-labelledby="print-footer-title">
      <div class="print-link-sheet__masthead">
        <div class="print-link-sheet__brand">
          <img src="/brand/lvbt-logo-dark.svg" alt="" width="260" height="260" />
          <img
            src="/brand/lvbt-wordmark-dark.svg"
            alt={site.name}
            width="720"
            height="190"
            class="print-link-sheet__wordmark"
          />
        </div>
        <div class="print-link-sheet__intro">
          <h2 id="print-footer-title" class="sr-only">{site.name} directory</h2>
          <dl class="print-link-sheet__contact-list">
            <div>
              <dt>Website</dt>
              <dd>{domain}</dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd>{site.email.general}</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="print-link-sheet__grid">
        {
          printLinkSheetSections.map((section) => (
            <div class="print-link-sheet__section">
              <ul>
                {section.links.map((link) => (
                  <li>
                    <a href={link.href}>
                      <span class="print-link-sheet__label">{link.label}</span>
                      <span class="print-link-sheet__url">
                        {typeof link.printUrl === 'string' ? (
                          link.printUrl
                        ) : Array.isArray(link.printUrl) ? (
                          link.printUrl.map((part) => (
                            <span class="print-link-sheet__chunk">{part}</span>
                          ))
                        ) : (
                          <>
                            <span>{link.printUrl.domain}</span>
                            <span class="print-link-sheet__path">{link.printUrl.path}</span>
                          </>
                        )}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div class="print-link-sheet__bottom-anchor" aria-hidden="true"></div>
    </section>
    {
      /* Single utility nav. Each link remains the focusable element so
        :focus-visible outlines hug the link text or QR glyph. */
    }
    <nav
      class="footer-utilities container-page w-full text-sm text-on-slab/60"
      aria-label="Site utilities"
    >
      <span class="footer-utility-group">
        <a href="/colophon" class="nav-link no-underline hover:text-primary">Colophon</a>
        <a href="/brand" class="nav-link no-underline hover:text-primary">Brand</a>
      </span>
      <span class="footer-utility-group">
        <a href="/sitemap" class="nav-link no-underline hover:text-primary">Sitemap</a>
        <a
          href="https://github.com/LasVegasForTransit/website"
          rel="noopener"
          class="nav-link no-underline hover:text-primary">Source</a
        >
        {
          /* Opens the QR presenter (/qr) — a chromeless deck of scan cards for
            tabling and events. Icon-only utility; the page itself is noindex.
            `.qr-portal` shares a view-transition-name with the first code on /qr
            during a `to-qr` navigation only (see global.css + route-transition.js),
            so this glyph container-transforms into the live code on the way in. */
        }
        <a
          href="/qr"
          class="qr-portal inline-flex items-center hover:text-primary"
          aria-label="Scan cards"
          title="Scan cards"
        >
          <Icon name="mdi:qrcode-scan" class="size-5" aria-hidden="true" />
        </a>
      </span>
    </nav>
  </div>
</footer>

<style>
  .footer-primary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    column-gap: clamp(2rem, 5vw, 4rem);
    row-gap: clamp(1.75rem, 4vh, 2.5rem);
    padding-block: clamp(2rem, 5vh, 4.5rem);
  }

  .footer-brand {
    grid-column: 1 / -1;
    container-type: inline-size;
  }

  .footer-wordmark {
    /* Cap the mark against the brand display ramp (8× display-lg, ~44rem at
       the ramp's max) instead of a magic width, so it scales with the type
       system. The dvh term keeps it height-aware for the h-dvh footer budget;
       it's loosened just enough that the display-lg cap can actually bind on a
       normal desktop rather than the viewport height clipping it first. */
    width: min(100%, clamp(16rem, min(78vw, 72dvh), calc(var(--text-display-lg) * 8)));
  }

  .footer-nav {
    width: auto;
    max-width: 100%;
  }

  .footer-nav-list {
    margin-top: 1.25rem;
  }

  .footer-nav-list > * + * {
    margin-top: 0.75rem;
  }

  @media (min-width: 48rem) {
    .footer-primary {
      grid-template-columns: minmax(0, 1fr) repeat(2, minmax(11rem, max-content));
      column-gap: clamp(2.5rem, 6vw, 5rem);
    }

    .footer-brand {
      grid-column: auto;
    }
  }

  .footer-mission {
    padding-block: clamp(1.25rem, var(--page-pad), 3rem);
  }

  .footer-mission p {
    font-size: clamp(1.25rem, min(4.75vw, 4.75dvh), 2.75rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .footer-utilities {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.875rem clamp(1.25rem, 5vw, 2rem);
    padding-block: 0.75rem;
    line-height: 1.25;
  }

  .footer-utility-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem clamp(1.25rem, 4vw, 2rem);
  }

  .footer-utilities .qr-portal {
    margin-inline-start: 0.125rem;
  }

  /* The mission band is only visible on viewports tall enough to fit it
     alongside the nav grid + meta row without forcing the footer past
     the viewport height. The threshold was tuned to match the natural
     height of the rest of the footer content. */
  @media (max-height: 650px) {
    .footer-primary {
      row-gap: clamp(1rem, 4dvh, 1.5rem);
      padding-block: clamp(0.75rem, 2.5dvh, 1.5rem);
    }

    .footer-wordmark {
      /* Short-viewport cap steps down a display tier (8× display-md) so the
         mark stays proportional to the ramp while the height budget tightens. */
      width: min(100%, clamp(14rem, min(72vw, 58dvh), calc(var(--text-display-md) * 8)));
    }

    .footer-nav-list {
      margin-top: 0.75rem;
    }

    .footer-nav-list > * + * {
      margin-top: 0.45rem;
    }

    .footer-mission {
      padding-block: clamp(0.75rem, 1.7dvh, 1rem);
    }

    .footer-mission p {
      font-size: clamp(1rem, min(3.75vw, 4.5dvh), 1.5rem);
      line-height: 1.05;
    }

    .footer-utilities {
      padding-block: 0.625rem;
    }
  }

  @media (max-width: 47.999rem) {
    .footer-mission p {
      max-width: 42rem;
    }
  }
</style>
