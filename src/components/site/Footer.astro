---
import { site } from '../../lib/site';
---

<footer class="relative z-[60] min-h-dvh mt-32 bg-ink text-paper flex flex-col">
  {
    /* Named for the View Transitions API. Latent on this site today —
      a follow-up will enable @view-transition { navigation: auto } in
      global.css; once it lands, the orange stripe persists visually
      across page navigations instead of cross-fading with body content.
      Harmless as a bare property until then. */
  }
  <div class="h-2 bg-accent [view-transition-name:footer-stripe]"></div>

  {
    /* Link grid + mission band centered vertically as a group within the
      dvh-tall footer. Wrapping them in a single `flex-1 + justify-center`
      container is what pushes them off the top edge — without it, the
      link grid pins to the orange bar and the mission band's own flex-1
      eats the rest of the space, leaving the top cramped and the middle
      yawning. */
  }
  <div class="flex-1 flex flex-col justify-center w-full">
    <div
      class="container-page w-full pt-12 pb-10 md:py-[clamp(2.5rem,5vh,4.5rem)] grid grid-cols-2 md:grid-cols-12 gap-10 md:gap-12"
    >
      <div class="col-span-2 md:col-span-7">
        <a href="/" class="text-display-sm md:text-display-md tracking-tight no-underline block">
          <span class="block leading-[0.9]">Las Vegans</span>
          <span class="block leading-[0.9] text-accent">for Better Transit</span>
        </a>
      </div>
      <div class="md:col-span-3">
        <p class="eyebrow text-accent-soft">Organization</p>
        <ul class="mt-5 space-y-3 text-base font-semibold">
          <li><a href="/about" class="no-underline hover:text-accent">About</a></li>
          <li><a href="/projects" class="no-underline hover:text-accent">Projects</a></li>
          <li><a href="/events" class="no-underline hover:text-accent">Events</a></li>
          <li><a href="/contact" class="no-underline hover:text-accent">Contact</a></li>
        </ul>
      </div>
      <div class="md:col-span-2">
        <p class="eyebrow text-accent-soft">Get involved</p>
        <ul class="mt-5 space-y-3 text-base font-semibold">
          <li><a href="/go" class="no-underline hover:text-accent">Join us</a></li>
          <li>
            <a href={site.donate.url} rel="noopener" class="no-underline hover:text-accent"
              >Donate</a
            >
          </li>
          <li>
            <a href={site.social.instagram} rel="noopener" class="no-underline hover:text-accent"
              >Instagram</a
            >
          </li>
          <li>
            <a href={site.social.linkedin} rel="noopener" class="no-underline hover:text-accent"
              >LinkedIn</a
            >
          </li>
          <li>
            <a href={`mailto:${site.email.general}`} class="no-underline hover:text-accent">Email</a
            >
          </li>
        </ul>
      </div>
    </div>

    <div
      class="footer-mission container-page w-full py-[clamp(2rem,5vh,4rem)] border-t border-paper/15 hidden md:block"
    >
      <p class="eyebrow text-accent-soft">§ The work</p>
      <p class="text-headline-lg mt-5 max-w-4xl">
        14th-busiest bus system in the country. <span class="text-accent">Zero miles of rail.</span> We're
        organizing the people who can change that — before the 2027 Nevada session closes the window.
      </p>
    </div>
  </div>

  <div
    class="container-page w-full py-6 border-t border-paper/15 mt-auto grid grid-cols-1 md:grid-cols-3 items-baseline gap-3 text-xs uppercase tracking-wider text-paper/60"
  >
    <span class="md:text-left">A nonprofit in Las&nbsp;Vegas, Nevada.</span>
    <a href="/sitemap" class="md:text-center underline underline-offset-4 hover:text-accent"
      >Sitemap</a
    >
    <a
      href="https://github.com/LasVegasForTransit/website"
      rel="noopener"
      class="md:text-right underline underline-offset-4 hover:text-accent"
    >
      Built in public — GitHub
    </a>
  </div>
</footer>

<style>
  /* The mission band is only visible on viewports tall enough to fit it
     alongside the nav grid + meta row without forcing the footer past
     the viewport height. The threshold was tuned to match the natural
     height of the rest of the footer content. */
  @media (max-height: 650px) {
    .footer-mission {
      display: none !important;
    }
  }
</style>
