---
import { navMain } from '../../lib/site';
const path = Astro.url.pathname;
---

{
  /* Sentinel drives data-stuck via IntersectionObserver below; cheaper
    and more reliable than listening to scroll events. */
}
<div data-header-sentinel aria-hidden="true" class="h-px"></div>
<header
  data-site-header
  class="sticky top-0 z-50 bg-paper/80 border-b border-transparent data-[stuck]:backdrop-blur-md data-[stuck]:backdrop-saturate-150 data-[stuck]:border-rule/15 transition-[border-color] duration-200 ease-out [view-transition-name:site-header]"
>
  <div class="container-page py-4 flex items-center justify-between gap-6">
    {
      /* Wordmark sits at text-xl across breakpoints: at 18px (text-lg)
        the accent "for Better Transit" reads 3.64:1 on cream, which
        passes WCAG large-text (3:1) but fails normal-text (4.5:1).
        font-extrabold qualifies as large only at ≥18.66px, so dropping
        to text-lg on mobile flipped the threshold and tanked mobile
        a11y on every paper-canvas page. text-xl (20px) clears it on
        every viewport. */
    }
    <a href="/" class="font-extrabold tracking-tight text-xl no-underline">
      <span class="block leading-none">Las Vegans</span>
      <span class="block leading-none text-accent">for Better Transit</span>
    </a>
    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm font-semibold">
        {
          navMain.map((item) => {
            const active = path.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? 'page' : undefined}
                  class="nav-link no-underline hover:text-accent"
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <a
      href="/go"
      class="press hidden md:inline-flex items-center gap-1.5 bg-ink text-paper px-4 py-2 text-sm font-bold no-underline hover:bg-accent"
    >
      Get involved <span class="arrow" aria-hidden="true">→</span>
    </a>
    {/* Mobile controls: Join CTA (hidden when nav open) + hamburger toggle */}
    <div class="md:hidden flex items-center gap-3">
      <a
        href="/join"
        data-mobile-join
        class="press inline-flex items-center gap-1.5 bg-ink text-paper px-4 py-2 text-sm font-bold no-underline hover:bg-accent"
      >
        Join <span class="arrow" aria-hidden="true">→</span>
      </a>
      <button
        data-nav-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav-overlay"
        class="flex flex-col items-center justify-center gap-[5px] p-2 -mr-2 w-10 h-10"
      >
        <span class="block w-5 h-[1.5px] rounded-[1px] bg-current" aria-hidden="true"></span>
        <span class="block w-5 h-[1.5px] rounded-[1px] bg-current" aria-hidden="true"></span>
        <span class="block w-5 h-[1.5px] rounded-[1px] bg-current" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

{/* Full-screen mobile nav overlay — sits beneath the sticky header */}
<nav
  id="mobile-nav-overlay"
  data-nav-overlay
  aria-label="Mobile navigation"
  inert
  class="md:hidden fixed left-0 right-0 bottom-0 bg-paper z-[65] flex flex-col overflow-y-auto"
  style="top: var(--lvbt-header-h)"
>
  <ul class="flex-1 list-none m-0 px-6 py-2">
    {
      navMain
        .filter((item) => item.href !== '/join')
        .map((item) => {
          const active = path.startsWith(item.href);
          return (
            <li class="border-b border-rule/15">
              <a
                href={item.href}
                aria-current={active ? 'page' : undefined}
                class="flex items-center py-5 text-2xl font-extrabold tracking-tight no-underline hover:text-accent aria-[current=page]:text-accent"
              >
                {item.label}
              </a>
            </li>
          );
        })
    }
  </ul>
  <div class="px-6 pb-8 pt-4">
    <a
      href="/go"
      class="press flex items-center justify-center gap-1.5 bg-ink text-paper py-4 text-sm font-bold no-underline hover:bg-accent"
    >
      Get involved <span class="arrow" aria-hidden="true">→</span>
    </a>
  </div>
</nav>

{
  /* Sourced from public/scripts/ rather than written inline because the
     site's CSP is `script-src 'self'` (see public/_headers) — an inline
     observer here would silently fail in production, leaving the header
     without its bottom border on scroll and breaking the vision page's
     transparent→cream color flip. Astro inlines short hoisted <script>
     tags too, so going through public/ is the only reliable way to keep
     the script same-origin and CSP-allowed. */
}
<script is:inline src="/scripts/header-stuck.js" defer></script>
<script is:inline src="/scripts/mobile-nav.js" defer></script>
