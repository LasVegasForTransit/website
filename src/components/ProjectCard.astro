---
import StatusPill from './StatusPill.astro';
import InitiativeChip from './InitiativeChip.astro';
import { site } from '../lib/site';
import { displayUrl } from '../lib/paths';

interface Props {
  href: string;
  title: string;
  status: 'active' | 'planned' | 'complete' | 'paused';
  tldr: string;
  initiatives: { title: string }[];
}
const { href, title, status, tldr, initiatives } = Astro.props;
const printDomain = displayUrl(site.url);
---

<a
  href={href}
  data-print-card
  data-print-url={href}
  class="lift group block border border-outline bg-surface-container p-6 md:p-8 no-underline hover:bg-slab hover:text-on-slab"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-title-lg flex-1">{title}</h3>
    <StatusPill status={status} />
  </div>
  <p class="mt-6 text-body-md leading-snug text-balance">{tldr}</p>
  <p data-print-card-url>
    <span data-print-link>
      {printDomain}<span data-print-link-path>{href}</span>
    </span>
  </p>
  {
    initiatives.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-2">
        {initiatives.map((i) => (
          <InitiativeChip title={i.title} />
        ))}
      </div>
    )
  }
  <p class="mt-8 text-sm font-bold">Read the brief →</p>
</a>
