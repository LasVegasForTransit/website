---
interface Props {
  title: string;
  href?: string;
  active?: boolean;
}
const { title, href, active = false } = Astro.props;
const Tag = href ? 'a' : 'span';
const variant = active ? 'active' : 'default';

const styles: Record<'active' | 'default', string> = {
  active:
    'bg-slab text-on-slab border-slab group-hover:bg-on-slab group-hover:text-slab group-hover:border-on-slab',
  default:
    'bg-transparent text-on-surface border-outline-variant/30 hover:border-outline group-hover:text-on-slab group-hover:border-on-slab/50',
};
---

<Tag
  href={href}
  class:list={[
    'press inline-flex items-center px-3 py-1 text-xs font-semibold border no-underline transition-colors',
    styles[variant],
  ]}
>
  {title}
</Tag>
