---
// The "Live now" / "Today" badge pill, shared by EventCard and the event
// detail page so the markup and the live-vs-today color classes stay in one
// place — they're the contract the client script (src/scripts/event-relative.ts)
// toggles at view time. Callers own the surrounding `[data-event-badge]`
// wrapper (a card uses an inline span, the detail header a block <p>); this
// renders only the pill itself.
import type { RelativeLabel } from '../lib/event-time';

interface Props {
  relative: RelativeLabel;
}

const { relative } = Astro.props;
const isUrgent = relative?.kind === 'live' || relative?.kind === 'today';
---

<span
  data-event-badge-pill
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-bold',
    relative?.kind === 'live' ? 'bg-accent text-paper' : 'bg-accent-soft text-ink',
  ]}
>
  <span
    data-event-badge-dot
    aria-hidden="true"
    hidden={relative?.kind !== 'live'}
    class="size-1.5 rounded-full bg-paper animate-pulse"></span>
  <span data-event-badge-text>{isUrgent && relative ? relative.text : ''}</span>
</span>
