---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NewsletterCard from '../components/NewsletterCard.astro';
import NewsletterEmbed from '../components/NewsletterEmbed.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';

// Issues come from the Beehiiv RSS feed (see src/lib/newsletter-loader.ts).
// The feed re-pulls on the twice-daily production rebuild, so new issues land
// within ~12h of publishing. We list issues here but link out to Beehiiv —
// nothing is hosted on this domain.
const posts = (await getCollection('newsletter')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="Newsletter"
  description="Member updates on events, transit news, and ways to take action, delivered straight to your inbox."
>
  <PageHero
    title="Newsletter"
    lede="The newsletter covers upcoming events, transit news from around the Valley, and ways to take action."
  >
    {
      site.newsletter.url && (
        <p class="mt-6">
          <a
            href={site.newsletter.url}
            data-print-plain-link
            data-print-url={site.newsletter.url}
            rel="noopener"
            target="_blank"
            class="press inline-flex items-center gap-2 bg-on-surface px-7 py-4 font-bold text-surface no-underline hover:bg-primary hover:text-on-primary focus-visible:bg-primary focus-visible:text-on-primary"
          >
            Read every issue
          </a>
        </p>
      )
    }
  </PageHero>
  <hr class="rule-thick container-page" />

  <section class="container-page py-12">
    <h2 class="sr-only">Newsletter issues and subscription</h2>
    {
      posts.length === 0 ? (
        <div class="max-w-2xl space-y-6">
          <p class="lede">
            Our first issue is on the way. Subscribe and we'll send it to your inbox before it goes
            anywhere else.
          </p>
          <NewsletterEmbed />
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <NewsletterCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
