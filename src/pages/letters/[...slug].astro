---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarkdownRule from '../../components/MarkdownRule.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { letterSchema } from '../../lib/structured-data';
import { paths, canonicalUrl } from '../../lib/paths';

export async function getStaticPaths() {
  const letters = await getCollection('letters');
  return letters.map((letter) => ({
    params: { slug: letter.id },
    props: { letter },
  }));
}

const { letter } = Astro.props;
const { Content } = await render(letter);
const letterUrl = canonicalUrl(Astro.url.pathname);

// `date` is authored as a plain calendar date (no time-of-day), so format in
// UTC — the zone it was coerced in — rather than a local zone that could
// shift it back a day.
const dateLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(letter.data.date);
---

<BaseLayout
  title={letter.data.title}
  description={letter.data.summary}
  ogType="article"
  articlePublishedTime={letter.data.date.toISOString()}
  articleAuthor={letter.data.author}
>
  <StructuredData slot="head" data={letterSchema(letter, letterUrl)} />

  <div class="mx-auto max-w-4xl px-5 pt-8 pb-16 md:pt-12 md:pb-24">
    <Breadcrumbs section={{ name: 'Letters', href: paths.letters }} current={letter.data.title} />

    <article class="border border-outline bg-surface-container p-8 md:p-12">
      <header class="border-b border-outline-variant/20 pb-6">
        <h1 class="text-headline-lg text-balance">{letter.data.title}</h1>
        <p class="mt-3 text-body-sm font-semibold text-on-surface-variant">
          {letter.data.author}, {letter.data.authorTitle} ·{' '}
          <time datetime={letter.data.date.toISOString()}>{dateLabel}</time>
        </p>
      </header>

      <div class="prose prose-lg mt-8 max-w-none">
        <Content components={{ hr: MarkdownRule }} />
      </div>
    </article>
  </div>
</BaseLayout>
