---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../lib/site';
import { generalInterestMailto } from '../lib/role-mailto';

const roles = (await getCollection('roles')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);
---

<BaseLayout
  title="Join"
  description="Become a member or join the team at Las Vegans for Better Transit."
>
  <header class="container-page pt-20 pb-12 md:pt-28 md:pb-16">
    <div class="max-w-4xl">
      <h1 class="text-headline-lg">Join Las&nbsp;Vegans for Better Transit.</h1>
      <p class="lede mt-6 max-w-2xl">
        Whether you want to be a supporter on record or take on a real operational role, this is
        where you start.
      </p>
      <div class="mt-8 flex flex-wrap gap-6">
        <a
          href="#membership"
          class="font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent"
        >
          Become a member ↓
        </a>
        <a
          href="#team"
          class="font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent"
        >
          Join the team ↓
        </a>
      </div>
    </div>
  </header>
  <hr class="rule-thick container-page" />

  {/* MEMBERSHIP */}
  <section id="membership" class="container-page py-16 md:py-24">
    <h2 class="text-headline-md max-w-3xl">Become a member.</h2>
    <div class="mt-6 max-w-2xl space-y-4 leading-relaxed">
      <p>
        Membership is free and takes a minute. Fill out the membership form and you're on the rolls.
      </p>
      <p>
        You'll get our newsletter — the easiest way to keep up with the 2028 service cuts, the 2027
        legislative session, and the times we need people to show up. And the more members we have,
        the more weight we carry: when we meet with officials, the number of people behind us is
        part of the argument.
      </p>
    </div>
    <div class="mt-8">
      {
        site.membership.formUrl ? (
          <a
            href={site.membership.formUrl}
            target="_blank"
            rel="noopener"
            class="press inline-flex items-center gap-1.5 bg-ink text-paper px-6 py-3 font-bold no-underline hover:bg-accent"
          >
            Become a member{' '}
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        ) : (
          <p class="leading-relaxed">
            Our membership form isn't available right now. Email{' '}
            <a
              href={generalInterestMailto()}
              class="font-bold underline underline-offset-4 decoration-2 decoration-accent"
            >
              {site.email.general}
            </a>{' '}
            and we'll add you.
          </p>
        )
      }
    </div>
  </section>

  {/* TEAM */}
  <section id="team" class="container-page py-16 md:py-24">
    <h2 class="text-headline-md max-w-3xl">Join the team.</h2>
    <p class="lede mt-6 max-w-2xl">
      We're a small team taking on a big problem. Every role here is real work — and if none of
      these fit exactly, we'll find one that does.
    </p>

    <div class="mt-10 border-t border-ink/15">
      {
        roles.map((role) => (
          <div class="py-6 border-b border-ink/15 flex flex-col md:flex-row md:items-baseline gap-4 md:gap-8 reveal">
            <div class="md:w-52 shrink-0">
              <a
                href={`/join/${role.id}`}
                class="text-title-lg font-bold hover:text-accent transition-colors"
              >
                {role.data.title}
              </a>
              <p class="mt-1 text-sm font-bold uppercase tracking-wider opacity-60">
                {role.data.commitment}
              </p>
            </div>
            <p class="flex-1 leading-relaxed">{role.data.summary}</p>
            <a
              href={`/join/${role.id}`}
              class="shrink-0 text-sm font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent"
            >
              View role →
            </a>
          </div>
        ))
      }
    </div>

    <div class="pt-10 mt-12">
      <h3 class="text-title-lg">Not sure where you fit in?</h3>
      <p class="mt-3 leading-relaxed max-w-xl">Get in touch, and we'll find a role for you.</p>
      <a
        href={generalInterestMailto()}
        class="inline-block mt-6 font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent"
      >
        Email {site.email.general} →
      </a>
    </div>
  </section>
</BaseLayout>
