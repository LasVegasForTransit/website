---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { byOrderThenTitle, isActiveProject } from '../lib/projects';
import { paths } from '../lib/paths';

type ProgramEntry = CollectionEntry<'programs'>;

const projects = await getCollection('projects', (entry) => !entry.id.startsWith('_'));
const programs = await getCollection('programs', (entry) => !entry.id.startsWith('_'));
const projectsById = new Map(projects.map((project) => [project.id, project]));

const getProjectEntries = (program: ProgramEntry) =>
  program.data.projects
    .map((id) => {
      const project = projectsById.get(id);

      if (!project) {
        throw new Error(`Program "${program.id}" references missing project "${id}".`);
      }

      return project;
    })
    .filter(isActiveProject)
    .sort(byOrderThenTitle);

const renderedPrograms = await Promise.all(
  programs
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (program) => ({
      ...program,
      Content: (await render(program)).Content,
      projectEntries: getProjectEntries(program),
    })),
);
---

<BaseLayout
  title="Programs"
  description="LVBT's ongoing work for advocating for transit in Southern Nevada."
>
  <PageHero
    title="Our programs"
    lede="LVBT's ongoing work for advocating for transit in Southern Nevada."
  />

  <div class="container-page">
    <hr class="rule-thick" />
  </div>

  <div class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div>
      <section aria-labelledby="program-directory">
        <h2 id="program-directory" class="sr-only">Program directory</h2>

        <div class="grid gap-16 md:gap-20 lg:gap-28 xl:gap-36">
          {
            renderedPrograms.map((program) => (
              <article
                id={program.id}
                class="grid min-w-0 scroll-mt-24 gap-8 lg:grid-cols-[minmax(14rem,22.5rem)_minmax(0,1fr)] lg:gap-10"
              >
                <div class="min-w-0 lg:sticky lg:top-24 lg:self-start">
                  <span
                    class="inline-flex size-16 items-center justify-center bg-slab text-on-slab"
                    aria-hidden="true"
                  >
                    <Icon name={program.data.icon} class="size-9" />
                  </span>
                  <h3 class="mt-6 text-headline-lg">{program.data.title}</h3>
                  <p class="mt-4 max-w-xl text-body-lg leading-relaxed text-on-surface-variant text-pretty">
                    {program.data.summary}
                  </p>
                </div>

                <div class="min-w-0">
                  <div>
                    <h4 class="text-title-lg">Overview</h4>
                    <div class="prose-doc mt-4 max-w-[72ch] text-on-surface-variant">
                      <program.Content />
                    </div>
                  </div>

                  {program.projectEntries.length > 0 && (
                    <div class="mt-8">
                      <h4 class="text-title-lg">Projects</h4>
                      <ul
                        class="mt-4 grid min-w-0 max-w-[49rem] gap-4 md:grid-cols-2"
                        data-print-stack-list
                      >
                        {program.projectEntries.map((project) => (
                          <li>
                            <a
                              href={paths.project(project.id)}
                              data-print-keep-together
                              class="group block h-full min-w-0 border border-outline-variant/20 bg-surface-container p-4 no-underline transition-colors hover:bg-slab hover:text-on-slab focus-visible:bg-slab focus-visible:text-on-slab"
                            >
                              <span class="font-bold leading-tight">{project.data.title}</span>
                              <span class="mt-2 block text-sm leading-relaxed text-on-surface-variant text-pretty group-hover:text-on-slab/75 group-focus-visible:text-on-slab/75">
                                {project.data.tldr}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {program.data.cohorts.length > 0 && (
                    <div class="mt-8">
                      <h4 class="text-title-lg">Cohorts</h4>
                      <ul class="mt-4 grid gap-4 lg:grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),24rem))]">
                        {program.data.cohorts.map((cohort) => (
                          <li class="border border-outline-variant/20 bg-surface-container p-4">
                            <p class="font-bold leading-tight">
                              {cohort.name}
                              <span class="font-normal text-on-surface-variant">
                                {' '}
                                — {cohort.status}
                              </span>
                            </p>
                            <p class="mt-2 text-sm leading-relaxed text-on-surface-variant text-pretty">
                              {cohort.description}
                            </p>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="pt-16 md:pt-20 lg:pt-28 xl:pt-36" aria-labelledby="project-roadmap">
        <div
          class="relative grid overflow-hidden border border-outline bg-surface-container md:grid-cols-[minmax(0,1fr)_18rem]"
        >
          <span class="absolute inset-y-0 left-0 w-2 bg-primary" aria-hidden="true"></span>

          <div class="min-w-0 p-6 pl-10 md:p-8 md:pl-12 lg:p-10 lg:pl-14">
            <p class="text-title-sm font-bold text-on-surface-variant">From programs to projects</p>
            <h2 id="project-roadmap" class="mt-3 text-headline-lg">Project roadmap</h2>
            <p
              class="mt-5 max-w-[64ch] text-body-lg leading-relaxed text-on-surface-variant text-pretty"
            >
              See the campaigns, tools, research, outreach work, and events that turn these program
              areas into public work.
            </p>
          </div>

          <a
            href="/projects"
            class="group flex min-w-0 flex-col justify-between bg-slab p-6 text-on-slab no-underline transition-colors hover:bg-primary hover:text-on-primary focus-visible:bg-primary focus-visible:text-on-primary md:p-8"
          >
            <span class="flex items-center justify-between gap-4 text-title-lg">
              Browse projects
              <Icon
                name="mdi:arrow-right"
                class="arrow size-6 shrink-0 transition-transform"
                aria-hidden="true"
              />
            </span>
            <span
              class="mt-8 block text-sm leading-relaxed text-on-slab/75 group-hover:text-on-primary/80 group-focus-visible:text-on-primary/80"
            >
              Campaigns, tools, reports, outreach, and events.
            </span>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
