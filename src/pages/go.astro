---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterEmbed from '../components/NewsletterEmbed.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../lib/site';
import { handleFromUrl } from '../lib/social';

const instagramHandle = handleFromUrl(site.social.instagram);
const blueskyHandle = handleFromUrl(site.social.bluesky);

// Membership is the page's primary conversion: link straight to the intake
// form when configured, falling back to the /join membership section (an
// always-valid internal route) rather than a stale literal.
const membershipUrl = site.membership.formUrl;
const membershipHref = membershipUrl ?? '/join#membership';

const leadProjectMailto = `mailto:${site.email.general}?subject=Project%20lead%20interest`;
const partnerMailto = `mailto:${site.email.partners}?subject=Partnership%20inquiry`;
---

<BaseLayout
  title="Get involved"
  description="Follow our progress, become a member, or support the work."
>
  <header class="container-page pt-20 pb-12 md:pt-28 md:pb-16">
    <div class="max-w-4xl">
      <h1 class="text-display-md">Get involved.</h1>
      <p class="lede mt-6 max-w-2xl">However much you can give, there's a way to help below.</p>
    </div>
  </header>
  <hr class="rule-thick container-page" />

  {/* FOLLOW — the channels we actually run lead; Bluesky and LinkedIn trail */}
  <section class="container-page py-12 md:py-16">
    <h2 class="text-headline-md">Follow our progress.</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-pretty">
      Following along is the easiest way to keep up with the campaign and to hear when we need
      people to show up.
    </p>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {
        site.social.instagram && (
          <a
            href={site.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col border border-ink bg-paper p-6 no-underline transition-colors hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper"
          >
            <Icon
              name="mdi:instagram"
              class="size-10 text-accent-ink group-hover:text-accent-soft group-focus-visible:text-accent-soft"
              aria-hidden="true"
            />
            <p class="text-title-lg mt-3">Instagram</p>
            {instagramHandle && (
              <p class="mt-1 text-sm font-semibold text-accent-ink group-hover:text-accent-soft group-focus-visible:text-accent-soft">
                {instagramHandle}
              </p>
            )}
            <p class="mt-2 text-sm text-mute leading-relaxed text-pretty group-hover:text-paper/80 group-focus-visible:text-paper/80">
              Our main place for updates and event news. We post here most days.
            </p>
            <span class="mt-auto pt-4 text-sm font-bold uppercase tracking-wider">Follow us →</span>
          </a>
        )
      }
      {
        site.social.discord && (
          <a
            href={site.social.discord}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col border border-ink bg-paper p-6 no-underline transition-colors hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper"
          >
            <Icon
              name="mdi:discord"
              class="size-10 text-accent-ink group-hover:text-accent-soft group-focus-visible:text-accent-soft"
              aria-hidden="true"
            />
            <p class="text-title-lg mt-3">Discord</p>
            <p class="mt-2 text-sm text-mute leading-relaxed text-pretty group-hover:text-paper/80 group-focus-visible:text-paper/80">
              Where members talk and we plan the work. Pop in anytime.
            </p>
            <span class="mt-auto pt-4 text-sm font-bold uppercase tracking-wider">
              Join the server →
            </span>
          </a>
        )
      }
      <div id="newsletter" class="flex flex-col border border-ink bg-paper p-6 scroll-mt-24">
        <Icon name="mdi:email-outline" class="size-10 text-accent-ink" aria-hidden="true" />
        <p class="text-title-lg mt-3">Newsletter</p>
        <p class="mt-2 text-sm text-mute leading-relaxed text-pretty">
          Updates and ways to show up, sent to your inbox.
        </p>
        <div class="mt-auto pt-4">
          <NewsletterEmbed compact stack />
        </div>
      </div>
    </div>

    {
      (site.social.bluesky || site.social.linkedin) && (
        <div class="mt-4 flex flex-wrap gap-3">
          {site.social.bluesky && (
            <a
              href={site.social.bluesky}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex w-full items-center gap-3 border border-ink bg-paper px-4 py-3 no-underline transition-colors hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper sm:w-[280px]"
            >
              <Icon
                name="bluesky"
                class="size-6 text-mute group-hover:text-accent-soft group-focus-visible:text-accent-soft"
                aria-hidden="true"
              />
              <span class="flex flex-col">
                <span class="font-bold leading-tight">Bluesky</span>
                {blueskyHandle && (
                  <span class="text-xs text-mute group-hover:text-paper/70 group-focus-visible:text-paper/70">
                    {blueskyHandle}
                  </span>
                )}
              </span>
            </a>
          )}
          {site.social.linkedin && (
            <a
              href={site.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex w-full items-center gap-3 border border-ink bg-paper px-4 py-3 no-underline transition-colors hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper sm:w-[280px]"
            >
              <Icon
                name="mdi:linkedin"
                class="size-6 text-mute group-hover:text-accent-soft group-focus-visible:text-accent-soft"
                aria-hidden="true"
              />
              <span class="flex flex-col">
                <span class="font-bold leading-tight">LinkedIn</span>
                <span class="text-xs text-mute group-hover:text-paper/70 group-focus-visible:text-paper/70">
                  Company page
                </span>
              </span>
            </a>
          )}
        </div>
      )
    }
  </section>

  {/* BECOME A MEMBER — the primary conversion, given the dark band for weight */}
  <section class="bg-ink text-paper">
    <div class="container-page py-32 md:py-48">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-headline-md">Become a member.</h2>
          <p class="mt-4 max-w-xl text-paper/80 leading-relaxed text-pretty">
            Join the community pushing for better transit and better neighborhoods in the
            Las&nbsp;Vegas area. Becoming a member strengthens the case we make to public servants
            and elected officials, since the number of people behind us is part of that case. LVBT
            holds virtual general meetings on the second Thursday of each month at 6&nbsp;p.m.
          </p>
          <p class="mt-4 max-w-xl text-paper/80 leading-relaxed text-pretty">
            LVBT membership is free and only takes a minute.
          </p>
        </div>
        <div class="md:justify-self-end">
          <a
            href={membershipHref}
            target={membershipUrl ? '_blank' : undefined}
            rel={membershipUrl ? 'noopener noreferrer' : undefined}
            class="press inline-flex items-center gap-2 bg-accent text-ink px-7 py-4 font-bold no-underline"
          >
            Sign up
            <Icon name="mdi:arrow-right" class="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* SUPPORT — give time or money; partnerships and project leads sit beneath */}
  <section class="container-page py-16 md:py-24">
    <h2 class="text-headline-md">Support our work.</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-pretty">
      We are entirely volunteer-run. Support our mission by giving your time or money.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <a
        href="/join#team"
        class="group flex flex-col gap-2 border border-ink bg-paper p-6 no-underline transition-colors hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper"
      >
        <Icon
          name="mdi:account-group-outline"
          class="size-10 text-accent-ink group-hover:text-accent-soft group-focus-visible:text-accent-soft"
          aria-hidden="true"
        />
        <p class="text-title-lg">Volunteer</p>
        <p
          class="text-mute leading-relaxed text-pretty group-hover:text-paper/80 group-focus-visible:text-paper/80"
        >
          Take on a real role on the team. We train you and have your back.
        </p>
        <span
          class="mt-auto pt-4 text-sm font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent"
        >
          See open roles →
        </span>
      </a>
      {
        site.donate.url && (
          <a
            href={site.donate.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col gap-2 border border-ink bg-paper p-6 no-underline transition-colors hover:bg-ink hover:text-paper focus-visible:bg-ink focus-visible:text-paper"
          >
            <Icon
              name="mdi:hand-heart-outline"
              class="size-10 text-accent-ink group-hover:text-accent-soft group-focus-visible:text-accent-soft"
              aria-hidden="true"
            />
            <p class="text-title-lg">Donate</p>
            <p class="text-mute leading-relaxed text-pretty group-hover:text-paper/80 group-focus-visible:text-paper/80">
              Your donations pay for yard signs, printed reports, and organizer time.
            </p>
            <span class="mt-auto pt-4 text-sm font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent">
              Give on Givebutter →
            </span>
          </a>
        )
      }
    </div>

    <div class="mt-10 grid gap-8 border-t border-ink/15 pt-8 sm:grid-cols-2">
      <div>
        <h3 class="text-title-lg">Lead a project</h3>
        <p class="mt-1 text-mute leading-relaxed text-pretty">
          Project leads run outreach in one community they know well. Email us if that's you.
        </p>
        <a
          href={leadProjectMailto}
          class="mt-3 inline-block text-sm font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent"
        >
          Email us →
        </a>
      </div>
      <div>
        <h3 class="text-title-lg">Partner with us</h3>
        <p class="mt-1 text-mute leading-relaxed text-pretty">
          LVBT welcomes opportunities to build a coalition with other community organizations. If
          you represent a union, a business, a school, or a nonprofit, we would love to build a
          relationship with you.
        </p>
        <a
          href={partnerMailto}
          class="mt-3 inline-block text-sm font-bold uppercase tracking-wider underline underline-offset-4 decoration-2 decoration-accent"
        >
          Get in touch →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
