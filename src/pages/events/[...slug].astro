---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import ShareButton from '../../components/ShareButton.astro';
import { eventSchema } from '../../lib/structured-data';
import { site } from '../../lib/site';
import { getCollection, getEntry, render } from 'astro:content';
import { whereLabel } from '../../lib/event-format';
import { relativeLabel } from '../../lib/event-time';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
// Two possible body sources, in priority order:
//
//   1. An MDX fragment under src/content/event-bodies/<slug>.mdx —
//      authored explicitly when an event needs MDX features (components,
//      typed links).
//   2. event.data.body — the HTML the loader extracted from everything
//      after the first paragraph of the GCal description.
//
// Most events ship with just the header; a body only renders when one
// of these sources is present.
const fragment = await getEntry('eventBodies', event.id);
const FragmentContent = fragment ? (await render(fragment)).Content : null;
const calendarBodyHtml = !FragmentContent && event.data.body ? event.data.body : null;
const eventUrl = new URL(Astro.url.pathname, site.url).toString();

const dateLabel = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Los_Angeles',
}).format(event.data.date);
const timeLabel = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/Los_Angeles',
  timeZoneName: 'short',
}).format(event.data.date);

// CTA visibility is purely format-driven now — no URL pattern sniffing. A
// virtual or hybrid event with a joinUrl shows "Join"; any event with an
// rsvpUrl shows "RSVP". Both can be shown together for hybrid events that
// also gate attendance behind a separate registration.
const showJoin = event.data.format !== 'in-person' && event.data.joinUrl !== undefined;
const showRsvp = event.data.rsvpUrl !== undefined;

// "Live now" / "Today" derive from the event's PT day — see lib/event-time.
// Other relative kinds (Tomorrow / In N days / Next week) render inline
// next to the When data rather than as a badge.
const relative = relativeLabel(event.data);
const isUrgent = relative?.kind === 'live' || relative?.kind === 'today';
const inlineRelative = relative && !isUrgent ? relative.text : null;

const icsHref = `/events/${event.id}.ics`;
---

<BaseLayout title={event.data.title} description={event.data.summary}>
  <StructuredData slot="head" data={eventSchema(event, eventUrl)} />
  {
    /* Header padding is intentionally compact on every viewport so the
      first paragraphs of the body peek below the fold — a visitor
      landing on /events/<id> needs a visible signal that there's more
      to read. The rule-thick separator below ends the header section,
      matching the brand motif used across every other page. */
  }
  <header class="container-page pt-6 pb-8 md:pt-14 md:pb-10">
    <p class="eyebrow"><a href="/events" class="no-underline hover:underline">← All events</a></p>
    {
      /* Headline-lg on mobile keeps "General Meeting" on one line;
        display-md on desktop is large enough to anchor the page but
        doesn't push the body content below the fold the way display-lg
        did (display-lg clamps to 5.5rem and ate the entire viewport). */
    }
    {
      /* Live now / Today badge — derived from the event's PT day vs
        now. Renders only when the event is live or today; absent
        otherwise so the badge isn't decorative chrome on every page. */
    }
    {
      isUrgent && relative && (
        <p class="mt-4 md:mt-5">
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-bold uppercase tracking-wider',
              relative.kind === 'live' ? 'bg-accent text-paper' : 'bg-accent-soft text-ink',
            ]}
          >
            {relative.kind === 'live' && (
              <span aria-hidden="true" class="size-1.5 rounded-full bg-paper animate-pulse" />
            )}
            {relative.text}
          </span>
        </p>
      )
    }
    <h1
      class:list={[
        'text-headline-lg md:text-display-md',
        isUrgent ? 'mt-3 md:mt-4' : 'mt-4 md:mt-5',
      ]}
    >
      {event.data.title}
    </h1>
    <p class="lede mt-4 md:mt-6 max-w-2xl">{event.data.summary}</p>

    {
      /* When/Where carries the format affordance now — "Online" tells the
        visitor it's virtual, a venue name tells them it's in-person. The
        format pill above the title was redundant with this dl and has
        been removed. */
    }
    <dl class="mt-8 md:mt-10 grid grid-cols-2 gap-x-8 gap-y-5 md:gap-y-6 max-w-2xl">
      <div>
        <dt class="eyebrow">When</dt>
        <dd class="mt-1 text-base font-semibold">
          <time datetime={event.data.date.toISOString()}>{dateLabel} · {timeLabel}</time>
          {
            inlineRelative && (
              <span class="ml-2 font-normal text-[color:var(--color-mute)]">
                · {inlineRelative}
              </span>
            )
          }
        </dd>
      </div>
      <div>
        <dt class="eyebrow">Where</dt>
        <dd class="mt-1 text-base font-semibold">{whereLabel(event.data)}</dd>
      </div>
    </dl>

    {
      /* Action row sits AFTER the When/Where data so the visitor has read
        what the event is and where/when it's happening before being asked
        to commit. A definition list (dl) is for data — a button isn't
        data, so it lives outside the dl with no eyebrow restating the
        button text. Order: primary (Join) → registration (RSVP) →
        utility (Add to calendar, Share). */
    }
    {
      /* `.press` (global.css) is the sitewide button gesture — 200ms
        ease-out color transition + 1px press-down on :active. Every
        action button uses it so hover/active feel uniform with the
        Subscribe / Donate CTAs elsewhere on the site. */
    }
    <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-3">
      {
        showJoin && (
          <a
            href={event.data.joinUrl}
            class="press inline-flex items-center bg-accent text-ink px-5 py-3 text-sm font-bold uppercase tracking-wider no-underline hover:bg-ink hover:text-paper"
            rel="noopener"
          >
            Join →
          </a>
        )
      }
      {
        showRsvp && (
          <a
            href={event.data.rsvpUrl}
            class="press inline-flex items-center border-2 border-ink px-5 py-3 text-sm font-bold uppercase tracking-wider no-underline hover:bg-ink hover:text-paper"
            rel="noopener"
          >
            RSVP →
          </a>
        )
      }
      <a
        href={icsHref}
        class="press inline-flex items-center border-2 border-ink px-5 py-3 text-sm font-bold uppercase tracking-wider no-underline hover:bg-ink hover:text-paper"
      >
        Add to calendar →
      </a>
      <ShareButton
        url={eventUrl}
        title={event.data.title}
        text={event.data.summary}
        class="press"
      />
    </div>
  </header>
  {
    (FragmentContent || calendarBodyHtml) && (
      <>
        <hr class="rule-thick container-page" />
        <div class="container-prose pt-8 pb-16 md:pt-10 md:pb-16 prose-doc">
          {FragmentContent ? <FragmentContent /> : <div set:html={calendarBodyHtml!} />}
        </div>
      </>
    )
  }
</BaseLayout>
