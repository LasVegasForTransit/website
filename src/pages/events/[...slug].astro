---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import EventFormatPill from '../../components/EventFormatPill.astro';
import { eventSchema } from '../../lib/structured-data';
import { site } from '../../lib/site';
import { getCollection, render } from 'astro:content';
import { whereLabel } from '../../lib/event-format';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => !e.id.startsWith('_'));
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const eventUrl = new URL(Astro.url.pathname, site.url).toString();

const dateLabel = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'America/Los_Angeles',
}).format(event.data.date);
const timeLabel = new Intl.DateTimeFormat('en-US', {
  hour: 'numeric',
  minute: '2-digit',
  timeZone: 'America/Los_Angeles',
}).format(event.data.date);

// CTA visibility is purely format-driven now — no URL pattern sniffing. A
// virtual or hybrid event with a joinUrl shows "Join"; any event with an
// rsvpUrl shows "RSVP". Both can be shown together for hybrid events that
// also gate attendance behind a separate registration.
const showJoin = event.data.format !== 'in-person' && event.data.joinUrl !== undefined;
const showRsvp = event.data.rsvpUrl !== undefined;
---

<BaseLayout title={event.data.title} description={event.data.summary}>
  <StructuredData slot="head" data={eventSchema(event, eventUrl)} />
  {
    /* Header padding is intentionally aggressive on mobile so the body
      content starts above the fold on short viewports — otherwise an
      iPhone SE class device lands on what looks like a complete card with
      no signal that there's more to scroll. Restore the wider rhythm at md+
      where the viewport has room to breathe. */
  }
  <header class="container-page pt-10 pb-8 md:pt-28 md:pb-12">
    <p class="eyebrow"><a href="/events" class="no-underline hover:underline">← All events</a></p>
    <div class="mt-5 md:mt-6">
      <EventFormatPill format={event.data.format} size="md" />
    </div>
    {
      /* Display-lg clamps to 2.5rem on small viewports, which forces a
        two-word title like "General Meeting" onto two lines and burns
        ~80px of vertical space. Headline-lg fits one line at common
        mobile widths; display-lg returns at md+ where it earns its size. */
    }
    <h1 class="text-headline-lg md:text-display-lg mt-3 md:mt-4">{event.data.title}</h1>
    <p class="lede mt-4 md:mt-6 max-w-2xl">{event.data.summary}</p>

    {
      /* Action row sits between the summary and the when/where data so the
        primary call-to-act is the next thing a visitor sees after reading
        what the event is. A definition list (dl) is for data — a button
        isn't data, so it shouldn't live inside the dl with a dt label
        that just restates the button text. */
    }
    {
      (showJoin || showRsvp) && (
        <div class="mt-6 md:mt-8 flex flex-wrap items-center gap-3">
          {showJoin && (
            <a
              href={event.data.joinUrl}
              class="inline-flex items-center bg-accent text-ink px-5 py-3 text-sm font-bold uppercase tracking-wider no-underline hover:bg-ink hover:text-paper"
              rel="noopener"
            >
              Join →
            </a>
          )}
          {showRsvp && (
            <a
              href={event.data.rsvpUrl}
              class="inline-flex items-center border-2 border-ink px-5 py-3 text-sm font-bold uppercase tracking-wider no-underline hover:bg-ink hover:text-paper"
              rel="noopener"
            >
              RSVP →
            </a>
          )}
        </div>
      )
    }

    <dl class="mt-8 md:mt-10 grid grid-cols-2 gap-x-8 gap-y-5 md:gap-y-6 max-w-2xl">
      <div>
        <dt class="eyebrow">When</dt>
        <dd class="mt-1 text-base font-semibold">{dateLabel} · {timeLabel}</dd>
      </div>
      <div>
        <dt class="eyebrow">Where</dt>
        <dd class="mt-1 text-base font-semibold">{whereLabel(event.data)}</dd>
      </div>
    </dl>
  </header>
  <div class="container-prose pt-10 pb-16 md:py-16 prose-doc">
    <Content />
  </div>
</BaseLayout>
