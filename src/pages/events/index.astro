---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';
import { whereLabel } from '../../lib/event-format';
import { TIMEZONE } from '../../lib/event-time';
import { site } from '../../lib/site';

const all = await getCollection('events');
const now = new Date();

const upcoming = all
  .filter((e) => e.data.date >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const past = all
  .filter((e) => e.data.date < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featured = upcoming.find((e) => e.data.featured) ?? upcoming[0] ?? null;
const otherUpcoming = featured ? upcoming.filter((e) => e.id !== featured.id) : [];
---

<BaseLayout title="Events" description="Where we're meeting up next, and what we've done.">
  <header class="container-page pt-20 pb-12 md:pt-28 md:pb-16">
    <SectionHeader title="Events" />
  </header>
  <hr class="rule-thick container-page" />

  <section class="container-page py-12">
    <h2 class="text-headline-lg">Upcoming</h2>
    {
      /* Cadence hint — names the rhythm so a newcomer doesn't have to
        scan eight cards to figure out we meet monthly. Static copy, no
        schema.org recurring-event claim; that would need
        Event.eventSchedule and a separate validation pass. */
    }
    {
      upcoming.length > 0 && (
        <p class="mt-3 text-sm text-[color:var(--color-mute)]">
          General meetings — first Thursday of every month, 6:00 PM PT.
        </p>
      )
    }
    {
      /* The Google Calendar is the source of truth for event metadata —
        the page rebuilds against it on a schedule. Surfacing the link
        gives readers a one-click subscribe path and a fallback if a
        rebuild lags behind a recent change. */
    }
    <p class="mt-2 text-sm text-[color:var(--color-mute)]">
      Subscribe in{' '}
      <a href={site.calendar.url} rel="noopener" target="_blank"> Google Calendar </a>{' '}
      — that's where event details are kept up to date.
    </p>
    {
      upcoming.length === 0 ? (
        <div class="mt-8 max-w-2xl space-y-6">
          <p class="lede">
            We're scheduling our first public events. Coalition meetings, neighborhood walks,
            organizing teach-ins, and Carson&nbsp;City delegations will all land here.
          </p>
          <p class="leading-relaxed text-mute">
            Subscribe and we'll send the first one to your inbox before it goes anywhere else. If
            you'd like to host a meeting for your community — a faith group, labor local, school,
            neighborhood — email{' '}
            <a href="mailto:hello@lasvegasfortransit.org">hello@lasvegasfortransit.org</a>.
          </p>
          <a
            href="/go#newsletter"
            class="press inline-flex items-center bg-ink text-paper px-6 py-3 font-bold uppercase tracking-wider no-underline hover:bg-accent"
          >
            Subscribe →
          </a>
        </div>
      ) : (
        <div class="mt-8 space-y-12">
          {featured && <EventCard event={featured} featured />}
          {otherUpcoming.length > 0 && (
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {otherUpcoming.map((e) => (
                <EventCard event={e} />
              ))}
            </div>
          )}
        </div>
      )
    }
  </section>

  {
    past.length > 0 && (
      <section class="container-page py-16">
        <h2 class="text-headline-lg">Past events</h2>
        <ul class="mt-8 divide-y divide-rule/20 border-y border-rule/20">
          {past.map((e) => {
            const dateLabel = new Intl.DateTimeFormat('en-US', {
              month: 'short',
              day: 'numeric',
              year: 'numeric',
              timeZone: TIMEZONE,
            }).format(e.data.date);
            return (
              <li>
                <a
                  href={`/events/${e.id}`}
                  class="press grid grid-cols-[10rem_1fr_auto] gap-6 items-baseline py-5 no-underline hover:bg-ink hover:text-paper hover:px-3"
                >
                  <span class="eyebrow">{dateLabel}</span>
                  <span class="font-semibold">{e.data.title}</span>
                  <span class="text-sm text-mute">{whereLabel(e.data.location)}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</BaseLayout>
