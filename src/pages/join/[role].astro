---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StructuredData from '../../components/seo/StructuredData.astro';
import { getCollection, render } from 'astro:content';
import { roleApplicationMailto } from '../../lib/role-mailto';
import { jobPostingSchema } from '../../lib/structured-data';
import { canonicalUrl, paths } from '../../lib/paths';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const roles = await getCollection('roles');
  return roles.map((role) => ({
    params: { role: role.id },
    props: { role },
  }));
}

const { role } = Astro.props;
const { Content } = await render(role);
const mailtoHref = roleApplicationMailto(role.data.title);
const roleUrl = canonicalUrl(Astro.url.pathname);
---

<BaseLayout title={role.data.title} description={role.data.summary}>
  <StructuredData slot="head" data={jobPostingSchema(role, roleUrl)} />
  {
    /* Condensed CTA that pins beneath the site header once the hero scrolls
      out of view. `top` is set from the live site-header height by
      role-sticky-bar.js; aria-hidden + tabindex=-1 keep it out of the AT
      tree and tab order since it only duplicates the hero/footer actions. */
  }
  <div
    data-role-bar
    aria-hidden="true"
    style="top: var(--site-header-h, 64px)"
    class="fixed inset-x-0 z-40 bg-surface/80 backdrop-blur-md backdrop-saturate-150 border-b border-outline-variant/15 opacity-0 -translate-y-2 pointer-events-none transition duration-200 ease-out data-[visible]:opacity-100 data-[visible]:translate-y-0 data-[visible]:pointer-events-auto motion-reduce:transition-none motion-reduce:translate-y-0"
  >
    <div class="container-page py-2.5 flex items-center justify-between gap-4">
      <span class="min-w-0 leading-tight">
        <span class="block text-title-md truncate">{role.data.title}</span>
        {
          role.data.team && (
            <span class="block text-body-sm opacity-60 truncate">{role.data.team}</span>
          )
        }
      </span>
      <a
        href={mailtoHref}
        tabindex="-1"
        class="press shrink-0 inline-flex items-center bg-primary text-on-primary px-4 py-2 text-sm font-bold no-underline hover:bg-on-surface hover:text-surface"
      >
        Express interest →
      </a>
    </div>
  </div>

  <header data-role-hero class="container-page pt-12 pb-12 md:pt-16 md:pb-16">
    <Breadcrumbs section={{ name: 'Join', href: paths.join }} current={role.data.title} />
    <h1 class="text-headline-lg mt-6">{role.data.title}</h1>
    <p class="mt-4 text-sm font-bold opacity-60">
      {role.data.team && <span>{role.data.team} · </span>}{role.data.commitment}
    </p>
    <a
      href={mailtoHref}
      class="press inline-flex items-center mt-8 bg-primary text-on-primary px-6 py-3 font-bold no-underline hover:bg-on-surface hover:text-surface"
    >
      Express interest →
    </a>
  </header>
  <hr class="rule-thick container-page" />
  <section class="container-page py-12 md:py-16">
    <div class="prose-doc prose-posting max-w-2xl">
      <Content />
      <h2>About Las Vegans for Better Transit</h2>
      <p>
        {site.orgIntro} We're working toward a Las&nbsp;Vegas Valley where a family doesn't have to drive
        to get groceries, where a kid can get home from an after-school club without waiting on a parent,
        where households aren't sinking thousands a year into gas and insurance, and where the preventable
        crashes that hurt and kill people every year stop happening. Transit as part of everyday life
        for a real share of the valley, not something only some people use.
      </p>
      <p>
        Our goal is to become the brand for transit advocacy and better urbanism in the
        Las&nbsp;Vegas Metropolitan Area. We're a relatively new organization, but we're growing and
        building LVBT to last.
      </p>
    </div>
    <div class="mt-16 border-t border-outline-variant/15 pt-10 max-w-2xl">
      <h2 class="text-title-lg">Ready to contribute?</h2>
      <p class="mt-3 leading-relaxed">
        Send a short note — where you're coming from, what draws you to this role, and anything
        relevant about your background.
      </p>
      <a
        href={mailtoHref}
        class="press inline-flex items-center mt-6 bg-primary text-on-primary px-6 py-3 font-bold no-underline hover:bg-on-surface hover:text-surface"
      >
        Express interest →
      </a>
    </div>
  </section>
  {
    /* public/scripts/ to satisfy CSP `script-src 'self'` — same pattern as
      the site header's stuck observer. */
  }
  <script is:inline src="/scripts/role-sticky-bar.js" defer></script>
</BaseLayout>
