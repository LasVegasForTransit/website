---
// The join form page. Built once, then served through the join handler
// (functions/join/member/index.ts), which fills in a one-time form token and,
// after a failed submit, the visitor's input and the errors. Every text comes
// from the message catalog. It works with no JavaScript; with it, typing
// survives a reload and a dropped connection.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JoinForm from '../../../components/join/JoinForm.astro';
import { t } from '../../../../platform/messages';
---

<BaseLayout title={t('join.title')} description={t('join.description')}>
  <section class="container-page pt-12 pb-16 md:pt-16 md:pb-24">
    <div class="max-w-2xl">
      <h1 class="text-headline-lg">{t('join.heading')}</h1>
      <p class="lede mt-4">{t('join.intro')}</p>
      <JoinForm action="/join/member/" />
    </div>
  </section>
  <script is:inline src="/scripts/app-enhance.js" defer></script>
</BaseLayout>
