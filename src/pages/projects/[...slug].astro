---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusPill from '../../components/StatusPill.astro';
import InitiativeChip from '../../components/InitiativeChip.astro';
import ProjectGoals from '../../components/ProjectGoals.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { paths } from '../../lib/paths';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (entry) => !entry.id.startsWith('_'));
  const initiatives = await getCollection('initiatives');
  const initiativesById = new Map(initiatives.map((i) => [i.id, i]));
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, initiativesById },
  }));
}

const { project, initiativesById } = Astro.props;
const { Content } = await render(project);

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
});

const today = new Date();

const startLabel = dateFmt.format(project.data.startDate);
const startLabelName = project.data.startDate <= today ? 'Started' : 'Starts';

const endLabel = project.data.endDate ? dateFmt.format(project.data.endDate) : null;
const endLabelName = project.data.endDate && project.data.endDate <= today ? 'Wrapped' : 'Wraps';

// Default contact role; used to pluralize the section label and to
// suppress the redundant role subtitle on a contact whose role matches.
const LEAD_ROLE = 'Project lead';
const leadsLabel = project.data.contacts.length > 1 ? `${LEAD_ROLE}s` : LEAD_ROLE;
---

<BaseLayout title={project.data.title} description={project.data.tldr}>
  <header class="container-page pt-6 pb-6 md:pt-10">
    <Breadcrumbs
      section={{ name: 'Projects', href: paths.projects }}
      current={project.data.title}
    />
    <h1 class="text-display-md mt-7">{project.data.title}</h1>
    <p class="lede mt-5 max-w-3xl">{project.data.tldr}</p>
    <div class="mt-6 flex flex-wrap items-center gap-2">
      {
        project.data.initiatives.map((slug: string) => (
          <InitiativeChip
            title={initiativesById.get(slug)?.data.title ?? slug}
            href={paths.initiative(slug)}
          />
        ))
      }
    </div>
  </header>

  <hr class="rule-thick container-page" />

  <div class="container-page pt-8 pb-16 grid gap-12 md:grid-cols-[2fr_1fr]">
    <article class="prose-doc max-w-none">
      <Content />
      <ProjectGoals goals={project.data.goals} />
    </article>

    <aside class="md:border-l md:pl-10 md:border-outline-variant/20 space-y-8">
      <div>
        <p class="text-title-sm text-on-surface-variant">Status</p>
        <div class="mt-2">
          <StatusPill status={project.data.status} />
        </div>
      </div>
      <div>
        <p class="text-title-sm text-on-surface-variant">{startLabelName}</p>
        <p class="mt-2 text-lg font-semibold">{startLabel}</p>
        {
          endLabel && (
            <>
              <p class="mt-4 text-title-sm text-on-surface-variant">{endLabelName}</p>
              <p class="mt-2 text-lg font-semibold">{endLabel}</p>
            </>
          )
        }
      </div>
      {
        project.data.contacts.length > 0 && (
          <div>
            <p class="text-title-sm text-on-surface-variant">{leadsLabel}</p>
            <ul class="mt-2 space-y-2">
              {project.data.contacts.map((c: { name: string; role: string }) => (
                <li>
                  <p class="font-semibold">{c.name}</p>
                  {c.role.toLowerCase() !== LEAD_ROLE.toLowerCase() && (
                    <p class="text-sm text-on-surface-variant">{c.role}</p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <div>
        <p class="text-title-sm text-on-surface-variant">Want to help?</p>
        <a
          href="/go"
          data-screen-action
          class="mt-3 inline-flex items-center bg-on-surface text-surface px-4 py-2 text-sm font-bold no-underline"
        >
          Get involved →
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>
