---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { byOrderThenTitle, isActiveProject } from '../../lib/projects';

const projects = await getCollection(
  'projects',
  (entry) => !entry.id.startsWith('_') && isActiveProject(entry),
);
const initiatives = await getCollection('initiatives');

const sorted = [...projects].sort(byOrderThenTitle);
const initiativesById = new Map(initiatives.map((i) => [i.id, i]));

// Cross-tagged projects appear in every section they're tagged with — for a
// small roadmap this reads as a feature, not duplication.
const projectsByInitiative = new Map(initiatives.map((i) => [i.id, [] as typeof sorted]));

for (const project of sorted) {
  for (const initiativeId of project.data.initiatives) {
    projectsByInitiative.get(initiativeId)?.push(project);
  }
}

// Filtered list drives the rendered sections; stable index lets us skip
// the negative-margin overlap on the very first section (no previous
// section to overlap with).
const renderedInitiatives = initiatives.filter(
  (i) => (projectsByInitiative.get(i.id) ?? []).length > 0,
);
---

<BaseLayout
  title="Projects"
  description="The work we're doing right now to build a transit constituency in the Las Vegas Valley."
>
  {
    /* Top padding scales with viewport height (dvh handles mobile URL-bar
       collapse) so the title sits above the fold on ~700–900px laptops
       and still breathes on tall monitors. Clamped to a 3rem floor and
       7rem ceiling so it doesn't go either claustrophobic or absurd. */
  }
  <PageHero
    title="Our projects"
    lede="Buses every ten minutes. Safe streets to reach them. A Legislature that funds both. None of it happens without organized people."
  >
    <a
      href="/roadmap"
      data-screen-action
      class="mt-8 inline-flex border-2 border-outline px-5 py-3 font-bold no-underline hover:bg-on-surface hover:text-surface focus-visible:bg-on-surface focus-visible:text-surface"
    >
      See the roadmap →
    </a>
  </PageHero>

  {
    /* Each initiative's inline header IS the sticky element — same DOM
       node morphs from expanded (display title + lede) to a
       compact label-row when it pins below the site header. A 1px
       sentinel placed just above the header drives the morph via an
       IntersectionObserver in /scripts/projects-initiative-stuck.js
       (CSP-safe — script-src 'self' rejects inline scripts).
       Non-first sections overlap the previous section's pb via negative
       margin so the next sticky pins before the previous releases —
       without this, there's a brief un-pinned window during the natural-
       position transition and the user perceives it as a gap below the
       site header. */
  }
  {
    renderedInitiatives.map((initiative, index) => {
      const inInitiative = projectsByInitiative.get(initiative.id) ?? [];
      return (
        <section
          id={initiative.id}
          class:list={[
            'container-page pb-16 md:pb-20 scroll-mt-24',
            index > 0 && '-mt-16 md:-mt-20',
          ]}
        >
          <div data-initiative-sentinel aria-hidden="true" class="h-px" />
          <div
            data-initiative-header
            class="group/init sticky top-[var(--lvbt-header-h)] z-40 bg-surface pt-10 pb-8 border-y border-y-transparent transition-[padding,border-color] duration-200 ease-out data-[stuck]:pt-3 data-[stuck]:pb-3 data-[stuck]:border-y-outline-variant/15"
          >
            <h2 class="text-headline-lg mt-2 transition-[font-size,line-height,letter-spacing] duration-200 ease-out group-data-[stuck]/init:text-title-lg group-data-[stuck]/init:mt-0">
              <a
                href={`#${initiative.id}`}
                data-initiative-permalink
                aria-label={`Copy link to ${initiative.data.title}`}
                class="group/perm relative inline-flex items-baseline gap-3 no-underline"
              >
                {/* Copy-success indicator lives in the left gutter,
                    absolute-positioned so it doesn't shift the title
                    when it appears. `right-full` parks it against the
                    title's left edge; `mr-3` adds breathing room.
                    Sized + colored to match the `#` affordance on the
                    right when active. */}
                <Icon
                  name="mdi:check"
                  aria-hidden="true"
                  class="absolute right-full top-1/2 -translate-y-1/2 mr-2 size-[0.6em] text-primary opacity-0 transition-opacity duration-150 group-data-[copied]/perm:opacity-100"
                />
                <span>{initiative.data.title}</span>
                {/* `#` permalink affordance on the right — visible on
                    hover/focus. Stays muted on copy; the primary check
                    on the left carries the success-state signal. */}
                <span
                  aria-hidden="true"
                  class="text-on-surface-variant text-[0.5em] font-normal tracking-normal opacity-0 transition-opacity duration-150 group-hover/perm:opacity-100 group-focus-visible/perm:opacity-100"
                >
                  #
                </span>
              </a>
            </h2>
            <p class="lede mt-3 max-w-3xl group-data-[stuck]/init:hidden">
              {initiative.data.description}
            </p>
          </div>
          <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {inInitiative.map((project) => (
              <ProjectCard
                project={project}
                initiatives={project.data.initiatives.map((slug) => ({
                  title: initiativesById.get(slug)?.data.title ?? slug,
                }))}
              />
            ))}
          </div>
        </section>
      );
    })
  }

  <script is:inline src="/scripts/projects-initiative-stuck.js" defer></script>
  <script is:inline src="/scripts/projects-initiative-permalink.js" defer></script>
</BaseLayout>

<style>
  /* /projects print layout — the sticky initiative headers unpin and the
     permalink affordances disappear on paper. Only this route ships it. */
  @media print {
    [data-initiative-header] {
      position: static !important;
      z-index: auto !important;
      padding-block: 0.18in 0.12in !important;
      background: transparent !important;
      border-top: 1pt solid color-mix(in srgb, var(--ink) 28%, var(--paper)) !important;
      border-bottom: 0 !important;
      break-after: avoid;
      page-break-after: avoid;
    }

    [data-initiative-sentinel] {
      display: none !important;
    }

    [data-initiative-permalink] {
      pointer-events: none !important;
    }

    [data-initiative-permalink] > :is(svg, [aria-hidden='true']) {
      display: none !important;
    }
  }
</style>
