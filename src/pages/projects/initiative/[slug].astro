---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import InitiativeChip from '../../../components/InitiativeChip.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const initiatives = await getCollection('initiatives');
  const projects = await getCollection('projects', (entry) => !entry.id.startsWith('_'));
  const initiativesById = new Map(initiatives.map((i) => [i.id, i]));

  return initiatives.map((initiative) => ({
    params: { slug: initiative.id },
    props: {
      initiative,
      initiatives,
      initiativesById,
      projects: projects
        .filter((p) => p.data.initiatives.includes(initiative.id))
        .sort((a, b) => {
          const ao = a.data.order ?? 999;
          const bo = b.data.order ?? 999;
          if (ao !== bo) return ao - bo;
          return a.data.title.localeCompare(b.data.title);
        }),
    },
  }));
}

const { initiative, initiatives, initiativesById, projects } = Astro.props;
---

<BaseLayout
  title={`${initiative.data.title} — Projects`}
  description={initiative.data.description}
>
  <header class="container-page pt-6 pb-6 md:pt-10">
    <p class="eyebrow">
      <a href="/projects" class="no-underline hover:underline">← All projects</a>
    </p>
    <SectionHeader
      eyebrow="Initiative"
      title={initiative.data.title}
      lede={initiative.data.description}
    />
  </header>

  <hr class="rule-thick container-page" />

  <section class="container-page py-10">
    <p class="eyebrow">Initiatives</p>
    <div class="mt-4 flex flex-wrap gap-3">
      {
        initiatives.map((i) => (
          <InitiativeChip
            title={i.data.title}
            href={`/projects/initiative/${i.id}`}
            active={i.id === initiative.id}
          />
        ))
      }
    </div>
  </section>

  <section class="container-page pb-20 md:pb-28">
    {
      projects.length === 0 ? (
        <p class="text-mute">No projects under this initiative yet.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard
              href={`/projects/${project.id}`}
              title={project.data.title}
              status={project.data.status}
              tldr={project.data.tldr}
              initiatives={project.data.initiatives.map((id) => ({
                title: initiativesById.get(id)?.data.title ?? id,
              }))}
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
