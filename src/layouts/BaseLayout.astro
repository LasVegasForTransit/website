---
import '../styles/global.css';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { site } from '../lib/site';
import { organizationSchema } from '../lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  chrome?: 'site' | 'none';
  /**
   * Root canvas color. 'paper' (default) is the standard cream surface every
   * page uses. 'dark' paints the body ink and asks the header to render
   * transparent until the user scrolls past it — the immersive-hero pattern.
   * Pages opt in by setting this prop; styling lives in global.css and is
   * page-agnostic (see [data-canvas='dark'] rules).
   */
  canvas?: 'paper' | 'dark';
}

const {
  title,
  description = 'Las Vegans for Better Transit is the grassroots advocacy group fighting for world-class public transit and supportive land use in the Las Vegas Valley.',
  ogImage = '/og-default.png',
  noindex = false,
  chrome = 'site',
  canvas = 'paper',
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---

<!doctype html>
{
  /* `reveal-ready` is rendered server-side so the `.reveal-ready .reveal`
    cascade in global.css applies before any reveal element paints — no
    FOUC. Previously this was an inline <head> <script>, which the site's
    CSP `script-src 'self'` blocked in production, leaving every reveal
    permanently in its default-visible state. The <noscript> override
    below restores graceful degradation for visitors without JS: reveals
    snap to visible instead of getting stuck hidden. */
}
<html lang="en" class="reveal-ready">
  <head>
    <meta charset="UTF-8" />
    <noscript>
      <style>
        .reveal-ready .reveal,
        .reveal-ready .reveal-stat,
        .reveal-ready .reveal-quote {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
          transition: none !important;
        }
      </style>
    </noscript>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      /* Render-blocking (no defer) so its `pagereveal` listener is registered
        before the event fires on an inbound cross-document view transition.
        Tiny; tags navigations to/from /qr with a view-transition type. */
    }
    <script is:inline src="/scripts/route-transition.js"></script>
    <StructuredData data={organizationSchema()} />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col" data-canvas={canvas}>
    {
      /* Scroll-progress indicator. Real element (not body::before) because
        Tailwind v4's Lightning CSS pipeline strips class-less pseudo-element
        rules from inside @supports blocks. Class-based selector survives
        purging; @supports gates the actual scroll-driven animation. */
    }
    {chrome === 'site' && <div class="site-scroll-progress" aria-hidden="true" />}
    {
      chrome === 'site' && (
        <a href="#main" class="skip-link">
          Skip to content
        </a>
      )
    }
    {
      /* Wrapper reserves exactly one dynamic viewport for header + main
        content. Header counts against the budget instead of being
        additional to it, so the footer sits flush at the next viewport
        boundary on first load — no over-scroll, no calc() math that
        breaks if the header height changes. Sticky positioning still
        anchors to the viewport top inside this block; when the wrapper
        scrolls past, sticky releases and the footer takes over. */
    }
    <div class="min-h-dvh flex flex-col">
      {chrome === 'site' && <Header />}
      <main id="main" class="flex-1">
        <slot />
      </main>
    </div>
    {chrome === 'site' && <Footer />}
    {
      /* Behaviour lives at /scripts/reveal-on-scroll.js (public/) so it
        satisfies the site's CSP `script-src 'self'` — an inline block
        here would be rejected in production, leaving every reveal
        element stuck hidden. Same pattern as ShareButton / Header. */
    }
    {chrome === 'site' && <script is:inline src="/scripts/reveal-on-scroll.js" defer />}
    {
      /* Cloudflare Web Analytics. Real-user CWV + page-view counts to
         complement the synthetic Lighthouse runs in CI. Gated on
         PUBLIC_CWA_TOKEN so local dev (no token in .env.local) ships
         no beacon and the CSP stays tight. The token is baked into
         the static HTML — that's how CWA is designed; the dashboard
         tokens are not secret credentials. `defer` (not `async`) so
         the beacon never competes with first-paint work. */
    }
    {
      import.meta.env.PUBLIC_CWA_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: import.meta.env.PUBLIC_CWA_TOKEN,
          })}
        />
      )
    }
  </body>
</html>
